---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { rutaFicha } from '../fichas/registro';
import {
  nombreSerie,
  textoRezago,
  textoUltimaSemana,
  type AntiguedadEntrada,
} from '../lib/frescura';
import { formatearFechaIso } from '../lib/vista-alertas';

interface Corte {
  fecha: string;
  version: string;
  series: Record<string, AntiguedadEntrada>;
}

const corte = JSON.parse(
  readFileSync(resolve('public/datos/corte.json'), 'utf8'),
) as Corte;
---

<Layout
  title="EPI-Aetheris — Estado del servicio"
  descripcion="Fecha del corte publicado y última semana con datos de cada serie."
>
  <main
    id="contenido-principal"
    class="mx-auto max-w-3xl px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header class="mb-8">
      <h1 class="font-display text-2xl font-semibold tracking-tight text-ink">
        Estado del servicio
      </h1>
      <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
        Esta edición estática se puede consultar desde una copia del sitio. Los
        datos se actualizan con la publicación de una nueva edición.
      </p>
      <dl class="mt-4 grid grid-cols-2 gap-4 font-sans text-sm">
        <div>
          <dt class="font-semibold text-ink">Fecha de corte</dt>
          <dd data-fecha-corte class="text-ink-muted">
            <time datetime={corte.fecha}>{formatearFechaIso(corte.fecha)}</time>
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-ink">Versión de los datos</dt>
          <dd class="font-mono text-xs text-ink-muted">{corte.version}</dd>
        </div>
      </dl>
    </header>

    <section
      data-frescura
      aria-labelledby="frescura-titulo"
      class="rounded-2xl border border-border bg-surface p-4 sm:p-6"
    >
      <h2 id="frescura-titulo" class="font-sans text-sm font-semibold text-ink">
        Última semana con dato
      </h2>
      <p class="mt-2 font-sans text-xs leading-relaxed text-ink-muted">
        El rezago se mide entre la última semana observada y la fecha de corte.
        Consulta cómo se calcula en la ficha de <a
          href={rutaFicha('m4-integridad-vigilancia')}
          class="font-semibold text-accent underline underline-offset-2"
          >integridad de la vigilancia</a
        >.
      </p>
      <div class="mt-4 overflow-x-auto font-sans text-sm">
        <table class="w-full text-left" aria-labelledby="frescura-titulo">
          <thead>
            <tr class="border-b border-border">
              <th scope="col" class="py-2 pr-4">Serie</th>
              <th scope="col" class="py-2 pr-4">Semana</th>
              <th scope="col" class="py-2">Rezago al corte</th>
            </tr>
          </thead>
          <tbody>
            {
              Object.entries(corte.series).map(([clave, serie]) => (
                <tr class="border-b border-border last:border-b-0">
                  <th scope="row" class="py-2 pr-4 font-medium">
                    {nombreSerie(clave)}
                  </th>
                  <td class="py-2 pr-4">
                    {textoUltimaSemana(serie) ?? 'Sin datos'}
                  </td>
                  <td class="py-2">{textoRezago(serie) ?? '—'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <a
        href="/datos/corte.json"
        class="mt-4 inline-block font-sans text-xs font-semibold text-accent underline underline-offset-2"
      >
        Consultar metadatos del corte (JSON)
      </a>
    </section>
  </main>
</Layout>
