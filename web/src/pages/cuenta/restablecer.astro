---
import CuentaPagina from '../../components/CuentaPagina.astro';
import {
  CLASE_AYUDA,
  CLASE_BOTON_PRINCIPAL,
  CLASE_CAMPO,
  CLASE_ENLACE,
  CLASE_ETIQUETA,
  CLASE_TARJETA,
} from '../../lib/cuenta-estilos';
---

<CuentaPagina
  titulo="Elegir contraseña nueva"
  descripcion="Escribe la contraseña nueva de tu cuenta."
>
  <div data-pagina-restablecer>
    <section data-estado="sin-token" hidden class={CLASE_TARJETA}>
      <h2 class="font-sans text-lg font-bold text-ink">
        El enlace está incompleto
      </h2>
      <p class="mt-2 font-sans text-sm leading-relaxed text-ink-muted">
        Ábrelo de nuevo desde el correo, o <a
          href="/cuenta/olvide"
          class={CLASE_ENLACE}>pide uno nuevo</a
        >.
      </p>
    </section>

    <section data-estado="formulario" hidden class={CLASE_TARJETA}>
      <form data-form-restablecer class="flex flex-col gap-4" novalidate>
        <label class="flex flex-col gap-1.5">
          <span class={CLASE_ETIQUETA}>Contraseña nueva</span>
          <input
            type="password"
            name="contrasena"
            autocomplete="new-password"
            required
            maxlength="256"
            aria-describedby="requisitos-contrasena"
            class={CLASE_CAMPO}
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class={CLASE_ETIQUETA}>Repite la contraseña</span>
          <input
            type="password"
            name="repetir"
            autocomplete="new-password"
            required
            maxlength="256"
            class={CLASE_CAMPO}
          />
        </label>
        <div>
          <p class={CLASE_ETIQUETA} id="titulo-requisitos">
            Requisitos de la contraseña
          </p>
          <ul
            id="requisitos-contrasena"
            data-requisitos
            aria-labelledby="titulo-requisitos"
            class="mt-1 space-y-0.5 font-sans text-xs"
          >
          </ul>
        </div>
        <label class="flex items-center gap-2 font-sans text-sm text-ink">
          <input
            type="checkbox"
            data-mostrar
            class="h-4 w-4 accent-[var(--color-accent)]"
          />
          <span>Mostrar contraseña</span>
        </label>
        <div data-aviso tabindex="-1" hidden></div>
        <div>
          <button type="submit" class={CLASE_BOTON_PRINCIPAL}
            >Guardar contraseña</button
          >
        </div>
      </form>
    </section>

    <section data-estado="listo" hidden class={CLASE_TARJETA}>
      <p
        data-mensaje-listo
        role="status"
        class="font-sans text-sm leading-relaxed text-ink"
      >
      </p>
      <p class={`mt-3 ${CLASE_AYUDA}`}>
        Por seguridad, se cerraron las sesiones abiertas de tu cuenta.
      </p>
      <p class="mt-4">
        <a href="/cuenta/ingresar" class={CLASE_ENLACE}>Ir a ingresar</a>
      </p>
    </section>
  </div>
</CuentaPagina>

<script>
  import { restablecerClave } from '../../lib/cuenta-api';
  import { contrasenaCumple } from '../../lib/contrasena-requisitos';
  import {
    conCarga,
    leerTokenDelFragmento,
    limpiarAviso,
    mensajeDeError,
    mostrarAviso,
    pedirElemento,
    vincularMostrarContrasena,
    vincularRequisitos,
  } from '../../lib/cuenta-ui';

  const raiz = document.querySelector<HTMLElement>('[data-pagina-restablecer]');
  if (raiz) iniciar(raiz);

  function estado(raiz: HTMLElement, nombre: string): void {
    for (const seccion of raiz.querySelectorAll<HTMLElement>('[data-estado]')) {
      seccion.hidden = seccion.dataset.estado !== nombre;
    }
  }

  function iniciar(raiz: HTMLElement): void {
    // El token viaja en el fragmento y se borra de la dirección al leerlo.
    const token = leerTokenDelFragmento();
    if (!token) {
      estado(raiz, 'sin-token');
      return;
    }
    estado(raiz, 'formulario');
    const form = pedirElemento<HTMLFormElement>(
      raiz,
      '[data-form-restablecer]',
    );
    const contrasena = pedirElemento<HTMLInputElement>(
      form,
      '[name="contrasena"]',
    );
    const repetir = pedirElemento<HTMLInputElement>(form, '[name="repetir"]');
    const aviso = pedirElemento<HTMLElement>(form, '[data-aviso]');
    vincularRequisitos(contrasena, pedirElemento(form, '[data-requisitos]'));
    vincularMostrarContrasena(pedirElemento(form, '[data-mostrar]'), [
      contrasena,
      repetir,
    ]);

    form.addEventListener('submit', (evento) => {
      evento.preventDefault();
      limpiarAviso(aviso);
      if (!contrasenaCumple(contrasena.value)) {
        mostrarAviso(aviso, 'error', 'La contraseña no cumple los requisitos.');
        return;
      }
      if (contrasena.value !== repetir.value) {
        mostrarAviso(aviso, 'error', 'Las contraseñas no coinciden.');
        return;
      }
      const boton = pedirElemento<HTMLButtonElement>(form, '[type="submit"]');
      void conCarga(boton, async () => {
        try {
          const mensaje = await restablecerClave(token, contrasena.value);
          contrasena.value = '';
          repetir.value = '';
          pedirElemento(raiz, '[data-mensaje-listo]').textContent = mensaje;
          estado(raiz, 'listo');
        } catch (error) {
          mostrarAviso(aviso, 'error', mensajeDeError(error));
        }
      });
    });
  }
</script>
