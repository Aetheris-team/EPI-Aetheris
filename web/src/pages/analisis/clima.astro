---
import Layout from '../../layouts/Layout.astro';
import NavSecciones from '../../components/NavSecciones.astro';
import PanelAporteClima from '../../components/clima/PanelAporteClima.astro';
import PanelAsociacionAnio from '../../components/clima/PanelAsociacionAnio.astro';
import PanelCicloClima from '../../components/clima/PanelCicloClima.astro';
import PanelPaisesClima from '../../components/clima/PanelPaisesClima.astro';
import PanelPaisVariable from '../../components/clima/PanelPaisVariable.astro';
import MenuExportar from '../../components/MenuExportar.astro';
import {
  URL_CLIMA_MULTIPAIS,
  URL_CLIMA_POR_ANIO,
} from '../../lib/analisis-api';
import { RUTA_CLIMA_DOC, RUTA_SENSIBILIDAD } from '../../lib/enlaces';

// Investigación de clima y dengue (ADR 0023 del monorepo). Dos artefactos
// descriptivos precomputados: GET /api/clima-dengue/por-anio (El Salvador, año
// por año) y /multipais (18 países de las Américas). Los paneles cargan sus
// datos cuando se acercan a la pantalla. Cada gráfica trae sus tablas; el
// método, los resultados completos y los datos que faltan viven en la
// Biblioteca (07-clima-y-dengue).
const DESCARGAS = [
  { texto: 'El Salvador por año (JSON)', href: URL_CLIMA_POR_ANIO },
  { texto: '18 países (JSON)', href: URL_CLIMA_MULTIPAIS },
];
---

<Layout
  title="EPI-Aetheris — Clima y dengue"
  descripcion="Cuánto aportó el clima al pronóstico de dengue en cada año, qué relación tienen el clima y el crecimiento de los casos en El Salvador y cómo se compara con otros 17 países de las Américas."
>
  <main
    id="contenido-principal"
    data-pagina-clima
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header
      class="mb-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-12"
      data-cabecera-clima
    >
      <div class="lg:col-span-8">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 font-sans text-xs font-semibold text-accent"
        >
          <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"
          ></span>
          <span>Investigación multivariada · OpenDengue & Open-Meteo</span>
        </div>
        <h1
          class="mt-3 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl"
        >
          Clima y dengue
        </h1>
        <p
          class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-ink-muted sm:text-base"
        >
          El aporte del clima al pronóstico de dengue cambia de un año a otro, y
          la evolución anual de los casos en El Salvador es de las que menos
          coinciden con la de la región. Esta página reúne las cifras de esa
          investigación descriptiva (2014 a 2024), con sus intervalos e
          inferencia estadística. La{' '}
          <a
            href={RUTA_CLIMA_DOC}
            class="font-medium text-accent underline underline-offset-4 transition-colors hover:text-accent/80"
            >Biblioteca técnica</a
          >{' '}
          explica el método, reúne los resultados completos y lista los datos que
          harían falta para avanzar. Sobre lo que significa una correlación está el{
            ' '
          }
          <a
            href={`${RUTA_SENSIBILIDAD}#coincidir-en-el-tiempo-no-prueba-una-causa`}
            class="font-medium text-accent underline underline-offset-4 transition-colors hover:text-accent/80"
            >aviso de sensibilidad</a
          >.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-4 font-sans text-sm">
          <a
            href="/dengue"
            class="inline-flex items-center gap-1.5 font-medium text-accent underline underline-offset-4 transition-colors hover:text-accent/80"
          >
            <span>← Volver a vigilancia de dengue</span>
          </a>
          <a
            href="#clima-descargas"
            class="inline-flex items-center gap-1.5 font-medium text-ink-muted underline underline-offset-4 transition-colors hover:text-ink"
          >
            <span>Descargar datos completos (JSON) ↓</span>
          </a>
        </div>
      </div>

      <div
        class="flex flex-col gap-3 rounded-2xl border border-border bg-surface/60 p-4 shadow-2xs backdrop-blur-xs lg:col-span-4"
      >
        <div
          class="flex items-center justify-between border-b border-border/60 pb-2.5"
        >
          <span
            class="font-sans text-xs font-semibold uppercase tracking-wider text-ink-muted"
          >
            Alcance metodológico
          </span>
          <span
            class="inline-flex items-center gap-1 font-mono text-[11px] text-accent"
          >
            <span
              class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"
              aria-hidden="true"></span>
            11 años evaluados
          </span>
        </div>
        <dl class="grid grid-cols-2 gap-2 font-sans text-xs">
          <div class="rounded-lg border border-border/40 bg-bg/80 p-2">
            <dt class="text-[11px] text-ink-muted">Países</dt>
            <dd class="mt-0.5 font-mono text-sm font-semibold text-ink">
              18 Américas
            </dd>
          </div>
          <div class="rounded-lg border border-border/40 bg-bg/80 p-2">
            <dt class="text-[11px] text-ink-muted">Variables</dt>
            <dd class="mt-0.5 font-mono text-sm font-semibold text-ink">
              8 climáticas
            </dd>
          </div>
          <div class="rounded-lg border border-border/40 bg-bg/80 p-2">
            <dt class="text-[11px] text-ink-muted">Horizontes</dt>
            <dd class="mt-0.5 font-mono text-sm font-semibold text-ink">
              4 y 8 semanas
            </dd>
          </div>
          <div class="rounded-lg border border-border/40 bg-bg/80 p-2">
            <dt class="text-[11px] text-ink-muted">Inferencia</dt>
            <dd class="mt-0.5 font-mono text-sm font-semibold text-ink">
              IC 95 % bootstrap
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <NavSecciones
      class="mb-8"
      etiqueta="Secciones de clima y dengue"
      enlaces={[
        { href: '#aporte', etiqueta: 'Aporte al pronóstico' },
        { href: '#asociacion', etiqueta: 'Correlación anual' },
        { href: '#ciclo', etiqueta: 'Ciclo estacional' },
        { href: '#paises', etiqueta: 'Comparativa multipaís' },
        { href: '#pais-variable', etiqueta: 'Matriz regional' },
        { href: '#clima-descargas', etiqueta: 'Descargas' },
      ]}
    />

    <div
      id="aporte"
      class="mt-6 scroll-mt-[calc(var(--alto-header)+1rem)]"
      data-bloque-clima="aporte"
    >
      <PanelAporteClima />
    </div>
    <div
      id="asociacion"
      class="mt-8 scroll-mt-[calc(var(--alto-header)+1rem)]"
      data-bloque-clima="asociacion"
    >
      <PanelAsociacionAnio />
    </div>
    <div
      id="ciclo"
      class="mt-8 scroll-mt-[calc(var(--alto-header)+1rem)]"
      data-bloque-clima="ciclo"
    >
      <PanelCicloClima />
    </div>
    <div
      id="paises"
      class="mt-8 scroll-mt-[calc(var(--alto-header)+1rem)]"
      data-bloque-clima="paises"
    >
      <PanelPaisesClima />
    </div>
    <div
      id="pais-variable"
      class="mt-8 scroll-mt-[calc(var(--alto-header)+1rem)]"
      data-bloque-clima="pais-variable"
    >
      <PanelPaisVariable />
    </div>

    <section
      id="clima-descargas"
      class="mt-10 scroll-mt-[calc(var(--alto-header)+1rem)] rounded-2xl border border-border bg-surface p-6 shadow-2xs"
      aria-labelledby="clima-descargas-titulo"
    >
      <h2
        id="clima-descargas-titulo"
        class="font-display text-lg font-semibold text-ink"
      >
        Descargar los datos
      </h2>
      <p
        class="mt-1 max-w-[68ch] font-sans text-sm leading-relaxed text-ink-muted"
      >
        Los dos archivos completos, con los parámetros de cada cálculo y las
        series semanales.
      </p>
      <MenuExportar
        class="mt-4"
        alineacion="izquierda"
        titulo="Datos completos de clima y dengue"
        fuente="EPI-Aetheris"
        imagen={false}
        enlaces={DESCARGAS}
      />
    </section>
  </main>
</Layout>
