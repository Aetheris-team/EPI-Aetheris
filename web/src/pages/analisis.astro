---
import Layout from '../layouts/Layout.astro';
import { DEPARTAMENTOS } from '../lib/departamentos';
import Icono from '../components/Icono.astro';
import { RUTA_CLIMA, RUTA_PREDICCION } from '../lib/enlaces';

// Índice de las herramientas descriptivas (ADR 0014). Existe para que la
// puerta de entrada del sitio pueda ser el panorama sin que las dos vistas
// de análisis pierdan un lugar propio y estable en la navegación. No calcula
// nada: solo enruta; los límites del sistema están en el pie y en la Biblioteca.

const HERRAMIENTAS = [
  {
    href: '/dengue',
    titulo: 'Dengue',
    icono: 'bug',
    estado: 'Cuatro capas activas',
    texto:
      'Mapa departamental con idoneidad biofísica (M1), anomalía climática frente a la propia historia del departamento (M2) y presión epidemiológica relativa como percentil (M3) e integridad de la vigilancia (M4). Series, canal endémico, comparaciones, calendario, dispersión con el clima y disponibilidad de datos.',
  },
  {
    href: RUTA_PREDICCION,
    titulo: 'Predicción de dengue',
    icono: 'bug',
    estado: 'Corto plazo',
    texto:
      'Conteo nacional de casos para las próximas 1 a 8 semanas, con intervalo de incertidumbre, contraste con lo observado y el archivo del clasificador piloto.',
  },
  {
    href: RUTA_CLIMA,
    titulo: 'Clima y dengue',
    icono: 'cloud-rain',
    estado: 'Investigación',
    texto:
      'Cuánto aportó el clima al pronóstico en cada año, qué relación tienen el clima y el crecimiento de los casos en El Salvador y cómo se compara El Salvador con otros 17 países de las Américas, con todas las cifras en tablas.',
  },
  {
    href: '/respiratorio',
    titulo: 'Respiratorio',
    icono: 'lungs',
    estado: 'Series notificadas',
    texto:
      'Neumonías e infección respiratoria aguda (IRA) notificadas por departamento (ADR 0011), más la serie nacional del tablero de MINSAL desde 2025 y la vigilancia laboratorial nacional de virus: muestras y detecciones. Cada serie conserva su unidad.',
  },
];

const COMO_LEER = [
  'Cada departamento se compara contra su propia historia.',
  'Cada capa describe lo ya publicado: un percentil, un conteo, una anomalía.',
  'Las series son históricas, no de tiempo real: el dato más reciente cargado no es el de esta semana.',
];
---

<Layout
  title="EPI-Aetheris — Análisis"
  descripcion="Herramientas descriptivas de EPI-Aetheris: dengue y respiratorio por departamento, sobre datos públicos históricos."
>
  <main
    id="contenido-principal"
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-14 lg:px-12"
  >
    <header class="max-w-3xl">
      <h1 class="titular-hero text-ink">Análisis</h1>
      <p
        class="mt-5 font-sans text-base leading-relaxed text-ink-muted sm:text-lg"
      >
        Las vistas descriptivas del sistema. Para lo que está vigente y las
        indicaciones para la unidad, <a
          href="/alertas"
          class="font-medium text-accent"
          ><span class="enlace-filete">Alertas de campo</span></a
        > es más directa.
      </p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        HERRAMIENTAS.map((h) => (
          <a
            href={h.href}
            data-herramienta={h.href}
            class="superficie-pulsable flex flex-col rounded-2xl border border-border bg-surface p-6 sm:p-8"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="insignia-icono flex h-11 w-11 items-center justify-center rounded-full bg-secondary text-secondary-ink">
                <Icono nombre={h.icono} class="h-6 w-6" />
              </span>
              <span class="shrink-0 rounded-full bg-secondary px-2.5 py-1 font-mono text-micro font-semibold text-secondary-ink">
                {h.estado}
              </span>
            </div>
            <h2 class="titular-seccion mt-5 text-ink">{h.titulo}</h2>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
              {h.texto}
            </p>
            <span class="mt-6 font-sans text-sm font-semibold text-accent">
              <span class="enlace-filete">Abrir {h.titulo.toLowerCase()}</span>
            </span>
          </a>
        ))
      }
    </div>

    <section
      data-seccion-departamentos
      class="aparece mt-14"
      aria-labelledby="departamentos-titulo"
    >
      <h2
        id="departamentos-titulo"
        class="titular-seccion flex items-center gap-3 text-ink"
      >
        <Icono nombre="map-pin" class="h-7 w-7 text-accent" />
        Un departamento en una página
      </h2>
      <p
        class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-ink-muted"
      >
        Alertas vigentes, canal endémico de dengue, clima y curvas respiratorias
        de un departamento, reunidos para quien trabaja en una unidad de salud.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          DEPARTAMENTOS.map((dep) => (
            <li>
              <a
                href={`/departamento/${dep.codigo}`}
                data-departamento-enlace={dep.codigo}
                class="group inline-flex min-h-[44px] items-center gap-2 rounded-full border border-border bg-surface px-4 font-sans text-xs font-medium text-ink transition-[transform,border-color,background-color] duration-200 hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-accent-ink active:translate-y-0"
              >
                {dep.nombre}
                <span class="font-mono text-micro text-ink-muted transition-colors duration-200 group-hover:text-accent-ink/70">
                  {dep.codigo}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      data-seccion-fichas
      class="aparece mt-14"
      aria-labelledby="fichas-titulo"
    >
      <h2
        id="fichas-titulo"
        class="titular-seccion flex items-center gap-3 text-ink"
      >
        <Icono nombre="printer" class="h-7 w-7 text-accent" />
        Fichas departamentales imprimibles
      </h2>
      <p
        class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-ink-muted"
      >
        Una hoja por departamento para campo e impresión sin conexión: estado de
        la última semana disponible (M1, M2, M3), series históricas, IRA,
        neumonías y las guías de prevención oficiales citadas.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          DEPARTAMENTOS.map((dep) => (
            <li>
              <a
                href={`/analisis/ficha/${dep.codigo}`}
                data-ficha-enlace={dep.codigo}
                class="group inline-flex min-h-[38px] items-center gap-2 rounded-full border border-border bg-surface px-4 font-sans text-xs font-medium text-ink transition-[transform,border-color,background-color] duration-200 hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-accent-ink active:translate-y-0"
              >
                {dep.nombre}
                <span class="font-mono text-micro text-ink-muted transition-colors duration-200 group-hover:text-accent-ink/70">
                  {dep.codigo}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="aparece mt-14" aria-labelledby="como-leer-titulo">
      <h2 id="como-leer-titulo" class="titular-seccion text-ink">
        Cómo leer estas vistas
      </h2>
      <ul class="mt-6 border-t border-border">
        {
          COMO_LEER.map((item) => (
            <li class="border-b border-border py-4 font-sans text-sm leading-relaxed text-ink-muted">
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 font-sans text-sm text-ink-muted">
        El porqué de cada decisión está en la <a
          href="/biblioteca"
          class="font-medium text-accent"
          ><span class="enlace-filete">Biblioteca</span></a
        >.
      </p>
    </section>
  </main>
</Layout>

<script>
  import { iniciarMovimiento } from '../lib/movimiento';

  iniciarMovimiento();
</script>
