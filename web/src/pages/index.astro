---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import Icono from '../components/Icono.astro';

// Portada. Habla primero a la poblacion general, despues a quien evalua el
// proyecto y al final a prensa. No repite el dashboard: presenta el sistema
// y enruta. Los deslindes vinculantes viven en el pie de pagina y, con su
// argumento entero, en la Biblioteca (RUTA_SENSIBILIDAD en src/lib/enlaces.ts).
//
// Firma visual (rediseno 2026-09): el hero es el mapa de los 14 departamentos
// a pantalla completa, proyectado en build desde el mismo geojson que consume
// MapaDepartamentos.astro en /dengue, con el titular encima. Cada silueta es
// un enlace real a su ficha. El mapa se traza departamento por departamento
// al cargar; es el unico movimiento del sitio que no responde a una accion.
//
// Contenedor a max-w-[1600px] (mismo ancho que el header/footer del Layout).

interface DepartamentoGeo {
  codigo: string;
  nombre: string;
  d: string;
  cx: number;
  cy: number;
}

function construirSiluetaDepartamentos(): {
  paths: DepartamentoGeo[];
  viewBox: string;
} {
  // No usar new URL('../../public/...', import.meta.url): en dev resuelve
  // contra la ruta fuente real, pero astro build empaqueta este codigo en
  // dist/.prerender/chunks/, asi que la misma ruta relativa termina
  // apuntando a dist/public/geo/... — ese directorio no existe, Astro copia
  // public/ a la raiz de dist/ (dist/geo/...). process.cwd() es estable en
  // ambos casos: astro build y astro dev corren con cwd en la raiz de web/.
  const ruta = join(process.cwd(), 'public/geo/slv-adm1.geojson');
  const geojson = JSON.parse(readFileSync(ruta, 'utf-8'));

  const ANCHO = 480;
  const ALTO = 340;
  const MARGEN = 10;

  let minLon = Infinity;
  let minLat = Infinity;
  let maxLon = -Infinity;
  let maxLat = -Infinity;
  for (const f of geojson.features) {
    const anillos =
      f.geometry.type === 'Polygon'
        ? [f.geometry.coordinates]
        : f.geometry.coordinates;
    for (const poligono of anillos) {
      for (const anillo of poligono) {
        for (const [lon, lat] of anillo) {
          if (lon < minLon) minLon = lon;
          if (lon > maxLon) maxLon = lon;
          if (lat < minLat) minLat = lat;
          if (lat > maxLat) maxLat = lat;
        }
      }
    }
  }

  // Corrección de aspecto: 1° de longitud cubre menos distancia real que 1°
  // de latitud a esta latitud (~14°N) — sin esto, El Salvador se ve
  // artificialmente ancho.
  const corrOAspecto = Math.cos(((minLat + maxLat) / 2) * (Math.PI / 180));
  const anchoGeo = (maxLon - minLon) * corrOAspecto;
  const altoGeo = maxLat - minLat;
  const escala = Math.min(
    (ANCHO - MARGEN * 2) / anchoGeo,
    (ALTO - MARGEN * 2) / altoGeo,
  );
  const offsetX = (ANCHO - anchoGeo * escala) / 2;
  const offsetY = (ALTO - altoGeo * escala) / 2;

  const proyectar = ([lon, lat]: [number, number]): [number, number] => {
    const x = (lon - minLon) * corrOAspecto * escala + offsetX;
    const y = ALTO - ((lat - minLat) * escala + offsetY);
    return [x, y];
  };

  const paths: DepartamentoGeo[] = geojson.features.map((f: any) => {
    const anillos =
      f.geometry.type === 'Polygon'
        ? [f.geometry.coordinates]
        : f.geometry.coordinates;
    let bxMin = Infinity;
    let bxMax = -Infinity;
    let byMin = Infinity;
    let byMax = -Infinity;
    const d = anillos
      .map((poligono: number[][][]) =>
        poligono
          .map((anillo: [number, number][]) => {
            const puntos = anillo.map(proyectar);
            for (const [x, y] of puntos) {
              if (x < bxMin) bxMin = x;
              if (x > bxMax) bxMax = x;
              if (y < byMin) byMin = y;
              if (y > byMax) byMax = y;
            }
            return `M${puntos.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')}Z`;
          })
          .join(' '),
      )
      .join(' ');
    return {
      codigo: f.properties.codigo,
      nombre: f.properties.shapeName.replace(/^Departamento de /, ''),
      d,
      cx: Number(((bxMin + bxMax) / 2).toFixed(1)),
      cy: Number(((byMin + byMax) / 2).toFixed(1)),
    };
  });

  return { paths, viewBox: `0 0 ${ANCHO} ${ALTO}` };
}

const { paths: DEPARTAMENTOS_SVG, viewBox: MAPA_VIEWBOX } =
  construirSiluetaDepartamentos();

// --- Contenido de la portada ----------------------------------------------
// Redaccion para poblacion general: verbos llanos, nada de jerga tecnica en
// la mitad superior. Lo que le habla a evaluadores (arquitectura, stack,
// replicar) va al final, ya con su propio tono.

const CIFRAS = [
  { valor: 14, texto: '14', etiqueta: 'departamentos vigilados' },
  { valor: 13, texto: '13', etiqueta: 'años de historia, 2014 a 2026' },
  { valor: 3, texto: '3', etiqueta: 'fuentes públicas de datos' },
  { valor: 4, texto: '4', etiqueta: 'preguntas por semana y departamento' },
];

// Secuencia real de tres pasos: por eso va numerada.
const PASOS = [
  {
    titulo: 'Reúne lo que ya es público',
    texto:
      'Los casos semanales que publica el Ministerio de Salud, el historial de OpenDengue y el clima de Open-Meteo, para cada departamento.',
  },
  {
    titulo: 'Compara cada departamento consigo mismo',
    texto:
      'Lo de esta semana se mide contra lo que ese mismo lugar vivió en años anteriores, no contra el promedio del país.',
  },
  {
    titulo: 'Señala lo que se sale de lo normal',
    texto:
      'El mapa marca dónde el clima favorece al zancudo y dónde los casos suben más de lo habitual, para que la atención llegue antes.',
  },
];

const MODULOS = [
  {
    id: 'M1',
    pregunta: '¿El clima le conviene al zancudo?',
    texto:
      'Temperatura, lluvia y humedad de la semana, resumidas en un índice de qué tan favorable es el momento para el mosquito.',
  },
  {
    id: 'M2',
    pregunta: '¿Es un clima raro para esta época?',
    texto:
      'Compara esa semana con el historial climático del propio departamento, con registros desde 2014.',
  },
  {
    id: 'M3',
    pregunta: '¿Hay más casos de lo habitual?',
    texto:
      'Sitúa los casos de la semana, probables y confirmados por separado, frente a los años anteriores del mismo departamento.',
  },
  {
    id: 'M4',
    pregunta: 'Integridad de la vigilancia',
    texto:
      'Tres indicadores de la calidad del dato: si informaron todos los departamentos, si el boletín cuadra y qué tan reciente es cada serie.',
  },
];

// Logotipos de Simple Icons, en el orden en que se nombran en `tecnologia`.
const STACK = [
  {
    capa: 'Datos',
    tecnologia: 'PostgreSQL 15',
    logos: ['postgresql'],
    texto:
      'Un esquema que no depende de la enfermedad ni de la región: dengue y respiratorio comparten la misma tabla de casos.',
  },
  {
    capa: 'Cálculo',
    tecnologia: 'Python · FastAPI',
    logos: ['python', 'fastapi'],
    texto:
      'Cada capa del mapa se calcula al momento de pedirla. La misma interfaz pública alimenta este sitio y está documentada.',
  },
  {
    capa: 'Sitio',
    tecnologia: 'Astro · TypeScript · SVG',
    logos: ['astro', 'typescript', 'svg'],
    texto:
      'Páginas estáticas con el mapa interactivo encima. Se instala como aplicación y las alertas abren sin señal.',
  },
  {
    capa: 'Despliegue',
    tecnologia: 'Docker Compose',
    logos: ['docker'],
    texto:
      'Tres servicios que se levantan juntos, con los datos ya cargados. Ninguna capa usa servicios de pago.',
  },
];
---

<Layout
  mapa
  title="EPI-Aetheris"
  descripcion="Sistema de análisis y prevención de brotes de dengue en El Salvador. Cruza los casos que publica el Ministerio de Salud con el clima de cada departamento, sobre datos públicos y código abierto."
>
  <main id="contenido-principal">
    {
      /* ---------------------------------------------------------------
        Hero a pantalla completa. Orden del DOM: primero el texto y sus
        botones, despues el mapa (14 enlaces), asi el teclado llega antes
        a las llamadas a la accion. El mapa va detras (z-0), el velo
        encima del mapa (z-10, sin eventos) y el texto arriba (z-20). El
        contenedor de texto no recibe punteros, solo sus enlaces, para que
        los departamentos bajo el titular sigan siendo pulsables.
        --------------------------------------------------------------- */
    }
    <section
      class="relative isolate flex min-h-[calc(100svh-var(--alto-header))] items-center overflow-hidden bg-deep"
      aria-labelledby="hero-titulo"
    >
      <div
        class="hero-mapa absolute inset-y-0 left-0 right-0 z-0 opacity-70 sm:opacity-100 lg:left-auto lg:w-[68%]"
      >
        <svg
          viewBox={MAPA_VIEWBOX}
          preserveAspectRatio="xMidYMid meet"
          role="group"
          aria-label="Mapa de los 14 departamentos de El Salvador. Cada uno abre su ficha departamental."
          class="p-4 sm:p-8 lg:p-6"
        >
          {
            DEPARTAMENTOS_SVG.map((d, i) => (
              <a
                href={`/analisis/ficha/${d.codigo}`}
                aria-label={`Ficha departamental de ${d.nombre}`}
                class="depto"
                style={`--retraso:${i * 90}ms`}
              >
                <title>{d.nombre}</title>
                <path d={d.d} pathLength="1" class="depto-forma" />
                <text
                  x={d.cx}
                  y={d.cy}
                  text-anchor="middle"
                  dominant-baseline="middle"
                  font-size="11"
                  class="depto-nombre"
                >
                  {d.nombre}
                </text>
              </a>
            ))
          }
        </svg>
      </div>

      {
        /* Velo: en escritorio va de izquierda (opaco, bajo el texto) a
          derecha (transparente, el mapa entero); en movil es vertical. */
      }
      <div
        class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(180deg,var(--color-deep)_0%,color-mix(in_srgb,var(--color-deep)_82%,transparent)_45%,color-mix(in_srgb,var(--color-deep)_55%,transparent)_100%)] lg:bg-[linear-gradient(90deg,var(--color-deep)_0%,var(--color-deep)_24%,color-mix(in_srgb,var(--color-deep)_55%,transparent)_46%,transparent_66%)]"
        aria-hidden="true"
      >
      </div>

      <div
        class="pointer-events-none relative z-20 mx-auto w-full max-w-[1600px] px-4 py-10 sm:px-8 sm:py-20 lg:px-12 [&_a]:pointer-events-auto"
      >
        <div class="max-w-[38rem] lg:max-w-[44rem]">
          <h1
            id="hero-titulo"
            class="titular-hero text-secondary [text-wrap:balance]"
          >
            <span class="hero-entra block" style="--retraso:700ms"
              >Sistema de análisis</span
            >
            <span class="hero-entra block" style="--retraso:820ms"
              >y prevención de</span
            >
            <span class="hero-entra block" style="--retraso:940ms"
              >brotes de dengue</span
            >
          </h1>
          <p
            class="hero-entra mt-5 max-w-[34rem] sm:mt-7 font-sans text-base leading-relaxed text-deep-ink-muted sm:text-lg"
            style="--retraso:1120ms"
          >
            Cruza los casos que publica el Ministerio de Salud con el clima de
            cada departamento y muestra, semana a semana, dónde está pasando
            algo fuera de lo normal en El Salvador. Sin registro ni pago.
          </p>

          <div
            class="hero-entra mt-7 flex flex-wrap items-center gap-3 sm:mt-9"
            style="--retraso:1260ms"
          >
            <a
              href="/dengue"
              class="boton-principal inline-flex min-h-[48px] items-center rounded-full bg-secondary px-7 font-sans text-sm font-semibold text-secondary-ink"
            >
              Ver el mapa
            </a>
            <a
              href="/alertas"
              class="boton-secundario inline-flex min-h-[48px] items-center rounded-full border border-white/30 px-7 font-sans text-sm font-medium text-deep-ink"
            >
              Alertas de campo
            </a>
          </div>
          <p
            class="hero-entra mt-8 font-sans text-xs text-deep-ink-muted"
            style="--retraso:1500ms"
          >
            Tocá un departamento del mapa para abrir su ficha.
          </p>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1600px] px-4 sm:px-8 lg:px-12">
      {
        /* Tira de alertas vigentes: el unico estado que cambia en la portada,
          y el unico lugar donde aparece el coral de la marca. Si el backend
          no responde, la seccion entera se queda oculta. */
      }
      <section data-tu-departamento hidden class="mt-6">
        <div
          class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-border bg-surface p-6"
        >
          <h2 class="font-sans text-sm font-semibold text-ink">
            Tu departamento
          </h2>
          <a
            href="/analisis"
            data-tu-departamento-enlace
            class="font-sans text-sm font-medium text-accent"
          >
            <span class="enlace-filete" data-tu-departamento-texto></span>
          </a>
        </div>
      </section>

      <section data-tira-alertas hidden class="mt-6">
        <div class="rounded-2xl border border-live/40 bg-surface p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2
              class="flex items-center gap-2.5 font-sans text-sm font-semibold text-ink"
            >
              <span class="punto-vigente" aria-hidden="true"></span>
              Alertas vigentes ahora
            </h2>
            <a
              href="/alertas"
              class="font-sans text-sm font-medium text-accent"
            >
              <span class="enlace-filete">Ver todas</span>
            </a>
          </div>
          <ul data-tira-alertas-lista class="mt-4 space-y-2.5"></ul>
        </div>
      </section>

      {
        /* Enfoque dual (ADR 0014). Dos puertas, no un modo con estado: son
          enlaces normales, asi que un enlace compartido funciona igual para
          cualquiera y no hay dos arquitecturas que mantener sincronizadas. */
      }
      <section class="aparece mt-14 sm:mt-16" aria-labelledby="puertas-titulo">
        <h2 id="puertas-titulo" class="sr-only">Por dónde entrar</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a
            href="/alertas"
            data-puerta="consulta"
            class="superficie-pulsable flex flex-col rounded-2xl border border-border bg-surface p-6 sm:p-8"
          >
            <span
              class="insignia-icono mb-5 flex h-11 w-11 items-center justify-center rounded-full bg-secondary text-secondary-ink"
            >
              <Icono nombre="bell" class="h-6 w-6" />
            </span>
            <h3 class="titular-seccion text-ink">Alertas por departamento</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
              Avisos redactados por el equipo de vigilancia, con lo que conviene
              hacer en cada departamento. Se leen desde el teléfono, se imprimen
              y funcionan sin señal.
            </p>
            <span class="mt-6 font-sans text-sm font-semibold text-accent">
              <span class="enlace-filete">Ver alertas</span>
            </span>
          </a>

          <a
            href="/analisis"
            data-puerta="analisis"
            class="superficie-pulsable flex flex-col rounded-2xl border border-border bg-surface p-6 sm:p-8"
          >
            <span
              class="insignia-icono mb-5 flex h-11 w-11 items-center justify-center rounded-full bg-secondary text-secondary-ink"
            >
              <Icono nombre="chart-line" class="h-6 w-6" />
            </span>
            <h3 class="titular-seccion text-ink">Explorá los datos</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
              Dengue, neumonías e infecciones respiratorias por departamento,
              cada uno comparado con sus propios años anteriores, y una ficha
              imprimible por departamento.
            </p>
            <span class="mt-6 font-sans text-sm font-semibold text-accent">
              <span class="enlace-filete">Abrir análisis</span>
            </span>
          </a>
        </div>
      </section>

      {
        /* Cifras que cuentan hacia arriba al entrar en pantalla. El valor
          final ya esta en el HTML; data-cifra solo lo repite en numero. */
      }
      <section
        class="aparece mt-16 border-y border-border py-10 sm:mt-20"
        aria-label="El sistema en cifras"
      >
        <dl class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4">
          {
            CIFRAS.map((c) => (
              <div>
                <dt class="font-display text-5xl font-semibold tracking-tight text-accent sm:text-6xl">
                  <span data-cifra={c.valor}>{c.texto}</span>
                </dt>
                <dd class="mt-2 max-w-[14rem] font-sans text-sm leading-snug text-ink-muted">
                  {c.etiqueta}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      {/* Como funciona: tres pasos en secuencia real, por eso numerados. */}
      <section class="aparece mt-16 sm:mt-20" aria-labelledby="pasos-titulo">
        <h2 id="pasos-titulo" class="titular-seccion max-w-2xl text-ink">
          Cómo funciona
        </h2>
        <ol class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-10">
          {
            PASOS.map((paso, i) => (
              <li class="relative pl-14">
                <span
                  class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full bg-accent font-display text-lg font-semibold text-accent-ink"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <h3 class="font-sans text-base font-semibold text-ink">
                  {paso.titulo}
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-ink-muted">
                  {paso.texto}
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      {
        /* Modulos: cuatro preguntas paralelas. Filetes en vez de cuatro
          tarjetas identicas: no son pulsables, asi que no llevan la
          superficie elevada. */
      }
      <section
        class="aparece mt-16 rounded-2xl bg-header p-8 sm:mt-20 sm:p-10 lg:p-12"
        aria-labelledby="modulos-titulo"
      >
        <h2 id="modulos-titulo" class="titular-seccion max-w-2xl text-white">
          Cuatro preguntas para cada departamento, cada semana
        </h2>
        <p
          class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-white/75"
        >
          En vez de una sola predicción, el sistema responde cuatro preguntas
          concretas que cualquiera puede comprobar contra la historia del lugar.
        </p>
        <div
          class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            MODULOS.map((m, i) => (
              <div
                class:list={[
                  'border-t border-white/25 pt-4',
                  i > 0 && 'lg:border-l lg:border-l-white/15 lg:pl-8',
                ]}
              >
                <p class="font-mono text-xs font-semibold text-secondary">
                  {m.id}
                </p>
                <h3 class="mt-2 font-sans text-base font-semibold text-white">
                  {m.pregunta}
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-white/75">
                  {m.texto}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      {
        /* Para quien evalua o quiere replicar: aqui si cabe el vocabulario
          tecnico, con una hoja de especificaciones en vez de tarjetas. */
      }
      <section class="aparece mt-16 sm:mt-20" aria-labelledby="abierto-titulo">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
          <div>
            <h2 id="abierto-titulo" class="titular-seccion text-ink">
              Para revisar o replicar el sistema
            </h2>
            <p class="mt-4 font-sans text-base leading-relaxed text-ink-muted">
              El código, los datos y el método están publicados. Cualquier
              persona puede revisarlos, levantar el sistema completo en su
              propia computadora con un solo paso, o consultar la misma interfaz
              de datos que alimenta este sitio.
            </p>
            <p class="mt-4 font-sans text-base leading-relaxed text-ink-muted">
              Cada capa se contrastó con los años de brote documentados del país
              antes de entrar al sistema. El método se explica en la Biblioteca
              y las decisiones de diseño están registradas en el repositorio.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a
                href="https://github.com/the-monolith-project/EPI-Aetheris"
                class="boton-principal inline-flex min-h-[44px] items-center rounded-full bg-accent px-6 font-sans text-sm font-semibold text-accent-ink"
              >
                Ver el código
              </a>
              <a
                href="/biblioteca"
                class="boton-secundario inline-flex min-h-[44px] items-center rounded-full border border-accent/40 px-6 font-sans text-sm font-medium text-accent"
              >
                Leer la Biblioteca
              </a>
            </div>
          </div>
          <dl class="border-t border-border">
            {
              STACK.map((s) => (
                <div class="grid grid-cols-1 gap-1 border-b border-border py-5 sm:grid-cols-[7rem_13rem_1fr] sm:items-baseline sm:gap-6">
                  <dt class="font-sans text-sm font-semibold text-ink">
                    {s.capa}
                  </dt>
                  <dd class="flex items-center gap-2.5 font-mono text-sm text-accent">
                    <span class="flex items-center gap-1.5" aria-hidden="true">
                      {s.logos.map((logo) => (
                        <Icono
                          nombre={logo}
                          coleccion="simple-icons"
                          class="h-4 w-4"
                        />
                      ))}
                    </span>
                    {s.tecnologia}
                  </dd>
                  <dd class="font-sans text-sm leading-relaxed text-ink-muted">
                    {s.texto}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      {/* Cierre: prensa e investigacion en una linea, y la vuelta al mapa. */}
      <section
        class="aparece mt-16 flex flex-col items-start gap-6 rounded-2xl bg-deep p-8 sm:mt-20 sm:flex-row sm:items-center sm:justify-between lg:p-12"
        aria-labelledby="cierre-titulo"
      >
        <div class="max-w-2xl">
          <h2 id="cierre-titulo" class="titular-seccion text-secondary">
            Datos públicos y citables
          </h2>
          <p class="mt-3 font-sans text-sm leading-relaxed text-deep-ink-muted">
            Para prensa, docencia e investigación: las series se pueden
            descargar, la interfaz de datos es pública y el método está
            documentado paso a paso en la <a
              href="/biblioteca"
              class="font-semibold text-deep-ink"
              ><span class="enlace-filete">Biblioteca</span></a
            >.
          </p>
        </div>
        <a
          href="/dengue"
          class="boton-principal inline-flex min-h-[48px] shrink-0 items-center rounded-full bg-secondary px-7 font-sans text-sm font-semibold text-secondary-ink"
        >
          Ver el mapa
        </a>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    ETIQUETAS_NIVEL,
    ETIQUETAS_TIPO,
    type PayloadAlertas,
  } from '../lib/vista-alertas';
  import { alertaAplicaA, esAlertaNacional } from '../lib/alcance-alertas';
  import { DEPARTAMENTOS_POR_CODIGO } from '../lib/departamentos';
  import { leerDepartamentoRecordado } from '../lib/departamento-recordado';
  import { iniciarMovimiento } from '../lib/movimiento';

  iniciarMovimiento();

  const tuDepartamento = document.querySelector<HTMLElement>(
    '[data-tu-departamento]',
  );
  const departamentoRecordado = leerDepartamentoRecordado();
  if (tuDepartamento && departamentoRecordado) {
    const enlace = tuDepartamento.querySelector<HTMLAnchorElement>(
      '[data-tu-departamento-enlace]',
    );
    const texto = tuDepartamento.querySelector<HTMLElement>(
      '[data-tu-departamento-texto]',
    );
    if (enlace && texto) {
      enlace.href = `/departamento/${departamentoRecordado}`;
      texto.textContent = `Ver ${DEPARTAMENTOS_POR_CODIGO[departamentoRecordado].nombre}: alertas, dengue y respiratorio`;
      tuDepartamento.hidden = false;
    }
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const seccion = document.querySelector<HTMLElement>('[data-tira-alertas]');
  const lista = document.querySelector<HTMLElement>(
    '[data-tira-alertas-lista]',
  );

  if (seccion && lista) {
    fetch(`${API_BASE}/api/alertas`)
      .then(async (respuesta) => {
        if (!respuesta.ok) throw new Error(String(respuesta.status));
        const datos = (await respuesta.json()) as PayloadAlertas;
        if (!Array.isArray(datos.alertas) || datos.alertas.length === 0) return;

        // Con un departamento recordado se muestran las que le aplican, las
        // propias primero; sin él, la lista completa (ADR 0022).
        const recordado = leerDepartamentoRecordado();
        const ordenadas = recordado
          ? datos.alertas
              .filter((a) => alertaAplicaA(a, recordado))
              .sort(
                (a, b) =>
                  Number(esAlertaNacional(a)) - Number(esAlertaNacional(b)),
              )
          : datos.alertas;
        if (ordenadas.length === 0) return;

        for (const alerta of ordenadas.slice(0, 3)) {
          const item = document.createElement('li');
          item.className =
            'flex flex-wrap items-baseline gap-x-2.5 font-sans text-sm leading-relaxed';
          const etiqueta = document.createElement('span');
          etiqueta.className =
            'font-mono text-xs font-semibold uppercase tracking-wide text-accent';
          const etiquetaNivel =
            alerta.nivel in ETIQUETAS_NIVEL
              ? ETIQUETAS_NIVEL[alerta.nivel as keyof typeof ETIQUETAS_NIVEL]
              : alerta.nivel;
          etiqueta.textContent = `${ETIQUETAS_TIPO[alerta.tipo] ?? alerta.tipo} · ${etiquetaNivel}`;
          const enlace = document.createElement('a');
          enlace.href = `/alertas?tipo=${encodeURIComponent(alerta.tipo)}#alerta-${alerta.id}`;
          enlace.className = 'enlace-filete text-ink';
          // textContent, no innerHTML: el titulo lo redacta una persona y
          // llega como texto plano desde la API.
          enlace.textContent = alerta.titulo;
          item.append(etiqueta, enlace);
          lista.appendChild(item);
        }
        seccion.hidden = false;
      })
      .catch(() => {
        // Backend caido o dormido: la portada se queda sin la tira y ya.
      });
  }
</script>
