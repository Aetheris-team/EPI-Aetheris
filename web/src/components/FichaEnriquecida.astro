---
/**
 * Plantilla de las fichas enriquecidas de la Biblioteca: una explicación
 * visual de un concepto del sistema que complementa al documento con
 * acordeones (que sigue siendo la versión de referencia). Cabecera con título,
 * subtítulo y etiquetas; debajo, la descripción y un hilo vertical que va de
 * la fuente de los datos a cómo se aplican en el sistema. Cada paso es un
 * <PasoFicha>.
 *
 * El hilo se llena con el scroll y los pasos aparecen al llegar a ellos, solo
 * si las animaciones están activas (interruptor del pie y prefers-reduced-
 * motion). Sin script o con animaciones apagadas la ficha se lee completa.
 */
import Layout from '../layouts/Layout.astro';

interface Props {
  titulo: string;
  subtitulo: string;
  etiquetas: string[];
  descripcion: string;
  /** Documento con acordeones al que esta ficha complementa. */
  documentacion: { href: string; etiqueta: string };
  /** Fichas vecinas en el orden del registro, para pasar de una a otra. */
  anterior?: { href: string; titulo: string };
  siguiente?: { href: string; titulo: string };
  /** 'centrada' (por omisión, max-w-5xl) o 'dividida' (ancho extendido, dos columnas). */
  disposicion?: 'centrada' | 'dividida';
}

const {
  titulo,
  subtitulo,
  etiquetas,
  descripcion,
  documentacion,
  anterior,
  siguiente,
  disposicion = 'centrada',
} = Astro.props;
---

<Layout title={`EPI-Aetheris — ${titulo}`} descripcion={descripcion}>
  <main
    id="contenido-principal"
    class={disposicion === 'dividida'
      ? 'mx-auto max-w-[1680px] px-4 py-8 sm:px-6 lg:px-8'
      : 'mx-auto max-w-5xl px-4 py-8 sm:px-8 sm:py-10'}
  >
    <a
      href="/biblioteca"
      class="mb-5 inline-flex min-h-[44px] items-center gap-2 font-sans text-sm font-semibold text-accent underline-offset-4 hover:underline"
    >
      <span aria-hidden="true">←</span> Volver a la biblioteca
    </a>

    {
      disposicion === 'dividida' ? (
        <div class="ficha-dividida-layout" data-ficha-dividida>
          <slot />
          {(anterior || siguiente) && (
            <nav
              class="ficha-vecinas mt-12 pt-6 border-t border-border"
              aria-label="Otras fichas"
            >
              {anterior && (
                <a href={anterior.href} rel="prev">
                  <span aria-hidden="true">←</span> {anterior.titulo}
                </a>
              )}
              {siguiente && (
                <a href={siguiente.href} rel="next" class="ficha-siguiente">
                  {siguiente.titulo} <span aria-hidden="true">→</span>
                </a>
              )}
            </nav>
          )}
        </div>
      ) : (
        <article class="ficha" data-ficha>
          <header class="ficha-cabecera">
            <div class="ficha-cabecera-texto">
              <h1 class="ficha-titulo">{titulo}</h1>
              <p class="ficha-subtitulo">{subtitulo}</p>
            </div>
            <ul class="ficha-etiquetas" aria-label="Etiquetas">
              {etiquetas.map((etiqueta) => (
                <li>{etiqueta}</li>
              ))}
            </ul>
          </header>

          <div class="ficha-cuerpo">
            <p class="ficha-descripcion">{descripcion}</p>

            <div class="ficha-hilo" data-ficha-hilo>
              <div class="ficha-hilo-linea" aria-hidden="true">
                <div class="ficha-hilo-relleno" />
              </div>
              <slot />
            </div>

            <aside class="ficha-pie" aria-label="Documentación relacionada">
              <p>
                Esta ficha explica el cálculo con ejemplos. La descripción
                formal, con todas las constantes y los límites, está en el
                documento del módulo.
              </p>
              <a href={documentacion.href}>{documentacion.etiqueta}</a>
            </aside>

            {(anterior || siguiente) && (
              <nav class="ficha-vecinas" aria-label="Otras fichas">
                {anterior && (
                  <a href={anterior.href} rel="prev">
                    <span aria-hidden="true">←</span> {anterior.titulo}
                  </a>
                )}
                {siguiente && (
                  <a href={siguiente.href} rel="next" class="ficha-siguiente">
                    {siguiente.titulo} <span aria-hidden="true">→</span>
                  </a>
                )}
              </nav>
            )}
          </div>
        </article>
      )
    }
  </main>
</Layout>

<script>
  import { animacionesActivas } from '../lib/animaciones';

  const ficha = document.querySelector<HTMLElement>('[data-ficha]');
  const hilo = ficha?.querySelector<HTMLElement>('[data-ficha-hilo]');

  if (ficha && hilo) {
    const pasos = Array.from(hilo.querySelectorAll<HTMLElement>('[data-paso]'));
    const anima = 'IntersectionObserver' in window && animacionesActivas();

    // Sin animaciones el hilo queda completo y todos los pasos visibles.
    hilo.style.setProperty('--progreso', '1');

    if (anima) {
      ficha.setAttribute('data-anima', '');

      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) {
              entrada.target.classList.add('visto');
              observador.unobserve(entrada.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
      );
      pasos.forEach((paso) => observador.observe(paso));

      let pendiente = false;
      const actualizar = () => {
        pendiente = false;
        const caja = hilo.getBoundingClientRect();
        const referencia = window.innerHeight * 0.55;
        const avance = (referencia - caja.top) / caja.height;
        hilo.style.setProperty(
          '--progreso',
          String(Math.min(1, Math.max(0, avance))),
        );
        for (const paso of pasos) {
          const nodo = paso.getBoundingClientRect();
          paso.classList.toggle('alcanzado', nodo.top < referencia);
        }
      };
      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(actualizar);
      };
      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', alScroll);
      actualizar();
    }
  }
</script>

<style is:global>
  .ficha {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    overflow: clip;
  }
  .ficha-cabecera {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.75rem 1.5rem;
    color: var(--color-deep-ink);
    background-color: var(--color-deep);
    /* Trama de líneas finas: separa la cabecera del cuerpo sin imagen. */
    background-image: repeating-linear-gradient(
      135deg,
      rgb(221 219 255 / 0.07) 0 2px,
      transparent 2px 7px
    );
  }
  .ficha-cabecera-texto {
    flex: 1 1 22rem;
    min-width: 0;
  }
  .ficha-titulo {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .ficha-subtitulo {
    margin-top: 0.5rem;
    max-width: 38rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-deep-ink-muted);
  }
  .ficha-etiquetas {
    display: flex;
    flex: 0 1 18rem;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: flex-start;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ficha-etiquetas li {
    padding: 0.2rem 0.65rem;
    border: 1px solid rgb(221 219 255 / 0.45);
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-deep-ink);
  }
  .ficha-cuerpo {
    padding: 1.75rem 1.5rem 2rem;
  }
  .ficha-descripcion {
    max-width: 44rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  /* Hilo vertical: de la fuente a la aplicación. */
  .ficha-hilo {
    --progreso: 1;
    position: relative;
    margin-top: 2rem;
  }
  .ficha-hilo-linea {
    position: absolute;
    top: 1.2rem;
    bottom: 0;
    left: 1.1rem;
    width: 2px;
    background: var(--color-border);
  }
  .ficha-hilo-relleno {
    width: 100%;
    height: 100%;
    background: var(--color-termino);
    transform-origin: top;
    transform: scaleY(var(--progreso, 1));
    transition: transform 0.12s linear;
  }

  .paso {
    position: relative;
    padding: 0 0 2.75rem 3.25rem;
  }
  .paso:last-child {
    padding-bottom: 1rem;
  }
  .paso-nodo {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    transition:
      background-color 0.3s,
      border-color 0.3s,
      color 0.3s;
  }
  .paso.alcanzado .paso-nodo,
  .ficha:not([data-anima]) .paso-nodo {
    border-color: var(--color-termino);
    background: var(--color-termino);
    color: var(--color-surface);
  }
  .paso-titulo {
    padding-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .paso-texto {
    margin-top: 0.6rem;
    max-width: 44rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  .paso-texto a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .paso-texto p + p {
    margin-top: 0.75rem;
  }
  .paso-visual {
    margin-top: 1.25rem;
  }
  .ficha[data-anima] .paso {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .ficha[data-anima] .paso.visto {
    opacity: 1;
    transform: none;
  }
  .ficha-pie {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .ficha-pie a {
    display: inline-block;
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ficha-vecinas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .ficha-vecinas a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ficha-vecinas .ficha-siguiente {
    margin-left: auto;
  }

  /* Piezas comunes de los pasos: tarjetas, notas, fórmulas, cuentas y
     el bloque del color. */
  .ficha-rejilla {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .ficha-tarjeta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    font-family: var(--font-sans);
  }
  .ficha-tarjeta strong {
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .ficha-tarjeta span {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }
  .ficha-nota {
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }
  .ficha-resumen,
  .ficha-resultado {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .ficha-formula {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    overflow-wrap: anywhere;
  }
  .ficha-formula-grande {
    font-size: clamp(0.95rem, 2.4vw, 1.25rem);
    color: var(--color-ink);
  }
  .ficha-cuenta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    align-items: center;
    margin-top: 1rem;
    font-family: var(--font-mono);
  }
  .ficha-cuenta span {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ficha-cuenta b {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .ficha-cuenta small {
    font-size: 0.7rem;
    color: var(--color-ink-muted);
  }
  .ficha-cuenta-iv,
  .ficha-cuenta-resultado {
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--color-termino);
    border-radius: 0.75rem;
  }
  .ficha-color {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
  }
  .ficha-color-mapa {
    flex: 0 1 18rem;
    min-width: 12rem;
  }
  .ficha-muestra {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    margin-right: 0.4rem;
    vertical-align: -0.2em;
    border: 1px solid var(--color-ink-muted);
    border-radius: 0.25rem;
  }

  /* Curvas (src/lib/curvas-iv.ts). */
  .cv-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .cv-guia {
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .cv-texto {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .cv-eje-x {
    font-size: 9.5px;
  }
  .cv-relleno {
    fill: var(--color-termino);
    opacity: 0.12;
  }
  .cv-curva {
    fill: none;
    stroke: var(--color-termino);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .cv-marca-eje {
    stroke: var(--color-ink-muted);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.6;
  }
  .cv-posicion {
    stroke: var(--color-ink);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
  }
  .cv-punto {
    fill: var(--color-surface);
    stroke: var(--color-ink);
    stroke-width: 2.5;
  }

  .ficha-grafico {
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
  }
  .ficha-cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    font-family: var(--font-sans);
  }
  .ficha-cifras div {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
  }
  .ficha-cifras dt {
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
  .ficha-cifras dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .ficha-escala-sigma {
    position: relative;
    max-width: 26rem;
    height: 10px;
    margin: 1.4rem 0 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
  }
  .ficha-escala-marca {
    position: absolute;
    top: -5px;
    width: 4px;
    height: 18px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-ink);
  }
  .ficha-escala-etiquetas {
    position: absolute;
    top: 14px;
    right: 0;
    left: 0;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
  }

  /* Tira de años (src/lib/tira-anios.ts) y gráficos de M3 y M4. */
  .tira-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .tira-guia {
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .tira-texto {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .tira-texto-descrito {
    fill: var(--color-ink);
    font-weight: 700;
  }
  .tira-barra {
    fill: var(--color-termino);
    opacity: 0.55;
  }
  .tira-barra-descrita {
    fill: var(--color-ink);
    opacity: 1;
  }
  .tira-hueco {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }
  .tira-atenuado {
    opacity: 0.35;
  }
  .tira-banda {
    fill: var(--color-termino);
    opacity: 0.12;
  }
  .tira-separador {
    stroke: var(--color-ink-muted);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .tira-linea {
    stroke-width: 1.5;
  }
  .tira-linea-mediana {
    stroke: var(--color-ink);
    stroke-width: 2;
  }
  .tira-linea-corte {
    stroke: var(--color-ink);
    stroke-dasharray: 5 3;
  }
  .tira-linea-cuantil {
    stroke: var(--color-ink-muted);
    stroke-dasharray: 2 3;
  }
  .tira-texto-linea {
    fill: var(--color-ink);
  }

  .recta-eje {
    stroke: var(--color-ink-muted);
    stroke-width: 1.2;
  }
  .recta-punto {
    fill: var(--color-termino);
    opacity: 0.75;
  }
  .recta-corte {
    stroke: var(--color-ink);
    stroke-width: 1.2;
    stroke-dasharray: 5 3;
  }
  .recta-observado {
    stroke: var(--color-ink);
    stroke-width: 2.5;
  }
  .recta-texto {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .recta-texto-observado {
    fill: var(--color-ink);
    font-weight: 700;
  }
  .canal-fondo {
    fill: var(--color-surface);
    stroke: var(--color-border);
  }
  .canal-linea {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .canal-punto {
    fill: var(--color-ink);
  }
  .ficha-nota-separada {
    margin-top: 1.25rem;
  }
  .ficha-color-texto {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .ficha-leyenda-fila {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  .ficha-anio {
    display: grid;
    grid-template-columns: repeat(26, minmax(0, 1fr));
    gap: 3px;
    max-width: 34rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ficha-anio-semana,
  .ficha-anio-muestra {
    display: block;
    height: 1.1rem;
    border-radius: 2px;
  }
  .ficha-anio-muestra {
    width: 0.85rem;
    height: 0.85rem;
  }
  .ficha-anio .completa,
  .ficha-anio-muestra.completa {
    background: var(--color-termino);
  }
  .ficha-anio .parcial,
  .ficha-anio-muestra.parcial {
    background: color-mix(
      in srgb,
      var(--color-termino) 40%,
      var(--color-surface)
    );
  }
  .ficha-anio .hueco,
  .ficha-anio-muestra.hueco {
    border: 1px dashed var(--color-ink-muted);
    background: transparent;
  }
  .ficha-tabla {
    width: 100%;
    max-width: 36rem;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink);
  }
  .ficha-tabla th,
  .ficha-tabla td {
    padding: 0.4rem 0.6rem 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }
  .ficha-tabla td {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
