---
import PanelWorkspace from './analisis/PanelWorkspace.astro';
// Vigilancia laboratorial nacional. No hay mapa: la fuente no desagrega
// por departamento. Una métrica por escala (no se mezclan conteos y %).
---

<PanelWorkspace
  tipo="registro"
  titulo="Vigilancia centinela de virus (nacional)"
  descripcion="Muestras, detecciones y positividad publicadas por MINSAL a nivel nacional. Que un virus coincida en el tiempo con un alza de IRA no prueba que la haya causado. SARS-CoV-2 aparece como covid_19 solo en 2023."
  data-panel-virus
>
  <div class="mt-4 flex flex-wrap gap-3 font-sans text-sm">
    <label class="flex flex-wrap items-center gap-2"
      >Métrica
      <select
        data-virus-metrica
        class="rounded-lg border border-border bg-bg px-3 py-1.5"
      >
        <option value="detecciones">detecciones (conteo)</option>
        <option value="positividad">positividad (%)</option>
        <option value="muestras_analizadas">muestras analizadas (conteo)</option
        >
        <option value="muestras_positivas">muestras positivas (conteo)</option>
      </select>
    </label>
    <label class="flex flex-wrap items-center gap-2"
      >Año
      <select
        data-virus-anio
        class="rounded-lg border border-border bg-bg px-3 py-1.5"></select>
    </label>
  </div>
  <p data-virus-global class="mt-3 hidden font-sans text-sm text-ink">
    Todos los virus / vigilancia total
  </p>
  <fieldset
    class="mt-3 flex flex-wrap gap-3 font-sans text-sm"
    data-virus-toggles
  >
    <legend class="sr-only">Virus visibles</legend>
  </fieldset>

  <p
    data-virus-aviso
    class="mt-3 font-sans text-xs leading-relaxed text-ink-muted"
  >
  </p>
  <div
    data-virus-error
    role="status"
    class="mt-3 hidden rounded-lg border border-secondary bg-secondary/25 p-3 font-sans text-sm"
  >
    <p class="text-ink">
      No se pudo contactar la fuente de datos. No se muestra ningún dato hasta
      que la fuente vuelva a responder.
    </p>
    <button
      type="button"
      data-virus-reintentar
      class="mt-2 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      Reintentar
    </button>
  </div>
  <div
    data-virus-heatmap
    role="status"
    aria-busy="true"
    class="mt-4 min-h-[220px] overflow-x-auto scroll-shadow-x"
  >
    <div
      class="flex h-full min-h-[220px] w-full min-w-[760px] flex-col justify-between gap-2.5 p-2"
      aria-hidden="true"
    >
      <div class="skeleton h-7 w-full rounded"></div>
      <div class="skeleton h-7 w-full rounded"></div>
      <div class="skeleton h-7 w-full rounded"></div>
      <div class="skeleton h-7 w-full rounded"></div>
      <div class="skeleton h-7 w-full rounded"></div>
    </div>
  </div>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderEsqueletoMatriz,
    renderSinDato,
  } from './estado-async';

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const VIRUS_DEFAULT = [
    'influenza',
    'vsr',
    'covid_19',
    'adenovirus',
    'parainfluenza',
  ];
  // Subtipos de influenza: siguen en la base (ADR 0012), no en este panel.
  const VIRUS_OCULTOS_EN_PANEL = new Set([
    'influenza_a_h1n1',
    'influenza_a_h3n2',
    'influenza_a_no_subtipificado',
    'influenza_b',
  ]);

  interface CatalogoItem {
    virus: string;
    metrica: string;
    unidad: string;
  }

  async function jsonOk(url: string) {
    const resp = await fetch(url);
    if (!resp.ok) throw new Error('no ok');
    return resp.json();
  }

  function color(valor: number, max: number, metrica: string): string {
    if (max <= 0) return '#e4e4e7';
    const t = Math.min(1, valor / max);
    if (metrica === 'positividad') {
      const r = Math.round(220 * t);
      return `rgb(${r}, ${80}, ${80 + Math.round(80 * (1 - t))})`;
    }
    const b = Math.round(40 + 180 * (1 - t));
    return `rgb(${40}, ${80 + Math.round(80 * t)}, ${b})`;
  }

  // Referencia al reintento vigente: antes de tener catálogo reintenta toda
  // la inicialización; una vez cargado, reintenta solo el último fetch.
  let reintentarVirus: () => void = () => void iniciar();

  async function iniciar() {
    const root = document.querySelector<HTMLElement>('[data-panel-virus]');
    if (!root) return;
    const botonReintentar = root.querySelector<HTMLButtonElement>(
      '[data-virus-reintentar]',
    );
    if (botonReintentar && !botonReintentar.dataset.enlazado) {
      botonReintentar.dataset.enlazado = 'si';
      botonReintentar.addEventListener('click', () => reintentarVirus());
    }
    const selMetrica = root.querySelector<HTMLSelectElement>(
      '[data-virus-metrica]',
    )!;
    const selAnio = root.querySelector<HTMLSelectElement>('[data-virus-anio]')!;
    const toggles = root.querySelector<HTMLFieldSetElement>(
      '[data-virus-toggles]',
    )!;
    const aviso = root.querySelector<HTMLElement>('[data-virus-aviso]')!;
    const error = root.querySelector<HTMLElement>('[data-virus-error]')!;
    const heatmap = root.querySelector<HTMLElement>('[data-virus-heatmap]')!;

    let catalogo: CatalogoItem[] = [];
    try {
      heatmap.setAttribute('aria-busy', 'true');
      renderEsqueletoMatriz(heatmap, 5);
      const datos = await jsonOk(`${API_BASE}/api/respiratorios/virus`);
      if (esNoDisponible(datos)) {
        error.classList.add('hidden');
        aviso.textContent = '';
        renderSinDato(heatmap, motivoNoDisponible(datos));
        return;
      }
      catalogo = datos.series;
      aviso.textContent = datos.aviso;
    } catch {
      error.classList.remove('hidden');
      heatmap.textContent = '';
      heatmap.removeAttribute('aria-busy');
      return;
    }

    const notaGlobal = root.querySelector<HTMLElement>('[data-virus-global]')!;
    const METRICAS_GLOBALES = new Set([
      'muestras_analizadas',
      'muestras_positivas',
    ]);

    function virusParaMetrica(metrica: string): string[] {
      return [
        ...new Set(
          catalogo.filter((s) => s.metrica === metrica).map((s) => s.virus),
        ),
      ].sort();
    }

    function pintarToggles(metrica: string) {
      const prev = new Set(
        [...toggles.querySelectorAll<HTMLInputElement>('input:checked')].map(
          (c) => c.value,
        ),
      );
      toggles.replaceChildren();
      const disponibles = virusParaMetrica(metrica).filter(
        (v) => v !== 'todos' && !VIRUS_OCULTOS_EN_PANEL.has(v),
      );
      for (const v of disponibles) {
        const lab = document.createElement('label');
        lab.className = 'flex items-center gap-1';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.value = v;
        cb.checked =
          prev.has(v) || (prev.size === 0 && VIRUS_DEFAULT.includes(v));
        lab.append(cb, document.createTextNode(v));
        toggles.appendChild(lab);
      }
    }

    function aplicarModoMetrica(metrica: string) {
      const global = METRICAS_GLOBALES.has(metrica);
      notaGlobal.classList.toggle('hidden', !global);
      toggles.classList.toggle('hidden', global);
      toggles.disabled = global;
      if (!global) pintarToggles(metrica);
    }

    async function refrescar() {
      const metrica = selMetrica.value;
      aplicarModoMetrica(metrica);
      const virusConsulta = METRICAS_GLOBALES.has(metrica)
        ? ['todos']
        : [...toggles.querySelectorAll<HTMLInputElement>('input:checked')].map(
            (c) => c.value,
          );
      heatmap.setAttribute('aria-busy', 'true');
      renderEsqueletoMatriz(heatmap, Math.max(3, virusConsulta.length));
      const seriesPorVirus: Record<
        string,
        Record<string, [number, number][]>
      > = {};
      const anios = new Set<number>();
      try {
        const vistos = new Set<string>();
        for (const virus of virusConsulta) {
          if (vistos.has(virus)) continue;
          vistos.add(virus);
          const datos = await jsonOk(
            `${API_BASE}/api/respiratorios/temporal?virus=${encodeURIComponent(virus)}&metrica=${encodeURIComponent(metrica)}`,
          );
          if (esNoDisponible(datos)) {
            error.classList.add('hidden');
            renderSinDato(heatmap, motivoNoDisponible(datos));
            return;
          }
          const etiqueta =
            virus === 'todos' ? 'Todos los virus / vigilancia total' : virus;
          seriesPorVirus[etiqueta] = datos.series;
          for (const a of datos.anios) anios.add(a);
        }
      } catch {
        error.classList.remove('hidden');
        heatmap.textContent = '';
        heatmap.removeAttribute('aria-busy');
        return;
      }
      error.classList.add('hidden');
      const listaAnios = [...anios].sort();
      if (selAnio.options.length === 0) {
        for (const a of listaAnios) {
          const op = document.createElement('option');
          op.value = String(a);
          op.textContent = String(a);
          if (a === 2023) op.selected = true;
          selAnio.appendChild(op);
        }
      }
      const anio =
        selAnio.value || String(listaAnios[listaAnios.length - 1] ?? 2023);
      const filas = Object.keys(seriesPorVirus);
      const semanas = Array.from({ length: 52 }, (_, i) => i + 1);
      let max = 0;
      const grid: Record<string, Record<number, number | null>> = {};
      for (const v of filas) {
        grid[v] = {};
        const pts = seriesPorVirus[v][anio] ?? [];
        const mapa = new Map(pts);
        for (const s of semanas) {
          const val = mapa.has(s) ? mapa.get(s)! : null;
          grid[v][s] = val;
          if (val != null && val > max) max = val;
        }
      }

      const table = document.createElement('table');
      table.className = 'font-sans tabular-nums text-[11px] border-collapse';
      table.setAttribute(
        'aria-label',
        `Mapa de calor de ${metrica} por virus y semana epidemiológica, año ${anio}`,
      );
      const caption = document.createElement('caption');
      caption.className = 'sr-only';
      caption.textContent = `Casos de ${metrica} por virus y semana epidemiológica del año ${anio}`;
      table.appendChild(caption);
      const thead = document.createElement('thead');
      const trh = document.createElement('tr');
      const thCorner = document.createElement('th');
      thCorner.scope = 'col';
      thCorner.textContent = 'Virus';
      thCorner.className = 'sr-only';
      trh.appendChild(thCorner);
      for (const s of semanas) {
        const th = document.createElement('th');
        th.textContent = String(s);
        th.scope = 'col';
        th.className = 'px-0.5 text-ink-muted font-sans';
        trh.appendChild(th);
      }
      thead.appendChild(trh);
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      for (const v of filas) {
        const tr = document.createElement('tr');
        const name = document.createElement('th');
        name.scope = 'row';
        name.textContent = v;
        name.className =
          'pr-2 text-left font-sans text-xs font-medium text-ink sticky left-0 bg-surface';
        tr.appendChild(name);
        for (const s of semanas) {
          const td = document.createElement('td');
          const val = grid[v][s];
          const etiqueta =
            val == null
              ? `${v} SE${s} ${anio}: sin dato`
              : `${v} SE${s} ${anio}: ${val} casos`;
          td.title = etiqueta;
          td.setAttribute('aria-label', etiqueta);
          td.style.background =
            val == null ? '#f4f4f5' : color(val, max, metrica);
          td.style.width = '14px';
          td.style.height = '18px';
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      heatmap.replaceChildren(table);
      const nota = document.createElement('p');
      nota.className = 'mt-2 font-sans text-xs text-ink-muted';
      nota.textContent = `Mapa de calor de ${metrica} · año ${anio} · celdas claras = hueco real. Una sola métrica por escala. Fuente: MINSAL.`;
      heatmap.appendChild(nota);
      heatmap.removeAttribute('aria-busy');
    }

    reintentarVirus = () => {
      error.classList.add('hidden');
      void refrescar();
    };
    selMetrica.addEventListener('change', () => void refrescar());
    selAnio.addEventListener('change', () => void refrescar());
    toggles.addEventListener('change', () => void refrescar());
    void refrescar();
  }

  void iniciar();
</script>
