---
import LeyendaRampa from './analisis/LeyendaRampa.astro';
import PanelWorkspace from './analisis/PanelWorkspace.astro';
import SelectorSemanaEpi from './SelectorSemanaEpi.astro';
import { RAMPA_CASOS } from '../lib/colores';
import { ANIOS_RESPIRATORIO } from '../lib/respiratorio-state';
// Heatmap departamento × semana de Neumonías. Una métrica: conteo notificado.
// Celda sin dato = hueco, nunca cero.
---

<PanelWorkspace
  tipo="matriz"
  titulo="Mapa de calor de neumonías por departamento y semana"
  descripcion="Unidad: conteo notificado (desacumulado). Celdas claras = hueco de la fuente MINSAL, no un cero."
  data-heatmap-neu
  controlesAnchos
>
  <div
    slot="controles"
    class="flex flex-wrap items-center gap-2 font-sans text-sm"
  >
    <label class="flex flex-wrap items-center gap-2"
      >Año
      <select
        data-hm-anio
        class="rounded-lg border border-border bg-bg px-3 py-1.5"
      >
        {ANIOS_RESPIRATORIO.map((a) => <option value={String(a)}>{a}</option>)}
      </select>
    </label>
    <span class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-medium text-ink-muted">Desde:</span>
      <SelectorSemanaEpi
        id="hm-neu-selector-desde"
        semana={1}
        compacto={true}
        mostrarRangoFechas={false}
        etiqueta="Semana epidemiológica inicial neumonías"
        class="hm-selector-desde"
      />
      <input
        id="hm-neu-desde"
        data-hm-desde
        type="range"
        min="1"
        max="52"
        value="1"
        aria-label="Semana epidemiológica inicial"
        aria-valuetext="Semana 1"
        class="w-20 sm:w-28 accent-accent"
      />
      <span class="text-xs font-medium text-ink-muted">Hasta:</span>
      <SelectorSemanaEpi
        id="hm-neu-selector-hasta"
        semana={52}
        compacto={true}
        mostrarRangoFechas={false}
        etiqueta="Semana epidemiológica final neumonías"
        class="hm-selector-hasta"
      />
      <input
        id="hm-neu-hasta"
        data-hm-hasta
        type="range"
        min="1"
        max="52"
        value="52"
        aria-label="Semana epidemiológica final"
        aria-valuetext="Semana 52"
        class="w-20 sm:w-28 accent-accent"
      />
      <span data-hm-rango class="font-sans tabular-nums text-xs">SE1–SE52</span>
    </span>
    <button
      type="button"
      data-hm-export
      aria-label="Exportar datos del mapa de calor a CSV"
      class="rounded-lg border border-border bg-bg px-3 py-1.5 hover:border-accent hover:text-accent"
      >Exportar a CSV</button
    >
  </div>
  <div class="mt-4 overflow-x-auto scroll-shadow-x" tabindex="0">
    <div
      data-hm-grid
      class="min-h-[420px] min-w-[760px]"
      role="region"
      aria-label="Mapa de calor de neumonías notificadas por departamento y semana"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[420px] w-full min-w-[760px] flex-col justify-between gap-2.5 p-2"
        aria-hidden="true"
      >
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
      </div>
    </div>
  </div>

  <LeyendaRampa
    rampa={RAMPA_CASOS}
    idRampa="hm-neu-leyenda-rampa"
    etiquetaMin="Menor conteo"
    etiquetaMax="Mayor conteo"
    descripcionLectores="El color de cada celda va de un tono claro para el conteo más bajo del rango seleccionado a un tono oscuro para el conteo más alto, en una escala continua; las celdas grises indican que falta el dato."
  />

  <details
    id="hm-neu-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="hm-neu-tabla-contenedor"></div>
  </details>

  <p
    id="hm-neu-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import {
    ANIOS_RESPIRATORIO,
    actualizarFiltrosRespiratorio,
    obtenerFiltrosRespiratorio,
    soloCambiaDepartamento,
    suscribirFiltrosRespiratorio,
    type FiltrosRespiratorio,
  } from '../lib/respiratorio-state';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoMatriz,
    renderSinDato,
  } from './estado-async';
  import { colorCasos, gradienteCss, RAMPA_CASOS } from '../lib/colores';
  import { moverSeleccionMatriz, montarMatriz } from '../lib/echarts-matriz';
  import type { ConfigMatriz } from '../lib/echarts-matriz';
  import type { GraficoMontado } from '../lib/echarts-montaje';
  import { TablaAlternativa } from '../lib/tabla-alternativa';

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

  interface DeptoHeat {
    nombre: string;
    codigo: string;
    semanas: Record<string, number | null>;
  }

  interface CeldaNeumonias {
    codigo: string;
    nombre: string;
    semana: number;
    valor: number | null;
  }

  const root = document.querySelector<HTMLElement>('[data-heatmap-neu]');
  const contenedor = root?.querySelector<HTMLElement>('[data-hm-grid]') ?? null;
  const resumen = document.getElementById('hm-neu-resumen');
  const leyenda = document.getElementById('hm-neu-leyenda-rampa');
  if (leyenda) leyenda.style.background = gradienteCss(RAMPA_CASOS);

  let ultimo: { anio: string; departamentos: DeptoHeat[] } | null = null;
  let revision = 0;
  let grafico: GraficoMontado | null = null;
  let filtrosPintados: FiltrosRespiratorio | null = null;
  /** Reaplica el departamento activo sobre la matriz vigente, con transición. */
  let moverSeleccion: ((filtros: FiltrosRespiratorio) => void) | null = null;
  let datosTabla: CeldaNeumonias[] = [];

  const detailsTabla = document.getElementById(
    'hm-neu-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById('hm-neu-tabla-contenedor');

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Neumonías notificadas por departamento y semana',
          columnas: [
            { clave: 'nombre', encabezado: 'Departamento' },
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'valor',
              encabezado: 'Conteo notificado',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? String(v) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  function rangoActivo(r: HTMLElement): { desde: number; hasta: number } {
    const inpDesde = r.querySelector<HTMLInputElement>('[data-hm-desde]')!;
    const inpHasta = r.querySelector<HTMLInputElement>('[data-hm-hasta]')!;
    let desde = Number(inpDesde.value);
    let hasta = Number(inpHasta.value);
    if (desde > hasta) [desde, hasta] = [hasta, desde];
    return { desde, hasta };
  }

  function textoCelda(celda: CeldaNeumonias, anio: string): string {
    return (
      `${celda.nombre} · ${anio} · SE${String(celda.semana).padStart(2, '0')}\n` +
      (celda.valor === null
        ? 'Sin dato notificado'
        : `${celda.valor} notificados`)
    );
  }

  async function pintar() {
    if (!root || !contenedor) return;
    const sel = root.querySelector<HTMLSelectElement>('[data-hm-anio]')!;
    const inpDesde = root.querySelector<HTMLInputElement>('[data-hm-desde]')!;
    const inpHasta = root.querySelector<HTMLInputElement>('[data-hm-hasta]')!;
    const txtRango = root.querySelector<HTMLElement>('[data-hm-rango]')!;
    const selectorDesde = root.querySelector<HTMLElement>('.hm-selector-desde');
    const selectorHasta = root.querySelector<HTMLElement>('.hm-selector-hasta');
    let desde = Number(inpDesde.value);
    let hasta = Number(inpHasta.value);
    if (desde > hasta) [desde, hasta] = [hasta, desde];
    txtRango.textContent = `SE${desde}–SE${hasta}`;
    inpDesde.setAttribute('aria-valuetext', `Semana ${inpDesde.value}`);
    inpHasta.setAttribute('aria-valuetext', `Semana ${inpHasta.value}`);
    const anio = sel.value;
    const anioNum = Number(anio);
    selectorDesde?.dispatchEvent(
      new CustomEvent('ajustar-semana', {
        detail: { anio: anioNum, semana: desde },
      }),
    );
    selectorHasta?.dispatchEvent(
      new CustomEvent('ajustar-semana', {
        detail: { anio: anioNum, semana: hasta },
      }),
    );

    const filtros = obtenerFiltrosRespiratorio();
    filtrosPintados = filtros;
    moverSeleccion = null;
    const idRevision = ++revision;
    grafico?.destruir();
    grafico = null;
    if (resumen) resumen.textContent = `Cargando ${anio}…`;
    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoMatriz(contenedor, 7);
    try {
      const resp = await fetch(`${API_BASE}/api/neumonias/heatmap/${anio}`);
      if (!resp.ok) throw new Error('no ok');
      const datos = await resp.json();
      if (idRevision !== revision) return;
      if (esNoDisponible(datos)) {
        ultimo = null;
        renderSinDato(contenedor, motivoNoDisponible(datos));
        return;
      }
      const departamentos: DeptoHeat[] = datos.departamentos;
      ultimo = { anio, departamentos };

      const celdas: CeldaNeumonias[] = departamentos.flatMap((d) => {
        const filas: CeldaNeumonias[] = [];
        for (let s = desde; s <= hasta; s++) {
          filas.push({
            codigo: d.codigo,
            nombre: d.nombre,
            semana: s,
            valor: d.semanas[String(s)] ?? null,
          });
        }
        return filas;
      });
      let maximo = 0;
      for (const c of celdas) {
        if (c.valor !== null && c.valor > maximo) maximo = c.valor;
      }

      datosTabla = celdas;
      tablaAlternativa?.marcarCaducada();

      const seleccionDe = (f: FiltrosRespiratorio) =>
        celdas.filter((c) => c.codigo === f.departamento);

      const configMatriz = (f: FiltrosRespiratorio): ConfigMatriz => {
        const seleccion = seleccionDe(f);
        return {
          semanas: Array.from(
            { length: hasta - desde + 1 },
            (_, i) => desde + i,
          ),
          filas: departamentos.map((d) => d.nombre),
          celdas: celdas.map((c) => ({
            semana: c.semana,
            fila: c.nombre,
            color: colorCasos(c.valor, maximo),
            activa: seleccion.includes(c),
          })),
          izquierda: 110,
          etiquetasX: 10,
          texto: (indice) => textoCelda(celdas[indice], anio),
        };
      };

      contenedor.style.height = '430px';
      const montado = await montarMatriz(
        contenedor,
        () => configMatriz(filtros),
        `Mapa de calor de neumonías notificadas por departamento y semana epidemiológica, año ${anio}`,
        (indice) =>
          actualizarFiltrosRespiratorio({
            departamento: celdas[indice].codigo,
          }),
      );
      if (idRevision !== revision) {
        montado.destruir();
        return;
      }
      grafico = montado;

      const pintarResumen = (f: FiltrosRespiratorio) => {
        if (!resumen) return;
        const activa = seleccionDe(f);
        const base = `Conteo notificado · ${anio} · SE${desde}–SE${hasta} · MINSAL. Claro = hueco. Escala única de conteo, no positividad.`;
        if (activa.length === 0) {
          resumen.textContent = base;
          return;
        }
        const observados = activa.filter((c) => c.valor !== null);
        const total = observados.reduce((acc, c) => acc + (c.valor ?? 0), 0);
        resumen.innerHTML = `<span><span class="cifra font-semibold text-accent">${activa[0].nombre}</span> seleccionado · <span class="cifra">${total}</span> notificados en SE${desde}–SE${hasta} de <span class="cifra">${anio}</span>.</span>`;
      };
      pintarResumen(filtros);
      moverSeleccion = (f) => {
        moverSeleccionMatriz(montado, configMatriz(f));
        pintarResumen(f);
      };
    } catch {
      if (idRevision !== revision) return;
      ultimo = null;
      renderErrorFuente(contenedor, () => void pintar());
      if (resumen)
        resumen.textContent =
          'No se pudo cargar el mapa de calor de neumonías.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  function exportar() {
    if (!ultimo || !root) return;
    const { desde, hasta } = rangoActivo(root);
    const lineas = ['anio,departamento,codigo,semana,valor'];
    for (const d of ultimo.departamentos) {
      for (let s = desde; s <= hasta; s++) {
        const v = d.semanas[String(s)];
        lineas.push(
          `${ultimo.anio},${d.nombre},${d.codigo},${s},${v == null ? '' : v}`,
        );
      }
    }
    const blob = new Blob([lineas.join('\n')], {
      type: 'text/csv;charset=utf-8',
    });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `neumonias-heatmap-${ultimo.anio}-SE${desde}-${hasta}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  // El mapa de calor necesita un año concreto: con "todos" (curvas) muestra el
  // más reciente.
  function anioParaMapa(f: FiltrosRespiratorio): string {
    return String(f.anio === 'todos' ? ANIOS_RESPIRATORIO[0] : f.anio);
  }

  if (root && contenedor) {
    const selAnio = root.querySelector<HTMLSelectElement>('[data-hm-anio]')!;
    const inpDesde = root.querySelector<HTMLInputElement>('[data-hm-desde]')!;
    const inpHasta = root.querySelector<HTMLInputElement>('[data-hm-hasta]')!;
    const selectorDesde = root.querySelector<HTMLElement>('.hm-selector-desde');
    const selectorHasta = root.querySelector<HTMLElement>('.hm-selector-hasta');

    const sincronizar = (f: FiltrosRespiratorio) => {
      selAnio.value = anioParaMapa(f);
      const actualDesde = Math.min(
        Number(inpDesde.value),
        Number(inpHasta.value),
      );
      const actualHasta = Math.max(
        Number(inpDesde.value),
        Number(inpHasta.value),
      );
      if (actualDesde !== f.semanaDesde || actualHasta !== f.semanaHasta) {
        inpDesde.value = String(f.semanaDesde);
        inpHasta.value = String(f.semanaHasta);
      }
      const anioNum = Number(selAnio.value);
      selectorDesde?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: anioNum, semana: f.semanaDesde },
        }),
      );
      selectorHasta?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: anioNum, semana: f.semanaHasta },
        }),
      );
    };
    sincronizar(obtenerFiltrosRespiratorio());

    const alCambiar = () => {
      actualizarFiltrosRespiratorio({
        anio: Number(selAnio.value),
        semanaDesde: Number(inpDesde.value),
        semanaHasta: Number(inpHasta.value),
      });
    };
    selAnio.addEventListener('change', alCambiar);
    inpDesde.addEventListener('input', alCambiar);
    inpHasta.addEventListener('input', alCambiar);
    selectorDesde?.addEventListener('cambio-semana', ((
      ev: CustomEvent<{ semana: number }>,
    ) => {
      inpDesde.value = String(ev.detail.semana);
      alCambiar();
    }) as EventListener);
    selectorHasta?.addEventListener('cambio-semana', ((
      ev: CustomEvent<{ semana: number }>,
    ) => {
      inpHasta.value = String(ev.detail.semana);
      alCambiar();
    }) as EventListener);
    suscribirFiltrosRespiratorio((f) => {
      sincronizar(f);
      if (
        grafico &&
        moverSeleccion &&
        soloCambiaDepartamento(filtrosPintados, f)
      ) {
        filtrosPintados = f;
        moverSeleccion(f);
        return;
      }
      void pintar();
    }, false);
    root.querySelector('[data-hm-export]')?.addEventListener('click', exportar);
    void pintar();
  }
</script>
