---
import Icono from './Icono.astro';
import { RUTA_SENSIBILIDAD } from '../lib/enlaces';
// Clasificador nacional retirado: se muestra como referencia, no como
// predicción en vivo. Se retiró porque ninguna de las cinco líneas de
// validación sostuvo capacidad predictiva (aviso de sensibilidad de la
// Biblioteca), así que su salida no se presenta como predicción. Va en una
// sección colapsable y etiquetada como histórica para que sus métricas y
// errores sigan consultables desde el panel.
//
// El endpoint GET /api/riesgo-nacional y el modelo entrenado se conservan sin
// cambios como referencia.
---

<section
  class="rounded-2xl border border-dashed border-border bg-surface p-5 sm:p-6"
>
  <details>
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-3 font-sans text-base font-semibold text-ink [&::-webkit-details-marker]:hidden"
    >
      <span class="flex items-center gap-3">
        <span
          class="rounded-full bg-ink-muted/10 px-2.5 py-0.5 font-sans text-micro font-semibold uppercase tracking-wide text-ink-muted"
        >
          Retirado
        </span>
        Clasificador histórico
      </span>
      <Icono
        nombre="chevron-down"
        class="chevron h-4 w-4 text-ink-muted transition-transform duration-200"
      />
    </summary>
    <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
      Clasificador piloto de 2024. Al validarlo con los años de brote conocidos
      no detectó las semanas de riesgo alto y se retiró. Se conserva para
      consultar su evaluación. Los motivos están en el{' '}
      <a
        class="underline decoration-border underline-offset-2 hover:text-accent"
        href={RUTA_SENSIBILIDAD}>aviso de sensibilidad</a
      >.
    </p>

    <div id="riesgo-nacional" class="mt-3" role="status" aria-busy="true">
      <div data-estado aria-hidden="true">
        <div class="skeleton h-16 w-full"></div>
        <div class="skeleton mt-3 h-24 w-full"></div>
        <div class="skeleton mt-3 h-3 w-1/2"></div>
      </div>
    </div>
  </details>
</section>

<style>
  details[open] .chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  import { escapeHtml } from '../utils/security';
  import { renderErrorFuente, renderSinDato } from './estado-async';

  interface RiesgoNacional {
    anio: number;
    semana_epi: number;
    etiqueta_predicha: string;
    etiqueta_real: string;
    probabilidades: Record<string, number>;
    casos_observados: number;
    metricas_modelo: {
      anio_prueba: number;
      anios_entrenamiento: number[];
      corte_percentil: string;
      f1_macro_modelo: number;
      recall_alto_modelo: number | null;
      n_alto_real_prueba: number;
      f1_macro_baseline_climatologica: number;
      recall_alto_baseline_climatologica: number | null;
      supera_baseline_climatologica: boolean;
      nota: string;
    } | null;
    aviso: string;
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

  const COLOR_CLASE: Record<string, string> = {
    bajo: '#2e7d32',
    medio: '#785600',
    alto: '#c62828',
  };

  function badge(clase: string): string {
    const color = COLOR_CLASE[clase] ?? 'var(--color-accent)';
    return `<span style="background:${color}" class="inline-block rounded-full px-2.5 py-0.5 font-sans text-xs font-semibold uppercase tracking-wide text-white">${escapeHtml(clase)}</span>`;
  }

  function formatearRecall(valor: number | null, nAltoReal: number): string {
    if (valor === null) {
      return `N/D (0 semanas observadas de "alto" en el año de prueba, ${nAltoReal} de soporte)`;
    }
    return valor.toFixed(3);
  }

  function render(contenedor: HTMLElement, datos: RiesgoNacional) {
    const estado = contenedor.querySelector('[data-estado]');
    estado?.remove();

    const m = datos.metricas_modelo;
    const probas = Object.entries(datos.probabilidades)
      .map(
        ([clase, p]) =>
          `<li>${escapeHtml(clase)}: ${(p * 100).toFixed(1)}%</li>`,
      )
      .join('');

    contenedor.innerHTML = `
      <div class="rounded-xl border border-border bg-bg p-3">
        <p class="font-sans text-sm text-ink">
          Clasificador piloto (archivo), semana ${datos.semana_epi} / ${datos.anio}: predijo ${badge(datos.etiqueta_predicha)}
          &nbsp;·&nbsp; observado ${badge(datos.etiqueta_real)}
        </p>
        <ul class="mt-2 font-sans text-xs tabular-nums text-ink-muted">${probas}</ul>
        <p class="mt-2 font-sans text-xs text-ink-muted">
          Casos observados esa semana (OpenDengue, clasificación='total'): ${datos.casos_observados}
        </p>
      </div>

      <div class="mt-3 rounded-xl border border-border bg-bg p-3">
        <p class="font-sans text-xs font-semibold uppercase text-ink-muted">Aviso</p>
        <p class="mt-1 font-sans text-sm text-ink">${escapeHtml(datos.aviso)}</p>
      </div>

      ${
        m
          ? `
      <div class="mt-3 rounded-xl border border-border bg-bg p-3">
        <p class="font-sans text-xs font-semibold uppercase text-ink-muted">
          Métricas del modelo (entrenado ${m.anios_entrenamiento.join(', ')} · probado ${m.anio_prueba} · corte ${escapeHtml(m.corte_percentil)})
        </p>
        <div class="overflow-x-auto scroll-shadow-x bg-bg">
        <table class="mt-2 w-full border-collapse font-sans text-xs tabular-nums text-ink" aria-label="Comparación de métricas entre el modelo y la línea base climatológica">
          <caption class="sr-only">Comparación de F1 macro y recall de "alto" entre el modelo y la línea base climatológica</caption>
          <thead>
            <tr class="text-left text-ink-muted">
              <th scope="col" class="border-b border-border py-1.5 pr-4"><span class="sr-only">Serie</span></th>
              <th scope="col" class="border-b border-border py-1.5 pr-4">F1 macro</th>
              <th scope="col" class="border-b border-border py-1.5">Recall "alto"</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="border-b border-border py-1.5 pr-4 text-left font-medium">Modelo</th>
              <td class="border-b border-border py-1.5 pr-4">${m.f1_macro_modelo.toFixed(3)}</td>
              <td class="border-b border-border py-1.5">${formatearRecall(m.recall_alto_modelo, m.n_alto_real_prueba)}</td>
            </tr>
            <tr>
              <th scope="row" class="py-1.5 pr-4 text-left font-medium">Línea base climatológica</th>
              <td class="py-1.5 pr-4">${m.f1_macro_baseline_climatologica.toFixed(3)}</td>
              <td class="py-1.5">${formatearRecall(m.recall_alto_baseline_climatologica, m.n_alto_real_prueba)}</td>
            </tr>
          </tbody>
        </table>
        </div>
        <p class="mt-2 font-sans text-sm text-ink">
          ¿Supera a la línea base climatológica (criterio decisivo)?
          <strong>${m.supera_baseline_climatologica ? 'Sí' : 'No, esta pasada'}</strong>
        </p>
        <p class="mt-1 font-sans text-xs text-ink-muted">${escapeHtml(m.nota)}</p>
      </div>
      `
          : `
      <div class="mt-3 rounded-xl border border-border bg-bg p-3">
        <p class="font-sans text-sm text-ink-muted">Métricas del modelo no disponibles todavía.</p>
      </div>
      `
      }
    `;
  }

  async function iniciar() {
    const contenedor = document.getElementById('riesgo-nacional');
    if (!contenedor) return;

    try {
      contenedor.setAttribute('aria-busy', 'true');
      const resp = await fetch(`${API_BASE}/api/riesgo-nacional`);
      if (!resp.ok) throw new Error('respuesta no OK');
      const datos: RiesgoNacional | { disponible: false; motivo?: string } =
        await resp.json();
      // El backend responde 200 con disponible:false cuando los artefactos
      // del modelo no están generados en el despliegue (#72) -- aviso
      // explícito en vez de un fallo genérico.
      if (datos && 'disponible' in datos && datos.disponible === false) {
        renderSinDato(
          contenedor,
          datos.motivo ??
            'La evaluación histórica no está generada en este despliegue.',
        );
        return;
      }
      render(contenedor, datos as RiesgoNacional);
      contenedor.removeAttribute('aria-busy');
    } catch {
      renderErrorFuente(contenedor, () => void iniciar());
    }
  }

  iniciar();
</script>
