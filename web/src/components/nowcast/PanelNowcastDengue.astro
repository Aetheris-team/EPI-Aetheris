---
import AyudaTermino from '../AyudaTermino.astro';
// Predicción de casos de dengue a corto plazo (GET /api/nowcast-dengue).
// Artefacto precomputado por backend/ingestion/nowcast_tablero_dengue.py. Sobre
// la serie del tablero de MINSAL (desde 2025) el método es la mezcla del modelo
// de ADR 0020 con una tendencia amortiguada; `prueba` describe su prueba con
// semanas nuevas y `desempeno.dentro_de_muestra` marca que los años del
// desempeño se usaron para elegirlo. Detalle de método y validación en
// docs/biblioteca/05-sensibilidad-y-honestidad.md.
//
// La predicción se extiende desde la última semana publicada de la serie, no
// desde la fecha de hoy. El panel muestra siempre esa fecha de anclaje.
//
// Prop `variante`:
//   - 'compacto'  -> solo el abanico hacia adelante + una línea de desempeño.
//   - 'completo'  -> además el backtest a cuatro semanas y el detalle por año.
//
// Prop `demo`: fuerza la secuencia de presentación sin depender de `?demo` en
// la URL. La usa /demos/nowcast. En /prediccion el gatillo es `?demo`.

interface Props {
  variante?: 'compacto' | 'completo';
  demo?: boolean;
}
const { variante = 'completo', demo = false } = Astro.props;
---

<section
  class="card-elevated rounded-2xl border border-border bg-surface p-5 sm:p-6"
  data-nowcast
  data-variante={variante}
  data-demo={demo ? 'true' : undefined}
>
  <div class="flex items-start gap-3">
    <span
      class="mt-1 h-6 w-1 shrink-0 rounded-full bg-accent"
      aria-hidden="true"></span>
    <div>
      <h2
        class="flex items-center gap-1 font-sans text-base font-semibold text-ink sm:text-lg"
      >
        Predicción de casos a corto plazo
        <AyudaTermino clave="bandas" />
        <AyudaTermino clave="sospechoso" />
      </h2>
      <p class="mt-1 font-sans text-sm leading-relaxed text-ink-muted">
        Predicción estadística del conteo nacional de dengue para las próximas 1
        a 8 semanas, con intervalo de incertidumbre, a partir de la última
        semana observada.
      </p>
    </div>
  </div>

  <div data-nowcast-cuerpo class="mt-4" role="status" aria-busy="true">
    <div data-estado aria-hidden="true">
      <div class="skeleton h-56 w-full sm:h-64"></div>
      <div class="skeleton mt-3 h-3 w-2/5"></div>
    </div>
  </div>
</section>

<style>
  /* pulso del punto de anclaje (solo modo demo): anillo HTML sobre la gráfica */
  @keyframes nc-pulso-ancla {
    0% {
      transform: translate(-50%, -50%) scale(0.35);
      opacity: 0.55;
    }
    75%,
    100% {
      transform: translate(-50%, -50%) scale(2.6);
      opacity: 0;
    }
  }
  :global(.nc-pulso-ancla) {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1.5px solid var(--color-estimacion);
    pointer-events: none;
    opacity: 0;
    animation: nc-pulso-ancla 1.7s ease-out 2;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.nc-pulso-ancla) {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  import { obtenerNowcastDengue } from '../../lib/analisis-api';
  import { animacionesActivas } from '../../lib/animaciones';
  import { montarGrafico } from '../../lib/echarts-montaje';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import {
    etiquetaAbanico,
    etiquetaValidacion,
    fecha,
    filasAbanico,
    filasValidacion,
    fmtFecha,
    fmtNum,
    prepararAbanico,
    prepararValidacion,
    recortarAbanico,
    resumenAbanico,
    resumenValidacion,
  } from '../../lib/nowcast-datos';
  import type { DatosAbanico } from '../../lib/nowcast-datos';
  import {
    SEMANAS_VISTA,
    SERIE,
    opcionAbanico,
    opcionValidacion,
  } from '../../lib/nowcast-opciones';
  import type {
    NombreSerie,
    VistaAbanico,
    Visibles,
  } from '../../lib/nowcast-opciones';
  import type {
    NowcastDengue,
    PuntoBacktestNowcast,
  } from '../../lib/tipos-analisis';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import {
    alCruzarAnchoMovil,
    crearDetalleTabla,
    crearLeyenda,
    crearSelector,
    esMovil,
  } from './ui-nowcast';
  import type { ItemLeyenda } from './ui-nowcast';

  // --- ritmo de la presentación ---------------------------------------------

  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  // Llama a aplicar(frac) con frac lineal de 0 a 1 sobre `dur` ms. Con las
  // animaciones apagadas (interruptor del pie o prefers-reduced-motion) salta
  // al estado final. Resuelve al terminar.
  function animar(aplicar: (frac: number) => void, dur: number): Promise<void> {
    if (!animacionesActivas() || dur <= 0) {
      aplicar(1);
      return Promise.resolve();
    }
    return new Promise((res) => {
      const t0 = performance.now();
      const paso = (ahora: number) => {
        const frac = Math.min(1, (ahora - t0) / dur);
        aplicar(frac);
        if (frac < 1) requestAnimationFrame(paso);
        else res();
      };
      requestAnimationFrame(paso);
    });
  }
  const espera = (ms: number) =>
    animacionesActivas()
      ? new Promise((r) => setTimeout(r, ms))
      : Promise.resolve();

  // --- piezas de HTML -------------------------------------------------------

  function chip(texto: string, fuerte = false): HTMLElement {
    const s = document.createElement('span');
    s.className = fuerte
      ? 'inline-flex items-center rounded-full bg-accent/12 px-2.5 py-1 font-sans text-xs font-semibold text-accent'
      : 'inline-flex items-center rounded-full border border-border px-2.5 py-1 font-sans text-xs text-ink-muted';
    s.textContent = texto;
    return s;
  }

  function bloque(titulo: string): HTMLElement {
    const h = document.createElement('h3');
    h.className = 'mt-6 font-sans text-sm font-semibold text-ink';
    h.textContent = titulo;
    return h;
  }

  function parrafo(texto: string, clase: string): HTMLElement {
    const p = document.createElement('p');
    p.className = clase;
    p.textContent = texto;
    return p;
  }

  const CLASE_NOTA = 'font-sans text-xs leading-relaxed text-ink-muted';

  // La leyenda oculta y resalta series por nombre.
  function enlazarLeyenda(
    grafico: GraficoMontado,
    visibles: Visibles,
    items: ItemLeyenda[],
  ) {
    return crearLeyenda(
      items,
      visibles,
      (nombre: NombreSerie, visible: boolean) => {
        visibles[nombre] = visible;
        grafico.instancia.dispatchAction({
          type: visible ? 'legendSelect' : 'legendUnSelect',
          name: nombre,
        });
      },
      (nombre) =>
        grafico.instancia.dispatchAction({
          type: nombre ? 'highlight' : 'downplay',
          seriesName: nombre ?? undefined,
        }),
    );
  }

  const LEYENDA_ABANICO: ItemLeyenda[] = [
    { nombre: SERIE.publicado, muestra: 'continua' },
    { nombre: SERIE.mediana, muestra: 'punteada' },
    { nombre: SERIE.rango50, muestra: 'banda50' },
    { nombre: SERIE.rango95, muestra: 'banda95' },
  ];

  // --- abanico hacia adelante -------------------------------------------------

  interface AbanicoHandle {
    revelar: (dur?: number) => Promise<void>;
    enfocar: () => void;
    /** posición en píxeles del punto de anclaje respecto al lienzo */
    posicionAncla: () => [number, number] | null;
    lienzo: HTMLElement;
  }

  const VISTAS: { valor: VistaAbanico; texto: string; descripcion: string }[] =
    [
      {
        valor: 'cerca',
        texto: '3 meses',
        descripcion: 'Se muestran los últimos 3 meses y la predicción.',
      },
      {
        valor: 'anio',
        texto: '1 año',
        descripcion: 'Se muestra el último año y la predicción.',
      },
      {
        valor: 'todo',
        texto: 'Todo',
        descripcion: 'Se muestra toda la serie disponible y la predicción.',
      },
    ];

  async function montarAbanico(
    zona: HTMLElement,
    barra: HTMLElement,
    anuncio: HTMLElement,
    datos: DatosAbanico,
    opts: { iniciarOculto: boolean },
  ): Promise<AbanicoHandle> {
    let vista: VistaAbanico = 'anio';
    let revelado = !opts.iniciarOculto;
    const visibles: Visibles = {};

    const lienzo = document.createElement('div');
    lienzo.className = 'h-[320px] w-full min-w-0 sm:h-[380px]';
    renderEsqueletoTraza(lienzo);
    zona.appendChild(lienzo);
    // En pantallas estrechas un año entero deja la predicción en pocos píxeles.
    if (esMovil(lienzo)) vista = 'cerca';

    const construir = (t: Parameters<typeof opcionAbanico>[0]) =>
      opcionAbanico(t, recortarAbanico(datos, SEMANAS_VISTA[vista]), {
        movil: esMovil(lienzo),
        vista,
        visibles,
        revelado,
      });

    const grafico = await montarGrafico(
      lienzo,
      construir,
      etiquetaAbanico(datos),
    );
    alCruzarAnchoMovil(lienzo, () => grafico.actualizar(construir));

    const leyenda = enlazarLeyenda(grafico, visibles, LEYENDA_ABANICO);
    const selector = crearSelector<VistaAbanico>(
      'Periodo de la serie publicada',
      VISTAS,
      vista,
      (valor, descripcion) => {
        vista = valor;
        grafico.actualizar(construir, { suave: true });
        anuncio.textContent = descripcion;
      },
    );
    barra.append(leyenda.elemento, selector.elemento);

    return {
      lienzo,
      revelar: async (dur = 1500) => {
        revelado = true;
        grafico.instancia.setOption({ animationDurationUpdate: dur });
        grafico.actualizar(construir, { suave: true });
        await espera(dur);
        grafico.instancia.setOption({ animationDurationUpdate: 320 });
      },
      enfocar: () => {
        vista = 'cerca';
        selector.elegir('cerca');
        grafico.actualizar(construir, { suave: true });
      },
      posicionAncla: () => {
        const px = grafico.instancia.convertToPixel(
          { xAxisIndex: 0, yAxisIndex: 0 },
          [datos.ancla.t, datos.ancla.casos],
        );
        return Array.isArray(px) ? [px[0], px[1]] : null;
      },
    };
  }

  // --- validación a cuatro semanas -----------------------------------------

  const LEYENDA_VALIDACION: ItemLeyenda[] = [
    { nombre: SERIE.publicado, muestra: 'continua' },
    { nombre: SERIE.mediana, muestra: 'punteada' },
    { nombre: SERIE.rango50, muestra: 'banda50' },
    { nombre: SERIE.rango95, muestra: 'banda95' },
    { nombre: SERIE.fuera, muestra: 'anillo' },
  ];

  async function montarValidacion(
    destino: HTMLElement,
    puntos: PuntoBacktestNowcast[],
    anios: string,
  ) {
    const datos = prepararValidacion(puntos);
    if (!datos) return;
    destino.appendChild(
      parrafo(
        resumenValidacion(datos),
        'mt-3 font-sans text-sm leading-relaxed text-ink',
      ),
    );
    const barra = document.createElement('div');
    barra.className = 'mt-3 flex flex-wrap items-center gap-2';
    const zona = document.createElement('div');
    zona.className = 'mt-2 rounded-xl border border-border bg-bg p-2 sm:p-3';
    const lienzo = document.createElement('div');
    lienzo.className = 'h-[260px] w-full min-w-0 sm:h-[300px]';
    renderEsqueletoTraza(lienzo);
    zona.appendChild(lienzo);
    destino.append(barra, zona);

    const visibles: Visibles = {};
    const construir = (t: Parameters<typeof opcionValidacion>[0]) =>
      opcionValidacion(t, datos, { movil: esMovil(lienzo), visibles });
    const grafico = await montarGrafico(
      lienzo,
      construir,
      etiquetaValidacion(datos, anios),
    );
    alCruzarAnchoMovil(lienzo, () => grafico.actualizar(construir));
    barra.appendChild(
      enlazarLeyenda(grafico, visibles, LEYENDA_VALIDACION).elemento,
    );

    destino.appendChild(
      crearDetalleTabla(
        'Casos publicados y predicción a cuatro semanas por semana',
        [
          { clave: 'semana', encabezado: 'Semana del' },
          {
            clave: 'observado',
            encabezado: 'Publicado',
            alineacion: 'derecha',
          },
          { clave: 'mediana', encabezado: 'Mediana', alineacion: 'derecha' },
          { clave: 'rango50', encabezado: 'Rango 50 %', alineacion: 'derecha' },
          { clave: 'rango95', encabezado: 'Rango 95 %', alineacion: 'derecha' },
          { clave: 'dentro', encabezado: 'Dentro de' },
        ],
        () => filasValidacion(datos),
      ),
    );
  }

  // --- panel -------------------------------------------------------------------

  async function render(
    cont: HTMLElement,
    datos: NowcastDengue,
    completo: boolean,
    demoForzado = false,
  ) {
    const abanico = prepararAbanico(datos);
    if (!abanico || !datos.ancla || !datos.desempeno) {
      renderSinDato(cont, 'La predicción no está disponible todavía.');
      return;
    }
    const d = datos.desempeno;
    cont.replaceChildren();

    // modo demo (para grabar el video): ?demo -> secuencia con botón y revelado
    // cinematográfico. En uso normal el abanico aparece con un barrido breve.
    const busqueda =
      typeof location !== 'undefined'
        ? new URLSearchParams(location.search)
        : new URLSearchParams();
    const demo = completo && (demoForzado || busqueda.has('demo'));
    // ?demo=lento (o ?lento en /demos) -> ritmo más pausado en toda la secuencia.
    const RITMO =
      busqueda.get('demo') === 'lento' || busqueda.has('lento') ? 1.6 : 1;

    let barraDemo: HTMLElement | null = null;
    if (demo) {
      barraDemo = document.createElement('div');
      barraDemo.className = 'mb-3 flex flex-wrap items-end gap-3';
      barraDemo.innerHTML =
        '<label class="flex flex-col gap-1">' +
        '<span class="font-sans text-micro font-medium text-ink-muted">Semana de anclaje</span>' +
        '<select class="rounded-lg border border-border bg-surface px-3 py-2 font-sans text-sm text-ink" aria-label="Semana de anclaje">' +
        `<option>${fmtFecha.format(fecha(datos.ancla.fecha))} · última semana observada</option>` +
        '</select></label>' +
        '<button type="button" data-cargar class="rounded-full bg-accent px-5 py-2.5 font-sans text-sm font-semibold text-accent-ink shadow-sm transition-colors hover:bg-deep">Cargar predicción →</button>' +
        '<button type="button" data-reiniciar hidden class="font-sans text-xs text-accent underline underline-offset-2">Reiniciar</button>';
      cont.appendChild(barraDemo);
    }

    // lo que se ve, dicho en palabras, antes de la gráfica
    const resumen = parrafo(
      resumenAbanico(abanico),
      'font-sans text-sm leading-relaxed text-ink',
    );
    resumen.dataset.nowcastResumen = '';
    if (demo) resumen.classList.add('hidden');
    cont.appendChild(resumen);

    const barra = document.createElement('div');
    barra.className = 'mt-3 flex flex-wrap items-center justify-between gap-2';
    const anuncio = document.createElement('p');
    anuncio.className = 'sr-only';
    anuncio.setAttribute('role', 'status');
    const contAbanico = document.createElement('div');
    contAbanico.className =
      'relative mt-2 overflow-hidden rounded-xl border border-border bg-bg p-2 sm:p-3';
    cont.append(barra, anuncio, contAbanico);

    const handleAbanico = await montarAbanico(
      contAbanico,
      barra,
      anuncio,
      abanico,
      { iniciarOculto: demo },
    );

    cont.appendChild(
      crearDetalleTabla(
        'Casos publicados y predicción por semana',
        [
          { clave: 'semana', encabezado: 'Semana' },
          { clave: 'tipo', encabezado: 'Tipo' },
          {
            clave: 'casos',
            encabezado: 'Casos o mediana',
            alineacion: 'derecha',
          },
          { clave: 'rango50', encabezado: 'Rango 50 %', alineacion: 'derecha' },
          { clave: 'rango95', encabezado: 'Rango 95 %', alineacion: 'derecha' },
        ],
        () => filasAbanico(abanico),
      ),
    );

    const anios = Object.keys(d.skill_por_anio);
    const tramoAnios =
      anios.length > 1 ? `${anios[0]}–${anios[anios.length - 1]}` : anios[0];

    // cómo leer la gráfica, con la incertidumbre medida
    const lectura = document.createElement('div');
    lectura.className = 'mt-4 space-y-2';
    lectura.append(
      parrafo(
        'Línea continua: casos que publicó la fuente. Línea punteada: mediana de la predicción. La banda intensa es el rango donde el modelo espera el valor la mitad de las veces, y la clara 19 de cada 20 veces. Ambas se ensanchan con el horizonte porque la incertidumbre crece.',
        CLASE_NOTA,
      ),
      parrafo(
        `En ${tramoAnios}${d.dentro_de_muestra ? ' (años que sirvieron para elegir el método)' : ''}, a ${d.horizonte} semanas, lo observado quedó dentro del rango del 50 % en el ${Math.round(d.cobertura_50 * 100)} % de las semanas y dentro del 95 % en el ${Math.round(d.cobertura_95 * 100)} %.`,
        CLASE_NOTA,
      ),
      parrafo(
        datos.fuente_serie === 'minsal_tablero'
          ? `La predicción parte de la última semana publicada en el tablero de MINSAL (${fmtFecha.format(fecha(datos.ancla.fecha))}, ${fmtNum.format(datos.ancla.casos)} casos). El tablero publica cada semana como un promedio de varias.`
          : `La predicción parte de la última semana observada de la serie pública (${fmtFecha.format(fecha(datos.ancla.fecha))}, ${fmtNum.format(datos.ancla.casos)} casos), que se actualiza con retraso.`,
        CLASE_NOTA,
      ),
    );
    cont.appendChild(lectura);

    // desempeño
    const chips = document.createElement('div');
    chips.className =
      'mt-4 flex flex-wrap gap-2' +
      (demo ? ' transition-opacity duration-500 opacity-0' : '');
    const pct = Math.round(d.reduccion_wis * 100);
    const signo = pct > 0 ? '−' : '+';
    const contadores: {
      nodo: HTMLElement;
      plantilla: string;
      valor: number;
    }[] = [];
    const chipCont = (plantilla: string, valor: number, fuerte = false) => {
      const nodo = chip(plantilla.replace('{n}', String(valor)), fuerte);
      contadores.push({ nodo, plantilla, valor });
      return nodo;
    };
    const prueba = datos.prueba;
    if (d.dentro_de_muestra && prueba) {
      chips.append(
        chipCont(
          `${signo}{n} % de error frente a la persistencia en ${tramoAnios}`,
          Math.abs(pct),
          true,
        ),
        chip(
          `en prueba con semanas nuevas desde la semana ${prueba.inicio.semana} de ${prueba.inicio.anio}`,
        ),
        chip(`horizonte de referencia: ${d.horizonte} semanas`),
      );
    } else {
      chips.append(
        chipCont(
          `${signo}{n} % de error frente a la persistencia`,
          Math.abs(pct),
          true,
        ),
        chipCont(
          `mejor en {n} de ${d.n_anios} temporadas de prueba`,
          d.anios_ganados,
        ),
        chip(`horizonte de referencia: ${d.horizonte} semanas`),
      );
    }
    cont.appendChild(chips);
    const correrContadores = () => {
      for (const c of contadores)
        void animar((f) => {
          c.nodo.textContent = c.plantilla.replace(
            '{n}',
            String(Math.round(c.valor * easeOutCubic(f))),
          );
        }, 950 * RITMO);
    };

    const extra = document.createElement('div');
    if (demo) extra.className = 'transition-opacity duration-700 opacity-0';
    cont.appendChild(extra);

    if (completo) {
      const pruebaNueva = d.dentro_de_muestra ? prueba : undefined;
      const enMuestra = Boolean(pruebaNueva);
      const listaAnios = anios.join(' y ');
      extra.appendChild(
        bloque(
          enMuestra
            ? `Cómo se comportó en ${listaAnios}`
            : 'Cómo se comportó en las temporadas de prueba',
        ),
      );
      extra.appendChild(
        parrafo(
          pruebaNueva
            ? `En cada semana de ${listaAnios} la predicción usó solo los datos anteriores. Línea continua, lo publicado; línea punteada y bandas, la predicción a cuatro semanas. Estos años sirvieron para elegir el método. La prueba con semanas nuevas usa las ${pruebaNueva.semanas} que MINSAL publique desde el ${fmtFecha.format(fecha(pruebaNueva.inicio.fecha))}.`
            : 'Validación temporal sin fuga: en cada semana de 2019 y 2021–2024 el modelo solo vio datos anteriores. Línea continua, lo publicado; línea punteada y bandas, la predicción a cuatro semanas.',
          `mt-1 ${CLASE_NOTA}`,
        ),
      );

      if (datos.backtest?.puntos?.length) {
        await montarValidacion(
          extra,
          datos.backtest.puntos,
          enMuestra ? listaAnios : 'las temporadas de prueba',
        );
      }

      // detalle por año
      if (anios.length) {
        const tabla = document.createElement('div');
        tabla.className = 'mt-4 grid gap-2 sm:grid-cols-5';
        for (const a of anios) {
          const celda = document.createElement('div');
          celda.className =
            'rounded-lg border border-border bg-bg px-3 py-2 text-center';
          const v = d.skill_por_anio[a];
          const anioEl = document.createElement('div');
          anioEl.className = 'font-sans text-xs text-ink-muted';
          anioEl.textContent = a;
          const valEl = document.createElement('div');
          valEl.className =
            'mt-0.5 font-sans text-sm font-semibold tabular-nums ' +
            (v > 0 ? 'text-accent' : 'text-ink');
          valEl.textContent = `${v > 0 ? '−' : '+'}${Math.abs(Math.round(v * 100))} %`;
          celda.append(anioEl, valEl);
          tabla.appendChild(celda);
        }
        extra.appendChild(tabla);
        extra.appendChild(
          parrafo(
            'Reducción del error de intervalo (WIS) respecto a la persistencia, por año.',
            'mt-2 font-sans text-micro leading-relaxed text-ink-muted',
          ),
        );
      }
    }

    if (demo && barraDemo) {
      const btn = barraDemo.querySelector<HTMLButtonElement>('[data-cargar]');
      const rei =
        barraDemo.querySelector<HTMLButtonElement>('[data-reiniciar]');

      // resumen numérico que aparece sobre el gráfico tras el zoom
      const estimacion = datos.estimacion ?? [];
      const med = estimacion.map((x) => x.mediana);
      const b50lo = Math.min(...estimacion.map((x) => x.banda_50[0]));
      const b50hi = Math.max(...estimacion.map((x) => x.banda_50[1]));
      const cartel = document.createElement('div');
      cartel.className =
        'pointer-events-none absolute bottom-12 left-3 max-w-[min(92%,320px)] translate-y-1 rounded-xl border border-accent/25 bg-surface/95 p-3 opacity-0 shadow-lg transition-all duration-500 sm:left-4';
      const cartelEyebrow = document.createElement('div');
      cartelEyebrow.className =
        'font-sans text-micro font-semibold uppercase tracking-wide text-ink-muted';
      const cartelEyebrowTxt = 'Predicción · próximas 1 a 8 semanas';
      const cartelCifras = document.createElement('div');
      cartelCifras.className =
        'mt-1 font-sans text-lg font-semibold tabular-nums text-ink';
      const cartelCifrasTxt = `≈ ${fmtNum.format(Math.min(...med))}–${fmtNum.format(Math.max(...med))} casos / semana`;
      const cartelRango = document.createElement('div');
      cartelRango.className =
        'mt-0.5 font-sans text-xs tabular-nums text-ink-muted';
      cartelRango.textContent = `rango del 50 %: ${fmtNum.format(b50lo)}–${fmtNum.format(b50hi)}`;
      cartel.append(cartelEyebrow, cartelCifras, cartelRango);
      contAbanico.appendChild(cartel);

      if (RITMO !== 1) {
        cartel.style.transitionDuration = `${Math.round(500 * RITMO)}ms`;
        chips.style.transitionDuration = `${Math.round(500 * RITMO)}ms`;
        extra.style.transitionDuration = `${Math.round(700 * RITMO)}ms`;
      }

      // máquina de escribir: escribe `texto` en `nodo` char a char, reservando
      // el alto para no romper el layout del cartel. Sin animaciones -> directo.
      const escribir = (nodo: HTMLElement, texto: string, msChar: number) => {
        nodo.textContent = texto;
        const h = nodo.offsetHeight;
        if (h) nodo.style.minHeight = `${h}px`;
        nodo.textContent = '';
        return animar((f) => {
          nodo.textContent = texto.slice(0, Math.floor(f * texto.length));
        }, texto.length * msChar).then(() => {
          nodo.textContent = texto;
        });
      };

      // anillo que late sobre el punto de anclaje al cargar la predicción
      const pulsar = () => {
        const pos = handleAbanico.posicionAncla();
        if (!pos) return;
        const anillo = document.createElement('span');
        anillo.className = 'nc-pulso-ancla';
        anillo.setAttribute('aria-hidden', 'true');
        anillo.style.left = `${handleAbanico.lienzo.offsetLeft + pos[0]}px`;
        anillo.style.top = `${handleAbanico.lienzo.offsetTop + pos[1]}px`;
        contAbanico.appendChild(anillo);
        setTimeout(() => anillo.remove(), 3600);
      };

      btn?.addEventListener(
        'click',
        async () => {
          btn.disabled = true;
          btn.classList.add('opacity-70');
          btn.textContent = 'Calculando…';
          await espera(550 * RITMO);
          btn.textContent = 'Predicción cargada';
          resumen.classList.remove('hidden');
          pulsar();
          await handleAbanico.revelar(1700 * RITMO);
          await espera(280 * RITMO);
          handleAbanico.enfocar();
          await espera(950 * RITMO);
          cartel.classList.remove('opacity-0', 'translate-y-1');
          await espera(320 * RITMO);
          await escribir(cartelEyebrow, cartelEyebrowTxt, 24 * RITMO);
          await escribir(cartelCifras, cartelCifrasTxt, 28 * RITMO);
          await espera(140 * RITMO);
          chips.classList.remove('opacity-0');
          correrContadores();
          extra.classList.remove('opacity-0');
          if (rei) rei.hidden = false;
        },
        { once: true },
      );
      rei?.addEventListener(
        'click',
        () => void render(cont, datos, completo, demoForzado),
      );
    }

    const pie = document.createElement('p');
    pie.className = `mt-4 ${CLASE_NOTA}`;
    pie.append(
      'Predicción estadística del conteo nacional de casos de dengue. ',
    );
    const enlace = document.createElement('a');
    enlace.className = 'text-accent underline underline-offset-2';
    enlace.href = '/biblioteca/05-sensibilidad-y-honestidad';
    enlace.textContent = 'Método y validación';
    pie.append(enlace, '.');
    cont.appendChild(pie);
  }

  async function iniciar() {
    const secciones = document.querySelectorAll<HTMLElement>('[data-nowcast]');
    for (const sec of secciones) {
      const cont = sec.querySelector<HTMLElement>('[data-nowcast-cuerpo]');
      if (!cont) continue;
      const completo = sec.dataset.variante !== 'compacto';
      const demoForzado = sec.dataset.demo === 'true';
      try {
        cont.setAttribute('aria-busy', 'true');
        const datos = await obtenerNowcastDengue();
        if (esNoDisponible(datos)) {
          renderSinDato(cont, motivoNoDisponible(datos));
          continue;
        }
        await render(cont, datos, completo, demoForzado);
        cont.removeAttribute('aria-busy');
        // El panel armado tiene controles y su propio aviso: ya no es una
        // región de estado.
        if (cont.querySelector('[data-nowcast-resumen]'))
          cont.removeAttribute('role');
      } catch {
        renderErrorFuente(cont, () => void iniciar());
      }
    }
  }

  iniciar();
</script>
