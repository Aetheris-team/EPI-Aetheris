---
// Contraste de la predicción de dengue con lo observado (ADR 0020).
//
// Permite mover el punto de partida de la predicción a cualquier semana de la
// serie nacional (OpenDengue hasta 2024, tablero de MINSAL desde 2025) y ver,
// junto al abanico de 1 a 8 semanas, lo que se observó después. Cada abanico se
// calculó solo con los datos anteriores a su semana de partida
// (GET /api/nowcast-dengue/retrospectivo); la última semana usa la estimación
// publicada (GET /api/nowcast-dengue). Desde `retro.tablero.inicio` el método
// es la mezcla con la tendencia amortiguada y la referencia es la persistencia
// con márgenes aprendidos de la historia promediada.
//
// La semana se elige con el año, el deslizador, los botones de semana anterior
// y siguiente o arrastrando sobre la gráfica. La tabla es la alternativa textual
// de la gráfica.
import SelectorSemanaEpi from '../SelectorSemanaEpi.astro';
---

<section
  aria-labelledby="contraste-nowcast-titulo"
  class="card-elevated rounded-2xl border border-border bg-surface p-5 sm:p-6"
  data-contraste-nowcast
>
  <div class="flex items-start gap-3">
    <span
      class="mt-1 h-6 w-1 shrink-0 rounded-full bg-accent"
      aria-hidden="true"></span>
    <div>
      <h2
        id="contraste-nowcast-titulo"
        class="font-sans text-base font-semibold text-ink sm:text-lg"
      >
        Contrastar la predicción con lo observado
      </h2>
      <p class="mt-1 font-sans text-sm leading-relaxed text-ink-muted">
        Elige una semana de partida. La gráfica muestra lo que el modelo habría
        predicho con los datos disponibles hasta esa semana y lo que se observó
        después.
      </p>
    </div>
  </div>

  <div
    class="mt-4 grid gap-3 sm:grid-cols-[auto_1fr] sm:items-end"
    data-controles
  >
    <label
      class="flex flex-col gap-1 font-sans text-xs font-medium text-ink-muted"
    >
      Año
      <select
        data-anio
        disabled
        class="rounded-lg border border-border bg-surface px-3 py-2 font-sans text-sm text-ink"
      ></select>
    </label>
    <div class="flex flex-wrap items-end gap-2">
      <button
        type="button"
        data-anterior
        disabled
        aria-label="Semana anterior"
        class="rounded-lg border border-border bg-surface px-3 py-2 font-sans text-sm text-ink transition-colors hover:border-accent/50 hover:text-accent disabled:opacity-40 min-h-[44px]"
      >
        ‹
      </button>

      <div
        class="flex grow flex-col gap-1 font-sans text-xs font-medium text-ink-muted min-w-[220px]"
      >
        <div class="flex items-center justify-between">
          <span>Semana de partida:</span>
          <span
            data-semana-valor
            class="font-sans tabular-nums text-ink font-semibold">—</span
          >
        </div>
        <div class="flex items-center gap-2">
          <SelectorSemanaEpi
            id="contraste-nowcast-selector-semana"
            compacto={false}
            mostrarRangoFechas={true}
            etiqueta="Semana de partida de predicción"
            class="w-full"
          />
        </div>
        <label class="sr-only" for="contraste-nowcast-semana-slider">
          Deslizador de semana de partida
        </label>
        <input
          id="contraste-nowcast-semana-slider"
          data-semana
          type="range"
          min="1"
          max="52"
          value="1"
          disabled
          class="w-full accent-accent"
        />
      </div>

      <button
        type="button"
        data-siguiente
        disabled
        aria-label="Semana siguiente"
        class="rounded-lg border border-border bg-surface px-3 py-2 font-sans text-sm text-ink transition-colors hover:border-accent/50 hover:text-accent disabled:opacity-40 min-h-[44px]"
      >
        ›
      </button>
    </div>
  </div>

  <div data-contraste-cuerpo class="mt-4" aria-busy="true">
    <div data-estado aria-hidden="true">
      <div class="skeleton h-56 w-full sm:h-64"></div>
      <div class="skeleton mt-3 h-3 w-2/5"></div>
    </div>
  </div>
</section>

<script>
  import {
    obtenerNowcastDengue,
    obtenerNowcastRetrospectivo,
  } from '../../lib/analisis-api';
  import { montarGrafico } from '../../lib/echarts-montaje';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import {
    construirModelo,
    dentroDe,
    fecha,
    fmtFecha,
    fmtNum,
    marcaTiempo,
    textoNotaAnio,
    textoResumenOrigen,
  } from '../../lib/nowcast-datos';
  import type { ModeloContraste, Origen } from '../../lib/nowcast-datos';
  import { SERIE, opcionContraste } from '../../lib/nowcast-opciones';
  import type { NombreSerie, Visibles } from '../../lib/nowcast-opciones';
  import type { NowcastDengue } from '../../lib/tipos-analisis';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import { alCruzarAnchoMovil, crearLeyenda, esMovil } from './ui-nowcast';

  // --- texto y tabla -----------------------------------------------------------

  function resumenOrigen(modelo: ModeloContraste, origen: Origen): HTMLElement {
    const p = document.createElement('p');
    p.className = 'font-sans text-sm leading-relaxed text-ink';
    p.setAttribute('aria-live', 'polite');
    p.textContent = textoResumenOrigen(modelo, origen);
    return p;
  }

  function tabla(origen: Origen): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'mt-3 overflow-x-auto scroll-shadow-x';
    wrap.tabIndex = 0;
    wrap.setAttribute('role', 'region');
    wrap.setAttribute(
      'aria-label',
      `Predicción desde la semana ${origen.semana} de ${origen.anio} y casos observados`,
    );
    const t = document.createElement('table');
    t.className =
      'w-full min-w-[34rem] font-sans text-xs tabular-nums text-ink';
    const cap = document.createElement('caption');
    cap.className = 'sr-only';
    cap.textContent = `Predicción desde la semana ${origen.semana} de ${origen.anio} y casos observados`;
    t.appendChild(cap);
    const thead = document.createElement('thead');
    thead.innerHTML =
      '<tr class="border-b border-border text-left text-ink-muted">' +
      '<th scope="col" class="py-1.5 pr-3 font-medium">Semana</th>' +
      '<th scope="col" class="py-1.5 pr-3 text-right font-medium">Predicción</th>' +
      '<th scope="col" class="py-1.5 pr-3 text-right font-medium">Rango 50 %</th>' +
      '<th scope="col" class="py-1.5 pr-3 text-right font-medium">Rango 95 %</th>' +
      '<th scope="col" class="py-1.5 pr-3 text-right font-medium">Observado</th>' +
      '<th scope="col" class="py-1.5 font-medium">Dentro de</th>' +
      '</tr>';
    t.appendChild(thead);
    const tbody = document.createElement('tbody');
    for (const h of origen.horizontes ?? []) {
      if (!h) continue;
      const tr = document.createElement('tr');
      tr.className = 'border-b border-border/60';
      const celdas: [string, string][] = [
        [`+${h.h} · ${fmtFecha.format(fecha(h.fecha))}`, 'text-left'],
        [fmtNum.format(h.mediana), 'text-right'],
        [`${fmtNum.format(h.b50[0])}–${fmtNum.format(h.b50[1])}`, 'text-right'],
        [`${fmtNum.format(h.b95[0])}–${fmtNum.format(h.b95[1])}`, 'text-right'],
        [h.observado === null ? '—' : fmtNum.format(h.observado), 'text-right'],
        [dentroDe(h), 'text-left'],
      ];
      celdas.forEach(([texto, alinear], i) => {
        const td = document.createElement(i === 0 ? 'th' : 'td');
        if (i === 0) td.setAttribute('scope', 'row');
        td.className = `py-1.5 pr-3 font-normal ${alinear}`;
        td.textContent = texto;
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    }
    t.appendChild(tbody);
    wrap.appendChild(t);
    return wrap;
  }

  function notaAnio(modelo: ModeloContraste, anio: number): HTMLElement {
    const p = document.createElement('p');
    p.className = 'mt-3 font-sans text-xs leading-relaxed text-ink-muted';
    p.textContent = textoNotaAnio(modelo, anio);
    return p;
  }

  // --- montaje -----------------------------------------------------------------

  const LEYENDA = [
    { nombre: SERIE.publicado, muestra: 'continua' },
    { nombre: SERIE.mediana, muestra: 'punteada' },
    { nombre: SERIE.rango50, muestra: 'banda50' },
    { nombre: SERIE.rango95, muestra: 'banda95' },
    { nombre: SERIE.diferencia, muestra: 'segmento' },
  ] as const;

  function montar(
    sec: HTMLElement,
    cont: HTMLElement,
    modelo: ModeloContraste,
  ) {
    const selAnio = sec.querySelector<HTMLSelectElement>('[data-anio]')!;
    const rango = sec.querySelector<HTMLInputElement>('input[data-semana]')!;
    const salida = sec.querySelector<HTMLElement>('[data-semana-valor]')!;
    const btnAnt = sec.querySelector<HTMLButtonElement>('[data-anterior]')!;
    const btnSig = sec.querySelector<HTMLButtonElement>('[data-siguiente]')!;

    const anios = [...modelo.porAnio.keys()].sort((a, b) => a - b);
    selAnio.replaceChildren(
      ...anios.map((a) => {
        const op = document.createElement('option');
        op.value = String(a);
        op.textContent = String(a);
        return op;
      }),
    );

    const barraLeyenda = document.createElement('div');
    barraLeyenda.className = 'flex flex-wrap items-center gap-2';
    const contGrafica = document.createElement('div');
    contGrafica.className =
      'mt-2 overflow-hidden rounded-xl border border-border bg-bg p-2 sm:p-3';
    const lienzo = document.createElement('div');
    lienzo.className = 'h-[300px] w-full min-w-0 select-none sm:h-[360px]';
    lienzo.style.touchAction = 'pan-y';
    renderEsqueletoTraza(lienzo);
    contGrafica.appendChild(lienzo);
    const pista = document.createElement('p');
    pista.className =
      'mt-2 font-sans text-[11px] leading-relaxed text-ink-muted';
    const textoPista = () =>
      esMovil(lienzo)
        ? 'Cambia la semana de partida con el control deslizante o las flechas. Los segmentos unen la mediana de cada semana con el valor publicado.'
        : 'Arrastra sobre la gráfica para mover la semana de partida. Los segmentos unen la mediana de cada semana con el valor publicado.';
    const contResumen = document.createElement('div');
    contResumen.className = 'mt-3';
    const contTabla = document.createElement('div');
    const contNota = document.createElement('div');
    cont.replaceChildren(
      barraLeyenda,
      contGrafica,
      pista,
      contResumen,
      contTabla,
      contNota,
    );
    pista.textContent = textoPista();
    cont.removeAttribute('aria-busy');

    let actual = modelo.origenes[modelo.origenes.length - 1];
    let grafico: GraficoMontado | null = null;
    let anioGrafico: number | null = null;
    let anioDibujado: number | null = null;
    const visibles: Visibles = {};

    const construir = (t: Parameters<typeof opcionContraste>[0]) =>
      opcionContraste(t, modelo, actual, { movil: esMovil(lienzo), visibles });

    const dibujarGrafica = () => {
      if (!grafico) return;
      // el mismo año conserva la escala: la gráfica se transforma sin
      // repetir la entrada; otro año la dibuja de nuevo
      grafico.actualizar(construir, { suave: anioGrafico === actual.anio });
      anioGrafico = actual.anio;
    };

    const pintar = (idx: number) => {
      const o =
        modelo.origenes[Math.max(0, Math.min(idx, modelo.origenes.length - 1))];
      actual = o;
      const delAnio = modelo.porAnio.get(o.anio) ?? [o];
      selAnio.value = String(o.anio);
      rango.min = String(delAnio[0].semana);
      rango.max = String(delAnio[delAnio.length - 1].semana);
      rango.value = String(o.semana);
      const texto = `Semana ${o.semana} de ${o.anio}, ${fmtFecha.format(fecha(o.fecha))}`;
      rango.setAttribute('aria-valuetext', texto);
      salida.textContent = `S${o.semana} · ${fmtFecha.format(fecha(o.fecha))}`;
      btnAnt.disabled = o.idx === 0;
      btnSig.disabled = o.idx === modelo.origenes.length - 1;

      dibujarGrafica();
      contResumen.replaceChildren(resumenOrigen(modelo, o));
      contTabla.replaceChildren(
        o.horizontes ? tabla(o) : document.createElement('div'),
      );
      if (anioDibujado !== o.anio) {
        contNota.replaceChildren(notaAnio(modelo, o.anio));
        anioDibujado = o.anio;
      }

      const selectorSemana = document.getElementById(
        'contraste-nowcast-selector-semana',
      );
      selectorSemana?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: o.anio, semana: o.semana },
        }),
      );
    };

    selAnio.addEventListener('change', () => {
      const delAnio = modelo.porAnio.get(Number(selAnio.value));
      if (!delAnio?.length) return;
      // conserva la semana si existe en el año nuevo
      const misma = delAnio.find((o) => o.semana === actual.semana);
      pintar((misma ?? delAnio[delAnio.length - 1]).idx);
    });
    rango.addEventListener('input', () => {
      const delAnio = modelo.porAnio.get(actual.anio) ?? [];
      const o = delAnio.find((x) => x.semana === Number(rango.value));
      if (o) pintar(o.idx);
    });
    btnAnt.addEventListener('click', () => pintar(actual.idx - 1));
    btnSig.addEventListener('click', () => pintar(actual.idx + 1));

    const selectorSemana = document.getElementById(
      'contraste-nowcast-selector-semana',
    );
    selectorSemana?.addEventListener('cambio-semana', ((
      ev: CustomEvent<{ anio: number; semana: number }>,
    ) => {
      const { anio, semana: semElegida } = ev.detail;
      const o = modelo.origenes.find(
        (x) => x.anio === anio && x.semana === semElegida,
      );
      if (o) {
        pintar(o.idx);
      } else {
        const delAnio = modelo.porAnio.get(anio);
        if (delAnio?.length) {
          const masCercana = delAnio.reduce((prev, curr) =>
            Math.abs(curr.semana - semElegida) <
            Math.abs(prev.semana - semElegida)
              ? curr
              : prev,
          );
          pintar(masCercana.idx);
        }
      }
    }) as EventListener);

    // arrastrar sobre la gráfica: la semana de partida salta a la más cercana
    let arrastrando = false;
    const origenEnX = (clientX: number): number | null => {
      if (!grafico) return null;
      const caja = lienzo.getBoundingClientRect();
      const valor = grafico.instancia.convertFromPixel({ xAxisIndex: 0 }, [
        clientX - caja.left,
        caja.height / 2,
      ]);
      const t = Array.isArray(valor) ? Number(valor[0]) : Number(valor);
      if (!Number.isFinite(t)) return null;
      const delAnio = modelo.porAnio.get(actual.anio) ?? [actual];
      let mejor: number | null = null;
      let dist = Infinity;
      for (const o of delAnio) {
        const d = Math.abs(marcaTiempo(o.fecha) - t);
        if (d < dist) {
          dist = d;
          mejor = o.idx;
        }
      }
      return mejor;
    };
    const mover = (ev: PointerEvent) => {
      const idx = origenEnX(ev.clientX);
      if (idx !== null && idx !== actual.idx) pintar(idx);
    };
    contGrafica.addEventListener('pointerdown', (ev) => {
      // en pantalla estrecha la ventana se encuadra en la semana de partida:
      // arrastrar movería la gráfica bajo el dedo, así que solo hay controles
      if (esMovil(lienzo)) return;
      arrastrando = true;
      contGrafica.setPointerCapture(ev.pointerId);
      mover(ev);
    });
    contGrafica.addEventListener('pointermove', (ev) => {
      if (arrastrando) mover(ev);
    });
    const soltar = () => {
      arrastrando = false;
    };
    contGrafica.addEventListener('pointerup', soltar);
    contGrafica.addEventListener('pointercancel', soltar);

    for (const control of [selAnio, rango, btnAnt, btnSig])
      control.disabled = false;
    pintar(actual.idx);

    // la gráfica se monta aparte: los controles y el texto ya responden
    const idxAlPedir = actual.idx;
    void montarGrafico(
      lienzo,
      construir,
      `Casos de dengue observados y predicción de 1 a 8 semanas desde una semana de partida elegida. Los valores de la semana elegida están en la tabla siguiente.`,
    ).then((montado) => {
      grafico = montado;
      anioGrafico = actual.anio;
      lienzo.style.cursor = esMovil(lienzo) ? '' : 'ew-resize';
      if (!esMovil(lienzo))
        montado.instancia.getZr().setCursorStyle('ew-resize');
      alCruzarAnchoMovil(lienzo, () => {
        pista.textContent = textoPista();
        montado.actualizar(construir);
      });
      const leyenda = crearLeyenda(
        [...LEYENDA],
        visibles,
        (nombre: NombreSerie, visible: boolean) => {
          visibles[nombre] = visible;
          montado.instancia.dispatchAction({
            type: visible ? 'legendSelect' : 'legendUnSelect',
            name: nombre,
          });
        },
        (nombre) =>
          montado.instancia.dispatchAction({
            type: nombre ? 'highlight' : 'downplay',
            seriesName: nombre ?? undefined,
          }),
      );
      barraLeyenda.appendChild(leyenda.elemento);
      // la semana pudo cambiar mientras cargaba ECharts
      if (actual.idx !== idxAlPedir) montado.actualizar(construir);
    });
  }

  async function iniciar(sec: HTMLElement) {
    const cont = sec.querySelector<HTMLElement>('[data-contraste-cuerpo]');
    if (!cont) return;
    try {
      cont.setAttribute('aria-busy', 'true');
      const [retro, principal] = await Promise.all([
        obtenerNowcastRetrospectivo(),
        obtenerNowcastDengue(),
      ]);
      if (esNoDisponible(retro)) {
        renderSinDato(cont, motivoNoDisponible(retro));
        return;
      }
      const modelo = construirModelo(
        retro,
        esNoDisponible(principal) ? ({} as NowcastDengue) : principal,
      );
      if (!modelo) {
        renderSinDato(
          cont,
          'La predicción retrospectiva no está disponible todavía.',
        );
        return;
      }
      montar(sec, cont, modelo);
    } catch {
      renderErrorFuente(cont, () => void iniciar(sec));
    }
  }

  // Carga diferida: el componente vive al final de /prediccion y el
  // artefacto pesa unos cientos de KB; se pide al hacerse visible.
  for (const sec of document.querySelectorAll<HTMLElement>(
    '[data-contraste-nowcast]',
  )) {
    if (!('IntersectionObserver' in window)) {
      void iniciar(sec);
      continue;
    }
    const obs = new IntersectionObserver((entradas) => {
      if (entradas.some((e) => e.isIntersecting)) {
        obs.disconnect();
        void iniciar(sec);
      }
    });
    obs.observe(sec);
  }
</script>
