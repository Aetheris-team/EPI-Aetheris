---
interface Enlace {
  href: string;
  etiqueta: string;
}

interface Props {
  etiqueta: string;
  enlaces: Enlace[];
  class?: string;
}

const { etiqueta, enlaces, class: clasePersonalizada = 'mb-6' } = Astro.props;
---

<nav
  class:list={['flex flex-wrap gap-2 font-sans text-sm', clasePersonalizada]}
  aria-label={etiqueta}
  data-nav-secciones
>
  {
    enlaces.map((enlace) => (
      <a
        href={enlace.href}
        class="inline-flex min-h-[44px] items-center rounded-full border border-border bg-surface px-3 py-1.5 transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        {enlace.etiqueta}
      </a>
    ))
  }
</nav>
