---
import Icono from './Icono.astro';
import PanelWorkspace from './analisis/PanelWorkspace.astro';
interface Props {
  evento?: 'ira' | 'neumonias';
}
const evento = Astro.props.evento ?? 'ira';
const etiqueta = evento === 'neumonias' ? 'neumonías' : 'IRA';
const endpoint =
  evento === 'neumonias'
    ? '/api/neumonias/departamental'
    : '/api/ira/departamental';
---

<PanelWorkspace
  tipo="visor"
  titulo={`Mapa departamental de ${etiqueta}`}
  descripcion="Volumen acumulado de casos notificados por departamento (MINSAL, 2018-2023, sin 2020). Unidad: conteo notificado."
  data-mapa-evento={evento}
  data-mapa-endpoint={endpoint}
>
  <div
    class="mt-4 flex gap-2 rounded-lg border border-dashed border-border bg-bg p-3"
  >
    <Icono nombre="list-details" class="mt-0.5 h-4 w-4 text-accent" />
    <p class="font-sans text-xs leading-relaxed text-ink-muted">
      <strong class="font-semibold text-ink">Cómo leer el color:</strong> más oscuro
      = más casos notificados acumulados en la ventana cargada. Los huecos de la fuente
      hacen que una sola semana no sea representativa; el color agrega toda la ventana
      cargada.
    </p>
  </div>

  <div
    data-mapa-vacio
    class="mt-3 hidden rounded-lg border border-secondary bg-secondary/25 p-3"
  >
    <p data-mapa-vacio-texto class="font-sans text-sm text-ink">
      No se pudo cargar el mapa porque la fuente de datos no responde. No se
      muestra ningún dato sustituto. Recarga la página para reintentarlo.
    </p>
  </div>

  <div
    data-mapa-canvas
    role="region"
    aria-label={`Mapa departamental de ${etiqueta}`}
    aria-busy="true"
    class="mt-4 h-[300px] w-full overflow-hidden rounded-xl border border-border shadow-inner sm:h-[420px] lg:h-[540px]"
  >
    <div class="skeleton h-full w-full" aria-hidden="true"></div>
  </div>
  <div
    class="mt-3 flex items-center gap-2 rounded-lg border border-border/80 bg-surface px-3 py-2 shadow-2xs"
  >
    <Icono nombre="map-pin" class="h-4 w-4 shrink-0 text-accent" />
    <p
      data-mapa-seleccion
      role="status"
      aria-live="polite"
      class="font-sans text-xs font-medium text-ink"
    >
      Elige un departamento en el mapa para ver su curva y su fila en el mapa de
      calor.
    </p>
  </div>
  <div data-mapa-leyenda class="mt-3"></div>

  <details class="mt-3 rounded-xl border border-border bg-bg p-3">
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted"
    >
      Ver los valores por departamento en una tabla
    </summary>
    <div class="mt-2 overflow-x-auto">
      <table
        data-mapa-tabla
        class="w-full border-collapse font-sans text-xs tabular-nums text-ink"
      >
        <caption class="sr-only"
          >Casos "notificado" acumulados de {etiqueta} por departamento, 2018-2023</caption
        >
        <thead>
          <tr class="text-left text-ink-muted">
            <th scope="col" class="border-b border-border py-1 pr-4"
              >Departamento</th
            >
            <th scope="col" class="border-b border-border py-1"
              >Notificado (acum.)</th
            >
          </tr>
        </thead>
        <tbody data-mapa-tabla-cuerpo></tbody>
      </table>
    </div>
  </details>
</PanelWorkspace>

<style>
  :global(.leaflet-container) {
    font-family: var(--font-sans);
    background: var(--color-bg);
    /* Ver MapaDepartamentos.astro: confina el z-index:1000 de los controles
       de Leaflet dentro de su propio contexto de apilamiento, para que no
       compita contra el z-40 del header sticky de Layout.astro. */
    isolation: isolate;
  }
  :global(.leaflet-control-zoom) {
    border: 1px solid var(--color-border) !important;
    box-shadow: var(--shadow-card) !important;
  }
  :global(.leaflet-control-zoom a) {
    color: var(--color-accent) !important;
    background-color: var(--color-surface) !important;
  }
  :global(.leaflet-control-zoom a:hover) {
    background-color: var(--color-secondary) !important;
  }
  :global(.leaflet-tooltip) {
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink);
    padding: 6px 10px;
  }
</style>

<script>
  // Leaflet se carga de forma perezosa (mismo patrón que
  // MapaDepartamentos.astro): /respiratorio monta dos instancias de este
  // componente, así que el bundle eager metía ~140KB en la ruta crítica. El
  // "?url" del CSS evita que Vite lo inyecte en el <head> del primer HTML; el
  // <link> se crea a mano justo antes de instanciar el mapa.
  import type Leaflet from 'leaflet';
  import leafletCssHref from 'leaflet/dist/leaflet.css?url';
  import { escapeHtml } from '../utils/security';
  import { DEPARTAMENTOS_POR_CODIGO } from '../lib/departamentos';
  import {
    actualizarFiltrosRespiratorio,
    obtenerFiltrosRespiratorio,
    suscribirFiltrosRespiratorio,
  } from '../lib/respiratorio-state';
  import { esNoDisponible, motivoNoDisponible } from './estado-async';
  import { protegerScrollMapa } from '../lib/mapa-scroll';

  function cargarCssLeaflet() {
    if (document.querySelector(`link[href="${leafletCssHref}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = leafletCssHref;
    document.head.appendChild(link);
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const SIN_DATO = '#e4e4e7';
  // Mismo family de la marca que la capa de volumen MINSAL de dengue, para
  // que "más oscuro = más casos" se lea igual en ambos mapas.
  const RAMPA = ['#cde2fb', '#9ec5f4', '#5598e7', '#256abf', '#0d366b'];

  // El shapeName del geojson (geoBoundaries) es inconsistente: 12 de los 14
  // departamentos traen el prefijo "Departamento de ..." pero La Libertad y
  // San Vicente no -- se normaliza en un solo lugar (mismo criterio que
  // MapaDepartamentos.astro e index.astro).
  function normalizarNombreDepto(shapeName: string): string {
    return shapeName.replace(/^Departamento de /, '');
  }

  interface DatoDepartamentoIra {
    nombre: string;
    codigo: string;
    notificado_total: number;
    semanas_con_dato: number;
    primer_anio: number | null;
    ultimo_anio: number | null;
  }

  function cortesPorCuantiles(valores: number[]): number[] {
    const ordenados = [...valores].sort((a, b) => a - b);
    if (ordenados.length === 0) return [1, 2, 3, 4];
    const corte = (p: number) =>
      ordenados[
        Math.min(ordenados.length - 1, Math.floor(p * (ordenados.length - 1)))
      ];
    return [corte(0.2), corte(0.4), corte(0.6), corte(0.8)];
  }

  function colorPorValor(valor: number | undefined, cortes: number[]): string {
    if (valor === undefined) return SIN_DATO;
    for (let i = 0; i < cortes.length; i++) {
      if (valor <= cortes[i]) return RAMPA[i];
    }
    return RAMPA[RAMPA.length - 1];
  }

  function dibujarLeyenda(contenedor: HTMLElement, cortes: number[]) {
    const rangos = [
      `1–${cortes[0]}`,
      `${cortes[0] + 1}–${cortes[1]}`,
      `${cortes[1] + 1}–${cortes[2]}`,
      `${cortes[2] + 1}–${cortes[3]}`,
      `> ${cortes[3]}`,
    ];
    const item = (color: string, etiqueta: string) =>
      `<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2 py-1">` +
      `<span style="background:${color}" class="inline-block h-2.5 w-2.5 rounded-full ring-1 ring-black/5"></span>` +
      `<span class="font-mono text-[11px] text-ink-muted">${escapeHtml(etiqueta)}</span></span>`;
    const items = RAMPA.map((color, i) => item(color, rangos[i])).join('');
    contenedor.innerHTML = `
      <div class="flex flex-wrap items-center gap-1.5 font-sans text-xs text-ink-muted">
        <span class="mr-1 font-medium text-ink">Casos "notificado" acumulados 2018-2023:</span>
        ${items}
        ${item(SIN_DATO, 'sin dato')}
      </div>
    `;
  }

  // Máscara visual: un rectángulo enorme con un "agujero" recortado por
  // cada departamento (SVG fill-rule evenodd, soportado nativamente por
  // L.Polygon con múltiples anillos). No evita las peticiones de tiles de
  // países vecinos -- son ráster de OpenStreetMap, no hay forma de pedir
  // "sin Guatemala/Honduras" a ese proveedor -- pero atenúa visualmente
  // todo lo que no sea El Salvador, incluyendo los nombres de lugar que
  // trae el tile, para que la atención quede en el país que sí cubre el
  // proyecto.
  const ANILLO_MUNDO: [number, number][] = [
    [-85, -170],
    [-85, 10],
    [85, 10],
    [85, -170],
  ];

  function construirMascara(geojson: any): [number, number][][] {
    const agujeros: [number, number][][] = [];
    for (const f of geojson.features) {
      const partes =
        f.geometry.type === 'Polygon'
          ? [f.geometry.coordinates]
          : f.geometry.coordinates;
      for (const poligono of partes) {
        agujeros.push(
          poligono[0].map(([lon, lat]: [number, number]) => [lat, lon]),
        );
      }
    }
    return [ANILLO_MUNDO, ...agujeros];
  }

  async function iniciarSeccion(seccion: HTMLElement) {
    cargarCssLeaflet();
    const L: typeof Leaflet = (await import('leaflet')).default;
    const contenedorMapa = seccion.querySelector(
      '[data-mapa-canvas]',
    ) as HTMLElement | null;
    const contenedorLeyenda = seccion.querySelector(
      '[data-mapa-leyenda]',
    ) as HTMLElement | null;
    const contenedorNoDisponible = seccion.querySelector(
      '[data-mapa-vacio]',
    ) as HTMLElement | null;
    const tablaCuerpo = seccion.querySelector('[data-mapa-tabla-cuerpo]');
    const endpoint = seccion.dataset.mapaEndpoint ?? '/api/ira/departamental';
    if (!contenedorMapa || !contenedorLeyenda || !contenedorNoDisponible)
      return;

    function pintarTablaValores(detalles: Map<string, DatoDepartamentoIra>) {
      if (!tablaCuerpo) return;
      tablaCuerpo.innerHTML = '';
      const filas = (
        geojson.features as {
          properties?: { codigo?: string; shapeName?: string };
        }[]
      )
        .map((feature) => {
          const codigo = feature.properties?.codigo ?? '';
          const nombre = feature.properties?.shapeName
            ? normalizarNombreDepto(feature.properties.shapeName)
            : codigo;
          return { nombre, dato: detalles.get(codigo) };
        })
        .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
      for (const fila of filas) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.className = 'border-b border-border py-1 pr-4 text-left font-normal';
        th.textContent = fila.nombre;
        const td = document.createElement('td');
        td.className = 'border-b border-border py-1';
        td.textContent = fila.dato
          ? String(fila.dato.notificado_total)
          : 'sin dato';
        tr.append(th, td);
        tablaCuerpo.appendChild(tr);
      }
    }

    // Selección compartida con las curvas y el mapa de calor (estado en la URL).
    const anuncio = seccion.querySelector('[data-mapa-seleccion]');
    let capaGeo: Leaflet.GeoJSON | null = null;

    function anunciarSeleccion(codigo: string) {
      const nombre = DEPARTAMENTOS_POR_CODIGO[codigo]?.nombre ?? codigo;
      if (anuncio)
        anuncio.textContent = `Departamento seleccionado: ${nombre}. Las curvas y el mapa de calor lo muestran.`;
    }

    function resaltar(codigoActivo: string) {
      capaGeo?.eachLayer((capa) => {
        const ruta = capa as Leaflet.Path & {
          feature?: { properties?: { codigo?: string } };
          bringToFront?: () => void;
        };
        const activa = ruta.feature?.properties?.codigo === codigoActivo;
        ruta.setStyle({
          color: activa ? 'var(--color-seleccion)' : '#8a8a90',
          weight: activa ? 3 : 1,
        });
        if (activa) ruta.bringToFront?.();
      });
    }

    function vincularSeleccion(
      capa: Leaflet.Layer,
      codigo: string,
      nombre: string,
    ) {
      const seleccionar = () => {
        actualizarFiltrosRespiratorio({ departamento: codigo });
        // Si ya estaba elegido no hay evento: se anuncia igual.
        anunciarSeleccion(codigo);
      };
      capa.on('click', seleccionar);
      capa.on('add', () => {
        const elemento = (capa as Leaflet.Path).getElement();
        if (!elemento) return;
        elemento.setAttribute('tabindex', '0');
        elemento.setAttribute('role', 'button');
        elemento.setAttribute('aria-label', `Seleccionar ${nombre}`);
        elemento.addEventListener('keydown', (evento: KeyboardEvent) => {
          if (evento.key !== 'Enter' && evento.key !== ' ') return;
          evento.preventDefault();
          seleccionar();
        });
      });
    }

    // Límites duros a El Salvador (mismo bbox que MapaDepartamentos.astro) --
    // sin esto, un scroll de más con la rueda del mouse manda a ver
    // Guatemala u Honduras, que el proyecto todavía no cubre.
    const LIMITES_SV = L.latLngBounds([12.95, -90.35], [14.65, -87.45]);
    // Con departamentos como unidad no hay nada que ver más cerca de 10.
    const MAX_ZOOM = 10;
    contenedorMapa.innerHTML = '';
    contenedorMapa.removeAttribute('aria-busy');
    const mapa = L.map(contenedorMapa, {
      minZoom: 8,
      maxZoom: MAX_ZOOM,
      maxBounds: LIMITES_SV,
      maxBoundsViscosity: 1.0,
    }).setView([13.79, -88.9], 8);
    protegerScrollMapa(contenedorMapa);
    mapa.whenReady(() => {
      mapa.invalidateSize();
    });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; colaboradores de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: MAX_ZOOM,
    }).addTo(mapa);

    const respGeo = await fetch('/geo/slv-adm1.geojson');
    const geojson = await respGeo.json();

    L.polygon(construirMascara(geojson), {
      stroke: false,
      fillColor: '#f0f0f0',
      fillOpacity: 0.85,
      interactive: false,
    }).addTo(mapa);

    let detalles = new Map<string, DatoDepartamentoIra>();
    let valores: Map<string, number | undefined> | null = null;

    try {
      const resp = await fetch(`${API_BASE}${endpoint}`);
      if (!resp.ok) throw new Error('respuesta no OK');
      const datos: { departamentos: DatoDepartamentoIra[] } | unknown =
        await resp.json();
      if (esNoDisponible(datos)) {
        const texto = contenedorNoDisponible.querySelector(
          '[data-mapa-vacio-texto]',
        );
        if (texto) texto.textContent = motivoNoDisponible(datos);
        valores = null;
      } else {
        const cuerpo = datos as { departamentos: DatoDepartamentoIra[] };
        detalles = new Map(cuerpo.departamentos.map((d) => [d.codigo, d]));
        valores = new Map(
          cuerpo.departamentos.map((d) => [
            d.codigo,
            d.notificado_total > 0 ? d.notificado_total : undefined,
          ]),
        );
      }
    } catch {
      valores = null;
    }

    if (!valores) {
      contenedorNoDisponible.classList.remove('hidden');
      pintarTablaValores(detalles);
      L.geoJSON(geojson, {
        style: () => ({
          color: '#8a8a90',
          weight: 1,
          fillColor: SIN_DATO,
          fillOpacity: 0.5,
        }),
        onEachFeature: (feature, layer) => {
          const nombre = feature.properties?.shapeName
            ? normalizarNombreDepto(feature.properties.shapeName)
            : (feature.properties?.codigo ?? '');
          layer.bindTooltip(
            `<strong>${escapeHtml(nombre)}</strong><br>mapa no disponible todavía`,
          );
        },
      }).addTo(mapa);
      return;
    }

    const numericos = [...valores.values()].filter(
      (v): v is number => v !== undefined,
    );
    const cortes = cortesPorCuantiles(numericos);
    dibujarLeyenda(contenedorLeyenda, cortes);
    pintarTablaValores(detalles);

    capaGeo = L.geoJSON(geojson, {
      style: (feature) => {
        const codigo = feature?.properties?.codigo ?? '';
        return {
          color: '#8a8a90',
          weight: 1,
          fillColor: colorPorValor(valores!.get(codigo), cortes),
          fillOpacity: 0.75,
        };
      },
      onEachFeature: (feature, layer) => {
        const codigo = feature.properties?.codigo ?? '';
        const nombre = feature.properties?.shapeName
          ? normalizarNombreDepto(feature.properties.shapeName)
          : codigo;
        vincularSeleccion(layer, codigo, nombre);
        const dato = detalles.get(codigo);
        if (!dato) {
          layer.bindTooltip(nombre);
          return;
        }
        const ventana =
          dato.primer_anio && dato.ultimo_anio
            ? `${dato.primer_anio}-${dato.ultimo_anio}`
            : 'sin dato';
        layer.bindTooltip(
          `<strong>${escapeHtml(nombre)}</strong><br>` +
            `Notificado (acum.): ${dato.notificado_total}<br>` +
            `Semanas con dato: ${dato.semanas_con_dato}<br>` +
            `Ventana: ${escapeHtml(ventana)}`,
        );
      },
    }).addTo(mapa);

    resaltar(obtenerFiltrosRespiratorio().departamento);
    suscribirFiltrosRespiratorio((f) => {
      resaltar(f.departamento);
      anunciarSeleccion(f.departamento);
    }, false);
  }

  document
    .querySelectorAll<HTMLElement>('[data-mapa-evento]')
    .forEach((seccion) => {
      void iniciarSeccion(seccion).catch(() => {
        seccion.querySelector('[data-mapa-vacio]')?.classList.remove('hidden');
      });
    });
</script>
