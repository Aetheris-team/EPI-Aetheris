---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Icono from './Icono.astro';
import PanelWorkspace from './analisis/PanelWorkspace.astro';
import { proyectarDepartamentos, type GeoDepartamentos } from '../lib/geo-svg';
import { DEPARTAMENTOS_POR_CODIGO } from '../lib/departamentos';

interface Props {
  evento?: 'ira' | 'neumonias';
}
const evento = Astro.props.evento ?? 'ira';
const etiqueta = evento === 'neumonias' ? 'neumonías' : 'IRA';
const endpoint =
  evento === 'neumonias'
    ? '/api/neumonias/departamental'
    : '/api/ira/departamental';

const geo = JSON.parse(
  readFileSync(join(process.cwd(), 'public/geo/slv-adm1.geojson'), 'utf8'),
) as GeoDepartamentos;

const mapaSvg = proyectarDepartamentos(geo, 700, 14, 0.4);
---

<PanelWorkspace
  tipo="visor"
  titulo={`Mapa departamental de ${etiqueta}`}
  descripcion="Volumen acumulado de casos notificados por departamento (MINSAL, 2018-2023, sin 2020). Unidad: conteo notificado."
  data-mapa-evento={evento}
  data-mapa-endpoint={endpoint}
>
  <div
    class="mt-4 flex gap-2 rounded-lg border border-dashed border-border bg-bg p-3"
  >
    <Icono nombre="list-details" class="mt-0.5 h-4 w-4 text-accent" />
    <p class="font-sans text-xs leading-relaxed text-ink-muted">
      <strong class="font-semibold text-ink">Cómo leer el color:</strong> más oscuro
      = más casos notificados acumulados en la ventana cargada. Los huecos de la fuente
      hacen que una sola semana no sea representativa; el color agrega toda la ventana
      cargada.
    </p>
  </div>

  <div
    data-mapa-vacio
    class="mt-3 hidden rounded-lg border border-secondary bg-secondary/25 p-3"
  >
    <p data-mapa-vacio-texto class="font-sans text-sm text-ink">
      No se pudo cargar el mapa porque la fuente de datos no responde. No se
      muestra ningún dato sustituto. Recarga la página para reintentarlo.
    </p>
  </div>

  <div
    data-mapa-canvas
    role="region"
    aria-label={`Mapa departamental de ${etiqueta}`}
    class="relative mt-4 flex h-[320px] w-full items-center justify-center overflow-hidden rounded-xl border border-border bg-bg/30 shadow-inner sm:h-[420px] lg:h-[520px]"
  >
    <svg
      viewBox={`0 0 ${mapaSvg.ancho} ${mapaSvg.alto}`}
      role="group"
      aria-label={`Mapa coroplético departamental de ${etiqueta}`}
      class="h-full w-full max-h-[500px] select-none p-2 sm:p-4 drop-shadow-2xs"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <filter
          id={`mapa-sombra-hover-${evento}`}
          x="-10%"
          y="-10%"
          width="120%"
          height="120%"
        >
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.25"
          ></feDropShadow>
        </filter>
      </defs>

      <g role="group" aria-label="Departamentos de El Salvador">
        {
          mapaSvg.departamentos.map((d) => {
            const nombre =
              d.nombre ??
              DEPARTAMENTOS_POR_CODIGO[d.codigo]?.nombre ??
              d.codigo;
            return (
              <path
                d={d.d}
                data-codigo={d.codigo}
                data-departamento={d.codigo}
                data-nombre={nombre}
                tabindex="0"
                role="button"
                aria-label={`Seleccionar ${nombre}`}
                aria-pressed="false"
                class="mapa-ira-path cursor-pointer stroke-border focus:outline-none"
                style="fill: var(--color-surface); stroke: #8a8a90; stroke-width: 1.2px; stroke-linejoin: round; transition: fill 0.35s ease, stroke 0.2s ease, stroke-width 0.2s ease;"
              />
            );
          })
        }
      </g>
      <g class="pointer-events-none">
        {
          mapaSvg.departamentos.map((d) => {
            const nombre =
              d.nombre ??
              DEPARTAMENTOS_POR_CODIGO[d.codigo]?.nombre ??
              d.codigo;
            const corta =
              d.abreviatura ?? d.codigoCorto ?? d.codigo.replace(/^SV-/, '');
            return (
              <text
                x={d.centroX}
                y={d.centroY}
                text-anchor="middle"
                dominant-baseline="central"
                class="mapa-ira-etiqueta font-sans text-[10px] font-semibold tracking-tight fill-ink select-none"
                style="paint-order: stroke; stroke: var(--color-surface); stroke-width: 2.5px; stroke-linejoin: round;"
              >
                <tspan class="etiqueta-larga">{nombre}</tspan>
                <tspan class="etiqueta-corta">{corta}</tspan>
              </text>
            );
          })
        }
      </g>
    </svg>

    <!-- Tooltip flotante enriquecido -->
    <div
      data-mapa-tooltip
      role="tooltip"
      aria-hidden="true"
      class="pointer-events-none absolute z-20 hidden -translate-x-1/2 -translate-y-full rounded-lg border border-border bg-surface px-3 py-2 text-xs font-sans shadow-md backdrop-blur-xs transition-opacity duration-150 leading-relaxed text-ink"
    >
    </div>
  </div>

  <div
    class="mt-3 flex items-center gap-2 rounded-lg border border-border/80 bg-surface px-3 py-2 shadow-2xs"
  >
    <Icono nombre="map-pin" class="h-4 w-4 shrink-0 text-accent" />
    <p
      data-mapa-seleccion
      role="status"
      aria-live="polite"
      class="font-sans text-xs font-medium text-ink"
    >
      Elige un departamento en el mapa para ver su curva y su fila en el mapa de
      calor.
    </p>
  </div>
  <div data-mapa-leyenda class="mt-3"></div>

  <details class="mt-3 rounded-xl border border-border bg-bg p-3">
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted"
    >
      Ver los valores por departamento en una tabla
    </summary>
    <div class="mt-2 overflow-x-auto">
      <table
        data-mapa-tabla
        class="w-full border-collapse font-sans text-xs tabular-nums text-ink"
      >
        <caption class="sr-only"
          >Casos "notificado" acumulados de {etiqueta} por departamento, 2018-2023</caption
        >
        <thead>
          <tr class="text-left text-ink-muted">
            <th scope="col" class="border-b border-border py-1 pr-4"
              >Departamento</th
            >
            <th scope="col" class="border-b border-border py-1"
              >Notificado (acum.)</th
            >
          </tr>
        </thead>
        <tbody data-mapa-tabla-cuerpo></tbody>
      </table>
    </div>
  </details>
</PanelWorkspace>

<style>
  .mapa-ira-path:hover {
    stroke: var(--color-ink) !important;
    stroke-width: 1.8px !important;
    filter: brightness(1.06);
  }

  .mapa-ira-path:focus-visible {
    outline: none;
    stroke: var(--color-accent) !important;
    stroke-width: 2.2px !important;
    filter: drop-shadow(0 0 4px var(--focus-ring));
  }

  .mapa-ira-path.seleccionado {
    stroke: var(--color-seleccion, #040316) !important;
    stroke-width: 2.5px !important;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.25));
  }

  .etiqueta-corta {
    display: none;
  }

  @media (max-width: 640px) {
    .etiqueta-larga {
      display: none;
    }
    .etiqueta-corta {
      display: inline;
      font-size: 8.5px;
      font-weight: 700;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mapa-ira-path {
      transition: none !important;
    }
  }
</style>

<script>
  import { escapeHtml } from '../utils/security';
  import {
    DEPARTAMENTOS,
    DEPARTAMENTOS_POR_CODIGO,
  } from '../lib/departamentos';
  import {
    actualizarFiltrosRespiratorio,
    obtenerFiltrosRespiratorio,
    suscribirFiltrosRespiratorio,
  } from '../lib/respiratorio-state';
  import { esNoDisponible, motivoNoDisponible } from './estado-async';

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const SIN_DATO = '#e4e4e7';
  const RAMPA = ['#cde2fb', '#9ec5f4', '#5598e7', '#256abf', '#0d366b'];

  interface DatoDepartamentoIra {
    nombre: string;
    codigo: string;
    notificado_total: number;
    semanas_con_dato: number;
    primer_anio: number | null;
    ultimo_anio: number | null;
  }

  function cortesPorCuantiles(valores: number[]): number[] {
    const ordenados = [...valores].sort((a, b) => a - b);
    if (ordenados.length === 0) return [1, 2, 3, 4];
    const corte = (p: number) =>
      ordenados[
        Math.min(ordenados.length - 1, Math.floor(p * (ordenados.length - 1)))
      ];
    return [corte(0.2), corte(0.4), corte(0.6), corte(0.8)];
  }

  function colorPorValor(valor: number | undefined, cortes: number[]): string {
    if (valor === undefined) return SIN_DATO;
    for (let i = 0; i < cortes.length; i++) {
      if (valor <= cortes[i]) return RAMPA[i];
    }
    return RAMPA[RAMPA.length - 1];
  }

  function dibujarLeyenda(contenedor: HTMLElement, cortes: number[]) {
    const rangos = [
      `1–${cortes[0]}`,
      `${cortes[0] + 1}–${cortes[1]}`,
      `${cortes[1] + 1}–${cortes[2]}`,
      `${cortes[2] + 1}–${cortes[3]}`,
      `> ${cortes[3]}`,
    ];
    const item = (color: string, etiqueta: string) =>
      `<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2 py-1">` +
      `<span style="background:${color}" class="inline-block h-2.5 w-2.5 rounded-full ring-1 ring-black/5"></span>` +
      `<span class="font-mono text-[11px] text-ink-muted">${escapeHtml(etiqueta)}</span></span>`;
    const items = RAMPA.map((color, i) => item(color, rangos[i])).join('');
    contenedor.innerHTML = `
      <div class="flex flex-wrap items-center gap-1.5 font-sans text-xs text-ink-muted">
        <span class="mr-1 font-medium text-ink">Casos "notificado" acumulados 2018-2023:</span>
        ${items}
        ${item(SIN_DATO, 'sin dato')}
      </div>
    `;
  }

  async function iniciarSeccion(seccion: HTMLElement) {
    const contenedorCanvas = seccion.querySelector(
      '[data-mapa-canvas]',
    ) as HTMLElement | null;
    const svgElement = contenedorCanvas?.querySelector(
      'svg',
    ) as SVGSVGElement | null;
    const contenedorLeyenda = seccion.querySelector(
      '[data-mapa-leyenda]',
    ) as HTMLElement | null;
    const contenedorNoDisponible = seccion.querySelector(
      '[data-mapa-vacio]',
    ) as HTMLElement | null;
    const tablaCuerpo = seccion.querySelector('[data-mapa-tabla-cuerpo]');
    const anuncio = seccion.querySelector('[data-mapa-seleccion]');
    const tooltip = seccion.querySelector(
      '[data-mapa-tooltip]',
    ) as HTMLElement | null;
    const endpoint = seccion.dataset.mapaEndpoint ?? '/api/ira/departamental';

    if (
      !contenedorCanvas ||
      !contenedorLeyenda ||
      !contenedorNoDisponible ||
      !svgElement
    )
      return;

    const paths = Array.from(
      seccion.querySelectorAll<SVGPathElement>('path[data-codigo]'),
    );

    function pintarTablaValores(detalles: Map<string, DatoDepartamentoIra>) {
      if (!tablaCuerpo) return;
      tablaCuerpo.innerHTML = '';
      const filas = DEPARTAMENTOS.map((dep) => ({
        nombre: dep.nombre,
        dato: detalles.get(dep.codigo),
      })).sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

      for (const fila of filas) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.className = 'border-b border-border py-1 pr-4 text-left font-normal';
        th.textContent = fila.nombre;
        const td = document.createElement('td');
        td.className = 'border-b border-border py-1';
        td.textContent = fila.dato
          ? String(fila.dato.notificado_total)
          : 'sin dato';
        tr.append(th, td);
        tablaCuerpo.appendChild(tr);
      }
    }

    function anunciarSeleccion(codigo: string) {
      const nombre = DEPARTAMENTOS_POR_CODIGO[codigo]?.nombre ?? codigo;
      if (anuncio)
        anuncio.textContent = `Departamento seleccionado: ${nombre}. Las curvas y el mapa de calor lo muestran.`;
    }

    function resaltar(codigoActivo: string) {
      paths.forEach((ruta) => {
        const activa = ruta.dataset.codigo === codigoActivo;
        ruta.style.stroke = activa
          ? 'var(--color-seleccion, #040316)'
          : '#8a8a90';
        ruta.style.strokeWidth = activa ? '2.5px' : '1.2px';
        if (activa) {
          ruta.classList.add('seleccionado');
          ruta.setAttribute('aria-pressed', 'true');
          ruta.parentElement?.appendChild(ruta);
        } else {
          ruta.classList.remove('seleccionado');
          ruta.setAttribute('aria-pressed', 'false');
        }
      });
    }

    function posicionarTooltip(e: MouseEvent) {
      if (!tooltip) return;
      const rect = contenedorCanvas!.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top - 12;
      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
    }

    let detalles = new Map<string, DatoDepartamentoIra>();
    let valores: Map<string, number | undefined> | null = null;

    try {
      const resp = await fetch(`${API_BASE}${endpoint}`);
      if (!resp.ok) throw new Error('respuesta no OK');
      const datos: { departamentos: DatoDepartamentoIra[] } | unknown =
        await resp.json();
      if (esNoDisponible(datos)) {
        const texto = contenedorNoDisponible.querySelector(
          '[data-mapa-vacio-texto]',
        );
        if (texto) texto.textContent = motivoNoDisponible(datos);
        valores = null;
      } else {
        const cuerpo = datos as { departamentos: DatoDepartamentoIra[] };
        detalles = new Map(cuerpo.departamentos.map((d) => [d.codigo, d]));
        valores = new Map(
          cuerpo.departamentos.map((d) => [d.codigo, d.notificado_total]),
        );
      }
    } catch {
      valores = null;
    }

    if (!valores) {
      contenedorNoDisponible.classList.remove('hidden');
      pintarTablaValores(detalles);
      paths.forEach((ruta) => {
        ruta.style.fill = SIN_DATO;
        ruta.style.fillOpacity = '0.5';
      });
      return;
    }

    const numericos = [...valores.values()].filter(
      (v): v is number => v !== undefined,
    );
    const cortes = cortesPorCuantiles(numericos);
    dibujarLeyenda(contenedorLeyenda, cortes);
    pintarTablaValores(detalles);

    paths.forEach((ruta) => {
      const codigo = ruta.dataset.codigo ?? '';
      const nombre = ruta.dataset.nombre ?? codigo;
      const valor = valores?.get(codigo);
      const color = colorPorValor(valor, cortes);
      ruta.style.fill = color;
      ruta.style.fillOpacity = '0.85';

      const seleccionar = () => {
        actualizarFiltrosRespiratorio({ departamento: codigo });
        anunciarSeleccion(codigo);
      };

      ruta.addEventListener('click', seleccionar);
      ruta.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          seleccionar();
        }
      });

      const dato = detalles.get(codigo);
      const ventana =
        dato?.primer_anio && dato?.ultimo_anio
          ? `${dato.primer_anio}-${dato.ultimo_anio}`
          : 'sin dato';

      const textoTooltip = dato
        ? `<strong>${escapeHtml(nombre)}</strong><br>` +
          `Notificado (acum.): ${dato.notificado_total}<br>` +
          `Semanas con dato: ${dato.semanas_con_dato}<br>` +
          `Ventana: ${escapeHtml(ventana)}`
        : `<strong>${escapeHtml(nombre)}</strong><br>sin dato`;

      ruta.addEventListener('mouseenter', (e) => {
        if (!tooltip) return;
        tooltip.innerHTML = textoTooltip;
        tooltip.classList.remove('hidden');
        tooltip.setAttribute('aria-hidden', 'false');
        posicionarTooltip(e);
      });

      ruta.addEventListener('mousemove', (e) => {
        posicionarTooltip(e);
      });

      ruta.addEventListener('mouseleave', () => {
        tooltip?.classList.add('hidden');
        tooltip?.setAttribute('aria-hidden', 'true');
      });

      ruta.addEventListener('focus', () => {
        if (!tooltip || !svgElement) return;
        tooltip.innerHTML = textoTooltip;
        tooltip.classList.remove('hidden');
        tooltip.setAttribute('aria-hidden', 'false');
        const rect = contenedorCanvas!.getBoundingClientRect();
        const svgRect = svgElement.getBoundingClientRect();
        const bbox = ruta.getBBox();
        const viewBox = svgElement.viewBox.baseVal;
        const x =
          svgRect.left -
          rect.left +
          (bbox.x + bbox.width / 2) * (svgRect.width / viewBox.width);
        const y =
          svgRect.top -
          rect.top +
          (bbox.y + bbox.height * 0.3) * (svgRect.height / viewBox.height);
        tooltip.style.left = `${x}px`;
        tooltip.style.top = `${y}px`;
      });

      ruta.addEventListener('blur', () => {
        tooltip?.classList.add('hidden');
        tooltip?.setAttribute('aria-hidden', 'true');
      });
    });

    resaltar(obtenerFiltrosRespiratorio().departamento);
    suscribirFiltrosRespiratorio((f) => {
      resaltar(f.departamento);
      anunciarSeleccion(f.departamento);
    }, false);
  }

  document
    .querySelectorAll<HTMLElement>('[data-mapa-evento]')
    .forEach((seccion) => {
      void iniciarSeccion(seccion).catch(() => {
        seccion.querySelector('[data-mapa-vacio]')?.classList.remove('hidden');
      });
    });
</script>
