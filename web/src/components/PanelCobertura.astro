---
import PanelWorkspace from './analisis/PanelWorkspace.astro';
// Cobertura de la ingesta respiratoria. No es M4.
---

<PanelWorkspace
  tipo="registro"
  titulo="Cobertura y calidad de la fuente"
  descripcion="Mide cuántas semanas del año tienen dato cargado en la base, frente a las 52 nominales."
  data-cobertura
>
  <div
    data-cob-error
    role="status"
    class="mt-3 hidden rounded-lg border border-secondary bg-secondary/25 p-3 font-sans text-sm"
  >
    <p class="text-ink">
      No se pudo cargar la cobertura porque la fuente de datos no responde.
    </p>
    <button
      type="button"
      data-cob-reintentar
      class="mt-2 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      Reintentar
    </button>
  </div>
  <div
    data-cob-cuerpo
    role="status"
    aria-busy="true"
    class="mt-4 space-y-4 font-sans text-sm"
  >
    <div class="flex h-full w-full flex-col gap-3 p-3" aria-hidden="true">
      <div class="skeleton h-4 w-1/3 rounded"></div>
      <div class="skeleton h-10 w-full rounded"></div>
      <div class="skeleton h-10 w-full rounded"></div>
    </div>
  </div>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderEsqueletoRegistro,
    renderSinDato,
  } from './estado-async';

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const ANIOS = ['2018', '2019', '2021', '2022', '2023'];

  function filaAnios(
    titulo: string,
    porAnio: Record<string, number>,
    filas: number,
    extra: string[],
  ) {
    const wrap = document.createElement('div');
    wrap.className =
      'flex flex-col justify-between rounded-xl border border-border bg-surface p-4 shadow-2xs';
    const h = document.createElement('h3');
    h.className = 'font-display text-sm font-semibold text-ink';
    h.textContent = `${titulo} · ${filas.toLocaleString('es-SV')} filas cargadas`;
    wrap.appendChild(h);
    const ul = document.createElement('ul');
    ul.className = 'mt-3 grid grid-cols-5 gap-1.5 font-mono text-xs';
    for (const a of ANIOS) {
      const li = document.createElement('li');
      li.className =
        'flex flex-col items-center rounded border border-border/60 bg-bg py-1 text-center';
      const n = porAnio[a] ?? 0;
      li.innerHTML = `<span class="text-[10px] text-ink-muted">${a}</span><span class="font-semibold text-ink">${n}/52</span>`;
      ul.appendChild(li);
    }
    wrap.appendChild(ul);
    const p = document.createElement('p');
    p.className = 'mt-3 text-xs leading-relaxed text-ink-muted';
    p.textContent = extra.join(' · ');
    wrap.appendChild(p);
    return wrap;
  }

  async function iniciar() {
    const root = document.querySelector<HTMLElement>('[data-cobertura]');
    if (!root) return;
    const cuerpo = root.querySelector<HTMLElement>('[data-cob-cuerpo]')!;
    const error = root.querySelector<HTMLElement>('[data-cob-error]')!;
    const reintentar = root.querySelector<HTMLButtonElement>(
      '[data-cob-reintentar]',
    );
    if (reintentar && !reintentar.dataset.enlazado) {
      reintentar.dataset.enlazado = 'si';
      reintentar.addEventListener('click', () => void iniciar());
    }
    try {
      error.classList.add('hidden');
      cuerpo.setAttribute('aria-busy', 'true');
      renderEsqueletoRegistro(cuerpo);
      const resp = await fetch(`${API_BASE}/api/respiratorios/cobertura`);
      if (!resp.ok) throw new Error('no ok');
      const d = await resp.json();
      if (esNoDisponible(d)) {
        renderSinDato(cuerpo, motivoNoDisponible(d));
        return;
      }
      const aviso = document.createElement('p');
      aviso.className = 'text-xs leading-relaxed text-ink-muted';
      aviso.textContent = `${d.aviso} Procedencia: ${d.procedencia}.`;
      const neu = d.neumonias;
      const ira = d.ira;
      const vir = d.virus;
      const rejilla = document.createElement('div');
      rejilla.className = 'mt-3 grid grid-cols-1 gap-4 lg:grid-cols-3';
      rejilla.append(
        filaAnios('IRA', ira.semanas_con_dato_por_anio, ira.filas_cargadas, [
          ira.notas.nota,
        ]),
        filaAnios(
          'Neumonías',
          neu.semanas_con_dato_por_anio,
          neu.filas_cargadas,
          [
            `${neu.notas.tablas_imagen} tablas-imagen`,
            `${neu.notas.ausencia_vacacion} vacaciones`,
            `${neu.notas.correcciones_negativas_excluidas} correcciones negativas excluidas`,
            `reimpresión: ${neu.notas.reimpresiones[0]}`,
          ],
        ),
        filaAnios(
          'Virus (nacional)',
          vir.semanas_con_dato_por_anio,
          vir.filas_cargadas,
          [
            vir.notas.unidad,
            `COVID-19 solo en ${vir.notas.covid_19_solo_en}`,
            `2020 descargado: ${vir.notas.anio_2020_descargado ? 'sí' : 'no'}`,
            `${vir.notas.tablas_imagen} tablas-imagen`,
          ],
        ),
      );
      cuerpo.replaceChildren(aviso, rejilla);
      cuerpo.removeAttribute('aria-busy');
    } catch {
      error.classList.remove('hidden');
      cuerpo.textContent = '';
      cuerpo.removeAttribute('aria-busy');
    }
  }

  void iniciar();
</script>
