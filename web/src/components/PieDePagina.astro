---
/**
 * Pie del sitio: cuatro columnas de enlaces con título (proyecto,
 * herramientas, datos y método, externo) y el interruptor de animaciones.
 * Cada columna es un <nav> con aria-labelledby a su título.
 *
 * Todo el pie va sobre bg-deep, que es oscuro en ambos temas, así que los
 * colores salen de los tokens deep-ink y no dependen de data-theme.
 */
import { RUTA_PREDICCION } from '../lib/enlaces';
import { CUENTAS_HABILITADAS } from '../lib/cuentas-config';

const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

interface Enlace {
  href: string;
  etiqueta: string;
  externo?: boolean;
  /** Enlace de cuenta: el script lo cambia a "Mi cuenta" si hay sesión. */
  cuenta?: boolean;
}

const COLUMNAS: { id: string; titulo: string; enlaces: Enlace[] }[] = [
  {
    id: 'pie-proyecto',
    titulo: 'EPI-Aetheris',
    enlaces: [
      { href: '/', etiqueta: 'Inicio' },
      { href: '/biblioteca', etiqueta: 'Biblioteca' },
      { href: '/acerca-de', etiqueta: 'Acerca de' },
      { href: '/contacto', etiqueta: 'Contacto' },
      { href: '/configuracion', etiqueta: 'Configuración' },
      { href: '/legal/terminos#licencias', etiqueta: 'Licencia' },
      { href: '/legal/terminos', etiqueta: 'Términos de uso' },
      { href: '/legal/privacidad', etiqueta: 'Privacidad' },
      { href: '/legal/aviso-legal', etiqueta: 'Aviso legal' },
    ],
  },
  {
    id: 'pie-herramientas',
    titulo: 'Herramientas',
    enlaces: [
      { href: '/dengue', etiqueta: 'Dengue' },
      { href: RUTA_PREDICCION, etiqueta: 'Predicción de dengue' },
      { href: '/respiratorio', etiqueta: 'Respiratorio' },
      { href: '/analisis', etiqueta: 'Análisis' },
      { href: '/analisis#fichas-titulo', etiqueta: 'Fichas departamentales' },
      { href: '/alertas', etiqueta: 'Alertas' },
      { href: '/alertas/archivo', etiqueta: 'Archivo de alertas' },
    ],
  },
  {
    id: 'pie-datos',
    titulo: 'Datos y método',
    enlaces: [
      { href: '/biblioteca/04-fuentes-de-datos', etiqueta: 'Fuentes de datos' },
      { href: '/biblioteca/03-funciones', etiqueta: 'Módulos M1–M3' },
      {
        href: '/biblioteca/05-sensibilidad-y-honestidad',
        etiqueta: 'Aviso de sensibilidad',
      },
      {
        href: '/biblioteca/06-arquitectura-y-reproducibilidad',
        etiqueta: 'Arquitectura y reproducibilidad',
      },
      {
        href: `${API_BASE}/docs`,
        etiqueta: 'API pública (Swagger)',
        externo: true,
      },
      {
        href: 'https://boletin.salud.gob.sv',
        etiqueta: 'MINSAL, tablero de vigilancia',
        externo: true,
      },
      {
        href: 'https://opendengue.org',
        etiqueta: 'OpenDengue',
        externo: true,
      },
      {
        href: 'https://open-meteo.com/en/license',
        etiqueta: 'Open-Meteo (CC BY 4.0)',
        externo: true,
      },
    ],
  },
  {
    id: 'pie-externo',
    titulo: 'Externo',
    enlaces: [
      {
        href: 'https://github.com/the-monolith-project/EPI-Aetheris',
        etiqueta: 'GitHub',
        externo: true,
      },
      { href: '/sugerencias', etiqueta: 'Sugerencias' },
      { href: '/estado', etiqueta: 'Estado del servicio' },
      // Sin cuentas activadas no hay ningún enlace hacia ellas (decisión 15).
      ...(CUENTAS_HABILITADAS
        ? [{ href: '/cuenta/ingresar', etiqueta: 'Ingresar', cuenta: true }]
        : []),
    ],
  },
];
---

<footer class="mt-12 bg-deep sm:mt-16">
  <div class="mx-auto max-w-[1600px] px-4 py-10 sm:px-8 sm:py-16 lg:px-12">
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:gap-10 lg:grid-cols-4">
      {
        COLUMNAS.map((columna) => (
          <nav aria-labelledby={columna.id}>
            <h2
              id={columna.id}
              class="font-sans text-base font-bold text-secondary"
            >
              {columna.titulo}
            </h2>
            <ul class="mt-4 space-y-1 font-sans text-sm">
              {columna.enlaces.map((enlace) => (
                <li>
                  <a
                    href={enlace.href}
                    class="enlace-filete py-1 text-deep-ink transition-colors hover:text-white"
                    rel={enlace.externo ? 'noopener noreferrer' : undefined}
                    data-enlace-cuenta={enlace.cuenta ? '' : undefined}
                  >
                    {enlace.etiqueta}
                  </a>
                </li>
              ))}
            </ul>
            {columna.id === 'pie-externo' && (
              <button
                type="button"
                role="switch"
                aria-checked="true"
                data-interruptor-animaciones
                class="mt-5 flex min-h-[44px] items-center gap-3 rounded-full py-1 font-sans text-xs text-deep-ink transition-colors hover:text-white"
              >
                <span>Animaciones</span>
                <span
                  aria-hidden="true"
                  class="interruptor-pista relative inline-block h-5 w-9 shrink-0 rounded-full border border-white/40"
                >
                  <span class="interruptor-bola absolute left-0.5 top-0.5 block h-3.5 w-3.5 rounded-full" />
                </span>
              </button>
            )}
          </nav>
        ))
      }
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 sm:mt-12">
      <p
        class="max-w-4xl font-sans text-xs leading-relaxed text-deep-ink-muted"
      >
        Proyecto académico · El Salvador · 2026. Ayuda de priorización sobre
        datos públicos agregados de MINSAL, OpenDengue y Open-Meteo, bajo
        licencia GPL-3.0; no reemplaza los lineamientos del MINSAL ni el
        criterio clínico. Las capas describen cada departamento contra su propia
        historia, no asignan un nivel de riesgo automatizado.
      </p>
      <p class="mt-3 font-mono text-[11px] text-deep-ink-muted">
        MINSAL · OpenDengue · Open-Meteo CC BY 4.0 · GPL-3.0 · 2026
      </p>
    </div>
  </div>
</footer>

<style>
  .interruptor-pista {
    background-color: transparent;
    transition: background-color 150ms ease;
  }
  .interruptor-bola {
    background-color: var(--color-deep-ink);
    transition: transform 150ms ease;
  }
  [data-interruptor-animaciones][aria-checked='true'] .interruptor-pista {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
  }
  [data-interruptor-animaciones][aria-checked='true'] .interruptor-bola {
    background-color: var(--color-deep);
    transform: translateX(1rem);
  }
</style>

<script>
  // Interruptor "Animaciones". El atributo data-animaciones de <html> ya lo
  // fijó el script en línea del Layout antes del primer pintado; aquí solo se
  // sincroniza el control y se guarda la elección (lib/preferencias.ts). Se
  // repinta también cuando cambia desde el atajo de teclado o /configuracion.
  import { animacionesActivas } from '../lib/animaciones';
  import {
    EVENTO_PREFERENCIAS,
    alternarAnimaciones,
  } from '../lib/preferencias';

  const interruptor = document.querySelector<HTMLButtonElement>(
    '[data-interruptor-animaciones]',
  );

  function pintar(): void {
    interruptor?.setAttribute('aria-checked', String(animacionesActivas()));
  }

  interruptor?.addEventListener('click', () => {
    alternarAnimaciones();
  });
  window.addEventListener(EVENTO_PREFERENCIAS, pintar);
  pintar();

  // "Ingresar" pasa a "Mi cuenta" cuando hay una sesión completa. El módulo de
  // sesión se carga solo si el pie tiene el enlace (cuentas activadas), y solo
  // consulta al backend si este navegador tiene la pista de una sesión previa.
  const enlaceCuenta = document.querySelector<HTMLAnchorElement>(
    '[data-enlace-cuenta]',
  );
  if (enlaceCuenta) {
    void import('../lib/sesion-state').then(
      ({ cargarSesionSiHayPista, esSesionCompleta, suscribirSesion }) => {
        const pintarCuenta = (
          sesion: Parameters<typeof esSesionCompleta>[0],
        ) => {
          const hay = esSesionCompleta(sesion);
          enlaceCuenta.textContent = hay ? 'Mi cuenta' : 'Ingresar';
          enlaceCuenta.href = hay ? '/cuenta' : '/cuenta/ingresar';
        };
        suscribirSesion(pintarCuenta);
        void cargarSesionSiHayPista();
      },
    );
  }
</script>
