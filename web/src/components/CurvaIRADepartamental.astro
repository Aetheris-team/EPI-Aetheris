---
import PanelWorkspace from './analisis/PanelWorkspace.astro';
import MenuExportar from './MenuExportar.astro';
import SelectorSemanaEpi from './SelectorSemanaEpi.astro';
import { ANIOS_RESPIRATORIO } from '../lib/respiratorio-state';
interface Props {
  evento?: 'ira' | 'neumonias';
  /**
   * Código de departamento fijo (p. ej. en /departamento/[codigo]). Con él se
   * oculta el selector y el componente no lee ni escribe el estado compartido.
   */
  departamento?: string;
}
const evento = Astro.props.evento ?? 'ira';
const departamentoFijo = Astro.props.departamento;
const etiqueta = evento === 'neumonias' ? 'Neumonías' : 'IRA';
const apiBase = evento === 'neumonias' ? '/api/neumonias' : '/api/ira';
const idPrefijo = `curva-${evento}${departamentoFijo ? `-${departamentoFijo}` : ''}`;
---

<PanelWorkspace
  tipo="traza"
  titulo={`Casos semanales de ${etiqueta} por departamento`}
  descripcion="Serie desacumulada de los boletines MINSAL (la fuente publica acumulados desde SE1). Unidad: conteo notificado. Un año por línea; los huecos se dejan vacíos, no se interpolan."
  data-curva-evento={evento}
  data-curva-api={apiBase}
  data-curva-departamento={departamentoFijo}
  controlesAnchos
>
  <div
    slot="controles"
    class="flex flex-wrap items-center gap-2 font-sans text-sm text-ink-muted"
  >
    <label
      class:list={[
        'flex flex-wrap items-center gap-2',
        { hidden: departamentoFijo },
      ]}
      >Departamento
      <select
        data-curva-depto
        class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-sm text-ink"
      ></select>
    </label>
    <label class="flex flex-wrap items-center gap-2"
      >Año
      <select
        data-curva-anio
        class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-sm text-ink"
      >
        <option value="todos">todos (comparar temporadas)</option>
        {ANIOS_RESPIRATORIO.map((a) => <option value={String(a)}>{a}</option>)}
      </select>
    </label>
    <label class="flex flex-wrap items-center gap-2"
      >Comparar con
      <select
        data-curva-compare
        class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-sm text-ink"
      >
        <option value="">(ningún otro departamento)</option>
      </select>
    </label>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-medium text-ink-muted">Desde:</span>
      <SelectorSemanaEpi
        id={`${idPrefijo}-selector-desde`}
        semana={1}
        compacto={true}
        mostrarRangoFechas={false}
        etiqueta={`Semana epidemiológica inicial ${etiqueta}`}
        class="curva-selector-desde"
      />
      <input
        data-curva-desde
        type="range"
        min="1"
        max="52"
        value="1"
        aria-label="Semana epidemiológica inicial"
        aria-valuetext="Semana epidemiológica 1"
        class="w-20 sm:w-28 accent-accent"
      />
      <span class="text-xs font-medium text-ink-muted">Hasta:</span>
      <SelectorSemanaEpi
        id={`${idPrefijo}-selector-hasta`}
        semana={52}
        compacto={true}
        mostrarRangoFechas={false}
        etiqueta={`Semana epidemiológica final ${etiqueta}`}
        class="curva-selector-hasta"
      />
      <input
        data-curva-hasta
        type="range"
        min="1"
        max="52"
        value="52"
        aria-label="Semana epidemiológica final"
        aria-valuetext="Semana epidemiológica 52"
        class="w-20 sm:w-28 accent-accent"
      />
      <span data-curva-rango class="font-sans tabular-nums text-xs"
        >SE1–SE52</span
      >
    </div>
    <MenuExportar
      csv={`curva-csv-${evento}`}
      titulo={`Casos semanales de ${etiqueta} por departamento`}
      fuente="Boletines epidemiológicos de MINSAL"
    />
  </div>

  <div
    data-curva-canvas
    class="mt-4 min-h-[340px] rounded-xl border border-border bg-bg p-3 sm:p-4"
    role="region"
    aria-label={`Casos semanales notificados de ${etiqueta} por departamento`}
    aria-busy="true"
  >
    <div
      class="flex h-full min-h-[312px] w-full flex-col justify-around gap-4 p-4"
      aria-hidden="true"
    >
      <div class="skeleton h-5 w-full rounded"></div>
      <div class="skeleton h-5 w-full rounded"></div>
      <div class="skeleton h-5 w-full rounded"></div>
    </div>
  </div>

  <p data-curva-huecos class="mt-2 font-sans text-xs text-ink-muted" hidden></p>
</PanelWorkspace>

<script>
  import type {
    DepartamentoIRA,
    RespuestaIraDepartamental,
  } from '../lib/tipos-analisis';
  import { colorCualitativo } from '../lib/colores';
  import { montarGrafico } from '../lib/echarts-montaje';
  import type { GraficoMontado } from '../lib/echarts-montaje';
  import {
    crearOpcionBase,
    ejeSemana,
    ejeValores,
    etiquetaSemana,
    tooltipSeries,
  } from '../lib/echarts-tema';
  import { habilitarCsv, inhabilitarCsv } from '../lib/exportar-csv';
  import {
    actualizarFiltrosRespiratorio,
    obtenerFiltrosRespiratorio,
    suscribirFiltrosRespiratorio,
    type FiltrosRespiratorio,
  } from '../lib/respiratorio-state';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderSinDato,
  } from './estado-async';

  // [semana, valor|null]
  type Punto = [number, number | null];

  interface RespuestaTemporal {
    departamento_codigo: string;
    departamento_nombre: string;
    anios: number[];
    series: Record<string, [number, number][]>;
    aviso: string;
  }

  interface Capa {
    nombre: string;
    series: Record<string, Punto[]>;
    dashed?: boolean;
  }

  function recortar(
    series: Record<string, Punto[]>,
    desde: number,
    hasta: number,
  ): Record<string, Punto[]> {
    const out: Record<string, Punto[]> = {};
    for (const anio of Object.keys(series)) {
      out[anio] = (series[anio] ?? []).filter(
        ([s]) => s >= desde && s <= hasta,
      );
    }
    return out;
  }

  /**
   * Devuelve el gráfico recién montado (o null si no hubo dato): cada
   * instancia de este componente (IRA, Neumonías, comparación fija) guarda su
   * propio gráfico en una variable local, no aquí -- la página monta varias
   * instancias a la vez y comparten este módulo.
   */
  async function dibujar(
    contenedor: HTMLElement,
    huecos: HTMLElement,
    capas: Capa[],
    desde: number,
    hasta: number,
    previo: GraficoMontado | null,
  ): Promise<GraficoMontado | null> {
    previo?.destruir();
    huecos.hidden = true;

    const primarias = capas[0]?.series ?? {};
    const anios = Object.keys(primarias).sort();
    const valores = capas.flatMap((c) =>
      Object.values(c.series).flatMap((pts) =>
        pts.map((p) => p[1]).filter((v): v is number => v !== null),
      ),
    );
    if (valores.length === 0) {
      renderSinDato(
        contenedor,
        'Sin puntos con dato para este departamento en el rango elegido.',
      );
      return null;
    }

    contenedor.style.height = '340px';
    const nombreDescripcion = capas.map((c) => c.nombre).join(' y ');
    const grafico = await montarGrafico(
      contenedor,
      (t) => ({
        ...crearOpcionBase(t, {
          grid: { bottom: 92 },
          legend: { data: anios },
          tooltip: {
            formatter: tooltipSeries(
              (semana) => etiquetaSemana(semana),
              'casos notificados',
            ),
          },
        }),
        xAxis: ejeSemana(t, desde, hasta),
        yAxis: ejeValores(t, 'Casos notificados', { min: 0, minInterval: 1 }),
        series: capas.flatMap((capa, indiceCapa) => {
          const aniosCapa = Object.keys(capa.series).sort();
          return aniosCapa.map((anio) => {
            const destacado =
              indiceCapa === 0 && anio === aniosCapa[aniosCapa.length - 1];
            const color = colorCualitativo(anios.indexOf(anio));
            return {
              id: `${indiceCapa}-${anio}`,
              name: capas.length > 1 ? `${capa.nombre} ${anio}` : anio,
              type: 'line' as const,
              symbol: capa.dashed ? 'none' : 'circle',
              symbolSize: destacado ? 6 : 4,
              itemStyle: { color },
              lineStyle: destacado
                ? { width: 2.25, color }
                : {
                    width: 1.5,
                    color,
                    type: capa.dashed
                      ? ('dashed' as const)
                      : ('solid' as const),
                  },
              z: destacado ? 5 : 2,
              data: capa.series[anio],
            };
          });
        }),
      }),
      `Casos semanales notificados ${nombreDescripcion}, SE${desde}–SE${hasta}`,
    );
    contenedor.removeAttribute('aria-busy');

    // Nota de huecos: cuántas semanas por año quedaron sin dato en la capa
    // principal (no interpoladas).
    const resumen = anios
      .map((a) => {
        const sinDato = primarias[a].filter((p) => p[1] === null).length;
        return sinDato > 0 ? `${a}: ${sinDato} semanas sin dato` : null;
      })
      .filter(Boolean)
      .join(' · ');
    if (resumen) {
      huecos.textContent = `Huecos (no interpolados) -- ${resumen}`;
      huecos.hidden = false;
    }
    return grafico;
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

  async function cargarTemporal(
    apiBase: string,
    codigo: string,
  ): Promise<Record<string, Punto[]>> {
    const resp = await fetch(`${API_BASE}${apiBase}/temporal/${codigo}`);
    if (!resp.ok) throw new Error('respuesta no OK');
    const datos = await resp.json();
    if (esNoDisponible(datos)) {
      throw Object.assign(new Error(motivoNoDisponible(datos)), {
        noDisponible: true,
        motivo: motivoNoDisponible(datos),
      });
    }
    const cuerpo = datos as RespuestaTemporal;
    const series: Record<string, Punto[]> = {};
    for (const anio of cuerpo.anios) {
      series[String(anio)] = cuerpo.series[String(anio)] ?? [];
    }
    return series;
  }

  async function iniciarSeccion(seccion: HTMLElement) {
    let grafico: GraficoMontado | null = null;
    const apiBase = seccion.dataset.curvaApi ?? '/api/ira';
    const contenedor = seccion.querySelector(
      '[data-curva-canvas]',
    ) as HTMLElement | null;
    const huecos = seccion.querySelector(
      '[data-curva-huecos]',
    ) as HTMLElement | null;
    const selector = seccion.querySelector(
      '[data-curva-depto]',
    ) as HTMLSelectElement | null;
    const selAnio = seccion.querySelector(
      '[data-curva-anio]',
    ) as HTMLSelectElement | null;
    const selCompare = seccion.querySelector(
      '[data-curva-compare]',
    ) as HTMLSelectElement | null;
    const inpDesde = seccion.querySelector(
      '[data-curva-desde]',
    ) as HTMLInputElement | null;
    const inpHasta = seccion.querySelector(
      '[data-curva-hasta]',
    ) as HTMLInputElement | null;
    const txtRango = seccion.querySelector(
      '[data-curva-rango]',
    ) as HTMLElement | null;
    const opcionCsv = seccion.querySelector<HTMLElement>(
      '[data-menu-accion="csv"]',
    );
    const selectorDesde = seccion.querySelector<HTMLElement>(
      '.curva-selector-desde',
    );
    const selectorHasta = seccion.querySelector<HTMLElement>(
      '.curva-selector-hasta',
    );
    if (
      !contenedor ||
      !huecos ||
      !selector ||
      !selAnio ||
      !selCompare ||
      !inpDesde ||
      !inpHasta ||
      !txtRango
    )
      return;

    let departamentos: DepartamentoIRA[];
    try {
      const resp = await fetch(`${API_BASE}${apiBase}/departamental`);
      if (!resp.ok) throw new Error('respuesta no OK');
      const datos = await resp.json();
      if (esNoDisponible(datos)) {
        renderSinDato(contenedor, motivoNoDisponible(datos));
        return;
      }
      departamentos = (datos as RespuestaIraDepartamental).departamentos;
    } catch {
      // Los <select> nunca llegaron a poblarse en este punto, así que
      // reintentar es volver a ejecutar iniciarSeccion sin duplicar opciones.
      renderErrorFuente(contenedor, () => void iniciarSeccion(seccion));
      return;
    }

    departamentos.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
    for (const d of departamentos) {
      const opcion = document.createElement('option');
      opcion.value = d.codigo;
      opcion.textContent = d.nombre;
      selector.appendChild(opcion);
      const op2 = opcion.cloneNode(true) as HTMLOptionElement;
      op2.selected = false;
      selCompare.appendChild(op2);
    }

    const rango = () => {
      let desde = Number(inpDesde.value);
      let hasta = Number(inpHasta.value);
      if (desde > hasta) [desde, hasta] = [hasta, desde];
      txtRango.textContent = `SE${desde}–SE${hasta}`;
      inpDesde.setAttribute('aria-valuetext', `Semana epidemiológica ${desde}`);
      inpHasta.setAttribute('aria-valuetext', `Semana epidemiológica ${hasta}`);
      const anioNum = selAnio.value === 'todos' ? 2024 : Number(selAnio.value);
      selectorDesde?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: anioNum, semana: desde },
        }),
      );
      selectorHasta?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: anioNum, semana: hasta },
        }),
      );
      return { desde, hasta };
    };

    // Con departamento fijo el componente vive aparte del estado compartido.
    const fijo = seccion.dataset.curvaDepartamento ?? null;

    const sincronizarControles = (f: FiltrosRespiratorio) => {
      selector.value = fijo ?? f.departamento;
      selAnio.value = String(f.anio);
      selCompare.value = f.comparar ?? '';
      // Los deslizadores pueden cruzarse mientras se arrastran: solo se
      // reasignan si el rango efectivo cambió, para no mover el que se sostiene.
      const actualDesde = Math.min(
        Number(inpDesde.value),
        Number(inpHasta.value),
      );
      const actualHasta = Math.max(
        Number(inpDesde.value),
        Number(inpHasta.value),
      );
      if (actualDesde !== f.semanaDesde || actualHasta !== f.semanaHasta) {
        inpDesde.value = String(f.semanaDesde);
        inpHasta.value = String(f.semanaHasta);
      }
      const anioNum = f.anio === 'todos' ? 2024 : f.anio;
      selectorDesde?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: anioNum, semana: f.semanaDesde },
        }),
      );
      selectorHasta?.dispatchEvent(
        new CustomEvent('ajustar-semana', {
          detail: { anio: anioNum, semana: f.semanaHasta },
        }),
      );
    };
    sincronizarControles(
      fijo
        ? { ...obtenerFiltrosRespiratorio(), departamento: fijo }
        : obtenerFiltrosRespiratorio(),
    );

    const refrescar = async () => {
      const { desde, hasta } = rango();
      const codigo = selector.value;
      const nombre = selector.selectedOptions[0]?.textContent ?? codigo;
      contenedor.setAttribute('aria-busy', 'true');
      try {
        const series = await cargarTemporal(apiBase, codigo);
        const filtro = selAnio.value;
        const base = recortar(
          filtro === 'todos' ? series : { [filtro]: series[filtro] ?? [] },
          desde,
          hasta,
        );
        const capas: Capa[] = [{ nombre, series: base }];
        const cmp = selCompare.value;
        if (cmp && cmp !== codigo) {
          const series2 = await cargarTemporal(apiBase, cmp);
          const nombre2 = selCompare.selectedOptions[0]?.textContent ?? cmp;
          capas.push({
            nombre: nombre2,
            dashed: true,
            series: recortar(
              filtro === 'todos'
                ? series2
                : { [filtro]: series2[filtro] ?? [] },
              desde,
              hasta,
            ),
          });
        }
        grafico = await dibujar(
          contenedor,
          huecos,
          capas,
          desde,
          hasta,
          grafico,
        );
        const lineas = ['departamento,anio,semana,valor'];
        for (const capa of capas) {
          for (const anio of Object.keys(capa.series)) {
            for (const [s, v] of capa.series[anio]) {
              lineas.push(`${capa.nombre},${anio},${s},${v ?? ''}`);
            }
          }
        }
        const contenido = lineas.join('\n');
        habilitarCsv(opcionCsv, () => ({
          nombre: 'serie-respiratoria.csv',
          contenido,
        }));
      } catch (err) {
        grafico?.destruir();
        grafico = null;
        const noDisponible =
          err instanceof Error &&
          (err as Error & { noDisponible?: boolean }).noDisponible === true;
        if (noDisponible) {
          renderSinDato(
            contenedor,
            (err as Error & { motivo?: string }).motivo ??
              motivoNoDisponible({ disponible: false }),
          );
        } else {
          renderErrorFuente(contenedor, () => void refrescar());
        }
        inhabilitarCsv(opcionCsv);
      } finally {
        contenedor.removeAttribute('aria-busy');
      }
    };
    const alCambiar = () => {
      if (fijo) {
        void refrescar();
        return;
      }
      actualizarFiltrosRespiratorio({
        departamento: selector.value,
        anio: selAnio.value === 'todos' ? 'todos' : Number(selAnio.value),
        comparar: selCompare.value || null,
        semanaDesde: Number(inpDesde.value),
        semanaHasta: Number(inpHasta.value),
      });
    };
    selector.addEventListener('change', alCambiar);
    selAnio.addEventListener('change', alCambiar);
    selCompare.addEventListener('change', alCambiar);
    inpDesde.addEventListener('input', alCambiar);
    inpHasta.addEventListener('input', alCambiar);
    selectorDesde?.addEventListener('cambio-semana', ((
      ev: CustomEvent<{ semana: number }>,
    ) => {
      inpDesde.value = String(ev.detail.semana);
      alCambiar();
    }) as EventListener);
    selectorHasta?.addEventListener('cambio-semana', ((
      ev: CustomEvent<{ semana: number }>,
    ) => {
      inpHasta.value = String(ev.detail.semana);
      alCambiar();
    }) as EventListener);
    if (!fijo) {
      suscribirFiltrosRespiratorio((f) => {
        sincronizarControles(f);
        void refrescar();
      }, false);
    }
    void refrescar();
  }

  document
    .querySelectorAll<HTMLElement>('[data-curva-evento]')
    .forEach((seccion) => {
      void iniciarSeccion(seccion);
    });
</script>
