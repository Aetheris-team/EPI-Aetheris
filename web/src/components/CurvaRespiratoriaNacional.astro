---
// Serie nacional de IRA o neumonías del tablero de MINSAL, desde 2025
// (ADR 0021). El tablero no publica departamentos, así que esta curva va
// aparte de las departamentales de los boletines (2018-2023) y no se empalma
// con la suma de estas: muchas semanas de los boletines no traen los 14
// departamentos y en neumonías las escalas no cuadran.
import PanelWorkspace from './analisis/PanelWorkspace.astro';
import MenuExportar from './MenuExportar.astro';
import Icono from './Icono.astro';
import { RUTA_FUENTE_TABLERO } from '../lib/enlaces';
import type { EventoRespiratorio } from '../lib/tipos-analisis';

interface Props {
  evento: EventoRespiratorio;
}
const { evento } = Astro.props;
const etiqueta = evento === 'neumonias' ? 'Neumonías' : 'IRA';
const etiquetaMinuscula = evento === 'neumonias' ? 'neumonías' : 'IRA';
---

<PanelWorkspace
  tipo="traza"
  titulo={`${etiqueta} en todo el país`}
  descripcion="Casos notificados por semana según el tablero de MINSAL, desde 2025. El tablero publica cada semana como un promedio de varias. Una línea por año."
  data-nac-evento={evento}
  data-nac-etiqueta={etiquetaMinuscula}
>
  <MenuExportar
    slot="controles"
    csv={`nac-csv-${evento}`}
    titulo={`${etiqueta} en todo el país`}
    fuente="Tablero de vigilancia de MINSAL"
  />

  <div
    class="mt-3 flex items-start gap-2.5 rounded-xl border border-border bg-surface p-3.5 shadow-2xs"
  >
    <Icono nombre="chart-line" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
    <p
      data-nac-resumen
      class="font-sans text-xs sm:text-sm leading-relaxed text-ink tabular-nums"
    >
    </p>
  </div>

  <div
    data-nac-canvas
    class="mt-3 min-h-[280px] rounded-xl border border-border bg-bg p-3 sm:p-4"
    role="region"
    aria-label={`Casos notificados de ${etiquetaMinuscula} en todo el país por semana epidemiológica, una línea por año`}
    aria-busy="true"
  >
    <div
      class="flex h-full min-h-[252px] w-full flex-col justify-around gap-4 p-4"
      aria-hidden="true"
    >
      <div class="skeleton h-5 w-full rounded"></div>
      <div class="skeleton h-5 w-full rounded"></div>
      <div class="skeleton h-5 w-full rounded"></div>
    </div>
  </div>

  <p data-nac-huecos class="mt-2 font-sans text-xs text-ink-muted" hidden></p>

  <details
    data-nac-detalle
    class="mt-3 rounded-xl border border-border bg-bg p-3"
    hidden
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted"
    >
      Ver los valores semanales en una tabla
    </summary>
    <div
      class="mt-2 max-h-96 overflow-auto rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      tabindex="0"
      role="region"
      aria-label={`Tabla semanal de ${etiquetaMinuscula} en todo el país`}
    >
      <table
        data-nac-tabla
        class="border-collapse font-sans text-xs tabular-nums text-ink"
      >
        <caption class="sr-only"
          >Casos notificados de {etiquetaMinuscula} en todo el país por semana epidemiológica,
          según el tablero de MINSAL</caption
        >
      </table>
    </div>
  </details>

  <p slot="pie" class="mt-3 font-sans text-xs text-ink-muted">
    <a
      href={RUTA_FUENTE_TABLERO}
      class="font-medium text-accent underline underline-offset-2"
      >Sobre el tablero de MINSAL</a
    >
  </p>
</PanelWorkspace>

<script>
  import { obtenerSerieRespiratoriaNacional } from '../lib/analisis-api';
  import { colorCualitativo } from '../lib/colores';
  import { montarGrafico } from '../lib/echarts-montaje';
  import {
    crearOpcionBase,
    ejeSemana,
    ejeValores,
    etiquetaSemana,
    tooltipSeries,
  } from '../lib/echarts-tema';
  import { habilitarCsv, type ArchivoCsv } from '../lib/exportar-csv';
  import type {
    EventoRespiratorio,
    SemanaRespiratoriaNacional,
  } from '../lib/tipos-analisis';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderSinDato,
  } from './estado-async';

  const SEMANA_MS = 7 * 86_400_000;

  type SemanaFaltante = { anio: number; semana_epi: number };

  const numero = (valor: number) => valor.toLocaleString('es-SV');

  const tiempo = (d: SemanaRespiratoriaNacional) =>
    new Date(`${d.semana_inicio}T00:00:00`).getTime();

  // Semanas sin fila entre dos publicadas, por fecha de inicio. Si el hueco
  // cruza el cambio de año, las que no caben antes de la semana siguiente
  // son las últimas del año anterior (la 53 de 2025).
  function semanasSinPublicar(
    semanas: SemanaRespiratoriaNacional[],
  ): SemanaFaltante[] {
    const faltantes: SemanaFaltante[] = [];
    for (let i = 1; i < semanas.length; i++) {
      const previa = semanas[i - 1];
      const actual = semanas[i];
      const n = Math.round((tiempo(actual) - tiempo(previa)) / SEMANA_MS) - 1;
      if (n <= 0) continue;
      const enAnioActual =
        actual.anio === previa.anio ? n : Math.min(n, actual.semana_epi - 1);
      for (let k = 1; k <= n - enAnioActual; k++) {
        faltantes.push({
          anio: previa.anio,
          semana_epi: previa.semana_epi + k,
        });
      }
      for (let k = enAnioActual; k >= 1; k--) {
        faltantes.push({
          anio: actual.anio,
          semana_epi: actual.semana_epi - k,
        });
      }
    }
    return faltantes;
  }

  function porAnio(semanas: SemanaRespiratoriaNacional[]) {
    const mapa = new Map<number, Map<number, number>>();
    for (const s of semanas) {
      if (!mapa.has(s.anio)) mapa.set(s.anio, new Map());
      mapa.get(s.anio)!.set(s.semana_epi, s.conteo);
    }
    return mapa;
  }

  function textoResumen(semanas: SemanaRespiratoriaNacional[]): string {
    const ultima = semanas[semanas.length - 1];
    const base = `Última semana publicada: SE${ultima.semana_epi} de ${ultima.anio}, con ${numero(ultima.conteo)} casos notificados`;
    const previa = semanas.find(
      (s) => s.anio === ultima.anio - 1 && s.semana_epi === ultima.semana_epi,
    );
    if (!previa || previa.conteo === 0) return `${base}.`;
    const cambio = ((ultima.conteo - previa.conteo) / previa.conteo) * 100;
    const redondeo = Math.round(Math.abs(cambio));
    const comparacion =
      redondeo === 0
        ? 'casi los mismos que'
        : `un ${redondeo} % ${cambio > 0 ? 'más' : 'menos'} que`;
    return `${base}, ${comparacion} en la misma semana de ${previa.anio} (${numero(previa.conteo)}).`;
  }

  function llenarTabla(
    tabla: HTMLTableElement,
    semanas: SemanaRespiratoriaNacional[],
    faltantes: SemanaFaltante[],
  ) {
    const series = porAnio(semanas);
    const anios = [...series.keys()].sort((a, b) => a - b);
    // Hasta la última semana con fila o sin publicar (la 53 de 2025 no tiene
    // fila en ningún año, pero debe verse como hueco).
    const semanaMax = Math.max(
      ...semanas.map((s) => s.semana_epi),
      ...faltantes.map((f) => f.semana_epi),
    );
    const sinPublicar = new Set(
      faltantes.map((f) => `${f.anio}-${f.semana_epi}`),
    );

    tabla.querySelectorAll('thead, tbody').forEach((n) => n.remove());
    const thead = tabla.createTHead();
    const filaCabecera = thead.insertRow();
    filaCabecera.className = 'text-left text-ink-muted';
    for (const titulo of ['Semana', ...anios.map(String)]) {
      const th = document.createElement('th');
      th.scope = 'col';
      th.className = 'sticky top-0 border-b border-border bg-bg py-1 pr-8';
      th.textContent = titulo;
      filaCabecera.appendChild(th);
    }

    const tbody = tabla.createTBody();
    for (let semana = 1; semana <= semanaMax; semana++) {
      const fila = tbody.insertRow();
      const th = document.createElement('th');
      th.scope = 'row';
      th.className = 'py-0.5 pr-8 text-left font-normal text-ink-muted';
      th.textContent = `SE${semana}`;
      fila.appendChild(th);
      for (const anio of anios) {
        const celda = fila.insertCell();
        celda.className = 'py-0.5 pr-8';
        const conteo = series.get(anio)!.get(semana);
        if (conteo !== undefined) {
          celda.textContent = numero(conteo);
        } else if (sinPublicar.has(`${anio}-${semana}`)) {
          celda.textContent = 'sin publicar';
          celda.classList.add('text-ink-muted');
        }
      }
    }
  }

  function archivoCsv(
    evento: string,
    semanas: SemanaRespiratoriaNacional[],
  ): ArchivoCsv {
    const lineas = ['semana_inicio,anio,semana_epi,conteo,fuente'];
    for (const s of semanas) {
      lineas.push(
        `${s.semana_inicio},${s.anio},${s.semana_epi},${s.conteo},minsal_tablero`,
      );
    }
    return {
      nombre: `epi-aetheris-${evento}-nacional-${semanas[0].anio}-${semanas[semanas.length - 1].anio}.csv`,
      contenido: lineas.join('\n'),
    };
  }

  async function iniciar(seccion: HTMLElement) {
    const evento = seccion.dataset.nacEvento as EventoRespiratorio;
    const etiqueta = seccion.dataset.nacEtiqueta ?? evento;
    const contenedor = seccion.querySelector<HTMLElement>('[data-nac-canvas]');
    const resumen = seccion.querySelector<HTMLElement>('[data-nac-resumen]');
    const huecos = seccion.querySelector<HTMLElement>('[data-nac-huecos]');
    const detalle = seccion.querySelector<HTMLElement>('[data-nac-detalle]');
    const tabla = seccion.querySelector<HTMLTableElement>('[data-nac-tabla]');
    const opcionCsv = seccion.querySelector<HTMLElement>(
      '[data-menu-accion="csv"]',
    );
    if (!contenedor || !resumen || !huecos || !detalle || !tabla) return;

    contenedor.setAttribute('aria-busy', 'true');
    let respuesta: Awaited<ReturnType<typeof obtenerSerieRespiratoriaNacional>>;
    try {
      respuesta = await obtenerSerieRespiratoriaNacional(evento);
    } catch {
      renderErrorFuente(contenedor, () => void iniciar(seccion));
      return;
    }
    if (esNoDisponible(respuesta)) {
      renderSinDato(contenedor, motivoNoDisponible(respuesta));
      return;
    }
    const semanas = respuesta.semanas;
    if (semanas.length === 0) {
      renderSinDato(contenedor, 'Sin semanas publicadas en el tablero.');
      return;
    }

    resumen.textContent = textoResumen(semanas);

    const series = porAnio(semanas);
    const anios = [...series.keys()].sort((a, b) => a - b);
    const semanaMax = Math.max(52, ...semanas.map((s) => s.semana_epi));

    await montarGrafico(
      contenedor,
      (t) => ({
        ...crearOpcionBase(t, {
          grid: { bottom: 72 },
          legend: { data: anios.map(String) },
          tooltip: {
            formatter: tooltipSeries(
              (semana) => `${etiqueta} · ${etiquetaSemana(semana)}`,
              'casos notificados',
            ),
          },
        }),
        xAxis: ejeSemana(t, 1, semanaMax),
        yAxis: ejeValores(t, 'Casos notificados', { min: 0, minInterval: 1 }),
        series: anios.map((anio, i) => {
          const destacado = anio === anios[anios.length - 1];
          const color = destacado ? t.acento : colorCualitativo(i);
          const valores = series.get(anio)!;
          return {
            id: String(anio),
            name: String(anio),
            type: 'line' as const,
            symbolSize: destacado ? 6 : 4,
            itemStyle: { color },
            lineStyle: destacado
              ? { width: 2.5, color }
              : { width: 1.5, type: 'dashed' as const, color },
            z: destacado ? 5 : 2,
            data: Array.from({ length: semanaMax }, (_, idx) => {
              const semana = idx + 1;
              return [semana, valores.get(semana) ?? null];
            }),
          };
        }),
      }),
      `Casos notificados de ${etiqueta} en todo el país por semana epidemiológica, una línea por año: ${anios.join(' y ')}`,
    );
    contenedor.removeAttribute('aria-busy');

    const faltantes = semanasSinPublicar(semanas);
    if (faltantes.length > 0) {
      huecos.textContent = `Sin publicar en el tablero: ${faltantes
        .map((f) => `SE${f.semana_epi} de ${f.anio}`)
        .join(', ')}.`;
      huecos.hidden = false;
    }
    llenarTabla(tabla, semanas, faltantes);
    detalle.hidden = false;

    habilitarCsv(opcionCsv, () => archivoCsv(evento, semanas));
  }

  document
    .querySelectorAll<HTMLElement>('[data-nac-evento]')
    .forEach((seccion) => {
      void iniciar(seccion);
    });
</script>
