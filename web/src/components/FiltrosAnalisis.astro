---
import AyudaTermino from './AyudaTermino.astro';
import SelectorSemanaEpi from './SelectorSemanaEpi.astro';
import { aniosClimaPresentacion } from '../lib/tipos-analisis';
---

<div id="analisis-filtros-popover" hidden>
  <div
    id="analisis-filtros-fondo"
    class="fixed inset-0 z-40 cursor-default bg-ink/30 lg:hidden"
    aria-hidden="true"
  >
  </div>
  {
    /* El 18rem del max-h de escritorio no es arbitrario: el dialogo se ancla
    bajo la barra pegajosa, que con la cinta de semanas mide 168px y se detiene
    en top:96. Su borde superior cae en 96 + 168 + 8 = 272px, asi que restar
    288px (18rem) es lo que deja el fondo dentro de la ventana. Si la barra
    vuelve a cambiar de alto, hay que volver a derivar este numero: ningun test
    lo cubre, porque las afirmaciones del dialogo son horizontales. */
  }
  <aside
    id="analisis-filtros-dialogo"
    role="dialog"
    tabindex="-1"
    aria-labelledby="filtros-analisis-titulo"
    class="fixed inset-x-0 bottom-0 z-50 flex max-h-[calc(100dvh-5rem)] flex-col overflow-y-auto rounded-t-2xl border border-border bg-surface p-5 shadow-2xl backdrop-blur sm:p-6 lg:absolute lg:inset-auto lg:right-0 lg:top-[calc(100%+0.5rem)] lg:max-h-[calc(100vh-18rem)] lg:w-[min(1180px,calc(100vw-3rem))] lg:rounded-2xl"
  >
    <section aria-labelledby="filtros-analisis-titulo" class="flex flex-col">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2
            id="filtros-analisis-titulo"
            class="font-sans text-base font-semibold text-ink"
          >
            Filtros de análisis
          </h2>
          <p class="mt-1 font-sans text-xs leading-relaxed text-ink-muted">
            Ajusta el periodo, el departamento y la serie utilizados por las
            vistas del workspace.
          </p>
        </div>
        <button
          id="analisis-cerrar-filtros"
          type="button"
          class="flex min-h-[44px] min-w-[44px] items-center justify-center shrink-0 rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-lg leading-none text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          aria-label="Cerrar filtros"
        >
          ×
        </button>
      </div>

      <div class="mt-5 flex flex-col gap-5">
        <!-- Grupo 1: Periodo -->
        <fieldset class="flex flex-col gap-3">
          <legend class="font-sans text-xs font-semibold text-ink">
            Periodo
          </legend>
          <div class="grid gap-3 md:grid-cols-12">
            <label
              class="flex flex-col gap-1 font-sans text-xs font-medium text-ink-muted md:col-span-3"
            >
              Año
              <select
                id="analisis-anio"
                class="rounded-lg border border-border bg-bg px-3 py-2 font-sans text-sm font-normal tabular-nums text-ink"
              >
                {
                  aniosClimaPresentacion().map((anio) => (
                    <option value={anio} selected={anio === 2023}>
                      {anio}
                    </option>
                  ))
                }
              </select>
            </label>

            <label
              class="flex flex-col gap-1 font-sans text-xs font-medium text-ink-muted md:col-span-3"
            >
              Periodo MINSAL
              <select
                id="analisis-modo-minsal"
                class="rounded-lg border border-border bg-bg px-3 py-2 font-sans text-sm font-normal normal-case text-ink"
              >
                <option value="semana">Semana seleccionada</option>
                <option value="ytd">Acumulado del año (YTD)</option>
                <option value="historico">Histórico completo</option>
              </select>
            </label>

            <div
              class="flex flex-col gap-2 rounded-xl border border-border bg-bg p-3 font-sans text-xs font-medium text-ink-muted md:col-span-6"
            >
              <div class="flex items-center justify-between gap-2">
                <span>Semana activa:</span>
                <output
                  id="analisis-semana-valor"
                  class="font-sans tabular-nums text-ink font-semibold"
                  >SE01</output
                >
              </div>

              <!-- Selector en calendario epidemiológico -->
              <SelectorSemanaEpi
                id="filtros-selector-semana"
                sincronizarAnalisis={true}
                mostrarRangoFechas={true}
                class="w-full"
              />

              <label class="sr-only" for="analisis-semana">
                Deslizador de semana epidemiológica activa
              </label>
              <input
                id="analisis-semana"
                type="range"
                min="1"
                max="53"
                value="1"
                aria-valuetext="Semana epidemiológica 1"
                class="w-full accent-accent"
              />
            </div>

            <fieldset
              class="grid grid-cols-1 md:grid-cols-2 gap-3 rounded-xl border border-border bg-bg p-3 md:col-span-12"
            >
              <legend class="px-1 font-sans text-xs font-medium text-ink-muted">
                Rango de comparación
              </legend>
              <div
                class="flex flex-col gap-2 font-sans text-xs font-medium text-ink-muted"
              >
                <div class="flex items-center justify-between">
                  <span>Desde:</span>
                  <output
                    id="analisis-desde-valor"
                    class="font-sans tabular-nums text-ink font-semibold"
                    >SE01</output
                  >
                </div>
                <SelectorSemanaEpi
                  id="filtros-selector-desde"
                  semana={1}
                  mostrarRangoFechas={true}
                  etiqueta="Semana inicial de comparación"
                  class="w-full"
                />
                <label class="sr-only" for="analisis-desde">
                  Deslizador semana inicial de comparación
                </label>
                <input
                  id="analisis-desde"
                  type="range"
                  min="1"
                  max="53"
                  value="1"
                  aria-valuetext="Semana epidemiológica 1"
                  class="w-full accent-accent"
                />
              </div>
              <div
                class="flex flex-col gap-2 font-sans text-xs font-medium text-ink-muted"
              >
                <div class="flex items-center justify-between">
                  <span>Hasta:</span>
                  <output
                    id="analisis-hasta-valor"
                    class="font-sans tabular-nums text-ink font-semibold"
                    >SE53</output
                  >
                </div>
                <SelectorSemanaEpi
                  id="filtros-selector-hasta"
                  semana={53}
                  mostrarRangoFechas={true}
                  etiqueta="Semana final de comparación"
                  class="w-full"
                />
                <label class="sr-only" for="analisis-hasta">
                  Deslizador semana final de comparación
                </label>
                <input
                  id="analisis-hasta"
                  type="range"
                  min="1"
                  max="53"
                  value="53"
                  aria-valuetext="Semana epidemiológica 53"
                  class="w-full accent-accent"
                />
              </div>
            </fieldset>
          </div>
        </fieldset>

        <!-- Grupo 2: Serie y territorio -->
        <fieldset class="flex flex-col gap-3 border-t border-border pt-4">
          <legend class="font-sans text-xs font-semibold text-ink">
            Serie y territorio
          </legend>
          <div class="grid gap-3 md:grid-cols-12">
            <fieldset class="flex flex-col gap-1 md:col-span-6">
              <span
                class="flex items-center gap-1 font-sans text-xs font-medium text-ink-muted"
              >
                Serie MINSAL
                <AyudaTermino clave="probable" />
                <AyudaTermino clave="confirmado" />
              </span>
              <div
                class="flex min-h-10 items-center gap-4 rounded-lg border border-border bg-bg px-3 py-2"
              >
                <label
                  class="flex items-center gap-2 font-sans text-sm text-ink"
                >
                  <input
                    type="radio"
                    name="analisis-serie"
                    value="probable"
                    checked
                  /> Probable
                </label>
                <label
                  class="flex items-center gap-2 font-sans text-sm text-ink"
                >
                  <input
                    type="radio"
                    name="analisis-serie"
                    value="confirmado"
                  /> Confirmado
                </label>
              </div>
            </fieldset>

            <label
              class="flex flex-col gap-1 font-sans text-xs font-medium text-ink-muted md:col-span-6"
            >
              Departamento
              <select
                id="analisis-departamento"
                class="rounded-lg border border-border bg-bg px-3 py-2 font-sans text-sm font-normal normal-case text-ink"
              >
                <option value="">Todos</option>
              </select>
            </label>
          </div>
        </fieldset>

        <!-- Grupo 3: Comparación -->
        <fieldset
          class="flex flex-col gap-3 border-t border-border pt-4"
          aria-describedby="analisis-comparar-ayuda"
        >
          <legend class="font-sans text-xs font-semibold text-ink">
            Comparar departamentos
          </legend>
          <div class="rounded-xl border border-border bg-bg p-3">
            <div
              id="analisis-comparar"
              class="grid gap-x-5 gap-y-2 sm:grid-cols-2 lg:grid-cols-4"
            >
            </div>
            <span
              id="analisis-comparar-ayuda"
              class="mt-2 block font-sans text-[11px] font-normal normal-case text-ink-muted"
            >
              Selecciona hasta cuatro departamentos. 0 de 4 seleccionados.
            </span>
          </div>
        </fieldset>
      </div>

      <!-- Barra de acciones fija al fondo -->
      <div
        class="sticky bottom-0 z-10 -mx-5 -mb-5 mt-5 border-t border-border bg-surface/95 px-5 py-3.5 backdrop-blur sm:-mx-6 sm:-mb-6 sm:px-6"
      >
        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <button
            id="analisis-limpiar-filtros"
            type="button"
            class="flex min-h-[44px] items-center rounded-lg border border-border bg-bg px-3 py-2 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            Limpiar filtros
          </button>
          <div class="flex flex-wrap gap-2">
            <button
              id="analisis-exportar"
              type="button"
              class="flex min-h-[44px] items-center rounded-lg border border-border bg-bg px-3 py-2 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-50"
            >
              Descargar vista
            </button>
            <button
              id="analisis-copiar-enlace"
              type="button"
              class="flex min-h-[44px] items-center rounded-lg border border-border bg-bg px-3 py-2 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-50"
            >
              Copiar enlace
            </button>
          </div>
        </div>

        <div class="mt-2 flex flex-col gap-1 sm:flex-row sm:justify-between">
          <p
            id="analisis-filtros-estado"
            class="font-sans text-xs text-ink-muted"
            role="status"
          >
            Cargando departamentos disponibles…
          </p>
          <p
            id="analisis-acciones-estado"
            class="min-h-4 font-sans text-xs text-ink-muted"
            role="status"
          >
          </p>
        </div>
      </div>
    </section>
  </aside>
</div>

<script>
  import { obtenerDatasetAnalitico } from '../lib/analisis-api';
  import { exportarAnalisisCsv } from '../lib/analisis-export';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    restablecerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../lib/analisis-state';
  import {
    esAnioAnalisisDengue,
    type AnioAnalisisDengue,
    type ModoMinsal,
    type SerieEpidemiologica,
  } from '../lib/tipos-analisis';

  const selectAnio = document.getElementById(
    'analisis-anio',
  ) as HTMLSelectElement | null;
  const selectDepartamento = document.getElementById(
    'analisis-departamento',
  ) as HTMLSelectElement | null;
  const contenedorComparar = document.getElementById('analisis-comparar');
  const selectModoMinsal = document.getElementById(
    'analisis-modo-minsal',
  ) as HTMLSelectElement | null;
  const semana = document.getElementById(
    'analisis-semana',
  ) as HTMLInputElement | null;
  const desde = document.getElementById(
    'analisis-desde',
  ) as HTMLInputElement | null;
  const hasta = document.getElementById(
    'analisis-hasta',
  ) as HTMLInputElement | null;
  const semanaValor = document.getElementById(
    'analisis-semana-valor',
  ) as HTMLOutputElement | null;
  const desdeValor = document.getElementById(
    'analisis-desde-valor',
  ) as HTMLOutputElement | null;
  const hastaValor = document.getElementById(
    'analisis-hasta-valor',
  ) as HTMLOutputElement | null;
  const ayudaComparar = document.getElementById('analisis-comparar-ayuda');
  const estadoCarga = document.getElementById('analisis-filtros-estado');
  const estadoAcciones = document.getElementById('analisis-acciones-estado');
  const botonExportar = document.getElementById(
    'analisis-exportar',
  ) as HTMLButtonElement | null;
  const botonCopiar = document.getElementById(
    'analisis-copiar-enlace',
  ) as HTMLButtonElement | null;
  const botonLimpiar = document.getElementById(
    'analisis-limpiar-filtros',
  ) as HTMLButtonElement | null;

  const selectorDesde = document.getElementById('filtros-selector-desde');
  const selectorHasta = document.getElementById('filtros-selector-hasta');

  const etiquetaSemana = (valor: number) =>
    `SE${String(valor).padStart(2, '0')}`;
  let cargaActual = 0;
  let timerCopiado: ReturnType<typeof setTimeout> | null = null;

  function crearOpcion(valor: string, etiqueta: string): HTMLOptionElement {
    const opcion = document.createElement('option');
    opcion.value = valor;
    opcion.textContent = etiqueta;
    return opcion;
  }

  function crearControlComparacion(
    codigo: string,
    nombre: string,
  ): HTMLLabelElement {
    const etiqueta = document.createElement('label');
    etiqueta.className =
      'flex items-center gap-2 rounded-lg px-2 py-1.5 font-sans text-sm text-ink transition-colors hover:bg-secondary/30';
    const casilla = document.createElement('input');
    casilla.type = 'checkbox';
    casilla.name = 'analisis-comparar';
    casilla.value = codigo;
    casilla.className = 'accent-accent';
    casilla.addEventListener('change', () => {
      const actuales = obtenerFiltrosAnalisis().comparar;
      const comparar = casilla.checked
        ? [...actuales, casilla.value].slice(0, 4)
        : actuales.filter((codigoActual) => codigoActual !== casilla.value);
      actualizarFiltrosAnalisis({ comparar });
      sincronizarControles();
    });
    etiqueta.append(casilla, nombre);
    return etiqueta;
  }

  function sincronizarControles() {
    const filtros = obtenerFiltrosAnalisis();
    if (selectAnio) selectAnio.value = String(filtros.anio);
    if (selectDepartamento)
      selectDepartamento.value = filtros.departamento ?? '';
    if (selectModoMinsal) selectModoMinsal.value = filtros.modoMinsal;
    if (semana) semana.value = String(filtros.semana);
    if (desde) desde.value = String(filtros.semanaDesde);
    if (hasta) hasta.value = String(filtros.semanaHasta);
    if (semanaValor) semanaValor.value = etiquetaSemana(filtros.semana);
    if (desdeValor) desdeValor.value = etiquetaSemana(filtros.semanaDesde);
    if (hastaValor) hastaValor.value = etiquetaSemana(filtros.semanaHasta);
    selectorDesde?.dispatchEvent(
      new CustomEvent('ajustar-semana', {
        detail: { anio: filtros.anio, semana: filtros.semanaDesde },
      }),
    );
    selectorHasta?.dispatchEvent(
      new CustomEvent('ajustar-semana', {
        detail: { anio: filtros.anio, semana: filtros.semanaHasta },
      }),
    );
    if (semana)
      semana.setAttribute(
        'aria-valuetext',
        `Semana epidemiológica ${filtros.semana}`,
      );
    if (desde)
      desde.setAttribute(
        'aria-valuetext',
        `Semana epidemiológica ${filtros.semanaDesde}`,
      );
    if (hasta)
      hasta.setAttribute(
        'aria-valuetext',
        `Semana epidemiológica ${filtros.semanaHasta}`,
      );
    document
      .querySelectorAll<HTMLInputElement>('input[name="analisis-serie"]')
      .forEach((radio) => {
        radio.checked = radio.value === filtros.serie;
      });
    const limiteComparacionAlcanzado = filtros.comparar.length >= 4;
    document
      .querySelectorAll<HTMLInputElement>('input[name="analisis-comparar"]')
      .forEach((casilla) => {
        casilla.checked = filtros.comparar.includes(casilla.value);
        casilla.disabled = limiteComparacionAlcanzado && !casilla.checked;
      });
    if (ayudaComparar) {
      ayudaComparar.textContent = `Selecciona hasta cuatro departamentos. ${filtros.comparar.length} de 4 seleccionados.`;
    }
  }

  async function cargarDepartamentos(anio: number) {
    const idCarga = ++cargaActual;
    const anioCatalogo: AnioAnalisisDengue = esAnioAnalisisDengue(anio)
      ? anio
      : 2023;
    if (estadoCarga)
      estadoCarga.textContent = `Cargando departamentos para ${anio}…`;
    try {
      const datos = await obtenerDatasetAnalitico(anioCatalogo);
      if (idCarga !== cargaActual) return;
      if (selectDepartamento) {
        selectDepartamento.replaceChildren(
          crearOpcion('', 'Todos'),
          ...datos.departamentos.map((departamento) =>
            crearOpcion(departamento.codigo, departamento.nombre),
          ),
        );
      }
      if (contenedorComparar) {
        contenedorComparar.replaceChildren(
          ...datos.departamentos.map((departamento) =>
            crearControlComparacion(departamento.codigo, departamento.nombre),
          ),
        );
      }
      sincronizarControles();
      if (estadoCarga) {
        estadoCarga.textContent = esAnioAnalisisDengue(anio)
          ? `${datos.departamentos.length} departamentos disponibles para ${anio}.`
          : `${datos.departamentos.length} departamentos. El año ${anio} solo tiene capa climática; los casos MINSAL se detienen en 2023.`;
      }
    } catch {
      if (idCarga !== cargaActual) return;
      if (estadoCarga)
        estadoCarga.textContent =
          'No se pudo cargar la lista de departamentos. Recarga la página para reintentarlo.';
    }
  }

  selectAnio?.addEventListener('change', () => {
    const anio = Number(selectAnio.value);
    actualizarFiltrosAnalisis({ anio });
    cargarDepartamentos(anio);
  });
  selectDepartamento?.addEventListener('change', () => {
    actualizarFiltrosAnalisis({
      departamento: selectDepartamento.value || null,
    });
  });
  selectModoMinsal?.addEventListener('change', () => {
    actualizarFiltrosAnalisis({
      modoMinsal: selectModoMinsal.value as ModoMinsal,
    });
  });
  semana?.addEventListener('input', () =>
    actualizarFiltrosAnalisis({ semana: Number(semana.value) }),
  );
  desde?.addEventListener('input', () =>
    actualizarFiltrosAnalisis({ semanaDesde: Number(desde.value) }),
  );
  hasta?.addEventListener('input', () =>
    actualizarFiltrosAnalisis({ semanaHasta: Number(hasta.value) }),
  );
  selectorDesde?.addEventListener('cambio-semana', ((
    ev: CustomEvent<{ semana: number }>,
  ) => {
    actualizarFiltrosAnalisis({ semanaDesde: ev.detail.semana });
  }) as EventListener);
  selectorHasta?.addEventListener('cambio-semana', ((
    ev: CustomEvent<{ semana: number }>,
  ) => {
    actualizarFiltrosAnalisis({ semanaHasta: ev.detail.semana });
  }) as EventListener);
  document
    .querySelectorAll<HTMLInputElement>('input[name="analisis-serie"]')
    .forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked)
          actualizarFiltrosAnalisis({
            serie: radio.value as SerieEpidemiologica,
          });
      });
    });
  botonExportar?.addEventListener('click', async () => {
    if (!botonExportar) return;
    const textoOriginal = 'Descargar vista actual';
    botonExportar.disabled = true;
    botonExportar.textContent = 'Preparando…';
    if (estadoAcciones) estadoAcciones.textContent = 'Preparando CSV…';
    try {
      const filas = await exportarAnalisisCsv(obtenerFiltrosAnalisis());
      if (estadoAcciones)
        estadoAcciones.textContent = `CSV generado con ${filas} filas filtradas.`;
    } catch {
      if (estadoAcciones)
        estadoAcciones.textContent =
          'No se pudo generar el CSV. Inténtalo de nuevo.';
    } finally {
      botonExportar.disabled = false;
      botonExportar.textContent = textoOriginal;
    }
  });
  botonCopiar?.addEventListener('click', async () => {
    if (!botonCopiar) return;
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (estadoAcciones)
        estadoAcciones.textContent = 'Enlace a esta vista copiado.';
      botonCopiar.textContent = '¡Copiado!';
      botonCopiar.classList.add('text-accent', 'border-accent/50');
      if (timerCopiado) clearTimeout(timerCopiado);
      timerCopiado = setTimeout(() => {
        botonCopiar.textContent = 'Copiar enlace';
        botonCopiar.classList.remove('text-accent', 'border-accent/50');
      }, 2000);
    } catch {
      if (estadoAcciones)
        estadoAcciones.textContent =
          'No se pudo copiar el enlace. Cópialo desde la barra de direcciones.';
    }
  });
  botonLimpiar?.addEventListener('click', () => {
    restablecerFiltrosAnalisis();
    if (estadoAcciones)
      estadoAcciones.textContent =
        'Filtros restablecidos a los valores predeterminados.';
  });

  suscribirFiltrosAnalisis(sincronizarControles);
  cargarDepartamentos(obtenerFiltrosAnalisis().anio);
</script>
