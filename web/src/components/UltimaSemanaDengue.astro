---
// Franja de la última semana publicada por el tablero de MINSAL y su par del
// año anterior. Se usa en /dengue y en /incrustar/ultima-semana. Sale de
// endpoints que ya usan otros paneles (casos-nacional, vigilancia/integridad);
// no hay lectura de riesgo ni umbral. La predicción de la semana siguiente
// vive solo en /prediccion.
import { RUTA_PREDICCION, RUTA_SENSIBILIDAD } from '../lib/enlaces';
import BotonIncrustar from './BotonIncrustar.astro';

// Copia de la serie tomada al compilar: la franja se pinta al instante con ella
// y luego se actualiza desde la API. Si el backend no responde durante el
// build, el sitio compila igual y la franja carga como siempre.
const API_BUILD = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
let instantanea: { generado: string; casos: unknown[] } | null = null;
if (!import.meta.env.DEV) {
  try {
    const respuesta = await fetch(`${API_BUILD}/api/casos-nacional`, {
      signal: AbortSignal.timeout(5000),
    });
    if (respuesta.ok) {
      const datos: unknown = await respuesta.json();
      if (Array.isArray(datos)) {
        instantanea = {
          generado: new Date().toISOString().slice(0, 10),
          casos: datos
            .filter((c) => c && c.fuente === 'minsal_tablero')
            .slice(-120),
        };
      }
    }
  } catch {
    instantanea = null;
  }
}

interface Props {
  class?: string;
}
const { class: clasePersonalizada } = Astro.props;
---

<section
  aria-labelledby="ultima-semana-titulo"
  data-ultima-semana
  class:list={[
    'rounded-2xl border border-border bg-surface p-4 sm:p-6 shadow-2xs',
    clasePersonalizada ?? 'mt-6',
  ]}
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2
      id="ultima-semana-titulo"
      class="font-display text-xl font-semibold text-ink"
    >
      Última semana publicada
    </h2>
    <BotonIncrustar
      ruta="/incrustar/ultima-semana"
      titulo="Última semana publicada de dengue en El Salvador"
      alto={320}
    />
  </div>
  <div
    id="ultima-semana"
    class="mt-4"
    role="status"
    aria-busy="true"
    data-ruta-sensibilidad={RUTA_SENSIBILIDAD}
    data-ruta-prediccion={RUTA_PREDICCION}
  >
    <div data-estado aria-hidden="true" class="grid gap-3 sm:grid-cols-2">
      <div class="skeleton h-24 border border-border"></div>
      <div class="skeleton h-24 border border-border"></div>
    </div>
  </div>
</section>

<script
  is:inline
  type="application/json"
  id="ultima-semana-instantanea"
  set:html={JSON.stringify(instantanea)}
/>

<script>
  import {
    obtenerCasosNacionales,
    obtenerIntegridadVigilancia,
  } from '../lib/analisis-api';
  import { resumirUltimaSemana } from '../lib/resumen-semana';
  import { escapeHtml } from '../utils/security';
  import { renderErrorFuente, renderSinDato } from './estado-async';
  import type {
    CasoNacionalSemanal,
    IntegridadVigilancia,
  } from '../lib/tipos-analisis';

  const fmtNum = new Intl.NumberFormat('es-SV');
  const fmtFecha = new Intl.DateTimeFormat('es-SV', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });

  function fecha(iso: string): string {
    return fmtFecha.format(new Date(`${iso}T00:00:00`));
  }

  function se(n: number): string {
    return String(n).padStart(2, '0');
  }

  function tarjeta(titulo: string, cifra: string, detalle: string): string {
    return `
      <div class="card-elevated rounded-2xl border border-border bg-surface p-4">
        <p class="font-sans text-xs font-medium text-ink-muted">${escapeHtml(titulo)}</p>
        <p class="mt-1 font-sans text-2xl font-semibold tracking-tight text-ink">${escapeHtml(cifra)}</p>
        <p class="mt-1 font-sans text-xs leading-snug text-ink-muted">${escapeHtml(detalle)}</p>
      </div>`;
  }

  type Resultado<T> = PromiseSettledResult<T> | null;

  interface Instantanea {
    generado: string;
    casos: CasoNacionalSemanal[];
  }

  function leerInstantanea(): Instantanea | null {
    try {
      const texto = document.getElementById(
        'ultima-semana-instantanea',
      )?.textContent;
      const datos = texto ? (JSON.parse(texto) as Instantanea | null) : null;
      return datos && Array.isArray(datos.casos) && datos.casos.length > 0
        ? datos
        : null;
    } catch {
      return null;
    }
  }

  // `integridad` en null: todavía cargando (copia del build).
  function pintar(
    contenedor: HTMLElement,
    casos: CasoNacionalSemanal[],
    integridad: Resultado<IntegridadVigilancia>,
    nota = '',
  ): void {
    const resumen = resumirUltimaSemana(casos);
    if (!resumen) {
      renderSinDato(
        contenedor,
        'El tablero de MINSAL todavía no tiene semanas cargadas en esta serie.',
      );
      return;
    }

    const { actual, mismaSemanaAnioAnterior: previa } = resumen;
    const partes: string[] = [];

    partes.push(
      tarjeta(
        `SE${se(actual.semana_epi)}/${actual.anio}, casos sospechosos`,
        fmtNum.format(actual.conteo),
        `Semana del ${fecha(actual.semana_inicio)}.`,
      ),
    );

    if (previa && resumen.diferencia !== null) {
      const signo = resumen.diferencia > 0 ? '+' : '';
      const pct =
        resumen.variacionPct === null
          ? ''
          : ` (${signo}${resumen.variacionPct.toFixed(0)} %)`;
      partes.push(
        tarjeta(
          `Misma semana de ${previa.anio}`,
          fmtNum.format(previa.conteo),
          `Diferencia: ${signo}${fmtNum.format(resumen.diferencia)}${pct}.`,
        ),
      );
    } else {
      partes.push(
        tarjeta(
          `Misma semana de ${actual.anio - 1}`,
          'Sin dato',
          'El tablero no publicó esa semana.',
        ),
      );
    }

    const antig =
      integridad?.status === 'fulfilled'
        ? integridad.value.antiguedad?.dengue_tablero_nacional
        : undefined;
    const antiguedad =
      antig && antig.ultima_anio !== null && antig.ultima_semana_epi !== null
        ? `Última semana en la base: SE${se(antig.ultima_semana_epi)}/${antig.ultima_anio}. `
        : '';
    const ruta = contenedor.dataset.rutaSensibilidad ?? '';
    const rutaPrediccion = contenedor.dataset.rutaPrediccion ?? '';

    contenedor.innerHTML = `
      <div class="grid gap-3 sm:grid-cols-2">${partes.join('')}</div>
      <p class="mt-3 font-sans text-xs leading-relaxed text-ink-muted">
        ${escapeHtml(nota)}${escapeHtml(antiguedad)}El tablero publica cada semana como un promedio de varias.
        <a href="${escapeHtml(ruta)}" class="font-medium text-accent underline underline-offset-2">Cómo leer estas cifras</a>.
      </p>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-sans text-sm">
        <a href="${escapeHtml(rutaPrediccion)}" class="font-medium text-accent underline underline-offset-2">Ver predicción</a>
        <a href="#curva" class="font-medium text-accent underline underline-offset-2">Curva nacional</a>
      </p>`;
    contenedor.setAttribute(
      'aria-busy',
      integridad === null ? 'true' : 'false',
    );
  }

  async function iniciar() {
    const contenedor = document.getElementById('ultima-semana');
    if (!contenedor) return;
    contenedor.setAttribute('aria-busy', 'true');

    const instantanea = leerInstantanea();
    const notaInstantanea = instantanea
      ? `Cifras guardadas al publicar el sitio (${fecha(instantanea.generado)}); se actualizan al cargar. `
      : '';
    if (instantanea) {
      pintar(contenedor, instantanea.casos, null, notaInstantanea);
    }

    const [casos, integridad] = await Promise.allSettled([
      obtenerCasosNacionales(),
      obtenerIntegridadVigilancia(),
    ]);

    if (casos.status === 'rejected') {
      if (instantanea) {
        pintar(
          contenedor,
          instantanea.casos,
          integridad,
          `No se pudo actualizar; se muestran las cifras guardadas al publicar el sitio (${fecha(instantanea.generado)}). `,
        );
      } else {
        renderErrorFuente(contenedor, () => void iniciar());
      }
      return;
    }
    pintar(contenedor, casos.value, integridad);
  }

  void iniciar();
</script>
