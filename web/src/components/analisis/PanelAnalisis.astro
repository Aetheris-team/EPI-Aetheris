---
import { ANIOS_ANALISIS_DENGUE } from '../../lib/tipos-analisis';
import Icono from '../Icono.astro';
import CalendarioEpidemico from './CalendarioEpidemico.astro';
import ComparacionDepartamentos from './ComparacionDepartamentos.astro';
import ComparacionTemporadas from './ComparacionTemporadas.astro';
import DisponibilidadDatos from './DisponibilidadDatos.astro';
import FiltrosAnalisis from '../FiltrosAnalisis.astro';
import HeatmapDepartamentos from './HeatmapDepartamentos.astro';
import MapaDepartamentos from '../MapaDepartamentos.astro';
import PerfilCalidadDatos from './PerfilCalidadDatos.astro';
import ScatterClimaPresion from './ScatterClimaPresion.astro';
import SelectorPaneles from './SelectorPaneles.astro';
import CanalEndemico from './CanalEndemico.astro';
import SerieDepartamento from './SerieDepartamento.astro';
import ToolbarAnalisis from './ToolbarAnalisis.astro';

const aniosHistorico = `${Math.min(...ANIOS_ANALISIS_DENGUE)} a ${Math.max(...ANIOS_ANALISIS_DENGUE)}`;
---

<section
  id="analisis"
  class="workspace-analitico scroll-mt-[calc(var(--alto-header)+0.5rem)]"
  aria-labelledby="panel-analisis-titulo"
>
  {
    /* Sin rotulo encima del titulo: "Workspace analitico" nombraba la seccion
    por como esta construida y no por lo que la persona hace en ella, y el
    titulo de abajo ya lo dice. La seccion se anuncia por aria-labelledby, asi
    que tampoco le aportaba nada a un lector de pantalla. */
  }
  <p
    data-cabecera-impresion
    class="mb-3 hidden font-sans text-sm font-semibold text-ink print:block"
  >
  </p>

  <header class="mb-4 max-w-3xl">
    <h2
      id="panel-analisis-titulo"
      class="font-display text-xl font-semibold text-ink"
    >
      Exploración espacial y temporal
    </h2>
    <p class="mt-2 font-sans text-sm leading-relaxed text-ink-muted">
      Histórico por departamento, {aniosHistorico} (boletines). Cada uno se compara
      contra su propia historia.
    </p>
  </header>

  <ToolbarAnalisis>
    <SelectorPaneles slot="selector-paneles" />
    <FiltrosAnalisis slot="filtros" />
  </ToolbarAnalisis>

  <div
    data-selector-movil
    role="group"
    aria-label="Panel visible"
    class="mt-4 flex flex-wrap gap-2 sm:hidden"
    hidden
  >
  </div>

  <div
    id="workspace-analitico-grid"
    class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-12"
  >
    <div data-columna-workspace="mapa" class="contents">
      <div id="mapa" data-panel-workspace="mapa" class="relative min-w-0">
        <MapaDepartamentos />
      </div>
    </div>
    <div data-columna-workspace="analisis" class="contents">
      <div data-panel-workspace="presion" class="relative min-w-0">
        <HeatmapDepartamentos />
      </div>
      <div data-grupo-workspace="comparaciones" class="contents">
        <div data-panel-workspace="temporadas" class="relative min-w-0">
          <ComparacionTemporadas />
        </div>
        <div data-panel-workspace="departamentos" class="relative min-w-0">
          <ComparacionDepartamentos />
        </div>
      </div>
    </div>
    <div data-panel-workspace="serie" class="relative min-w-0" hidden>
      <SerieDepartamento />
    </div>
    <div data-panel-workspace="canal" class="relative min-w-0" hidden>
      <CanalEndemico />
    </div>
    <div data-panel-workspace="calendario" class="relative min-w-0" hidden>
      <CalendarioEpidemico />
    </div>
    <div data-panel-workspace="clima" class="relative min-w-0" hidden>
      <ScatterClimaPresion />
    </div>
    <div data-panel-workspace="disponibilidad" class="relative min-w-0" hidden>
      <DisponibilidadDatos />
    </div>
    <div data-panel-workspace="calidad" class="relative min-w-0" hidden>
      <PerfilCalidadDatos />
    </div>
  </div>

  <template id="analisis-icono-dots-template">
    <Icono nombre="dots" class="h-5 w-5 text-ink" />
  </template>
</section>

<style>
  .workspace-analitico {
    width: min(calc(100vw - 2rem), 1840px);
    margin-inline-start: calc((100% - min(calc(100vw - 2rem), 1840px)) / 2);
  }

  /* Impresión de /dengue: sin cromo de navegación, paneles a ancho completo
     y sin cortes a mitad de gráfico. */
  @media print {
    :global(body > header),
    :global(body > footer),
    :global([data-pagina-dengue] [data-tabs]),
    :global([data-pagina-dengue] [data-nav-secciones]),
    :global([data-pagina-dengue] #toolbar-analisis-contenedor),
    :global([data-pagina-dengue] [data-selector-movil]),
    :global([data-pagina-dengue] [data-boton-menu-panel]),
    :global([data-pagina-dengue] [data-menu-panel]) {
      display: none !important;
    }
    .workspace-analitico {
      width: 100%;
      margin-inline-start: 0;
    }
    :global(#workspace-analitico-grid) {
      display: block;
    }
    :global(#workspace-analitico-grid [data-panel-workspace]) {
      grid-column: auto;
      margin-bottom: 1rem;
      break-inside: avoid;
    }
    :global(#workspace-analitico-grid [data-panel-workspace] > *) {
      overflow: visible;
    }
  }

  /* En teléfono el workspace muestra un panel a la vez: sin tamaños, foco ni
     zoom temporal, que solo tienen sentido con varias columnas. */
  @media (max-width: 639px) {
    :global([data-solo-escritorio]) {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .workspace-analitico {
      width: min(calc(100vw - 3rem), 1840px);
      margin-inline-start: calc((100% - min(calc(100vw - 3rem), 1840px)) / 2);
    }
  }
</style>

<script>
  import {
    PANELES_ANALITICOS,
    actualizarLayoutAnalisis,
    obtenerLayoutAnalisis,
    suscribirLayoutAnalisis,
  } from '../../lib/analisis-layout-state';
  import type {
    PanelAnalitico,
    TamanoPanel,
  } from '../../lib/analisis-layout-state';
  import {
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import {
    TODAS_LAS_CLASES_COL_SPAN,
    clasesColumnas,
    distribuirPaneles,
  } from '../../lib/distribucion-paneles';
  import {
    encontrarGrafico,
    exportarPng,
    exportarSvg,
  } from '../../lib/exportar-grafico';

  const paneles = document.querySelectorAll<HTMLElement>(
    '[data-panel-workspace]',
  );
  const columnaMapa = document.querySelector<HTMLElement>(
    '[data-columna-workspace="mapa"]',
  );
  const columnaAnalisis = document.querySelector<HTMLElement>(
    '[data-columna-workspace="analisis"]',
  );
  const grupoComparaciones = document.querySelector<HTMLElement>(
    '[data-grupo-workspace="comparaciones"]',
  );
  const plantillaIconoDots = document.getElementById(
    'analisis-icono-dots-template',
  ) as HTMLTemplateElement | null;
  // Orden del DOM: es el que sigue la cuadrícula al colocar los paneles.
  const ordenPaneles = Array.from(paneles).map(
    (panel) => panel.dataset.panelWorkspace as PanelAnalitico,
  );

  function esVistaGeneralOptimizada(
    layout: ReturnType<typeof obtenerLayoutAnalisis>,
  ): boolean {
    const panelesGenerales: PanelAnalitico[] = [
      'mapa',
      'presion',
      'temporadas',
      'departamentos',
    ];
    return (
      layout.vista === 'general' &&
      layout.panelEnFoco === null &&
      layout.panelesVisibles.length === panelesGenerales.length &&
      panelesGenerales.every((panel) =>
        layout.panelesVisibles.includes(panel),
      ) &&
      layout.tamanos.mapa === 'mediano' &&
      layout.tamanos.presion === 'grande' &&
      layout.tamanos.temporadas === 'grande' &&
      layout.tamanos.departamentos === 'grande'
    );
  }

  function aplicarComposicionGeneral(optimizada: boolean): void {
    if (!columnaMapa || !columnaAnalisis || !grupoComparaciones) return;
    columnaMapa.className = optimizada
      ? 'min-w-0 md:col-span-12 xl:col-span-4'
      : 'contents';
    columnaAnalisis.className = optimizada
      ? 'flex min-w-0 flex-col gap-4 md:col-span-12 xl:col-span-8'
      : 'contents';
    grupoComparaciones.className = optimizada
      ? 'grid min-w-0 grid-cols-1 gap-4 md:grid-cols-2'
      : 'contents';
  }

  // Solo las opciones realmente visibles: en móvil las de escritorio están
  // ocultas y las de exportar solo existen si el panel tiene gráfico.
  function itemsVisiblesMenu(menu: HTMLElement): HTMLElement[] {
    return Array.from(
      menu.querySelectorAll<HTMLElement>('[role^="menuitem"]'),
    ).filter((item) => !item.hidden && item.offsetParent !== null);
  }

  function cerrarMenus(devolverFoco = false): void {
    document
      .querySelectorAll<HTMLElement>('[data-menu-panel]')
      .forEach((menu) => {
        menu.hidden = true;
      });
    document
      .querySelectorAll<HTMLButtonElement>('[data-boton-menu-panel]')
      .forEach((boton) => {
        const estabaAbierto = boton.getAttribute('aria-expanded') === 'true';
        boton.setAttribute('aria-expanded', 'false');
        if (devolverFoco && estabaAbierto) boton.focus();
      });
  }

  paneles.forEach((panel) => {
    const id = panel.dataset.panelWorkspace as PanelAnalitico;
    const etiqueta =
      PANELES_ANALITICOS.find((item) => item.id === id)?.etiqueta ?? id;
    const boton = document.createElement('button');
    const menu = document.createElement('div');
    const menuId = `menu-panel-${id}`;
    boton.type = 'button';
    boton.dataset.botonMenuPanel = id;
    boton.setAttribute('aria-label', `Opciones de ${etiqueta}`);
    boton.setAttribute('aria-expanded', 'false');
    boton.setAttribute('aria-controls', menuId);
    boton.setAttribute('aria-haspopup', 'menu');
    boton.className =
      'flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md border border-border bg-surface font-sans text-xs font-semibold text-ink shadow-sm hover:border-accent/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent';
    if (plantillaIconoDots) {
      boton.appendChild(plantillaIconoDots.content.cloneNode(true));
    } else {
      boton.textContent = '⋯';
    }

    menu.id = menuId;
    menu.dataset.menuPanel = id;
    menu.setAttribute('role', 'menu');
    menu.hidden = true;
    menu.className =
      'absolute right-0 top-full z-30 mt-1 w-44 rounded-lg border border-border bg-surface p-2 shadow-lg';
    menu.innerHTML = `<p data-solo-escritorio class="px-2 py-1 font-sans text-xs font-semibold text-ink-muted">Tamaño</p><div class="grid gap-1" role="group" aria-label="Tamaño"><button type="button" role="menuitemradio" aria-checked="false" data-solo-escritorio data-accion-panel="tamano" data-valor="pequeno" class="flex w-full items-center justify-between rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30"><span>Pequeño</span><span class="marca-activa hidden text-accent" aria-hidden="true">✓</span></button><button type="button" role="menuitemradio" aria-checked="false" data-solo-escritorio data-accion-panel="tamano" data-valor="mediano" class="flex w-full items-center justify-between rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30"><span>Mediano</span><span class="marca-activa hidden text-accent" aria-hidden="true">✓</span></button><button type="button" role="menuitemradio" aria-checked="false" data-solo-escritorio data-accion-panel="tamano" data-valor="grande" class="flex w-full items-center justify-between rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30"><span>Grande</span><span class="marca-activa hidden text-accent" aria-hidden="true">✓</span></button><button type="button" role="menuitem" data-solo-escritorio data-accion-panel="foco" class="mt-1 rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30">Abrir en foco</button><button type="button" role="menuitem" data-accion-panel="ocultar" class="rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30">Ocultar panel</button><button type="button" role="menuitem" data-accion-panel="exportar-svg" hidden class="rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30">Descargar SVG</button><button type="button" role="menuitem" data-accion-panel="exportar-png" hidden class="rounded px-2 py-1 text-left font-sans text-xs hover:bg-secondary/30">Descargar PNG</button></div>`;
    boton.addEventListener('click', () => {
      const abrir = menu.hidden;
      cerrarMenus();
      // El mapa (Leaflet) no se exporta; solo los paneles con un gráfico SVG.
      const hayGrafico = encontrarGrafico(panel) !== null;
      menu
        .querySelectorAll<HTMLElement>('[data-accion-panel^="exportar"]')
        .forEach((item) => {
          item.hidden = !hayGrafico;
        });
      menu.hidden = !abrir;
      boton.setAttribute('aria-expanded', String(abrir));
      if (abrir) itemsVisiblesMenu(menu)[0]?.focus();
    });

    menu.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowDown' || evento.key === 'ArrowUp') {
        evento.preventDefault();
        const items = itemsVisiblesMenu(menu);
        const actual = items.indexOf(document.activeElement as HTMLElement);
        if (actual === -1) return;
        const siguiente =
          evento.key === 'ArrowDown'
            ? (actual + 1) % items.length
            : (actual - 1 + items.length) % items.length;
        items[siguiente]?.focus();
      }
    });

    menu.addEventListener('click', (evento) => {
      const objetivo = (
        evento.target as HTMLElement
      ).closest<HTMLButtonElement>('[data-accion-panel]');
      if (!objetivo) return;
      const accion = objetivo.dataset.accionPanel;
      if (accion === 'tamano')
        actualizarLayoutAnalisis({
          tamanos: { [id]: objetivo.dataset.valor as TamanoPanel },
        });
      if (accion === 'foco') {
        const { panelEnFoco } = obtenerLayoutAnalisis();
        actualizarLayoutAnalisis({
          panelEnFoco: panelEnFoco === id ? null : id,
        });
      }
      if (accion === 'exportar-svg' || accion === 'exportar-png') {
        const svg = encontrarGrafico(panel);
        const f = obtenerFiltrosAnalisis();
        if (svg) {
          const opciones = {
            titulo: etiqueta,
            fuente: 'EPI-Aetheris, boletines epidemiológicos de MINSAL',
            filtros: [
              f.departamento ?? 'todos los departamentos',
              String(f.anio),
              f.serie,
              `SE${f.semanaDesde}–SE${f.semanaHasta}`,
            ].join(' · '),
          };
          if (accion === 'exportar-svg') exportarSvg(svg, opciones);
          else void exportarPng(svg, opciones);
        }
      }
      if (accion === 'ocultar') {
        actualizarLayoutAnalisis({
          panelesVisibles: obtenerLayoutAnalisis().panelesVisibles.filter(
            (panelId) => panelId !== id,
          ),
        });
      }
      cerrarMenus(true);
    });

    const contenedorBoton = document.createElement('div');
    contenedorBoton.className = 'relative shrink-0';
    contenedorBoton.append(boton, menu);

    const destinoControles = panel.querySelector<HTMLElement>(
      '[data-panel-controles]',
    );
    if (destinoControles) {
      destinoControles.appendChild(contenedorBoton);
    } else {
      const cabecera = panel.querySelector<HTMLElement>('header');
      if (cabecera) {
        cabecera.classList.add('relative');
        contenedorBoton.className = 'absolute right-0 top-0';
        cabecera.appendChild(contenedorBoton);
      } else {
        contenedorBoton.className = 'absolute right-3 top-3 z-10';
        panel.appendChild(contenedorBoton);
      }
    }
  });

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape') cerrarMenus(true);
  });
  document.addEventListener('click', (evento) => {
    if (
      !(evento.target as HTMLElement).closest(
        '[data-menu-panel], [data-boton-menu-panel]',
      )
    ) {
      cerrarMenus();
    }
  });

  // Cabecera que solo se ve al imprimir: los filtros activos.
  const cabeceraImpresion = document.querySelector<HTMLElement>(
    '[data-cabecera-impresion]',
  );
  function pintarCabeceraImpresion(): void {
    if (!cabeceraImpresion) return;
    const f = obtenerFiltrosAnalisis();
    cabeceraImpresion.textContent = [
      'EPI-Aetheris · dengue',
      f.departamento ?? 'todos los departamentos',
      `año ${f.anio}`,
      `serie ${f.serie}`,
      `SE${f.semanaDesde}–SE${f.semanaHasta}`,
      new Date().toISOString().slice(0, 10),
    ].join(' · ');
  }
  pintarCabeceraImpresion();
  suscribirFiltrosAnalisis(pintarCabeceraImpresion);
  window.addEventListener('beforeprint', pintarCabeceraImpresion);

  // Modo teléfono: derivado del ancho, no se guarda en el estado del layout.
  const consultaMovil = window.matchMedia('(max-width: 639px)');
  const selectorMovil = document.querySelector<HTMLElement>(
    '[data-selector-movil]',
  );
  let panelMovil: PanelAnalitico | null = null;
  let layoutActual = obtenerLayoutAnalisis();

  function aplicarModoMovil(): void {
    if (!selectorMovil) return;
    const movil = consultaMovil.matches;
    selectorMovil.hidden = !movil;
    if (!movil) {
      // Al volver a escritorio manda de nuevo el layout guardado.
      paneles.forEach((panel) => {
        const id = panel.dataset.panelWorkspace as PanelAnalitico;
        panel.hidden = !layoutActual.panelesVisibles.includes(id);
      });
      return;
    }
    const visibles = layoutActual.panelesVisibles;
    if (!panelMovil || !visibles.includes(panelMovil)) {
      panelMovil = visibles[0] ?? null;
    }
    selectorMovil.replaceChildren(
      ...visibles.map((id) => {
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.dataset.panelMovil = id;
        boton.setAttribute('aria-pressed', String(id === panelMovil));
        boton.className =
          'min-h-[44px] rounded-full border border-border bg-surface px-3 font-sans text-xs font-semibold text-ink aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-accent-ink';
        boton.textContent =
          PANELES_ANALITICOS.find((item) => item.id === id)?.etiqueta ?? id;
        boton.addEventListener('click', () => {
          panelMovil = id;
          aplicarModoMovil();
          window.dispatchEvent(new Event('resize'));
        });
        return boton;
      }),
    );
    paneles.forEach((panel) => {
      const id = panel.dataset.panelWorkspace as PanelAnalitico;
      panel.hidden = !(visibles.includes(id) && id === panelMovil);
    });
  }
  consultaMovil.addEventListener('change', () => {
    aplicarModoMovil();
    window.dispatchEvent(new Event('resize'));
  });

  let primerPaseLayout = true;

  suscribirLayoutAnalisis((layout) => {
    const vistaGeneralOptimizada = esVistaGeneralOptimizada(layout);
    aplicarComposicionGeneral(vistaGeneralOptimizada);
    // Anchos de fila completa: solo cuentan los paneles visibles, en el
    // orden del DOM, y un panel en foco ocupa su propia fila.
    const distribucion = distribuirPaneles(
      ordenPaneles
        .filter((id) => layout.panelesVisibles.includes(id))
        .map((id) => ({
          id,
          tamano: layout.tamanos[id],
          enFoco: layout.panelEnFoco === id,
        })),
    );
    paneles.forEach((panel) => {
      const id = panel.dataset.panelWorkspace as PanelAnalitico;
      const debeEstarVisible = layout.panelesVisibles.includes(id);
      const estabaOculto = panel.hidden;

      panel.hidden = !debeEstarVisible;

      if (!primerPaseLayout && estabaOculto && debeEstarVisible) {
        panel.setAttribute('data-panel-nuevo', '');
        panel.addEventListener(
          'animationend',
          () => panel.removeAttribute('data-panel-nuevo'),
          { once: true },
        );
      }

      panel.classList.remove(...TODAS_LAS_CLASES_COL_SPAN);
      if (!vistaGeneralOptimizada && debeEstarVisible) {
        panel.classList.add(...clasesColumnas(distribucion[id]));
      }
      const botonFoco = panel.querySelector<HTMLButtonElement>(
        '[data-accion-panel="foco"]',
      );
      if (botonFoco) {
        const spanTexto = botonFoco.querySelector('span');
        const texto =
          layout.panelEnFoco === id ? 'Salir de foco' : 'Abrir en foco';
        if (spanTexto) {
          spanTexto.textContent = texto;
        } else {
          botonFoco.textContent = texto;
        }
      }

      // Actualizar estado activo de las opciones de tamaño en el menú
      const tamanoActual = layout.tamanos[id];
      const itemsTamano = panel.querySelectorAll<HTMLButtonElement>(
        '[data-accion-panel="tamano"]',
      );
      itemsTamano.forEach((item) => {
        const esActivo = item.dataset.valor === tamanoActual;
        item.setAttribute('aria-checked', String(esActivo));
        const marca = item.querySelector<HTMLElement>('.marca-activa');
        if (marca) marca.classList.toggle('hidden', !esActivo);
      });
    });
    primerPaseLayout = false;
    layoutActual = layout;
    aplicarModoMovil();
    aplicarZoomTemporal(layout.zoomTemporal);
  });

  let revelacionIniciada = false;
  function orquestarRevelacionInicial(): void {
    if (revelacionIniciada) return;
    if (
      typeof document !== 'undefined' &&
      !document.documentElement.hasAttribute('data-animar')
    ) {
      return;
    }
    const grid = document.getElementById('workspace-analitico-grid');
    if (!grid) return;
    revelacionIniciada = true;
    const visibles = Array.from(
      grid.querySelectorAll<HTMLElement>(
        '[data-panel-workspace]:not([hidden])',
      ),
    );
    visibles.forEach((panel, i) => {
      panel.style.setProperty('--revelacion-retraso', `${i * 60}ms`);
    });
    grid.classList.add('workspace-revelacion');
    setTimeout(() => {
      grid.classList.remove('workspace-revelacion');
      visibles.forEach((panel) => {
        panel.style.removeProperty('--revelacion-retraso');
      });
    }, 800);
  }

  window.addEventListener('epi:datos-cargados', orquestarRevelacionInicial, {
    once: true,
  });
  setTimeout(orquestarRevelacionInicial, 600);

  function aplicarZoomTemporal(zoom: number): void {
    const anchosBase: Record<string, number> = {
      'heatmap-departamentos': 760,
      'calendario-epidemico': 760,
      'comparacion-temporadas': 720,
      'comparacion-departamentos': 720,
    };
    Object.entries(anchosBase).forEach(([id, ancho]) => {
      const grafica = document.getElementById(id);
      const anchoDisponible = grafica?.parentElement?.clientWidth ?? 0;
      if (grafica) {
        grafica.style.minWidth = `${(Math.max(ancho, anchoDisponible) * zoom) / 100}px`;
      }
    });
  }

  window.addEventListener('resize', () => {
    aplicarZoomTemporal(obtenerLayoutAnalisis().zoomTemporal);
  });
</script>
