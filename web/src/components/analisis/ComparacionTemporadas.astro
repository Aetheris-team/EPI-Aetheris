---
import PanelWorkspace from './PanelWorkspace.astro';
---

<PanelWorkspace
  tipo="traza"
  titulo="Comparación de temporadas"
  descripcion="Compara las semanas observadas del departamento entre los años disponibles. Las líneas se interrumpen cuando falta una observación; los huecos no se rellenan."
>
  <div
    data-vacio-temporadas
    class="mt-4 flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-bg/50 p-8 text-center"
  >
    <p class="font-sans text-sm text-ink-muted">
      Elige un departamento en el mapa o en Filtros para comparar sus
      temporadas.
    </p>
    <button
      type="button"
      data-abrir-filtros-accion
      class="mt-3 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-accent transition-colors hover:border-accent/40"
    >
      Abrir filtros
    </button>
  </div>

  <div
    id="comparacion-temporadas-grafica"
    class="mt-4 overflow-x-auto scroll-shadow-x"
    tabindex="0"
    hidden
  >
    <div
      id="comparacion-temporadas"
      class="min-h-[340px] min-w-[720px]"
      role="region"
      aria-label="Comparación de conteos semanales por temporada para el departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[340px] w-full min-w-[720px] flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
  </div>

  <details
    id="temporadas-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="temporadas-tabla-contenedor"></div>
  </details>

  <p
    id="comparacion-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import { escapeHtml } from '../../utils/security';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import { obtenerDatasetAnalitico } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { montarGrafico } from '../../lib/echarts-montaje';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import {
    crearOpcionBase,
    ejeSemana,
    ejeValores,
    etiquetaSemana,
    marcaSemana,
    tooltipSeries,
  } from '../../lib/echarts-tema';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    ANIOS_ANALISIS_DENGUE,
    esAnioAnalisisDengue,
  } from '../../lib/tipos-analisis';
  import { colorCualitativo } from '../../lib/colores';
  import type {
    AnioAnalisisDengue,
    FiltrosAnalisis,
  } from '../../lib/tipos-analisis';

  interface PuntoTemporada {
    anio: number;
    semana: number;
    casos: number | null;
    departamento: string;
  }

  const contenedor = document.getElementById('comparacion-temporadas');
  const marcoGrafica = document.getElementById(
    'comparacion-temporadas-grafica',
  );
  const vacioContenedor = document.querySelector<HTMLElement>(
    '[data-vacio-temporadas]',
  );
  const resumen = document.getElementById('comparacion-resumen');
  let revision = 0;
  let grafico: GraficoMontado | null = null;
  let filtrosActuales = obtenerFiltrosAnalisis();
  let datosTabla: PuntoTemporada[] = [];

  const detailsTabla = document.getElementById(
    'temporadas-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById(
    'temporadas-tabla-contenedor',
  );

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Comparación de temporadas para el departamento activo',
          columnas: [
            { clave: 'anio', encabezado: 'Año' },
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'casos',
              encabezado: 'Casos observados',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? String(v) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  vacioContenedor
    ?.querySelector('[data-abrir-filtros-accion]')
    ?.addEventListener('click', () => {
      document.getElementById('analisis-abrir-filtros')?.click();
    });

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    const idRevision = ++revision;
    grafico?.destruir();
    grafico = null;
    if (!filtros.departamento) {
      contenedor.replaceChildren();
      if (marcoGrafica) marcoGrafica.hidden = true;
      if (vacioContenedor) vacioContenedor.hidden = false;
      if (resumen)
        resumen.textContent =
          'Selecciona un departamento en los filtros o en el mapa.';
      return;
    }
    if (vacioContenedor) vacioContenedor.hidden = true;
    if (marcoGrafica) marcoGrafica.hidden = false;
    if (resumen) resumen.textContent = 'Cargando temporadas históricas…';

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoTraza(contenedor);
    try {
      const datasets = await Promise.all(
        ANIOS_ANALISIS_DENGUE.map((anio) => obtenerDatasetAnalitico(anio)),
      );
      if (idRevision !== revision) return;
      const noDisp = datasets.find((d) => esNoDisponible(d));
      if (noDisp && esNoDisponible(noDisp)) {
        renderSinDato(contenedor, motivoNoDisponible(noDisp));
        return;
      }

      const puntos: PuntoTemporada[] = datasets.flatMap((dataset) => {
        const departamento = dataset.departamentos.find(
          (fila) => fila.codigo === filtros.departamento,
        );
        if (!departamento) return [];
        return departamento.semanas
          .filter(
            (semana) =>
              semana.semana_epi >= filtros.semanaDesde &&
              semana.semana_epi <= filtros.semanaHasta,
          )
          .map((semana) => ({
            anio: dataset.anio,
            semana: semana.semana_epi,
            casos:
              filtros.serie === 'probable'
                ? semana.probable
                : semana.confirmado,
            departamento: departamento.nombre,
          }));
      });
      const seleccionada = puntos.filter(
        (punto) => punto.anio === filtros.anio,
      );
      const puntosObservados = puntos.filter((punto) => punto.casos !== null);

      datosTabla = puntosObservados;
      tablaAlternativa?.marcarCaducada();

      const nombreDepartamento =
        puntos[0]?.departamento ?? filtros.departamento;
      const indiceAnio = (anio: number) =>
        (ANIOS_ANALISIS_DENGUE as readonly number[]).indexOf(anio);
      // Una serie por año: los años de contexto van discontinuos y el año
      // destacado, continuo y por encima. Se conservan las semanas sin dato
      // (null) para que el tooltip alinee los años por semana.
      const porAnio = ANIOS_ANALISIS_DENGUE.map((anio) => ({
        anio,
        puntos: puntos.filter((punto) => punto.anio === anio),
      })).filter((grupo) => grupo.puntos.length > 0);

      contenedor.style.height = '380px';
      const montado = await montarGrafico(
        contenedor,
        (t) => ({
          ...crearOpcionBase(t, {
            grid: { bottom: 96 },
            legend: { data: porAnio.map((g) => String(g.anio)) },
            tooltip: {
              formatter: tooltipSeries(
                (semana) => `${nombreDepartamento} · ${etiquetaSemana(semana)}`,
                `casos ${filtros.serie}`,
              ),
            },
          }),
          xAxis: ejeSemana(t, filtros.semanaDesde, filtros.semanaHasta),
          yAxis: ejeValores(t, `Casos ${filtros.serie}`, {
            min: 0,
            minInterval: 1,
          }),
          series: [
            ...porAnio.map(({ anio, puntos: filas }) => {
              const destacado = anio === filtros.anio;
              const color = destacado
                ? t.acento
                : colorCualitativo(indiceAnio(anio));
              return {
                name: String(anio),
                type: 'line' as const,
                symbolSize: destacado ? 6 : 4,
                itemStyle: { color },
                lineStyle: destacado
                  ? { width: 2.75, color }
                  : { width: 1.25, type: 'dashed' as const, color },
                z: destacado ? 5 : 2,
                data: filas.map((f) => [f.semana, f.casos]),
              };
            }),
            // Serie vacía que solo lleva la marca de la semana activa.
            {
              name: 'Semana activa',
              type: 'line' as const,
              silent: true,
              data: [],
              markLine: marcaSemana(t, filtros.semana),
            },
          ],
        }),
        'Casos semanales por temporada del departamento activo',
      );
      if (idRevision !== revision) {
        montado.destruir();
        return;
      }
      grafico = montado;
      // Pulsar un punto fija el año y la semana, como antes con el teclado
      // sobre cada marca: la alternativa accesible son los filtros y la tabla.
      montado.instancia.on('click', (evento: unknown) => {
        const { componentType, seriesName, value } = evento as {
          componentType?: string;
          seriesName?: string;
          value?: unknown;
        };
        if (componentType !== 'series' || !Array.isArray(value)) return;
        const anio = Number(seriesName);
        if (!esAnioAnalisisDengue(anio) || value[1] === null) return;
        actualizarFiltrosAnalisis({
          anio: anio as AnioAnalisisDengue,
          semana: Number(value[0]),
        });
      });

      const departamento = nombreDepartamento;
      const observacionesSeleccionadas = seleccionada.filter(
        (punto) => punto.casos !== null,
      ).length;
      if (resumen) {
        resumen.innerHTML = `<span><strong class="font-medium text-ink">${escapeHtml(departamento)}</strong> · serie ${filtros.serie} · año destacado <span class="cifra">${filtros.anio}</span> (<span class="cifra">${observacionesSeleccionadas}</span> semanas observadas) · rango <span class="cifra">SE${String(filtros.semanaDesde).padStart(2, '0')}–SE${String(filtros.semanaHasta).padStart(2, '0')}</span>.</span>`;
      }
    } catch {
      if (idRevision !== revision) return;
      if (marcoGrafica) marcoGrafica.hidden = false;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      if (resumen)
        resumen.textContent = 'No se pudo cargar la comparación de temporadas.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
</script>
