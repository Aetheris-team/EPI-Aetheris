---
import PanelWorkspace from './PanelWorkspace.astro';
import { rutaFicha } from '../../fichas/registro';
---

<PanelWorkspace
  tipo="registro"
  titulo="Perfil de calidad y procedencia"
  idTitulo="perfil-calidad-titulo"
  descripcion="Cobertura, referencia histórica y extracción, cada una por separado y con su origen."
>
  <p class="mt-3 font-sans text-xs text-ink-muted">
    La completitud, el cuadre del boletín y la antigüedad de cada serie se
    explican en la ficha de <a
      href={rutaFicha('m4-integridad-vigilancia')}
      class="font-semibold text-accent underline underline-offset-2"
      >integridad de la vigilancia</a
    >.
  </p>

  <div
    data-vacio-calidad
    class="mt-4 flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-bg/50 p-8 text-center"
  >
    <p class="font-sans text-sm text-ink-muted">
      Elige un departamento en el mapa o en Filtros para revisar la procedencia
      y calidad de sus observaciones.
    </p>
    <button
      type="button"
      data-abrir-filtros-accion
      class="mt-3 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-accent transition-colors hover:border-accent/40"
    >
      Abrir filtros
    </button>
  </div>

  <div id="perfil-calidad-contenido" class="mt-4" role="status"></div>

  <p
    id="perfil-calidad-estado"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
    Selecciona un departamento para revisar una observación.
  </p>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoRegistro,
    renderSinDato,
  } from '../estado-async';
  import {
    obtenerDatasetAnalitico,
    obtenerProcedenciaAnalitica,
  } from '../../lib/analisis-api';
  import {
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
    type FiltrosAnalisis,
    type ProcedenciaAnalitica,
    type RegistroProcedencia,
  } from '../../lib/tipos-analisis';

  const contenedor = document.getElementById('perfil-calidad-contenido');
  const vacioContenedor = document.querySelector<HTMLElement>(
    '[data-vacio-calidad]',
  );
  const estado = document.getElementById('perfil-calidad-estado');
  let revision = 0;
  let filtrosActuales = obtenerFiltrosAnalisis();

  vacioContenedor
    ?.querySelector('[data-abrir-filtros-accion]')
    ?.addEventListener('click', () => {
      document.getElementById('analisis-abrir-filtros')?.click();
    });

  function elemento<K extends keyof HTMLElementTagNameMap>(
    etiqueta: K,
    clases?: string,
    texto?: string,
  ): HTMLElementTagNameMap[K] {
    const nodo = document.createElement(etiqueta);
    if (clases) nodo.className = clases;
    if (texto !== undefined) nodo.textContent = texto;
    return nodo;
  }

  function tarjeta(titulo: string, valor: string, detalle: string) {
    const bloque = elemento(
      'div',
      'rounded-xl border border-border bg-surface p-4',
    );
    bloque.append(
      elemento('p', 'font-sans text-xs font-semibold text-ink-muted', titulo),
      elemento(
        'p',
        'mt-1 font-mono cifra text-lg font-semibold text-ink',
        valor,
      ),
      elemento(
        'p',
        'mt-1 font-sans text-xs leading-relaxed text-ink-muted',
        detalle,
      ),
    );
    return bloque;
  }

  function enlaceSeguro(url: string | null, texto: string): HTMLElement {
    if (!url) return elemento('span', undefined, texto);
    try {
      const destino = new URL(url);
      if (destino.protocol !== 'http:' && destino.protocol !== 'https:') {
        return elemento('span', undefined, texto);
      }
      const enlace = elemento('a', 'text-accent underline', texto);
      enlace.href = destino.href;
      enlace.target = '_blank';
      enlace.rel = 'noopener noreferrer';
      const aviso = elemento('span', 'sr-only', ' (abre en una nueva pestaña)');
      enlace.appendChild(aviso);
      return enlace;
    } catch {
      return elemento('span', undefined, texto);
    }
  }

  function etiquetaEstadoExtraccion(valor: string): string {
    const etiquetas: Record<string, string> = {
      ok: 'Disponible',
      revision_manual: 'Revisión manual',
      error: 'No disponible',
      ausencia_esperada: 'Ausencia esperada',
      sin_texto_extraible: 'Incompleto',
      pendiente: 'Pendiente',
    };
    return etiquetas[valor] ?? valor;
  }

  function detalleProcedencia(procedencia: ProcedenciaAnalitica): HTMLElement {
    const seccion = elemento(
      'section',
      'mt-4 rounded-xl border border-border bg-surface p-4',
    );
    seccion.append(
      elemento(
        'h4',
        'font-sans text-sm font-semibold text-ink',
        'Detalle de la observación',
      ),
    );
    if (!procedencia.disponible) {
      seccion.append(
        elemento(
          'p',
          'mt-2 font-sans text-xs leading-relaxed text-ink-muted',
          'No existe una fila epidemiológica para esta selección; por eso no se atribuye una fuente, un boletín ni un estado de extracción.',
        ),
      );
      return seccion;
    }

    const lista = elemento('dl', 'mt-3 grid gap-3');
    for (const registro of procedencia.registros) {
      const item = elemento(
        'div',
        'rounded-lg border border-border/70 bg-bg p-3 font-sans text-xs leading-relaxed text-ink-muted',
      );
      const dtFuente = elemento('dt', 'font-semibold text-ink', 'Fuente');
      const ddFuente = elemento('dd', 'mt-0.5');
      ddFuente.append(
        enlaceSeguro(registro.fuente.url_referencia, registro.fuente.nombre),
        ` · ${registro.conteo} casos`,
      );
      item.append(dtFuente, ddFuente);

      if (registro.boletin) {
        const dtBoletin = elemento(
          'dt',
          'mt-2 font-semibold text-ink',
          'Boletín',
        );
        const ddBoletin = elemento('dd', 'mt-0.5');
        ddBoletin.append(
          enlaceSeguro(
            registro.boletin.url_origen,
            registro.boletin.nombre_archivo,
          ),
          ` · extracción ${etiquetaEstadoExtraccion(registro.boletin.estado_extraccion)}`,
        );
        item.append(dtBoletin, ddBoletin);
      } else {
        const ddSinBoletin = elemento(
          'dd',
          'mt-1 text-ink-muted',
          'Esta fila no tiene un boletín asociado almacenado.',
        );
        item.append(ddSinBoletin);
      }
      if (registro.fecha_ingesta) {
        const dtIngesta = elemento(
          'dt',
          'mt-2 font-semibold text-ink',
          'Fecha de ingesta',
        );
        const ddIngesta = elemento(
          'dd',
          'mt-0.5 cifra text-micro',
          `Ingesta registrada: ${registro.fecha_ingesta}`,
        );
        item.append(dtIngesta, ddIngesta);
      }
      lista.append(item);
    }
    seccion.append(lista);
    return seccion;
  }

  function resumenFuente(registro: RegistroProcedencia | undefined): {
    valor: string;
    detalle: string;
  } {
    if (!registro) {
      return {
        valor: 'Sin observación',
        detalle: 'No hay procedencia que atribuir a la celda ausente.',
      };
    }
    if (!registro.boletin) {
      return {
        valor: registro.fuente.codigo,
        detalle: 'Fuente almacenada; sin boletín asociado a esta fila.',
      };
    }
    const cuadre =
      registro.boletin.validacion_cuadra === true
        ? 'cuadre validado'
        : registro.boletin.validacion_cuadra === false
          ? 'cuadre no validado'
          : 'cuadre no registrado';
    return {
      valor: etiquetaEstadoExtraccion(registro.boletin.estado_extraccion),
      detalle: `${registro.fuente.nombre} · ${cuadre} · estado almacenado: ${registro.boletin.estado_extraccion}.`,
    };
  }

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor || !estado) return;
    const idRevision = ++revision;
    if (!filtros.departamento) {
      contenedor.replaceChildren();
      if (vacioContenedor) vacioContenedor.hidden = false;
      estado.textContent =
        'Selecciona un departamento para revisar una observación.';
      return;
    }
    if (vacioContenedor) vacioContenedor.hidden = true;
    estado.textContent = 'Cargando perfil y procedencia…';
    if (!esAnioAnalisisDengue(filtros.anio)) {
      renderSinDato(contenedor, notaAnioSoloClima(filtros.anio));
      estado.textContent = notaAnioSoloClima(filtros.anio);
      contenedor.setAttribute('aria-busy', 'false');
      return;
    }

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoRegistro(contenedor);
    try {
      const [dataset, procedencia] = await Promise.all([
        obtenerDatasetAnalitico(filtros.anio),
        obtenerProcedenciaAnalitica(filtros),
      ]);
      if (idRevision !== revision) return;
      if (esNoDisponible(dataset)) {
        renderSinDato(contenedor, motivoNoDisponible(dataset));
        return;
      }
      if (esNoDisponible(procedencia)) {
        renderSinDato(contenedor, motivoNoDisponible(procedencia));
        return;
      }
      const departamento = dataset.departamentos.find(
        (fila) => fila.codigo === filtros.departamento,
      );
      const semana = departamento?.semanas.find(
        (fila) => fila.semana_epi === filtros.semana,
      );
      if (!departamento || !semana) throw new Error('Selección no encontrada');
      const semanasDisponibles = departamento.semanas.filter(
        (fila) => fila[filtros.serie] !== null,
      ).length;
      const casos = semana[filtros.serie];
      const presion = semana[`presion_${filtros.serie}`];
      const fuente = resumenFuente(procedencia.registros[0]);
      const cuadricula = elemento(
        'div',
        'grid gap-3 sm:grid-cols-2 xl:grid-cols-4',
      );
      cuadricula.append(
        tarjeta(
          'Cobertura temporal',
          `${semanasDisponibles} / 53`,
          `Semanas con observación ${filtros.serie} en ${filtros.anio}.`,
        ),
        tarjeta(
          'Semana seleccionada',
          casos === null ? 'Ausente' : 'Disponible',
          casos === null
            ? 'No se interpreta como cero.'
            : `${casos === 0 ? '0 observado' : `${casos} casos observados`} en SE${String(filtros.semana).padStart(2, '0')}.`,
        ),
        tarjeta(
          'Referencia de presión',
          `${presion.anios_baseline} años`,
          `${presion.n_obs_baseline} observaciones en la ventana histórica; P50 ${presion.p50_baseline ?? 'sin dato'} y P75 ${presion.p75_baseline ?? 'sin dato'}.`,
        ),
        tarjeta('Fuente y extracción', fuente.valor, fuente.detalle),
      );
      contenedor.replaceChildren(cuadricula, detalleProcedencia(procedencia));
      estado.innerHTML = `<span><strong class="font-medium text-ink">${departamento.nombre}</strong> · año <span class="cifra">${filtros.anio}</span> · semana <span class="cifra font-semibold text-accent">SE${String(filtros.semana).padStart(2, '0')}</span> · serie ${filtros.serie}.</span>`;
    } catch {
      if (idRevision !== revision) return;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      estado.textContent = 'No se pudo cargar el perfil de calidad.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
</script>
