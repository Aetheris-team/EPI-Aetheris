---
import LeyendaRampa from './LeyendaRampa.astro';
import PanelWorkspace from './PanelWorkspace.astro';
import SelectorSemanaEpi from '../SelectorSemanaEpi.astro';
import { RAMPA_CASOS } from '../../lib/colores';
---

<PanelWorkspace
  tipo="matriz"
  titulo="Calendario epidémico nacional"
  descripcion="Vista semanal de los casos nacionales: OpenDengue hasta 2024 y casos sospechosos del tablero de MINSAL desde 2025. El año 2020 se conserva en la serie nacional, aunque no se utiliza en las referencias departamentales."
>
  <div slot="controles" class="flex items-center gap-2">
    <span class="hidden sm:inline font-sans text-xs text-ink-muted"
      >Ir a semana:</span
    >
    <SelectorSemanaEpi
      id="calendario-matriz-selector"
      sincronizarAnalisis={true}
      compacto={true}
      mostrarRangoFechas={false}
      etiqueta="Saltar a semana en matriz nacional"
    />
  </div>
  <div class="mt-4 overflow-x-auto scroll-shadow-x" tabindex="0">
    <div
      id="calendario-epidemico"
      class="min-h-[300px] min-w-[760px]"
      role="region"
      aria-label="Calendario de casos nacionales por año y semana epidemiológica"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[300px] w-full min-w-[760px] flex-col justify-between gap-2.5 p-2"
        aria-hidden="true"
      >
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
      </div>
    </div>
  </div>

  <LeyendaRampa
    rampa={RAMPA_CASOS}
    idRampa="calendario-leyenda-rampa"
    etiquetaMin="Menor conteo"
    etiquetaMax="Mayor conteo"
    descripcionLectores="El color de cada celda va de un tono claro para el conteo más bajo de la serie a un tono oscuro para el conteo más alto, en una escala continua; las celdas grises indican que falta el dato."
  />

  <details
    id="calendario-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="calendario-tabla-contenedor"></div>
  </details>

  <p
    id="calendario-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoMatriz,
    renderSinDato,
  } from '../estado-async';
  import { obtenerCasosNacionales } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    soloCambiaSemana,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { colorCasos, gradienteCss, RAMPA_CASOS } from '../../lib/colores';
  import { moverSeleccionMatriz, montarMatriz } from '../../lib/echarts-matriz';
  import type { ConfigMatriz } from '../../lib/echarts-matriz';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import { ANIOS_ANALISIS_DENGUE } from '../../lib/tipos-analisis';
  import type {
    AnioAnalisisDengue,
    FiltrosAnalisis,
  } from '../../lib/tipos-analisis';

  interface CeldaCalendario {
    anio: number;
    semana: number;
    conteo: number | null;
  }

  const contenedor = document.getElementById('calendario-epidemico');
  const resumen = document.getElementById('calendario-resumen');
  const leyenda = document.getElementById('calendario-leyenda-rampa');
  if (leyenda) leyenda.style.background = gradienteCss(RAMPA_CASOS);

  let revision = 0;
  let grafico: GraficoMontado | null = null;
  let filtrosActuales = obtenerFiltrosAnalisis();
  let filtrosPintados: FiltrosAnalisis | null = null;
  /** Reaplica la semana activa sobre la matriz vigente, con transición. */
  let moverSemana: ((filtros: FiltrosAnalisis) => void) | null = null;
  let datosTabla: CeldaCalendario[] = [];

  const detailsTabla = document.getElementById(
    'calendario-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById(
    'calendario-tabla-contenedor',
  );

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Calendario de casos nacionales por año y semana',
          columnas: [
            { clave: 'anio', encabezado: 'Año' },
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'conteo',
              encabezado: 'Casos nacionales',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? String(v) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    if (grafico && moverSemana && soloCambiaSemana(filtrosPintados, filtros)) {
      filtrosPintados = filtros;
      moverSemana(filtros);
      return;
    }
    filtrosPintados = filtros;
    moverSemana = null;
    const idRevision = ++revision;
    grafico?.destruir();
    grafico = null;
    if (resumen) resumen.textContent = 'Cargando serie nacional…';

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoMatriz(contenedor, 6);
    try {
      const filas = await obtenerCasosNacionales();
      if (idRevision !== revision) return;
      if (esNoDisponible(filas)) {
        renderSinDato(contenedor, motivoNoDisponible(filas));
        return;
      }
      const anios = [...new Set(filas.map((fila) => fila.anio))].sort(
        (a, b) => a - b,
      );
      const porCelda = new Map(
        filas.map(
          (fila) => [`${fila.anio}-${fila.semana_epi}`, fila.conteo] as const,
        ),
      );
      const celdas: CeldaCalendario[] = anios.flatMap((anio) =>
        Array.from({ length: 53 }, (_, indice) => ({
          anio,
          semana: indice + 1,
          conteo: porCelda.get(`${anio}-${indice + 1}`) ?? null,
        })),
      );
      const observados = celdas
        .map((celda) => celda.conteo)
        .filter((conteo): conteo is number => conteo !== null);
      const maximo = Math.max(...observados, 0);
      const seleccionDe = (f: FiltrosAnalisis) =>
        celdas.filter(
          (celda) => celda.anio === f.anio && celda.semana === f.semana,
        );

      datosTabla = celdas;
      tablaAlternativa?.marcarCaducada();

      const textoCelda = (celda: CeldaCalendario) =>
        `${celda.anio} · SE${String(celda.semana).padStart(2, '0')}\n${celda.conteo === null ? 'Sin dato registrado' : `${celda.conteo} casos nacionales`}`;
      contenedor.style.height = '310px';
      const configMatriz = (f: FiltrosAnalisis): ConfigMatriz => {
        const seleccion = seleccionDe(f);
        return {
          semanas: Array.from({ length: 53 }, (_, indice) => indice + 1),
          filas: anios.map(String),
          celdas: celdas.map((celda) => ({
            semana: celda.semana,
            fila: String(celda.anio),
            color: colorCasos(celda.conteo, maximo),
            activa: seleccion.includes(celda),
          })),
          izquierda: 58,
          etiquetasX: 10,
          texto: (indice) => textoCelda(celdas[indice]),
        };
      };
      const montado = await montarMatriz(
        contenedor,
        () => configMatriz(filtrosActuales),
        'Casos nacionales por año y semana epidemiológica',
        (indice) => {
          const celda = celdas[indice];
          if (
            ANIOS_ANALISIS_DENGUE.includes(celda.anio as AnioAnalisisDengue)
          ) {
            actualizarFiltrosAnalisis({
              anio: celda.anio as AnioAnalisisDengue,
              semana: celda.semana,
            });
          } else if (resumen) {
            resumen.textContent = `${celda.anio} se conserva como historia nacional, pero no tiene análisis departamental MINSAL seleccionable.`;
          }
        },
      );
      if (idRevision !== revision) {
        montado.destruir();
        return;
      }
      grafico = montado;

      const pintarResumen = (f: FiltrosAnalisis) => {
        const activa = seleccionDe(f)[0];
        if (!resumen) return;
        resumen.innerHTML = activa
          ? `<span>Año <span class="cifra">${activa.anio}</span> · semana <span class="cifra font-semibold text-accent">SE${String(activa.semana).padStart(2, '0')}</span> · <span class="cifra">${activa.conteo === null ? 'sin dato nacional' : `${activa.conteo} casos nacionales`}</span>.</span>`
          : `<span><span class="cifra">${anios.length}</span> años disponibles en la serie nacional.</span>`;
      };
      pintarResumen(filtros);
      moverSemana = (f) => {
        moverSeleccionMatriz(montado, configMatriz(f));
        pintarResumen(f);
      };
    } catch {
      if (idRevision !== revision) return;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      if (resumen)
        resumen.textContent = 'No se pudo cargar el calendario epidémico.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  let activado = false;
  async function activar() {
    if (activado || !contenedor) return;
    activado = true;
    suscribirFiltrosAnalisis((filtros) => {
      filtrosActuales = filtros;
      void renderizar(filtros);
    });
  }

  const panel = contenedor?.closest('[data-panel-workspace]') ?? contenedor;
  if (panel) {
    const io = new IntersectionObserver((entradas) => {
      if (entradas.some((entrada) => entrada.isIntersecting)) {
        io.disconnect();
        void activar();
      }
    });
    io.observe(panel);
  } else {
    void activar();
  }
</script>
