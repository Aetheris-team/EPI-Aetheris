---
import PanelWorkspace from './PanelWorkspace.astro';
---

<PanelWorkspace
  tipo="traza"
  titulo="Serie del departamento"
  descripcion="Los tres módulos descriptivos del departamento activo, semana a semana: presión epidemiológica relativa (M3), idoneidad biofísica contra su banda histórica (M1) y anomalía climática (M2). Cada uno compara al departamento con su propia historia; ninguno reparte un nivel de riesgo."
>
  <div
    data-vacio-serie
    class="mt-4 flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-bg/50 p-8 text-center"
  >
    <p class="font-sans text-sm text-ink-muted">
      Elige un departamento en el mapa o en Filtros para ver sus tres módulos
      temporales.
    </p>
    <button
      type="button"
      data-abrir-filtros-accion
      class="mt-3 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-accent transition-colors hover:border-accent/40"
    >
      Abrir filtros
    </button>
  </div>

  <div id="serie-departamento-grafica" class="mt-4 flex flex-col gap-5" hidden>
    <div
      id="serie-presion"
      class="min-h-[260px]"
      role="region"
      aria-label="Percentil de presión epidemiológica relativa por semana para el departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[260px] w-full flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
    <div
      id="serie-idoneidad"
      class="min-h-[260px]"
      role="region"
      aria-label="Idoneidad biofísica por semana contra la banda histórica del departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[260px] w-full flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
    <div
      id="serie-anomalia"
      class="min-h-[240px]"
      role="region"
      aria-label="Anomalía climática continua por semana para el departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[240px] w-full flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
  </div>

  <details
    id="serie-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="serie-tabla-contenedor"></div>
  </details>

  <p
    id="serie-departamento-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
  <p
    id="serie-departamento-aviso"
    class="mt-2 font-sans text-xs leading-relaxed text-ink-muted"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import { escapeHtml } from '../../utils/security';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import {
    obtenerSerieIdoneidad,
    obtenerSeriePresion,
  } from '../../lib/analisis-api';
  import {
    obtenerFiltrosAnalisis,
    soloCambiaSemana,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import type { OpcionEcharts } from '../../lib/echarts-base';
  import { montarGrafico } from '../../lib/echarts-montaje';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import {
    crearOpcionBase,
    ejeSemana,
    ejeValores,
    etiquetaSemana,
    marcaSemana,
    tooltipPorSemana,
  } from '../../lib/echarts-tema';
  import type { TokensGrafico } from '../../lib/echarts-tema';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
  } from '../../lib/tipos-analisis';
  import type {
    FiltrosAnalisis,
    SemanaSerieIdoneidad,
    SemanaSeriePresion,
  } from '../../lib/tipos-analisis';

  const COLOR_CONFIRMADO = '#2171b5';
  const COLOR_CONTEXTO = '#9ca3af';
  const COLOR_ANOMALIA = '#e65100';

  const marco = document.getElementById('serie-departamento-grafica');
  const vacioContenedor =
    document.querySelector<HTMLElement>('[data-vacio-serie]');
  const nodoPresion = document.getElementById('serie-presion');
  const nodoIdoneidad = document.getElementById('serie-idoneidad');
  const nodoAnomalia = document.getElementById('serie-anomalia');
  const resumen = document.getElementById('serie-departamento-resumen');
  const avisoNodo = document.getElementById('serie-departamento-aviso');

  let revision = 0;
  let filtrosActuales = obtenerFiltrosAnalisis();
  /** Filtros con los que se pintaron las gráficas vigentes. */
  let filtrosPintados: FiltrosAnalisis | null = null;
  /** Falso mientras una carga completa sigue en curso. */
  let listo = false;
  /** Lo que necesita montarGrafico: se vuelve a evaluar al cambiar el tema. */
  interface EspecificacionGrafica {
    construir: (tokens: TokensGrafico) => OpcionEcharts;
    descripcion: string;
  }
  /** `regenerar` reconstruye la opción con otra semana sin volver a pedir datos. */
  interface GraficoVigente {
    montado: GraficoMontado;
    regenerar: (filtros: FiltrosAnalisis) => EspecificacionGrafica | null;
  }
  let graficos: GraficoVigente[] = [];
  let datosTabla: any[] = [];

  const detailsTabla = document.getElementById(
    'serie-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById('serie-tabla-contenedor');

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Series temporales del departamento por semana',
          columnas: [
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'probable',
              encabezado: 'Percentil probable',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v}%` : '—'),
            },
            {
              clave: 'confirmado',
              encabezado: 'Percentil confirmado',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v}%` : '—'),
            },
            {
              clave: 'iv',
              encabezado: 'Idoneidad (Iv)',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? Number(v).toFixed(2) : '—'),
            },
            {
              clave: 'anomalia',
              encabezado: 'Anomalía',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? Number(v).toFixed(2) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  vacioContenedor
    ?.querySelector('[data-abrir-filtros-accion]')
    ?.addEventListener('click', () => {
      document.getElementById('analisis-abrir-filtros')?.click();
    });

  function enRango(semana: number, filtros: FiltrosAnalisis) {
    return semana >= filtros.semanaDesde && semana <= filtros.semanaHasta;
  }

  function hayValores(valores: (number | null)[]): boolean {
    return valores.some((v) => v !== null && !Number.isNaN(v));
  }

  /** Series que comparten rejilla, eje de semanas y marca de la semana activa. */
  function opcionSerie(
    t: TokensGrafico,
    filtros: FiltrosAnalisis,
    nombreY: string,
    ejeY: Record<string, unknown>,
    extra: Parameters<typeof crearOpcionBase>[1],
  ): OpcionEcharts {
    return {
      ...crearOpcionBase(t, extra),
      xAxis: ejeSemana(t, filtros.semanaDesde, filtros.semanaHasta),
      yAxis: ejeValores(t, nombreY, ejeY),
    };
  }

  const par = (semana: number, valor: number | null) => [semana, valor];

  function graficaPresion(
    semanas: SemanaSeriePresion[],
    filtros: FiltrosAnalisis,
  ): EspecificacionGrafica | null {
    const datos = semanas
      .filter((s) => enRango(s.semana_epi, filtros))
      .map((s) => ({
        semana_epi: s.semana_epi,
        probable: s.probable.percentil,
        confirmado: s.confirmado.percentil,
      }));
    if (
      !hayValores([
        ...datos.map((s) => s.probable),
        ...datos.map((s) => s.confirmado),
      ])
    ) {
      return null;
    }
    const porSemana = new Map(datos.map((s) => [s.semana_epi, s]));
    return {
      descripcion:
        'Percentil de presión epidemiológica relativa por semana para el departamento activo',
      construir: (t) => ({
        ...opcionSerie(
          t,
          filtros,
          'Percentil frente a su historia (0–100)',
          { min: 0, max: 100 },
          {
            grid: { bottom: 84 },
            legend: { data: ['Probable', 'Confirmado'] },
            tooltip: {
              formatter: tooltipPorSemana(
                porSemana,
                (s) =>
                  `${etiquetaSemana(s.semana_epi)} · probable p${
                    s.probable ?? '—'
                  } · confirmado p${s.confirmado ?? '—'}`,
              ),
            },
          },
        ),
        series: [
          {
            id: 'probable',
            name: 'Probable',
            type: 'line',
            symbolSize: 5,
            itemStyle: { color: t.acento },
            lineStyle: { width: 2.5, color: t.acento },
            z: 5,
            data: datos.map((s) => par(s.semana_epi, s.probable)),
            markLine: {
              ...marcaSemana(t, filtros.semana),
              data: [
                { xAxis: filtros.semana },
                ...[50, 75].map((y) => ({
                  yAxis: y,
                  lineStyle: {
                    type: 'dotted',
                    width: 1,
                    color: COLOR_CONTEXTO,
                    opacity: 0.7,
                  },
                })),
              ],
            },
          },
          {
            // Trazo discontinuo: la serie confirmada se distingue sin depender
            // solo del color.
            id: 'confirmado',
            name: 'Confirmado',
            type: 'line',
            symbol: 'none',
            itemStyle: { color: COLOR_CONFIRMADO },
            lineStyle: { width: 2, type: 'dashed', color: COLOR_CONFIRMADO },
            data: datos.map((s) => par(s.semana_epi, s.confirmado)),
          },
        ],
      }),
    };
  }

  function graficaIdoneidad(
    semanas: SemanaSerieIdoneidad[],
    filtros: FiltrosAnalisis,
  ): EspecificacionGrafica | null {
    const datos = semanas.filter((s) => enRango(s.semana_epi, filtros));
    if (!hayValores(datos.map((s) => s.iv_real))) return null;
    const banda = datos.filter(
      (s) => s.p25_baseline !== null && s.p75_baseline !== null,
    );
    const porSemana = new Map(datos.map((s) => [s.semana_epi, s]));
    return {
      descripcion:
        'Idoneidad biofísica por semana contra la banda histórica del departamento activo',
      construir: (t) => ({
        ...opcionSerie(
          t,
          filtros,
          'Iv (0–1)',
          { min: 0 },
          {
            grid: { bottom: 84 },
            legend: { data: ['Iv observado', 'Banda histórica P25 a P75'] },
            tooltip: {
              formatter: tooltipPorSemana(
                porSemana,
                (s) =>
                  `${etiquetaSemana(s.semana_epi)} · Iv ${
                    s.iv_real ?? '—'
                  } · banda P25–P75: ${s.p25_baseline ?? '—'} a ${
                    s.p75_baseline ?? '—'
                  }`,
              ),
            },
          },
        ),
        series: [
          {
            // Base invisible de la banda: la serie siguiente aporta el tramo
            // entre P25 y P75.
            id: 'base-banda',
            name: 'Base de la banda',
            type: 'line',
            stack: 'banda',
            silent: true,
            symbol: 'none',
            lineStyle: { width: 0 },
            data: banda.map((s) => par(s.semana_epi, s.p25_baseline)),
          },
          {
            id: 'banda',
            name: 'Banda histórica P25 a P75',
            type: 'line',
            stack: 'banda',
            silent: true,
            symbol: 'none',
            lineStyle: { width: 0 },
            itemStyle: { color: t.secundario, opacity: 0.5 },
            areaStyle: { color: t.secundario, opacity: 0.5 },
            data: banda.map((s) =>
              par(
                s.semana_epi,
                (s.p75_baseline as number) - (s.p25_baseline as number),
              ),
            ),
          },
          {
            id: 'iv',
            name: 'Iv observado',
            type: 'line',
            symbolSize: 5,
            itemStyle: { color: t.acento },
            lineStyle: { width: 2.5, color: t.acento },
            z: 5,
            data: datos.map((s) => par(s.semana_epi, s.iv_real)),
            markLine: marcaSemana(t, filtros.semana),
          },
        ],
      }),
    };
  }

  function graficaAnomalia(
    semanas: SemanaSerieIdoneidad[],
    filtros: FiltrosAnalisis,
  ): EspecificacionGrafica | null {
    const datos = semanas.filter((s) => enRango(s.semana_epi, filtros));
    if (!hayValores(datos.map((s) => s.anomaly_sigma))) return null;
    const porSemana = new Map(datos.map((s) => [s.semana_epi, s]));
    return {
      descripcion:
        'Anomalía climática continua por semana para el departamento activo',
      construir: (t) => ({
        ...opcionSerie(
          t,
          filtros,
          'Anomalía (σ)',
          {},
          {
            legend: { show: false },
            tooltip: {
              formatter: tooltipPorSemana(
                porSemana,
                (s) =>
                  `${etiquetaSemana(s.semana_epi)} · anomalía ${
                    s.anomaly_sigma !== null
                      ? `${s.anomaly_sigma.toFixed(2)} σ`
                      : 'sin dato'
                  }`,
              ),
            },
          },
        ),
        series: [
          {
            id: 'anomalia',
            name: 'Anomalía',
            type: 'line',
            symbolSize: 5,
            itemStyle: { color: COLOR_ANOMALIA },
            lineStyle: { width: 2, color: COLOR_ANOMALIA },
            z: 5,
            data: datos.map((s) => par(s.semana_epi, s.anomaly_sigma)),
            markLine: {
              ...marcaSemana(t, filtros.semana),
              data: [
                { xAxis: filtros.semana },
                {
                  yAxis: 0,
                  lineStyle: {
                    type: 'solid',
                    width: 1,
                    color: COLOR_CONTEXTO,
                    opacity: 0.6,
                  },
                },
              ],
            },
          },
        ],
      }),
    };
  }

  async function pintar(
    nodo: HTMLElement | null,
    grafica: EspecificacionGrafica | null,
    esError: boolean,
    mensaje: string,
    idRevision: number,
    regenerar?: GraficoVigente['regenerar'],
  ): Promise<void> {
    if (!nodo) return;
    nodo.setAttribute('aria-busy', 'false');
    if (grafica) {
      const montado = await montarGrafico(
        nodo,
        grafica.construir,
        grafica.descripcion,
      );
      if (idRevision !== revision) {
        montado.destruir();
        return;
      }
      graficos.push({ montado, regenerar: regenerar ?? (() => grafica) });
      return;
    }
    if (esError) {
      renderErrorFuente(nodo, () => void renderizar(filtrosActuales), mensaje);
    } else {
      renderSinDato(nodo, mensaje);
    }
  }

  async function renderizar(filtros: FiltrosAnalisis): Promise<void> {
    if (!marco || !resumen) return;
    // Solo cambió la semana: se mueve la marca con transición, sin recrear
    // las gráficas ni volver a mostrar el esqueleto de carga.
    if (
      listo &&
      graficos.length > 0 &&
      soloCambiaSemana(filtrosPintados, filtros)
    ) {
      filtrosPintados = filtros;
      for (const g of graficos) {
        const nueva = g.regenerar(filtros);
        if (nueva) g.montado.actualizar(nueva.construir, { suave: true });
      }
      return;
    }
    const idRevision = ++revision;
    filtrosPintados = filtros;
    listo = false;
    graficos.forEach((g) => g.montado.destruir());
    graficos = [];

    if (!filtros.departamento) {
      marco.hidden = true;
      if (vacioContenedor) vacioContenedor.hidden = false;
      resumen.textContent =
        'Selecciona un departamento en los filtros o en el mapa.';
      if (avisoNodo) avisoNodo.textContent = '';
      return;
    }

    if (vacioContenedor) vacioContenedor.hidden = true;
    marco.hidden = false;
    resumen.textContent = 'Cargando series del departamento…';

    if (nodoPresion) {
      nodoPresion.setAttribute('aria-busy', 'true');
      renderEsqueletoTraza(nodoPresion);
    }
    if (nodoIdoneidad) {
      nodoIdoneidad.setAttribute('aria-busy', 'true');
      renderEsqueletoTraza(nodoIdoneidad);
    }
    if (nodoAnomalia) {
      nodoAnomalia.setAttribute('aria-busy', 'true');
      renderEsqueletoTraza(nodoAnomalia);
    }

    const [resPresion, resIdoneidad] = await Promise.allSettled([
      obtenerSeriePresion(filtros.departamento, filtros.anio),
      obtenerSerieIdoneidad(filtros.departamento, filtros.anio),
    ]);
    if (idRevision !== revision) return;

    const pendientes: Promise<void>[] = [];
    const presion =
      resPresion.status === 'fulfilled' && !esNoDisponible(resPresion.value)
        ? resPresion.value
        : null;
    const idoneidad =
      resIdoneidad.status === 'fulfilled' && !esNoDisponible(resIdoneidad.value)
        ? resIdoneidad.value
        : null;

    if (resPresion.status === 'rejected') {
      pendientes.push(
        pintar(
          nodoPresion,
          null,
          true,
          'No se pudo cargar la presión epidemiológica.',
          idRevision,
        ),
      );
    } else if (
      resPresion.status === 'fulfilled' &&
      esNoDisponible(resPresion.value)
    ) {
      pendientes.push(
        pintar(
          nodoPresion,
          null,
          false,
          motivoNoDisponible(resPresion.value),
          idRevision,
        ),
      );
    } else {
      pendientes.push(
        pintar(
          nodoPresion,
          presion ? graficaPresion(presion.semanas, filtros) : null,
          false,
          'Sin presión epidemiológica para este año (los casos MINSAL se detienen en 2023).',
          idRevision,
          presion ? (f) => graficaPresion(presion.semanas, f) : undefined,
        ),
      );
    }

    if (resIdoneidad.status === 'rejected') {
      pendientes.push(
        pintar(
          nodoIdoneidad,
          null,
          true,
          'No se pudo cargar la idoneidad biofísica.',
          idRevision,
        ),
      );
      pendientes.push(
        pintar(
          nodoAnomalia,
          null,
          true,
          'No se pudo cargar la anomalía climática.',
          idRevision,
        ),
      );
    } else if (
      resIdoneidad.status === 'fulfilled' &&
      esNoDisponible(resIdoneidad.value)
    ) {
      pendientes.push(
        pintar(
          nodoIdoneidad,
          null,
          false,
          motivoNoDisponible(resIdoneidad.value),
          idRevision,
        ),
      );
      pendientes.push(
        pintar(
          nodoAnomalia,
          null,
          false,
          motivoNoDisponible(resIdoneidad.value),
          idRevision,
        ),
      );
    } else {
      pendientes.push(
        pintar(
          nodoIdoneidad,
          idoneidad ? graficaIdoneidad(idoneidad.semanas, filtros) : null,
          false,
          'Sin idoneidad biofísica para este departamento y año.',
          idRevision,
          idoneidad ? (f) => graficaIdoneidad(idoneidad.semanas, f) : undefined,
        ),
      );
      pendientes.push(
        pintar(
          nodoAnomalia,
          idoneidad ? graficaAnomalia(idoneidad.semanas, filtros) : null,
          false,
          'Sin anomalía climática para este departamento y año.',
          idRevision,
          idoneidad ? (f) => graficaAnomalia(idoneidad.semanas, f) : undefined,
        ),
      );
    }

    await Promise.all(pendientes);
    if (idRevision !== revision) return;
    listo = true;

    // Preparar datos para tabla alternativa
    const filasTabla: any[] = [];
    for (let sem = filtros.semanaDesde; sem <= filtros.semanaHasta; sem++) {
      const pSem = presion?.semanas.find((s) => s.semana_epi === sem);
      const iSem = idoneidad?.semanas.find((s) => s.semana_epi === sem);
      filasTabla.push({
        semana: sem,
        probable: pSem?.probable.percentil ?? null,
        confirmado: pSem?.confirmado.percentil ?? null,
        iv: iSem?.iv_real ?? null,
        anomalia: iSem?.anomaly_sigma ?? null,
      });
    }
    datosTabla = filasTabla;
    tablaAlternativa?.marcarCaducada();

    const nombre =
      idoneidad?.departamento_nombre ??
      presion?.departamento_nombre ??
      filtros.departamento;
    resumen.innerHTML = `<span><strong class="font-medium text-ink">${escapeHtml(nombre)}</strong> · año <span class="cifra">${filtros.anio}</span> · rango <span class="cifra">SE${String(
      filtros.semanaDesde,
    ).padStart(
      2,
      '0',
    )}–SE${String(filtros.semanaHasta).padStart(2, '0')}</span>.</span>`;

    if (avisoNodo) {
      const partes: string[] = [];
      if (!esAnioAnalisisDengue(filtros.anio)) {
        partes.push(notaAnioSoloClima(filtros.anio));
      }
      if (idoneidad?.aviso) partes.push(idoneidad.aviso);
      if (presion?.aviso) partes.push(presion.aviso);
      avisoNodo.textContent = partes.join(' · ');
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
</script>
