  // ---------------------------------------------------------------------
  // Capas 4 y 5: presión epidemiológica relativa (M3)
  // ---------------------------------------------------------------------

  interface CeldaPresion {
    casos_observados: number | null;
    percentil: number | null;
    categoria: 'baja' | 'media' | 'alta' | null;
    p50_baseline: number | null;
    p75_baseline: number | null;
    nota?: string;
  }

  interface DatoPresion {
    codigo: string;
    probable: CeldaPresion | undefined;
    confirmado: CeldaPresion | undefined;
  }

  let cachePresion: Promise<Map<string, DatoPresion> | null> | null = null;
  let detallesPresion = new Map<string, DatoPresion>();

  async function obtenerDatosPresion(): Promise<Map<
    string,
    DatoPresion
  > | null> {
    if (!cachePresion) {
      cachePresion = (async () => {
        try {
          if (!esAnioAnalisisDengue(ANIO_ESPACIAL)) {
            detallesPresion = new Map();
            return new Map();
          }
          const datos = await obtenerDatasetAnalitico(ANIO_ESPACIAL);
          const mapa = new Map<string, DatoPresion>();
          for (const departamento of datos.departamentos) {
            const fila = departamento.semanas.find(
              (semana) => semana.semana_epi === SEMANA_ESPACIAL,
            );
            mapa.set(departamento.codigo, {
              codigo: departamento.codigo,
              probable: fila?.presion_probable,
              confirmado: fila?.presion_confirmado,
            });
          }
          detallesPresion = mapa;
          return mapa;
        } catch {
          return null;
        }
      })();
    }
    return cachePresion;
  }

  const CATEGORIA_A_INDICE: Record<string, number> = {
    baja: 0,
    media: 1,
    alta: 2,
  };

  function definirCapaPresion(
    serie: 'probable' | 'confirmado',
  ): DefinicionCapa {
    return {
      id: serie === 'probable' ? 'presion_probable' : 'presion_confirmado',
      etiqueta: `Presión epidemiológica (${serie})`,
      disponible: true,
      aviso:
        `Compara los casos ${serie} observados con la historia del mismo departamento y periodo. ` +
        'Un valor alto indica qué tan inusual es lo observado frente a la historia del propio departamento.',
      tituloLeyenda: `Presión relativa (${serie}, frente a P50/P75 de su referencia histórica)`,
      enlaceLeyenda: RUTA_FICHA_M3,
      rampa: RAMPA_PRESION_CATEGORIA,
      sinDatoColor: SIN_DATO,
      async cargarValores() {
        const datos = await obtenerDatosPresion();
        if (!datos) return null;
        const valores = new Map<string, number | undefined>();
        for (const [codigo, fila] of datos) {
          const celda = fila[serie];
          const indice =
            celda?.categoria != null
              ? CATEGORIA_A_INDICE[celda.categoria]
              : undefined;
          valores.set(codigo, indice);
        }
        return valores;
      },
      calcularCortes: () => [0.5, 1.5],
      etiquetasLeyenda: () => ['baja (≤P50)', 'media (P50–P75)', 'alta (>P75)'],
      tooltipValor(valor) {
        if (valor === undefined) return 'sin datos suficientes';
        return ['baja', 'media', 'alta'][valor] ?? 'sin dato';
      },
    };
  }

  const capaPresionProbable = definirCapaPresion('probable');
  const capaPresionConfirmado = definirCapaPresion('confirmado');

  // ---------------------------------------------------------------------
  // Capa 6: integridad de la vigilancia (M4)
  // ---------------------------------------------------------------------

  interface IntegridadSemana {
    completitud?: {
      probable: {
        departamentos: { codigo: string; presente: boolean }[];
      };
      confirmado: {
        departamentos: { codigo: string; presente: boolean }[];
      };
    };
    cuadre?: { cuadra: boolean | null };
  }

  let cacheConfianza: Promise<IntegridadSemana | null> | null = null;

  async function obtenerIntegridadSemana(): Promise<IntegridadSemana | null> {
    if (!cacheConfianza) {
      cacheConfianza = (async () => {
        try {
          const resp = await fetch(
            `${API_BASE}/api/v1/vigilancia/integridad?week=${SEMANA_ESPACIAL}&year=${ANIO_ESPACIAL}`,
          );
          if (!resp.ok) return null;
          return (await resp.json()) as IntegridadSemana;
        } catch {
          return null;
        }
      })();
    }
    return cacheConfianza;
  }

  const ESTADO_SIN_DATO = 0;
  const ESTADO_PRESENTE = 1;
  const ESTADO_NO_CUADRA = 2;

  const capaConfianza: DefinicionCapa = {
    id: 'confianza',
    etiqueta: 'Integridad de la vigilancia',
    disponible: true,
    aviso:
      'El color indica si ese departamento tiene fila esa semana, si falta el dato, o si el ' +
      'boletín no cuadra aritméticamente. No es un nivel de riesgo ni un índice de confianza opaco.',
    tituloLeyenda: 'Calidad del dato (semana seleccionada)',
    enlaceLeyenda: RUTA_FICHA_M4,
    rampa: RAMPA_CONFIANZA,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const datos = await obtenerIntegridadSemana();
      if (!datos?.completitud) return null;
      const serie = obtenerFiltrosAnalisis().serie;
      const cuadra = datos.cuadre?.cuadra;
      const valores = new Map<string, number | undefined>();
      for (const departamento of datos.completitud[serie].departamentos) {
        if (!departamento.presente) {
          valores.set(departamento.codigo, ESTADO_SIN_DATO);
        } else if (cuadra === false) {
          valores.set(departamento.codigo, ESTADO_NO_CUADRA);
        } else {
          valores.set(departamento.codigo, ESTADO_PRESENTE);
        }
      }
      return valores;
    },
    calcularCortes: () => [0.5, 1.5],
    etiquetasLeyenda: () => [
      'sin dato esta semana',
      'dato presente',
      'el boletín no cuadra',
    ],
    tooltipValor(valor) {
      if (valor === ESTADO_SIN_DATO) return 'sin dato esta semana';
      if (valor === ESTADO_NO_CUADRA)
        return 'dato presente — el boletín no cuadra';
      if (valor === ESTADO_PRESENTE) return 'dato presente';
      return 'sin dato';
    },
  };

  const CAPAS: DefinicionCapa[] = [
    capaMinsal,
    capaIv,
    capaAnomalia,
    capaPresionProbable,
    capaPresionConfirmado,
    capaConfianza,
  ];

  const ES_CAPA_MODULO: Partial<Record<IdCapa, boolean>> = {
    iv: true,
    anomalia: true,
    presion_probable: true,
    presion_confirmado: true,
  };

  function lineaPresion(
    celda: CeldaPresion | undefined,
    etiqueta: string,
  ): string {
    if (!celda || celda.percentil === null || celda.categoria === null) {
      return `${etiqueta}: sin datos suficientes`;
    }
    return `${etiqueta}: ${celda.categoria} (percentil ${celda.percentil})`;
  }

  function tooltipModulos(
    codigo: string,
    nombre: string,
    capaActiva: IdCapa,
  ): string {
    const esp = detallesEspacial.get(codigo);
    const pres = detallesPresion.get(codigo);
    const lineas = [
      `Iv (idoneidad): ${esp?.iv !== undefined ? esp.iv.toFixed(2) : 'sin dato'}`,
      `Anomalía climática: ${esp?.anomalia_sigma !== undefined ? `${esp.anomalia_sigma.toFixed(2)}σ` : 'sin dato'}`,
      lineaPresion(pres?.probable, 'Presión (probable)'),
      lineaPresion(pres?.confirmado, 'Presión (confirmado)'),
    ];

    if (
      capaActiva === 'presion_probable' ||
      capaActiva === 'presion_confirmado'
    ) {
      const serie =
        capaActiva === 'presion_probable' ? 'probable' : 'confirmado';
      const celda = pres?.[serie];
      if (celda && celda.percentil !== null) {
        lineas.push(
          `Casos observados (${serie}): ${celda.casos_observados} · línea base P50/P75: ` +
            `${celda.p50_baseline} / ${celda.p75_baseline}`,
        );
      } else if (celda?.nota) {
        lineas.push(celda.nota);
      }
    }

    return `<strong>${escapeHtml(nombre)}</strong><br>${lineas.join('<br>')}`;
  }

  // ---------------------------------------------------------------------
  // Detalle de departamento: mini-curva y snapshot
  // ---------------------------------------------------------------------

  interface SemanaTemporal {
    semana_epi: number;
    iv_real: number | null;
    p25_baseline: number | null;
    mediana_baseline: number | null;
    p75_baseline: number | null;
    anomaly_sigma: number | null;
  }

  function dibujarCurvaDetalle(
    contenedor: HTMLElement,
    semanas: SemanaTemporal[],
    semanaActiva: number,
  ) {
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const ANCHO = 600;
    const ALTO = 96;
    const conBanda = semanas.filter(
      (s) => s.p25_baseline !== null && s.p75_baseline !== null,
    );
    const valores = conBanda.flatMap((s) => [
      s.p25_baseline!,
      s.p75_baseline!,
      s.iv_real ?? s.p25_baseline!,
    ]);
    const min = Math.min(...valores, 0);
    const max = Math.max(...valores, 0.01);
    const escalaX = (i: number) =>
      (i / Math.max(semanas.length - 1, 1)) * ANCHO;
    const escalaY = (v: number) =>
      ALTO - ((v - min) / (max - min || 1)) * (ALTO - 8) - 4;

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${ANCHO} ${ALTO}`);
    svg.setAttribute('class', 'h-full w-full');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('role', 'img');
    svg.setAttribute(
      'aria-label',
      'Idoneidad biofísica del año seleccionado contra su banda histórica P25-P75',
    );

    if (conBanda.length > 1) {
      const puntosSup = conBanda.map(
        (s, i) => `${escalaX(i)},${escalaY(s.p75_baseline!)}`,
      );
      const puntosInf = [...conBanda]
        .reverse()
        .map(
          (s, i) =>
            `${escalaX(conBanda.length - 1 - i)},${escalaY(s.p25_baseline!)}`,
        );
      const banda = document.createElementNS(SVG_NS, 'polygon');
      banda.setAttribute('points', [...puntosSup, ...puntosInf].join(' '));
      banda.setAttribute('fill', 'var(--color-secondary)');
      banda.setAttribute('opacity', '0.6');
      svg.appendChild(banda);
    }

    const puntosReales = semanas
      .map((s, i) =>
        s.iv_real !== null ? `${escalaX(i)},${escalaY(s.iv_real)}` : null,
      )
      .filter((p): p is string => p !== null);
    if (puntosReales.length > 1) {
      const linea = document.createElementNS(SVG_NS, 'polyline');
      linea.setAttribute('points', puntosReales.join(' '));
      linea.setAttribute('fill', 'none');
      linea.setAttribute('stroke', 'var(--color-accent)');
      linea.setAttribute('stroke-width', '1.75');
      linea.setAttribute('stroke-linejoin', 'round');
      linea.setAttribute('stroke-linecap', 'round');
      svg.appendChild(linea);
    }

    const indiceActiva = semanas.findIndex(
      (s) => s.semana_epi === semanaActiva,
    );
    if (indiceActiva >= 0 && semanas[indiceActiva].iv_real !== null) {
      const punto = document.createElementNS(SVG_NS, 'circle');
      punto.setAttribute('cx', `${escalaX(indiceActiva)}`);
      punto.setAttribute('cy', `${escalaY(semanas[indiceActiva].iv_real!)}`);
      punto.setAttribute('r', '3.5');
      punto.setAttribute('fill', 'var(--color-deep)');
      punto.setAttribute('stroke', 'var(--color-surface)');
      punto.setAttribute('stroke-width', '1.5');
      svg.appendChild(punto);
    }

    contenedor.innerHTML = '';
    contenedor.appendChild(svg);
  }

  // ---------------------------------------------------------------------
  // Orquestación del mapa vectorial SVG nativo
  // ---------------------------------------------------------------------

  async function iniciar() {
    const contenedorSelector = document.getElementById('mapa-selector');
    const contenedorMapa = document.getElementById('mapa-departamentos');
    const svgElement = document.getElementById(
      'mapa-svg',
    ) as unknown as SVGSVGElement | null;
    const contenedorLeyenda = document.getElementById('mapa-leyenda');
    const contenedorAviso = document.getElementById('mapa-aviso');
    const contenedorNoDisponible =
      document.getElementById('mapa-no-disponible');
    const contenedorDetalle = document.getElementById('mapa-detalle');
    const detalleNombre = document.getElementById('mapa-detalle-nombre');
    const detalleSnapshot = document.getElementById('mapa-detalle-snapshot');
    const detalleCurva = document.getElementById('mapa-detalle-curva');
    const detalleCerrar = document.getElementById('mapa-detalle-cerrar');
    const detalleFicha = document.getElementById(
      'mapa-detalle-ficha',
    ) as HTMLAnchorElement | null;
    const tablaCuerpo = document.getElementById('mapa-tabla-cuerpo');
    const tablaCaption = document.getElementById('mapa-tabla-caption');
    const tablaColumnaValor = document.getElementById(
      'mapa-tabla-columna-valor',
    );
    const toggleEtiquetas = document.getElementById(
      'mapa-toggle-etiquetas',
    ) as HTMLInputElement | null;
    const btnExportarSvg = document.getElementById('mapa-exportar-svg');
    const btnExportarPng = document.getElementById('mapa-exportar-png');
    const tooltip = document.getElementById('mapa-tooltip');
    const grupoEtiquetas = document.getElementById('mapa-etiquetas-grupo');

    if (
      !contenedorSelector ||
      !contenedorMapa ||
      !svgElement ||
      !contenedorLeyenda ||
      !contenedorAviso ||
      !contenedorNoDisponible ||
      !contenedorDetalle ||
      !detalleNombre ||
      !detalleSnapshot ||
      !detalleCurva ||
      !detalleCerrar
    )
      return;

    const paths = Array.from(
      contenedorMapa.querySelectorAll<SVGPathElement>(
        '.mapa-departamento-path',
      ),
    );

    detalleCerrar.addEventListener('click', () => {
      actualizarFiltrosAnalisis({ departamento: null });
    });

    function celdaSnapshot(etiqueta: string, valor: string): string {
      return (
        `<div class="rounded-lg border border-border bg-surface px-3 py-2">` +
        `<dt class="font-sans text-xs font-medium text-ink-muted">${escapeHtml(etiqueta)}</dt>` +
        `<dd class="mt-0.5 cifra text-sm text-ink">${escapeHtml(valor)}</dd></div>`
      );
    }

    async function mostrarDetalle(codigo: string, nombre: string) {
      contenedorDetalle.classList.remove('hidden');
      detalleNombre.textContent = nombre;
      const anuncioDetalle = document.getElementById('mapa-detalle-anuncio');
      if (anuncioDetalle)
        anuncioDetalle.textContent = `Detalle de ${nombre} disponible más abajo`;
      if (detalleFicha) {
        detalleFicha.href = `/analisis/ficha/${codigo}`;
        detalleFicha.setAttribute(
          'aria-label',
          `Ver ficha imprimible de ${nombre}`,
        );
      }
      detalleSnapshot.innerHTML =
        '<div class="skeleton h-12 rounded-lg"></div><div class="skeleton h-12 rounded-lg"></div>' +
        '<div class="skeleton h-12 rounded-lg"></div><div class="skeleton h-12 rounded-lg"></div>';
      detalleCurva.innerHTML =
        '<div class="skeleton h-full w-full" aria-hidden="true"></div>';

      await Promise.all([obtenerDatosEspaciales(), obtenerDatosPresion()]);
      const esp = detallesEspacial.get(codigo);
      const pres = detallesPresion.get(codigo);

      detalleSnapshot.innerHTML = [
        celdaSnapshot(
          'Iv (idoneidad)',
          esp?.iv !== undefined ? esp.iv.toFixed(2) : 'sin dato',
        ),
        celdaSnapshot(
          'Anomalía climática',
          esp?.anomalia_sigma !== undefined
            ? `${esp.anomalia_sigma.toFixed(2)}σ`
            : 'sin dato',
        ),
        celdaSnapshot(
          'Presión (probable)',
          pres?.probable?.categoria
            ? `${pres.probable.categoria} (p${pres.probable.percentil})`
            : 'sin datos suficientes',
        ),
        celdaSnapshot(
          'Presión (confirmado)',
          pres?.confirmado?.categoria
            ? `${pres.confirmado.categoria} (p${pres.confirmado.percentil})`
            : 'sin datos suficientes',
        ),
      ].join('');

      try {
        const resp = await fetch(
          `${API_BASE}/api/v1/temporal/${codigo}?anio=${ANIO_ESPACIAL}`,
        );
        if (!resp.ok) throw new Error('respuesta no OK');
        const datos: { semanas: SemanaTemporal[] } = await resp.json();
        dibujarCurvaDetalle(detalleCurva, datos.semanas, SEMANA_ESPACIAL);
      } catch {
        detalleCurva.innerHTML =
          '<p class="font-sans text-xs text-ink-muted">Serie histórica no disponible en este momento.</p>';
      }
    }

    let capaActivaId: IdCapa = capaMinsal.id;
    let idCapaPintada: IdCapa | null = null;
    const cacheValoresPorCapa = new Map<
      IdCapa,
      Map<string, number | undefined> | null
    >();

    let departamentosConAlerta = new Set<string>();

    function pintarAlertasEnTabla() {
      tablaCuerpo
        ?.querySelectorAll<HTMLElement>('[data-celda-alerta]')
        .forEach((celda) => {
          const codigo = celda.dataset.celdaAlerta ?? '';
          if (departamentosConAlerta.has(codigo)) {
            const enlace = document.createElement('a');
            enlace.href = `/alertas?tipo=dengue&dept=${encodeURIComponent(codigo)}`;
            enlace.className = 'font-medium text-accent underline';
            enlace.textContent = 'Sí, ver alertas';
            celda.replaceChildren(enlace);
          } else {
            celda.textContent = 'No';
          }
        });
    }

    async function cargarAlertasVigentes() {
      const avisoNacional = document.getElementById('mapa-alertas-nacionales');
      try {
        const alertas = (await obtenerAlertasDengue()).filter((a) =>
          alertaEstaVigente(a),
        );
        const nuevas = new Set<string>();
        let nacionales = 0;
        for (const alerta of alertas) {
          if (esAlertaNacional(alerta)) nacionales += 1;
          else
            for (const codigo of alerta.departamentos ?? []) nuevas.add(codigo);
        }
        departamentosConAlerta = nuevas;
        if (avisoNacional && nacionales > 0) {
          avisoNacional.classList.remove('hidden');
          avisoNacional.innerHTML = `Hay ${nacionales} ${nacionales === 1 ? 'alerta nacional vigente' : 'alertas nacionales vigentes'} de dengue. Los departamentos con contorno punteado tienen además una alerta propia. <a href="/alertas?tipo=dengue" class="font-medium text-accent underline">Ver alertas</a>`;
        } else if (avisoNacional && nuevas.size > 0) {
          avisoNacional.classList.remove('hidden');
          avisoNacional.textContent =
            'Los departamentos con contorno punteado tienen una alerta de dengue vigente.';
        }
      } catch {
        departamentosConAlerta = new Set();
      }
      pintarAlertasEnTabla();
      resaltarDepartamento(obtenerFiltrosAnalisis().departamento);
    }

    function resaltarDepartamento(codigoActivo: string | null) {
      paths.forEach((ruta) => {
        const codigo = ruta.dataset.codigo ?? '';
        const activa = codigoActivo !== null && codigo === codigoActivo;
        const conAlerta = departamentosConAlerta.has(codigo);

        if (activa) {
          ruta.classList.add('seleccionado');
          ruta.setAttribute('aria-pressed', 'true');
          ruta.style.stroke = 'var(--color-seleccion, #040316)';
          ruta.style.strokeWidth = '2.5px';
          ruta.style.strokeDasharray = 'none';
          ruta.parentElement?.appendChild(ruta);
        } else if (conAlerta) {
          ruta.classList.remove('seleccionado');
          ruta.setAttribute('aria-pressed', 'false');
          ruta.style.stroke = 'var(--color-seleccion, #040316)';
          ruta.style.strokeWidth = '2.2px';
          ruta.style.strokeDasharray = '5 4';
        } else {
          ruta.classList.remove('seleccionado');
          ruta.setAttribute('aria-pressed', 'false');
          ruta.style.stroke = '#8a8a90';
          ruta.style.strokeWidth = '1.2px';
          ruta.style.strokeDasharray = 'none';
        }
      });
    }

    function botonId(id: IdCapa) {
      return `mapa-boton-${id}`;
    }

    function pintarSelector(activaId: IdCapa) {
      contenedorSelector!.innerHTML = CAPAS.map((capa) => {
        const activa = capa.id === activaId;
        const base =
          'rounded-full border px-3.5 py-1.5 font-sans text-xs font-medium transition-colors duration-150';
        const estilo = !capa.disponible
          ? 'cursor-not-allowed border-border bg-bg text-ink-muted opacity-60'
          : activa
            ? 'border-accent bg-accent text-accent-ink shadow-sm'
            : 'border-border bg-surface text-ink hover:border-accent/40 hover:bg-secondary/30';
        return `<button type="button" id="${botonId(capa.id)}" data-id="${capa.id}" ${
          capa.disponible
            ? ''
            : 'disabled aria-disabled="true" title="Capa no disponible temporalmente"'
        } role="tab" aria-selected="${activa}" tabindex="${activa ? '0' : '-1'}" class="${base} ${estilo}">${escapeHtml(capa.etiqueta)}</button>`;
      }).join('');

      for (const capa of CAPAS) {
        if (!capa.disponible) continue;
        const boton = document.getElementById(botonId(capa.id));
        boton?.addEventListener('click', () => {
          if (
            capa.id === 'presion_probable' ||
            capa.id === 'presion_confirmado'
          ) {
            const serie =
              capa.id === 'presion_probable' ? 'probable' : 'confirmado';
            if (capaActivaId === capa.id) return;
            actualizarFiltrosAnalisis({ capa: 'presion', serie });
            return;
          }
          if (capaActivaId === capa.id) return;
          actualizarFiltrosAnalisis({ capa: capa.id as CapaAnalitica });
        });
      }
    }

    function pestanasDisponibles(): HTMLButtonElement[] {
      return Array.from(
        contenedorSelector?.querySelectorAll<HTMLButtonElement>(
          '[role="tab"]:not([disabled])',
        ) ?? [],
      );
    }

    contenedorSelector?.addEventListener('keydown', (evento: KeyboardEvent) => {
      if (evento.key !== 'ArrowLeft' && evento.key !== 'ArrowRight') return;
      const pestanas = pestanasDisponibles();
      if (pestanas.length === 0) return;
      const actual = pestanas.findIndex(
        (boton) => boton === document.activeElement,
      );
      if (actual === -1) return;
      evento.preventDefault();
      const siguiente =
        evento.key === 'ArrowRight'
          ? (actual + 1) % pestanas.length
          : (actual - 1 + pestanas.length) % pestanas.length;
      pestanas.forEach((boton, indice) =>
        boton.setAttribute('tabindex', indice === siguiente ? '0' : '-1'),
      );
      pestanas[siguiente].focus();
      pestanas[siguiente].click();
    });

    function pintarTablaValores(
      capa: DefinicionCapa,
      valores: Map<string, number | undefined> | null,
    ) {
      if (!tablaCuerpo || !tablaCaption || !tablaColumnaValor) return;
      tablaColumnaValor.textContent = capa.etiqueta;
      tablaCaption.textContent = `Valores de ${capa.etiqueta} por departamento`;
      tablaCuerpo.innerHTML = '';
      const filas = DEPARTAMENTOS.map((dep) => ({
        codigo: dep.codigo,
        nombre: dep.nombre,
        valor: valores?.get(dep.codigo),
      })).sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

      for (const fila of filas) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.className = 'border-b border-border py-1 pr-4 text-left font-normal';
        th.textContent = fila.nombre;
        const td = document.createElement('td');
        td.className = 'border-b border-border py-1 pr-4';
        td.textContent = capa.tooltipValor(fila.valor);
        const tdAlerta = document.createElement('td');
        tdAlerta.className = 'border-b border-border py-1';
        tdAlerta.dataset.celdaAlerta = fila.codigo;
        tr.append(th, td, tdAlerta);
        tablaCuerpo.appendChild(tr);
      }
      pintarAlertasEnTabla();
    }

    function obtenerContenidoTooltip(codigo: string, nombre: string): string {
      const valores = cacheValoresPorCapa.get(capaActivaId);
      const capa = CAPAS.find((c) => c.id === capaActivaId);
      if (!capa || !valores) {
        return `<strong>${escapeHtml(nombre)}</strong><br>capa no disponible todavía`;
      }

      if (capa.id === 'minsal_volumen') {
        const dato = detallesMinsal.get(codigo);
        if (!dato) {
          return `<strong>${escapeHtml(nombre)}</strong><br>sin dato`;
        }
        const valorMinsal =
          dato.valor === undefined
            ? 'sin dato'
            : dato.valor === 0
              ? '0 observado'
              : `${dato.valor} casos`;
        return (
          `<strong>${escapeHtml(nombre)}</strong><br>` +
          `Serie: ${escapeHtml(obtenerFiltrosAnalisis().serie)}<br>` +
          `Periodo: ${escapeHtml(dato.periodo)}<br>` +
          `Valor: ${valorMinsal}<br>` +
          `Cobertura: ${dato.semanasObservadas}/${dato.semanasEsperadas} semanas`
        );
      }

      if (ES_CAPA_MODULO[capa.id]) {
        return tooltipModulos(codigo, nombre, capa.id);
      }

      const valor = valores.get(codigo);
      return `<strong>${escapeHtml(nombre)}</strong><br>${escapeHtml(capa.tituloLeyenda)}: ${capa.tooltipValor(valor)}`;
    }

    function posicionarTooltip(e: MouseEvent) {
      if (!tooltip) return;
      const rect = contenedorMapa.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top - 12;
      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
    }

    paths.forEach((ruta) => {
      const codigo = ruta.dataset.codigo ?? '';
      const nombre = ruta.dataset.nombre ?? codigo;

      const seleccionar = () => {
        const actual = obtenerFiltrosAnalisis().departamento;
        actualizarFiltrosAnalisis({
          departamento: actual === codigo ? null : codigo,
        });
      };

      ruta.addEventListener('click', seleccionar);

      ruta.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          seleccionar();
        }
      });

      ruta.addEventListener('mouseenter', (e) => {
        if (!tooltip) return;
        tooltip.innerHTML = obtenerContenidoTooltip(codigo, nombre);
        tooltip.classList.remove('hidden');
        tooltip.setAttribute('aria-hidden', 'false');
        posicionarTooltip(e);
      });

      ruta.addEventListener('mousemove', (e) => {
        posicionarTooltip(e);
      });

      ruta.addEventListener('mouseleave', () => {
        tooltip?.classList.add('hidden');
        tooltip?.setAttribute('aria-hidden', 'true');
      });

      ruta.addEventListener('focus', () => {
        if (!tooltip || !svgElement) return;
        tooltip.innerHTML = obtenerContenidoTooltip(codigo, nombre);
        tooltip.classList.remove('hidden');
        tooltip.setAttribute('aria-hidden', 'false');
        const rect = contenedorMapa.getBoundingClientRect();
        const svgRect = svgElement.getBoundingClientRect();
        const bbox = ruta.getBBox();
        const viewBox = svgElement.viewBox.baseVal;
        const x =
          svgRect.left -
          rect.left +
          (bbox.x + bbox.width / 2) * (svgRect.width / viewBox.width);
        const y =
          svgRect.top -
          rect.top +
          (bbox.y + bbox.height * 0.3) * (svgRect.height / viewBox.height);
        tooltip.style.left = `${x}px`;
        tooltip.style.top = `${y}px`;
      });

      ruta.addEventListener('blur', () => {
        tooltip?.classList.add('hidden');
        tooltip?.setAttribute('aria-hidden', 'true');
      });
    });

    toggleEtiquetas?.addEventListener('change', (e) => {
      const activo = (e.target as HTMLInputElement).checked;
      if (grupoEtiquetas) {
        grupoEtiquetas.style.opacity = activo ? '1' : '0';
      }
    });

    btnExportarSvg?.addEventListener('click', () => {
      if (!svgElement) return;
      const clon = svgElement.cloneNode(true) as SVGSVGElement;
      clon.removeAttribute('class');
      clon.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      clon
        .querySelectorAll<SVGPathElement>('.mapa-departamento-path')
        .forEach((path) => {
          const orig = contenedorMapa.querySelector(
            `.mapa-departamento-path[data-codigo="${path.dataset.codigo}"]`,
          ) as SVGPathElement | null;
          if (orig) {
            const estilo = window.getComputedStyle(orig);
            path.setAttribute('fill', estilo.fill);
            path.setAttribute('stroke', estilo.stroke);
            path.setAttribute('stroke-width', estilo.strokeWidth);
            if (orig.style.strokeDasharray) {
              path.setAttribute('stroke-dasharray', orig.style.strokeDasharray);
            }
          }
        });
      clon
        .querySelectorAll<SVGTextElement>('.mapa-etiqueta-texto')
        .forEach((txt) => {
          txt.setAttribute('fill', '#040316');
          txt.setAttribute('font-family', 'sans-serif');
        });
      const contenido = new XMLSerializer().serializeToString(clon);
      const blob = new Blob([contenido], {
        type: 'image/svg+xml;charset=utf-8',
      });
      const url = URL.createObjectURL(blob);
      const enlace = document.createElement('a');
      enlace.href = url;
      enlace.download = `mapa-el-salvador-${capaActivaId}.svg`;
      enlace.click();
      URL.revokeObjectURL(url);
    });

    btnExportarPng?.addEventListener('click', () => {
      if (!svgElement) return;
      const clon = svgElement.cloneNode(true) as SVGSVGElement;
      clon.removeAttribute('class');
      clon.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      clon
        .querySelectorAll<SVGPathElement>('.mapa-departamento-path')
        .forEach((path) => {
          const orig = contenedorMapa.querySelector(
            `.mapa-departamento-path[data-codigo="${path.dataset.codigo}"]`,
          ) as SVGPathElement | null;
          if (orig) {
            const estilo = window.getComputedStyle(orig);
            path.setAttribute('fill', estilo.fill);
            path.setAttribute('stroke', estilo.stroke);
            path.setAttribute('stroke-width', estilo.strokeWidth);
            if (orig.style.strokeDasharray) {
              path.setAttribute('stroke-dasharray', orig.style.strokeDasharray);
            }
          }
        });
      clon
        .querySelectorAll<SVGTextElement>('.mapa-etiqueta-texto')
        .forEach((txt) => {
          txt.setAttribute('fill', '#040316');
          txt.setAttribute('font-family', 'sans-serif');
        });
      const contenido = new XMLSerializer().serializeToString(clon);
      const svgBlob = new Blob([contenido], {
        type: 'image/svg+xml;charset=utf-8',
      });
      const url = URL.createObjectURL(svgBlob);
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const escala = 2;
        const anchoPx = svgElement.viewBox.baseVal.width * escala;
        const altoPx = svgElement.viewBox.baseVal.height * escala;
        canvas.width = anchoPx;
        canvas.height = altoPx;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, anchoPx, altoPx);
        ctx.drawImage(img, 0, 0, anchoPx, altoPx);
        const pngUrl = canvas.toDataURL('image/png');
        const enlace = document.createElement('a');
        enlace.href = pngUrl;
        enlace.download = `mapa-el-salvador-${capaActivaId}.png`;
        enlace.click();
        URL.revokeObjectURL(url);
      };
      img.src = url;
    });

    async function activarCapa(id: IdCapa) {
      const capa = CAPAS.find((c) => c.id === id);
      if (!capa || !capa.disponible) return;
      capaActivaId = id;
      if (id === 'minsal_volumen') actualizarDescripcionMinsal();

      pintarSelector(id);
      contenedorAviso!.textContent = capa.aviso;
      // Solo se reemplaza la leyenda por el esqueleto al cambiar de capa. Si
      // solo cambió la semana (Play recorriendo el slider) la leyenda
      // anterior se queda puesta hasta que la nueva esté lista -- si se
      // limpiaba en cada semana, el panel lateral se achicaba al esqueleto
      // (una línea) y volvía a crecer a la leyenda real un instante después;
      // como el mapa y el panel comparten fila con items-stretch, esa
      // oscilación de alto hacía que el mapa se encogiera y estirara en
      // cada cuadro de la animación.
      if (idCapaPintada !== id) {
        contenedorLeyenda!.innerHTML =
          '<div class="flex items-center gap-2" aria-hidden="true">' +
          '<div class="skeleton h-4 w-40"></div><div class="skeleton h-4 w-24"></div><div class="skeleton h-4 w-24"></div>' +
          '</div>';
      }
      contenedorNoDisponible!.classList.add('hidden');
      contenedorNoDisponible!.replaceChildren();

      let valores = cacheValoresPorCapa.get(id);
      if (valores === undefined) {
        valores = await capa.cargarValores();
        cacheValoresPorCapa.set(id, valores);
      }

      if (ES_CAPA_MODULO[id]) {
        await Promise.all([obtenerDatosEspaciales(), obtenerDatosPresion()]);
      }

      if (!valores) {
        idCapaPintada = null;
        contenedorNoDisponible!.classList.remove('hidden');
        contenedorLeyenda!.innerHTML = '';
        renderErrorFuente(
          contenedorNoDisponible!,
          () => void activarCapa(id),
          'No se pudo cargar esta capa. El mapa se muestra en gris hasta que los datos vuelvan a estar disponibles.',
        );
        pintarTablaValores(capa, null);
        paths.forEach((ruta) => {
          ruta.style.fill = SIN_DATO;
          ruta.style.fillOpacity = '0.5';
        });
        resaltarDepartamento(obtenerFiltrosAnalisis().departamento);
        return;
      }

      const numericos = [...valores.values()].filter(
        (v): v is number => v !== undefined,
      );
      const cortes = capa.calcularCortes(numericos);
      dibujarLeyenda(contenedorLeyenda!, capa, cortes);
      pintarTablaValores(capa, valores);
      idCapaPintada = id;

      paths.forEach((ruta) => {
        const codigo = ruta.dataset.codigo ?? '';
        const valor = valores!.get(codigo);
        const color = colorGenerico(
          valor,
          cortes,
          capa.rampa,
          capa.sinDatoColor,
        );
        ruta.style.fill = color;
        ruta.style.fillOpacity = '0.85';
      });

      resaltarDepartamento(obtenerFiltrosAnalisis().departamento);
    }

    const resolverIdCapa = (
      capaNombre?: string | null,
      serie?: SerieEpidemiologica,
    ): IdCapa => {
      if (capaNombre === 'presion') {
        return serie === 'confirmado'
          ? 'presion_confirmado'
          : 'presion_probable';
      }
      if (capaNombre && CAPAS.some((k) => k.id === capaNombre)) {
        return capaNombre as IdCapa;
      }
      return capaMinsal.id;
    };

    const idCapaInicial = resolverIdCapa(
      filtrosIniciales.capa,
      filtrosIniciales.serie,
    );
    capaActivaId = idCapaInicial;
    pintarSelector(idCapaInicial);
    void cargarAlertasVigentes();
    await activarCapa(idCapaInicial);

    let filtrosAplicados = obtenerFiltrosAnalisis();
    suscribirFiltrosAnalisis((filtros) => {
      const cambioTiempo =
        filtros.semana !== filtrosAplicados.semana ||
        filtros.anio !== filtrosAplicados.anio;
      const cambioSerie = filtros.serie !== filtrosAplicados.serie;
      const cambioModoMinsal =
        filtros.modoMinsal !== filtrosAplicados.modoMinsal;
      const cambioDepartamento =
        filtros.departamento !== filtrosAplicados.departamento;
      const idCapaObjetivo = resolverIdCapa(filtros.capa, filtros.serie);
      const cambioCapa = idCapaObjetivo !== capaActivaId;
      filtrosAplicados = filtros;

      if (cambioTiempo) {
        SEMANA_ESPACIAL = filtros.semana;
        ANIO_ESPACIAL = filtros.anio;
        cacheEspacial = null;
        cachePresion = null;
        cacheConfianza = null;
        (
          [
            'minsal_volumen',
            'iv',
            'anomalia',
            'presion_probable',
            'presion_confirmado',
            'confianza',
          ] as IdCapa[]
        ).forEach((id) => cacheValoresPorCapa.delete(id));
      }

      if (cambioSerie || cambioModoMinsal) {
        cacheValoresPorCapa.delete('minsal_volumen');
        cacheValoresPorCapa.delete('confianza');
      }

      if (
        cambioSerie &&
        (capaActivaId === 'presion_probable' ||
          capaActivaId === 'presion_confirmado')
      ) {
        capaActivaId =
          filtros.serie === 'probable'
            ? 'presion_probable'
            : 'presion_confirmado';
      } else if (cambioCapa) {
        capaActivaId = idCapaObjetivo;
      }

      void (async () => {
        if (cambioTiempo || cambioSerie || cambioModoMinsal || cambioCapa)
          await activarCapa(capaActivaId);
        if (cambioDepartamento || (cambioTiempo && filtros.departamento)) {
          resaltarDepartamento(filtros.departamento);
          if (!filtros.departamento) {
            contenedorDetalle.classList.add('hidden');
            return;
          }
          const dep = DEPARTAMENTOS.find(
            (d) => d.codigo === filtros.departamento,
          );
          const nombre = dep ? dep.nombre : filtros.departamento;
          await mostrarDetalle(filtros.departamento, nombre);
        }
      })();
    }, false);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void iniciar());
  } else {
    void iniciar();
  }
</script>
