---
import AyudaTermino from './AyudaTermino.astro';
import Icono from './Icono.astro';
import PanelWorkspace from './analisis/PanelWorkspace.astro';
import { rutaFicha } from '../fichas/registro';
// Mapa departamental -- selector de capas descriptivas (módulos M1–M3,
// docs/contexto). Leaflet necesita el DOM del navegador (no hay forma de
// renderizarlo en el servidor), así que todo el trabajo con L.* vive en el
// <script> de abajo, que Astro procesa y ejecuta solo en el cliente. No se
// agregó React/Preact para esto -- un componente .astro + <script> ya
// resuelve "solo en el navegador" sin sumar un framework de UI nuevo.
//
// Ninguna de las capas es salida del clasificador de riesgo (ese vive en
// MetricasModelo.astro, a nivel nacional, en /prediccion). Todas son descriptivas: volumen
// de casos MINSAL, idoneidad biofísica, anomalía climática continua,
// presión epidemiológica relativa (M3, dos series separadas), e integridad
// de la vigilancia (M4: presencia de dato / hueco / boletín que no cuadra).
// M4 no es un semáforo de riesgo ni un índice compuesto.
//
// La capa de anomalía climática no es un semáforo de alerta: el umbral
// binario que se probó se cruzaba todos los años y no distinguía nada. Escala continua,
// colores neutros (azul/gris/naranja), sin rojo de urgencia ni lenguaje de
// "cruce de umbral".
---

<PanelWorkspace tipo="visor" titulo="Mapa departamental" idTitulo="mapa-titulo">
  <div
    class="flex flex-col border-t border-border bg-bg lg:flex-row lg:items-stretch"
  >
    <div
      id="mapa-departamentos"
      role="region"
      aria-label="Mapa interactivo de departamentos de El Salvador"
      aria-busy="true"
      class="h-[340px] w-full overflow-hidden shadow-inner sm:h-[460px] lg:h-auto lg:min-h-[520px] lg:flex-1"
    >
      <div class="skeleton h-full w-full" aria-hidden="true"></div>
    </div>

    <div
      class="flex flex-col gap-3 p-4 sm:p-5 lg:w-[320px] lg:shrink-0 lg:overflow-y-auto lg:border-l lg:border-border"
    >
      <div
        class="flex gap-2 rounded-lg border border-dashed border-border bg-surface p-3"
      >
        <Icono
          nombre="list-details"
          class="mt-0.5 h-4 w-4 shrink-0 text-accent"
        />
        <p class="font-sans text-xs leading-relaxed text-ink-muted">
          <strong class="font-semibold text-ink">Cómo interpretar el mapa:</strong
          > el significado del color depende de la capa seleccionada. La explicación
          específica aparece en el aviso de la capa. El gris indica ausencia de dato.
        </p>
        <div class="flex shrink-0 items-start gap-2" data-ayudas-mapa>
          <AyudaTermino clave="iv" />
          <AyudaTermino clave="anomalia" />
          <AyudaTermino clave="percentil-presion" />
          <AyudaTermino clave="integridad" />
        </div>
      </div>

      <div
        id="mapa-selector"
        class="flex flex-wrap gap-2"
        role="tablist"
        aria-label="Capas del mapa"
      >
      </div>

      <div class="flex gap-2 rounded-lg border border-border bg-surface p-3">
        <Icono nombre="info-circle" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
        <div class="min-w-0 flex-1">
          <p
            id="mapa-aviso"
            role="status"
            aria-live="polite"
            class="font-sans text-sm text-ink"
          >
          </p>
        </div>
      </div>

      <div
        id="mapa-no-disponible"
        class="hidden rounded-lg border border-secondary bg-secondary/25 p-3"
      >
        <div class="flex gap-2">
          <Icono
            nombre="alert-triangle"
            class="mt-0.5 h-4 w-4 shrink-0 text-secondary-ink"
          />
          <p class="font-sans text-sm text-ink">
            No se pudo cargar esta capa. El mapa se muestra en gris hasta que
            los datos vuelvan a estar disponibles.
          </p>
        </div>
      </div>

      <p
        id="mapa-alertas-nacionales"
        class="hidden font-sans text-xs text-ink-muted"
      >
      </p>

      <div id="mapa-leyenda"></div>
    </div>
  </div>

  <div class="flex flex-col gap-3 border-t border-border bg-bg p-4 sm:p-5">
    <details class="rounded-xl border border-border bg-surface p-3">
      <summary
        class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
      >
        Ver los valores por departamento en una tabla
      </summary>
      <div class="mt-2 overflow-x-auto">
        <table
          id="mapa-tabla-valores"
          class="w-full border-collapse font-sans text-xs tabular-nums text-ink"
        >
          <caption class="sr-only" id="mapa-tabla-caption"></caption>
          <thead>
            <tr class="text-left text-ink-muted">
              <th scope="col" class="border-b border-border py-1 pr-4"
                >Departamento</th
              >
              <th
                scope="col"
                class="border-b border-border py-1 pr-4"
                id="mapa-tabla-columna-valor">Valor</th
              >
              <th scope="col" class="border-b border-border py-1"
                >Alerta vigente</th
              >
            </tr>
          </thead>
          <tbody id="mapa-tabla-cuerpo"></tbody>
        </table>
      </div>
    </details>

    <p
      id="mapa-detalle-anuncio"
      role="status"
      aria-live="polite"
      class="sr-only"
    >
    </p>
    <div
      id="mapa-detalle"
      role="region"
      aria-labelledby="mapa-detalle-nombre"
      tabindex="-1"
      class="hidden rounded-xl border border-accent/30 bg-secondary/20 p-4 sm:p-5"
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="font-sans text-xs font-semibold text-ink-muted">
            Detalle de departamento
          </p>
          <h3
            id="mapa-detalle-nombre"
            class="mt-0.5 font-display text-lg font-semibold text-ink"
          >
          </h3>
        </div>
        <div class="flex items-center gap-2">
          <a
            id="mapa-detalle-ficha"
            href="#"
            class="rounded-full border border-border bg-surface px-3 py-1 font-sans text-xs font-semibold text-accent transition-colors hover:border-accent/40 hover:underline"
          >
            Ficha imprimible
          </a>
          <button
            type="button"
            id="mapa-detalle-cerrar"
            class="rounded-full border border-border bg-surface px-2.5 py-1 font-sans text-xs text-ink-muted transition-colors hover:border-accent/40 hover:text-ink"
            aria-label="Cerrar detalle de departamento"
          >
            Cerrar
          </button>
        </div>
      </div>

      <dl
        id="mapa-detalle-snapshot"
        class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4"
      >
      </dl>

      <div class="mt-4">
        <p class="font-sans text-xs font-semibold text-ink-muted">
          <a
            href={rutaFicha('m1-idoneidad-biofisica')}
            class="text-accent underline underline-offset-2"
            >Idoneidad biofísica (Iv)</a
          >. Banda histórica P25-P75 frente al año seleccionado
        </p>
        <div id="mapa-detalle-curva" class="mt-2 h-24 w-full">
          <div class="skeleton h-full w-full" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</PanelWorkspace>

<style>
  :global(.leaflet-container) {
    font-family: var(--font-sans);
    background: var(--color-bg);
    /* Los controles internos de Leaflet (.leaflet-top, .leaflet-control)
       usan z-index: 1000 -- sin esto, ese valor compite directamente contra
       el z-40 del header sticky de Layout.astro y gana, así que al hacer
       scroll el zoom del mapa se dibuja encima del header. isolation
       confina el z-index de Leaflet dentro de su propio contexto de
       apilamiento, sin tocar los valores internos de la librería. */
    isolation: isolate;
  }
  /* Al cambiar la semana los departamentos se recolorean con un fundido corto
     (ver activarCapa). Con reduced-motion el color cambia de golpe. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.leaflet-container path.leaflet-interactive) {
      transition: fill 300ms ease-out;
    }
  }
  :global(.leaflet-control-zoom) {
    border: 1px solid var(--color-border) !important;
    box-shadow: var(--shadow-card) !important;
  }
  :global(.leaflet-control-zoom a) {
    color: var(--color-accent) !important;
    background-color: var(--color-surface) !important;
  }
  :global(.leaflet-control-zoom a:hover) {
    background-color: var(--color-secondary) !important;
  }
  :global(.leaflet-tooltip) {
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink);
    padding: 6px 10px;
  }
</style>

<script>
  // Leaflet (JS ~44KB + CSS ~6KB), el geojson de departamentos (~100KB) y
  // los tiles de OpenStreetMap (decenas de peticiones) no son necesarios
  // para el primer render de la página -- solo se importan/descargan aquí
  // dentro de iniciar(), en lugar de al nivel de módulo, para que no
  // compitan por ancho de banda ni CPU con el contenido inicial. Ver
  // "iniciar()" al final del archivo para el diferido con
  // requestIdleCallback.
  import type Leaflet from 'leaflet';
  // "?url" evita que Vite trate este CSS como parte del bundle de la
  // página (que inyectaría un <link> en el <head> desde el primer HTML,
  // volviendo a bloquear el render): solo da la URL del archivo, y el
  // <link> se crea a mano dentro de iniciar().
  import leafletCssHref from 'leaflet/dist/leaflet.css?url';
  import {
    obtenerAlertasDengue,
    obtenerDatasetAnalitico,
  } from '../lib/analisis-api';
  import { alertaEstaVigente } from '../lib/vista-alertas';
  import { esAlertaNacional } from '../lib/alcance-alertas';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../lib/analisis-state';
  import {
    ANIOS_ANALISIS_DENGUE,
    esAnioAnalisisDengue,
    type AnioAnalisisDengue,
    type CapaAnalitica,
    type SerieEpidemiologica,
  } from '../lib/tipos-analisis';
  import {
    RAMPA_ANOMALIA,
    RAMPA_CONFIANZA,
    RAMPA_IV,
    RAMPA_PRESION_CATEGORIA,
  } from '../lib/colores';
  import { rutaFicha } from '../fichas/registro';
  import { protegerScrollMapa } from '../lib/mapa-scroll';
  import { renderErrorFuente } from './estado-async';
  import { escapeHtml } from '../utils/security';

  // ---------------------------------------------------------------------
  // Tipos y datos compartidos
  // ---------------------------------------------------------------------

  type IdCapa =
    | 'minsal_volumen'
    | 'iv'
    | 'anomalia'
    | 'presion_probable'
    | 'presion_confirmado'
    | 'confianza';

  interface DefinicionCapa {
    id: IdCapa;
    etiqueta: string;
    disponible: boolean; // false => botón deshabilitado, "próximamente"
    aviso: string;
    tituloLeyenda: string;
    /** Si la capa tiene ficha enriquecida, el título de la leyenda la enlaza. */
    enlaceLeyenda?: string;
    rampa: string[];
    sinDatoColor: string;
    // Carga los valores por código de departamento. undefined = sin dato
    // para ese departamento (se pinta con sinDatoColor). null de retorno
    // completo = falla de fetch / capa no disponible en el backend todavía.
    cargarValores: () => Promise<Map<string, number | undefined> | null>;
    calcularCortes: (valores: number[]) => number[];
    etiquetasLeyenda: (cortes: number[]) => string[];
    tooltipValor: (valor: number | undefined) => string;
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const SIN_DATO = '#e4e4e7';
  const RUTA_FICHA_M1 = rutaFicha('m1-idoneidad-biofisica');
  const RUTA_FICHA_M2 = rutaFicha('m2-anomalia-climatica');
  const RUTA_FICHA_M3 = rutaFicha('m3-presion-epidemiologica');
  const RUTA_FICHA_M4 = rutaFicha('m4-integridad-vigilancia');

  // El shapeName del geojson (geoBoundaries) es inconsistente: 12 de los 14
  // departamentos traen el prefijo "Departamento de ..." pero La Libertad y
  // San Vicente no -- se ve como un error tipográfico en los tooltips si no
  // se normaliza en un solo lugar. Mismo criterio que index.astro (el hero
  // de la landing ya lo aplicaba, esto lo extiende a los tooltips del mapa).
  function normalizarNombreDepto(shapeName: string): string {
    return shapeName.replace(/^Departamento de /, '');
  }

  // Semana/año de las capas espaciales, derivados del estado global del panel.
  const filtrosIniciales = obtenerFiltrosAnalisis();
  let SEMANA_ESPACIAL = filtrosIniciales.semana;
  let ANIO_ESPACIAL = filtrosIniciales.anio;

  // ---------------------------------------------------------------------
  // Funciones genéricas de color / cortes / leyenda, reutilizadas por todas
  // las capas -- cada capa solo aporta su rampa, sus cortes y sus textos.
  // ---------------------------------------------------------------------

  function cortesPorCuantiles(valores: number[]): number[] {
    const ordenados = [...valores].sort((a, b) => a - b);
    if (ordenados.length === 0) return [1, 2, 3, 4];
    const corte = (p: number) =>
      ordenados[
        Math.min(ordenados.length - 1, Math.floor(p * (ordenados.length - 1)))
      ];
    return [corte(0.2), corte(0.4), corte(0.6), corte(0.8)];
  }

  function colorGenerico(
    valor: number | undefined,
    cortes: number[],
    rampa: string[],
    sinDato: string,
  ): string {
    if (valor === undefined) return sinDato;
    for (let i = 0; i < cortes.length; i++) {
      if (valor <= cortes[i]) return rampa[i];
    }
    return rampa[rampa.length - 1];
  }

  function dibujarLeyenda(
    contenedor: HTMLElement,
    capa: DefinicionCapa,
    cortes: number[],
  ) {
    const rangos = capa.etiquetasLeyenda(cortes);
    const item = (color: string, etiqueta: string) =>
      `<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2 py-1">` +
      `<span style="background:${color}" class="inline-block h-2.5 w-2.5 rounded-full ring-1 ring-black/5"></span>` +
      `<span class="font-mono text-[11px] text-ink-muted">${escapeHtml(etiqueta)}</span></span>`;
    const items = capa.rampa.map((color, i) => item(color, rangos[i])).join('');
    contenedor.innerHTML = `
      <div class="flex flex-wrap items-center gap-1.5 font-sans text-xs text-ink-muted">
        <span class="mr-1 font-medium text-ink">${
          capa.enlaceLeyenda
            ? `<a href="${escapeHtml(capa.enlaceLeyenda)}" class="text-accent underline underline-offset-2">${escapeHtml(capa.tituloLeyenda)}</a>`
            : escapeHtml(capa.tituloLeyenda)
        }:</span>
        ${items}
        ${item(capa.sinDatoColor, 'sin dato')}
      </div>
    `;
  }

  // ---------------------------------------------------------------------
  // Capa 1: volumen de casos MINSAL -- ya funcionaba, mismo comportamiento,
  // ahora expresado en la forma genérica de DefinicionCapa.
  // ---------------------------------------------------------------------

  interface DetalleDepartamentoMinsal {
    nombre: string;
    codigo: string;
    valor: number | undefined;
    semanasObservadas: number;
    semanasEsperadas: number;
    periodo: string;
  }

  let detallesMinsal = new Map<string, DetalleDepartamentoMinsal>();

  const RAMPA_MINSAL = ['#cde2fb', '#9ec5f4', '#5598e7', '#256abf', '#0d366b'];

  function descripcionMinsal() {
    const filtros = obtenerFiltrosAnalisis();
    const serie = `"${filtros.serie}"`;
    if (filtros.modoMinsal === 'semana') {
      return {
        periodo: `SE${String(filtros.semana).padStart(2, '0')} / ${filtros.anio}`,
        titulo: `Casos ${serie} en SE${String(filtros.semana).padStart(2, '0')} / ${filtros.anio}`,
        aviso: `El color representa los casos ${serie} observados por MINSAL en la semana seleccionada. Un valor de cero se conserva como observación; las semanas sin registro se muestran como “sin dato”.`,
      };
    }
    if (filtros.modoMinsal === 'ytd') {
      return {
        periodo: `SE01–SE${String(filtros.semana).padStart(2, '0')} / ${filtros.anio}`,
        titulo: `Casos ${serie} acumulados hasta SE${String(filtros.semana).padStart(2, '0')} / ${filtros.anio}`,
        aviso: `El color representa la suma de las observaciones ${serie} disponibles hasta la semana seleccionada. Los periodos sin registro no se convierten en cero. La cobertura se detalla al pasar sobre cada departamento.`,
      };
    }
    return {
      periodo: '2018–2023 (2020 sin serie departamental)',
      titulo: `Casos ${serie} acumulados en la historia disponible`,
      aviso: `El color representa la suma de las observaciones ${serie} disponibles en 2018, 2019, 2021, 2022 y 2023. Los periodos sin registro no se convierten en cero.`,
    };
  }

  function actualizarDescripcionMinsal() {
    const descripcion = descripcionMinsal();
    capaMinsal.aviso = descripcion.aviso;
    capaMinsal.tituloLeyenda = descripcion.titulo;
  }

  const capaMinsal: DefinicionCapa = {
    id: 'minsal_volumen',
    etiqueta: 'Volumen de casos (MINSAL)',
    disponible: true,
    aviso: '',
    tituloLeyenda: '',
    rampa: RAMPA_MINSAL,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const filtros = obtenerFiltrosAnalisis();
      actualizarDescripcionMinsal();
      const anios: readonly AnioAnalisisDengue[] =
        filtros.modoMinsal === 'historico'
          ? ANIOS_ANALISIS_DENGUE
          : esAnioAnalisisDengue(filtros.anio)
            ? [filtros.anio]
            : [];
      if (anios.length === 0) {
        detallesMinsal = new Map();
        return new Map();
      }
      const datasets = await Promise.all(
        anios.map((anio) => obtenerDatasetAnalitico(anio)),
      );
      const descripcion = descripcionMinsal();
      const nuevosDetalles = new Map<string, DetalleDepartamentoMinsal>();
      for (const dataset of datasets) {
        for (const departamento of dataset.departamentos) {
          const detalle = nuevosDetalles.get(departamento.codigo) ?? {
            nombre: departamento.nombre,
            codigo: departamento.codigo,
            valor: undefined,
            semanasObservadas: 0,
            semanasEsperadas: 0,
            periodo: descripcion.periodo,
          };
          const semanas = departamento.semanas.filter((semana) => {
            if (filtros.modoMinsal === 'historico') return true;
            if (filtros.modoMinsal === 'ytd') {
              return semana.semana_epi <= filtros.semana;
            }
            return semana.semana_epi === filtros.semana;
          });
          detalle.semanasEsperadas += semanas.length;
          for (const semana of semanas) {
            const casos = semana[filtros.serie];
            if (casos === null) continue;
            detalle.valor = (detalle.valor ?? 0) + casos;
            detalle.semanasObservadas += 1;
          }
          nuevosDetalles.set(departamento.codigo, detalle);
        }
      }
      detallesMinsal = nuevosDetalles;
      const valores = new Map<string, number | undefined>();
      for (const detalle of detallesMinsal.values())
        valores.set(detalle.codigo, detalle.valor);
      return valores;
    },
    calcularCortes: cortesPorCuantiles,
    etiquetasLeyenda(cortes) {
      return [
        `≤ ${cortes[0]}`,
        `${cortes[0]}–${cortes[1]}`,
        `${cortes[1]}–${cortes[2]}`,
        `${cortes[2]}–${cortes[3]}`,
        `> ${cortes[3]}`,
      ];
    },
    tooltipValor(valor) {
      if (valor === undefined) return 'sin dato';
      return valor === 0 ? '0 observado' : `${valor} casos`;
    },
  };

  // ---------------------------------------------------------------------
  // Capas 2 y 3: idoneidad biofísica (Iv) y anomalía climática continua --
  // GET /api/v1/spatial/current (no el dataset de dengue, que corta en 2023).
  // ---------------------------------------------------------------------

  interface DatoEspacial {
    codigo: string;
    iv: number | undefined;
    anomalia_sigma: number | undefined;
  }

  let cacheEspacial: Promise<Map<string, DatoEspacial> | null> | null = null;

  // Último resultado resuelto del endpoint espacial, para que el tooltip
  // unificado de los módulos M1–M3 pueda leerlo de forma síncrona.
  let detallesEspacial = new Map<string, DatoEspacial>();

  async function obtenerDatosEspaciales(): Promise<Map<
    string,
    DatoEspacial
  > | null> {
    if (!cacheEspacial) {
      cacheEspacial = (async () => {
        try {
          const resp = await fetch(
            `${API_BASE}/api/v1/spatial/current?week=${SEMANA_ESPACIAL}&year=${ANIO_ESPACIAL}`,
          );
          if (!resp.ok) return null;
          const cuerpo: {
            departamentos?: Array<{
              codigo: string;
              iv: number | null;
              anomaly_sigma: number | null;
            }>;
          } = await resp.json();
          const mapa = new Map<string, DatoEspacial>();
          for (const fila of cuerpo.departamentos ?? []) {
            mapa.set(fila.codigo, {
              codigo: fila.codigo,
              iv: typeof fila.iv === 'number' ? fila.iv : undefined,
              anomalia_sigma:
                typeof fila.anomaly_sigma === 'number'
                  ? fila.anomaly_sigma
                  : undefined,
            });
          }
          detallesEspacial = mapa;
          return mapa;
        } catch {
          return null;
        }
      })();
    }
    return cacheEspacial;
  }

  const capaIv: DefinicionCapa = {
    id: 'iv',
    etiqueta: 'Idoneidad biofísica (Iv)',
    disponible: true,
    aviso:
      'Resume qué tan favorables son las condiciones ambientales para el vector, de 0 a 1. Es condición biofísica (clima), no incidencia ni riesgo; los casos MINSAL y la presión epidemiológica no llegan más allá de 2023.',
    tituloLeyenda: 'Idoneidad biofísica (Iv, 0-1)',
    enlaceLeyenda: RUTA_FICHA_M1,
    rampa: RAMPA_IV,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const datos = await obtenerDatosEspaciales();
      if (!datos) return null;
      const valores = new Map<string, number | undefined>();
      for (const [codigo, fila] of datos) valores.set(codigo, fila.iv);
      return valores;
    },
    // Iv está acotado en [0,1] por definición, pero eso no significa que los
    // valores reales usen ese rango completo -- medido en vivo (SE01/2023):
    // Iv real va de 0.076 a 0.277 en los 14 departamentos, muy por debajo de
    // los cortes fijos que había antes (0.2/0.4/0.6/0.8), así que casi todo
    // el país caía en el mismo balde de color. Cuantiles de los datos (igual
    // que la capa de volumen MINSAL) en vez de cortes fijos sobre [0,1] --
    // siempre usa el rango completo de la rampa contra lo que realmente varía
    // esa semana, en vez de asumir una dispersión que no existe.
    calcularCortes: cortesPorCuantiles,
    etiquetasLeyenda(cortes) {
      return [
        `0.00–${cortes[0].toFixed(2)}`,
        `${cortes[0].toFixed(2)}–${cortes[1].toFixed(2)}`,
        `${cortes[1].toFixed(2)}–${cortes[2].toFixed(2)}`,
        `${cortes[2].toFixed(2)}–${cortes[3].toFixed(2)}`,
        `> ${cortes[3].toFixed(2)}`,
      ];
    },
    tooltipValor(valor) {
      return valor === undefined ? 'sin dato' : valor.toFixed(2);
    },
  };

  const capaAnomalia: DefinicionCapa = {
    id: 'anomalia',
    etiqueta: 'Anomalía climática (continua)',
    disponible: true,
    aviso:
      'Se expresa en desviaciones estándar frente a la referencia histórica del mismo ' +
      'departamento y semana. Es condición biofísica (clima), no incidencia ni riesgo; ' +
      'los casos MINSAL y la presión epidemiológica no llegan más allá de 2023.',
    tituloLeyenda: 'Anomalía climática (σ respecto al promedio histórico)',
    enlaceLeyenda: RUTA_FICHA_M2,
    rampa: RAMPA_ANOMALIA,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const datos = await obtenerDatosEspaciales();
      if (!datos) return null;
      const valores = new Map<string, number | undefined>();
      for (const [codigo, fila] of datos)
        valores.set(codigo, fila.anomalia_sigma);
      return valores;
    },
    // Sigma ya es una unidad estandarizada -- cortes fijos y simétricos en
    // vez de cuantiles, para que el mismo color siempre signifique la misma
    // magnitud de desviación entre semanas.
    calcularCortes: () => [-1.5, -0.5, 0.5, 1.5],
    etiquetasLeyenda(cortes) {
      return [
        `< ${cortes[0]}σ`,
        `${cortes[0]} a ${cortes[1]}σ`,
        `${cortes[1]} a ${cortes[2]}σ`,
        `${cortes[2]} a ${cortes[3]}σ`,
        `> ${cortes[3]}σ`,
      ];
    },
    tooltipValor(valor) {
      return valor === undefined ? 'sin dato' : `${valor.toFixed(2)}σ`;
    },
  };

  // ---------------------------------------------------------------------
  // Capas 4 y 5: presión epidemiológica relativa (M3), dos series
  // separadas. GET /api/v1/presion/current devuelve 'probable' y
  // 'confirmado' por departamento, nunca fusionadas (son conceptos
  // distintos y no comparables entre sí). Decisión de UI: un botón por
  // serie, reutilizando el selector de capas existente en vez de sumar un
  // sub-selector nuevo -- "probable" va primero por ser la serie con más
  // cobertura (misma serie que colorea la capa de volumen MINSAL). Ambas
  // comparten un único fetch cacheado.
  //
  // El color viene de la categoría (baja/media/alta contra P50/P75 del
  // propio baseline del departamento), no del percentil crudo -- el
  // percentil exacto y el conteo observado van en el tooltip. Rampa verde
  // azulada neutra: sin rojo de urgencia, esto no es una alerta.
  // ---------------------------------------------------------------------

  interface CeldaPresion {
    casos_observados: number | null;
    percentil: number | null;
    categoria: 'baja' | 'media' | 'alta' | null;
    p50_baseline: number | null;
    p75_baseline: number | null;
    nota?: string;
  }

  interface DatoPresion {
    codigo: string;
    probable: CeldaPresion | undefined;
    confirmado: CeldaPresion | undefined;
  }

  let cachePresion: Promise<Map<string, DatoPresion> | null> | null = null;

  // Adaptación de la semana activa del dataset analítico compartido a la
  // forma que ya consume el mapa para M3.
  async function obtenerDatosPresion(): Promise<Map<
    string,
    DatoPresion
  > | null> {
    if (!cachePresion) {
      cachePresion = (async () => {
        try {
          if (!esAnioAnalisisDengue(ANIO_ESPACIAL)) {
            detallesPresion = new Map();
            return new Map();
          }
          const datos = await obtenerDatasetAnalitico(ANIO_ESPACIAL);
          const mapa = new Map<string, DatoPresion>();
          for (const departamento of datos.departamentos) {
            const fila = departamento.semanas.find(
              (semana) => semana.semana_epi === SEMANA_ESPACIAL,
            );
            mapa.set(departamento.codigo, {
              codigo: departamento.codigo,
              probable: fila?.presion_probable,
              confirmado: fila?.presion_confirmado,
            });
          }
          detallesPresion = mapa;
          return mapa;
        } catch {
          return null;
        }
      })();
    }
    return cachePresion;
  }

  const CATEGORIA_A_INDICE: Record<string, number> = {
    baja: 0,
    media: 1,
    alta: 2,
  };
  let detallesPresion = new Map<string, DatoPresion>();

  function definirCapaPresion(
    serie: 'probable' | 'confirmado',
  ): DefinicionCapa {
    return {
      id: serie === 'probable' ? 'presion_probable' : 'presion_confirmado',
      etiqueta: `Presión epidemiológica (${serie})`,
      disponible: true,
      aviso:
        `Compara los casos ${serie} observados con la historia del mismo departamento y periodo. ` +
        'Un valor alto indica qué tan inusual es lo observado frente a la historia del propio departamento.',
      tituloLeyenda: `Presión relativa (${serie}, frente a P50/P75 de su referencia histórica)`,
      enlaceLeyenda: RUTA_FICHA_M3,
      rampa: RAMPA_PRESION_CATEGORIA,
      sinDatoColor: SIN_DATO,
      async cargarValores() {
        const datos = await obtenerDatosPresion();
        if (!datos) return null;
        const valores = new Map<string, number | undefined>();
        for (const [codigo, fila] of datos) {
          const celda = fila[serie];
          const indice =
            celda?.categoria != null
              ? CATEGORIA_A_INDICE[celda.categoria]
              : undefined;
          valores.set(codigo, indice);
        }
        return valores;
      },
      // Cortes fijos sobre el índice de categoría (0=baja, 1=media, 2=alta)
      // -- la categoría ya la decide el backend contra el baseline.
      calcularCortes: () => [0.5, 1.5],
      etiquetasLeyenda: () => ['baja (≤P50)', 'media (P50–P75)', 'alta (>P75)'],
      tooltipValor(valor) {
        if (valor === undefined) return 'sin datos suficientes';
        return ['baja', 'media', 'alta'][valor] ?? 'sin dato';
      },
    };
  }

  const capaPresionProbable = definirCapaPresion('probable');
  const capaPresionConfirmado = definirCapaPresion('confirmado');

  // ---------------------------------------------------------------------
  // Capa 6: integridad de la vigilancia (M4). Tres hechos por separado;
  // el color del mapa solo codifica presencia / hueco / boletín que no
  // cuadra. Sin índice compuesto y sin paleta de semáforo de riesgo.
  // GET /api/v1/vigilancia/integridad?week=&year=
  // ---------------------------------------------------------------------

  interface IntegridadSemana {
    completitud?: {
      probable: {
        departamentos: { codigo: string; presente: boolean }[];
      };
      confirmado: {
        departamentos: { codigo: string; presente: boolean }[];
      };
    };
    cuadre?: { cuadra: boolean | null };
  }

  let cacheConfianza: Promise<IntegridadSemana | null> | null = null;

  async function obtenerIntegridadSemana(): Promise<IntegridadSemana | null> {
    if (!cacheConfianza) {
      cacheConfianza = (async () => {
        try {
          const resp = await fetch(
            `${API_BASE}/api/v1/vigilancia/integridad?week=${SEMANA_ESPACIAL}&year=${ANIO_ESPACIAL}`,
          );
          if (!resp.ok) return null;
          return (await resp.json()) as IntegridadSemana;
        } catch {
          return null;
        }
      })();
    }
    return cacheConfianza;
  }

  const ESTADO_SIN_DATO = 0;
  const ESTADO_PRESENTE = 1;
  const ESTADO_NO_CUADRA = 2;

  const capaConfianza: DefinicionCapa = {
    id: 'confianza',
    etiqueta: 'Integridad de la vigilancia',
    disponible: true,
    aviso:
      'El color indica si ese departamento tiene fila esa semana, si falta el dato, o si el ' +
      'boletín no cuadra aritméticamente. No es un nivel de riesgo ni un índice de confianza opaco.',
    tituloLeyenda: 'Calidad del dato (semana seleccionada)',
    enlaceLeyenda: RUTA_FICHA_M4,
    rampa: RAMPA_CONFIANZA,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const datos = await obtenerIntegridadSemana();
      if (!datos?.completitud) return null;
      const serie = obtenerFiltrosAnalisis().serie;
      const cuadra = datos.cuadre?.cuadra;
      const valores = new Map<string, number | undefined>();
      for (const departamento of datos.completitud[serie].departamentos) {
        if (!departamento.presente) {
          valores.set(departamento.codigo, ESTADO_SIN_DATO);
        } else if (cuadra === false) {
          valores.set(departamento.codigo, ESTADO_NO_CUADRA);
        } else {
          valores.set(departamento.codigo, ESTADO_PRESENTE);
        }
      }
      return valores;
    },
    calcularCortes: () => [0.5, 1.5],
    etiquetasLeyenda: () => [
      'sin dato esta semana',
      'dato presente',
      'el boletín no cuadra',
    ],
    tooltipValor(valor) {
      if (valor === ESTADO_SIN_DATO) return 'sin dato esta semana';
      if (valor === ESTADO_NO_CUADRA)
        return 'dato presente — el boletín no cuadra';
      if (valor === ESTADO_PRESENTE) return 'dato presente';
      return 'sin dato';
    },
  };

  const CAPAS: DefinicionCapa[] = [
    capaMinsal,
    capaIv,
    capaAnomalia,
    capaPresionProbable,
    capaPresionConfirmado,
    capaConfianza,
  ];

  // ---------------------------------------------------------------------
  // Tooltip unificado de los módulos M1–M3: al pasar sobre un departamento en
  // cualquiera de las capas M1/M2/M3 se ven los cuatro valores a la vez
  // (Iv, anomalía, presión probable y confirmado), no solo el de la capa
  // activa -- la capa activa solo decide el color del mapa. La línea de la
  // capa activa va al final con el detalle extra de su baseline.
  // ---------------------------------------------------------------------

  const ES_CAPA_MODULO: Partial<Record<IdCapa, boolean>> = {
    iv: true,
    anomalia: true,
    presion_probable: true,
    presion_confirmado: true,
  };

  function lineaPresion(
    celda: CeldaPresion | undefined,
    etiqueta: string,
  ): string {
    if (!celda || celda.percentil === null || celda.categoria === null) {
      return `${etiqueta}: sin datos suficientes`;
    }
    return `${etiqueta}: ${celda.categoria} (percentil ${celda.percentil})`;
  }

  function tooltipModulos(
    codigo: string,
    nombre: string,
    capaActiva: IdCapa,
  ): string {
    const esp = detallesEspacial.get(codigo);
    const pres = detallesPresion.get(codigo);
    const lineas = [
      `Iv (idoneidad): ${esp?.iv !== undefined ? esp.iv.toFixed(2) : 'sin dato'}`,
      `Anomalía climática: ${esp?.anomalia_sigma !== undefined ? `${esp.anomalia_sigma.toFixed(2)}σ` : 'sin dato'}`,
      lineaPresion(pres?.probable, 'Presión (probable)'),
      lineaPresion(pres?.confirmado, 'Presión (confirmado)'),
    ];

    // Detalle extra de la serie de presión activa: casos observados y
    // baseline P50/P75, para poder verificar el color contra el número.
    if (
      capaActiva === 'presion_probable' ||
      capaActiva === 'presion_confirmado'
    ) {
      const serie =
        capaActiva === 'presion_probable' ? 'probable' : 'confirmado';
      const celda = pres?.[serie];
      if (celda && celda.percentil !== null) {
        lineas.push(
          `Casos observados (${serie}): ${celda.casos_observados} · línea base P50/P75: ` +
            `${celda.p50_baseline} / ${celda.p75_baseline}`,
        );
      } else if (celda?.nota) {
        lineas.push(celda.nota);
      }
    }

    return `<strong>${nombre}</strong><br>${lineas.join('<br>')}`;
  }

  // ---------------------------------------------------------------------
  // Detalle de departamento (click en el mapa): snapshot de las 4 capas de
  // los módulos M1–M3 para la semana/año seleccionados + mini-curva de Iv del
  // año contra su banda histórica P25-P75. Mismo patrón hecho a mano de
  // <svg><polyline> que CurvaEpidemicaNacional.astro -- sin librería de
  // charts nueva.
  // ---------------------------------------------------------------------

  interface SemanaTemporal {
    semana_epi: number;
    iv_real: number | null;
    p25_baseline: number | null;
    mediana_baseline: number | null;
    p75_baseline: number | null;
    anomaly_sigma: number | null;
  }

  function dibujarCurvaDetalle(
    contenedor: HTMLElement,
    semanas: SemanaTemporal[],
    semanaActiva: number,
  ) {
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const ANCHO = 600;
    const ALTO = 96;
    const conBanda = semanas.filter(
      (s) => s.p25_baseline !== null && s.p75_baseline !== null,
    );
    const valores = conBanda.flatMap((s) => [
      s.p25_baseline!,
      s.p75_baseline!,
      s.iv_real ?? s.p25_baseline!,
    ]);
    const min = Math.min(...valores, 0);
    const max = Math.max(...valores, 0.01);
    const escalaX = (i: number) =>
      (i / Math.max(semanas.length - 1, 1)) * ANCHO;
    const escalaY = (v: number) =>
      ALTO - ((v - min) / (max - min || 1)) * (ALTO - 8) - 4;

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${ANCHO} ${ALTO}`);
    svg.setAttribute('class', 'h-full w-full');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('role', 'img');
    svg.setAttribute(
      'aria-label',
      'Idoneidad biofísica del año seleccionado contra su banda histórica P25-P75',
    );

    if (conBanda.length > 1) {
      const puntosSup = conBanda.map(
        (s, i) => `${escalaX(i)},${escalaY(s.p75_baseline!)}`,
      );
      const puntosInf = [...conBanda]
        .reverse()
        .map(
          (s, i) =>
            `${escalaX(conBanda.length - 1 - i)},${escalaY(s.p25_baseline!)}`,
        );
      const banda = document.createElementNS(SVG_NS, 'polygon');
      banda.setAttribute('points', [...puntosSup, ...puntosInf].join(' '));
      banda.setAttribute('fill', 'var(--color-secondary)');
      banda.setAttribute('opacity', '0.6');
      svg.appendChild(banda);
    }

    const puntosReales = semanas
      .map((s, i) =>
        s.iv_real !== null ? `${escalaX(i)},${escalaY(s.iv_real)}` : null,
      )
      .filter((p): p is string => p !== null);
    if (puntosReales.length > 1) {
      const linea = document.createElementNS(SVG_NS, 'polyline');
      linea.setAttribute('points', puntosReales.join(' '));
      linea.setAttribute('fill', 'none');
      linea.setAttribute('stroke', 'var(--color-accent)');
      linea.setAttribute('stroke-width', '1.75');
      linea.setAttribute('stroke-linejoin', 'round');
      linea.setAttribute('stroke-linecap', 'round');
      svg.appendChild(linea);
    }

    const indiceActiva = semanas.findIndex(
      (s) => s.semana_epi === semanaActiva,
    );
    if (indiceActiva >= 0 && semanas[indiceActiva].iv_real !== null) {
      const punto = document.createElementNS(SVG_NS, 'circle');
      punto.setAttribute('cx', `${escalaX(indiceActiva)}`);
      punto.setAttribute('cy', `${escalaY(semanas[indiceActiva].iv_real!)}`);
      punto.setAttribute('r', '3.5');
      punto.setAttribute('fill', 'var(--color-deep)');
      punto.setAttribute('stroke', 'var(--color-surface)');
      punto.setAttribute('stroke-width', '1.5');
      svg.appendChild(punto);
    }

    contenedor.innerHTML = '';
    contenedor.appendChild(svg);
  }

  // ---------------------------------------------------------------------
  // Orquestación: un mapa Leaflet, un geojson, una capa geoJSON activa a la
  // vez -- se reemplaza al cambiar de selector en vez de duplicar mapas.
  // ---------------------------------------------------------------------

  // Máscara visual: un rectángulo enorme con un "agujero" recortado por
  // cada departamento (SVG fill-rule evenodd, soportado nativamente por
  // L.Polygon con múltiples anillos). No evita las peticiones de tiles de
  // países vecinos -- son ráster de OpenStreetMap, no hay forma de pedir
  // "sin Guatemala/Honduras" a ese proveedor -- pero atenúa visualmente
  // todo lo que no sea El Salvador, incluyendo los nombres de lugar que
  // trae el tile, para que la atención quede en el país que sí cubre el
  // proyecto. Mismo enfoque que MapaIRA.astro.
  const ANILLO_MUNDO: [number, number][] = [
    [-85, -170],
    [-85, 10],
    [85, 10],
    [85, -170],
  ];

  function construirMascara(geojson: any): [number, number][][] {
    const agujeros: [number, number][][] = [];
    for (const f of geojson.features) {
      const partes =
        f.geometry.type === 'Polygon'
          ? [f.geometry.coordinates]
          : f.geometry.coordinates;
      for (const poligono of partes) {
        agujeros.push(
          poligono[0].map(([lon, lat]: [number, number]) => [lat, lon]),
        );
      }
    }
    return [ANILLO_MUNDO, ...agujeros];
  }

  function cargarCssLeaflet() {
    if (document.querySelector(`link[href="${leafletCssHref}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = leafletCssHref;
    document.head.appendChild(link);
  }

  async function iniciar() {
    cargarCssLeaflet();
    const { default: L } = await import('leaflet');

    const contenedorSelector = document.getElementById('mapa-selector');
    const contenedorMapa = document.getElementById('mapa-departamentos');
    const contenedorLeyenda = document.getElementById('mapa-leyenda');
    const contenedorAviso = document.getElementById('mapa-aviso');
    const contenedorNoDisponible =
      document.getElementById('mapa-no-disponible');
    const contenedorDetalle = document.getElementById('mapa-detalle');
    const detalleNombre = document.getElementById('mapa-detalle-nombre');
    const detalleSnapshot = document.getElementById('mapa-detalle-snapshot');
    const detalleCurva = document.getElementById('mapa-detalle-curva');
    const detalleCerrar = document.getElementById('mapa-detalle-cerrar');
    const detalleFicha = document.getElementById(
      'mapa-detalle-ficha',
    ) as HTMLAnchorElement | null;
    const tablaCuerpo = document.getElementById('mapa-tabla-cuerpo');
    const tablaCaption = document.getElementById('mapa-tabla-caption');
    const tablaColumnaValor = document.getElementById(
      'mapa-tabla-columna-valor',
    );
    if (
      !contenedorSelector ||
      !contenedorMapa ||
      !contenedorLeyenda ||
      !contenedorAviso ||
      !contenedorNoDisponible ||
      !contenedorDetalle ||
      !detalleNombre ||
      !detalleSnapshot ||
      !detalleCurva ||
      !detalleCerrar
    )
      return;

    detalleCerrar.addEventListener('click', () => {
      actualizarFiltrosAnalisis({ departamento: null });
    });

    function celdaSnapshot(etiqueta: string, valor: string): string {
      return (
        `<div class="rounded-lg border border-border bg-surface px-3 py-2">` +
        `<dt class="font-sans text-xs font-medium text-ink-muted">${escapeHtml(etiqueta)}</dt>` +
        `<dd class="mt-0.5 cifra text-sm text-ink">${escapeHtml(valor)}</dd></div>`
      );
    }

    async function mostrarDetalle(codigo: string, nombre: string) {
      contenedorDetalle.classList.remove('hidden');
      detalleNombre.textContent = nombre;
      const anuncioDetalle = document.getElementById('mapa-detalle-anuncio');
      if (anuncioDetalle)
        anuncioDetalle.textContent = `Detalle de ${nombre} disponible más abajo`;
      if (detalleFicha) {
        detalleFicha.href = `/analisis/ficha/${codigo}`;
        detalleFicha.setAttribute(
          'aria-label',
          `Ver ficha imprimible de ${nombre}`,
        );
      }
      detalleSnapshot.innerHTML =
        '<div class="skeleton h-12 rounded-lg"></div><div class="skeleton h-12 rounded-lg"></div>' +
        '<div class="skeleton h-12 rounded-lg"></div><div class="skeleton h-12 rounded-lg"></div>';
      detalleCurva.innerHTML =
        '<div class="skeleton h-full w-full" aria-hidden="true"></div>';

      await Promise.all([obtenerDatosEspaciales(), obtenerDatosPresion()]);
      const esp = detallesEspacial.get(codigo);
      const pres = detallesPresion.get(codigo);

      detalleSnapshot.innerHTML = [
        celdaSnapshot(
          'Iv (idoneidad)',
          esp?.iv !== undefined ? esp.iv.toFixed(2) : 'sin dato',
        ),
        celdaSnapshot(
          'Anomalía climática',
          esp?.anomalia_sigma !== undefined
            ? `${esp.anomalia_sigma.toFixed(2)}σ`
            : 'sin dato',
        ),
        celdaSnapshot(
          'Presión (probable)',
          pres?.probable?.categoria
            ? `${pres.probable.categoria} (p${pres.probable.percentil})`
            : 'sin datos suficientes',
        ),
        celdaSnapshot(
          'Presión (confirmado)',
          pres?.confirmado?.categoria
            ? `${pres.confirmado.categoria} (p${pres.confirmado.percentil})`
            : 'sin datos suficientes',
        ),
      ].join('');

      try {
        const resp = await fetch(
          `${API_BASE}/api/v1/temporal/${codigo}?anio=${ANIO_ESPACIAL}`,
        );
        if (!resp.ok) throw new Error('respuesta no OK');
        const datos: { semanas: SemanaTemporal[] } = await resp.json();
        dibujarCurvaDetalle(detalleCurva, datos.semanas, SEMANA_ESPACIAL);
      } catch {
        detalleCurva.innerHTML =
          '<p class="font-sans text-xs text-ink-muted">Serie histórica no disponible en este momento.</p>';
      }
    }

    // Límites duros a El Salvador (bbox real del geojson + margen) -- sin
    // esto, un scroll de más con la rueda del mouse manda a ver Guatemala u
    // Honduras, que el proyecto todavía no cubre. maxBoundsViscosity: 1
    // hace que el mapa "rebote" en vez de dejar salir el pan; minZoom evita
    // alejar hasta ver la región entera.
    const LIMITES_SV = L.latLngBounds([12.95, -90.35], [14.65, -87.45]);
    // Con departamentos como unidad no hay nada que ver más cerca de 10.
    const MAX_ZOOM = 10;
    contenedorMapa.innerHTML = '';
    contenedorMapa.removeAttribute('aria-busy');
    const mapa = L.map(contenedorMapa, {
      minZoom: 8,
      maxZoom: MAX_ZOOM,
      maxBounds: LIMITES_SV,
      maxBoundsViscosity: 1.0,
    }).setView([13.79, -88.9], 8);
    protegerScrollMapa(contenedorMapa);
    new ResizeObserver(() => {
      mapa.invalidateSize({ animate: false, pan: false });
    }).observe(contenedorMapa);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; colaboradores de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: MAX_ZOOM,
    }).addTo(mapa);

    const respGeo = await fetch('/geo/slv-adm1.geojson');
    const geojson = await respGeo.json();
    const nombresPorCodigo = new Map<string, string>(
      geojson.features.map((feature: any) => [
        feature.properties?.codigo ?? '',
        feature.properties?.shapeName
          ? normalizarNombreDepto(feature.properties.shapeName)
          : (feature.properties?.codigo ?? ''),
      ]),
    );

    L.polygon(construirMascara(geojson), {
      stroke: false,
      fillColor: '#f0f0f0',
      fillOpacity: 0.85,
      interactive: false,
    }).addTo(mapa);

    let capaGeoJsonActiva: Leaflet.GeoJSON | null = null;
    /** Capa de datos que dibuja `capaGeoJsonActiva` (para fundir solo recoloreos). */
    let idCapaPintada: IdCapa | null = null;
    let capaActivaId: IdCapa = capaMinsal.id;
    const cacheValoresPorCapa = new Map<
      IdCapa,
      Map<string, number | undefined> | null
    >();

    // Departamentos con una alerta de dengue vigente que los nombra (ADR 0022).
    // Las nacionales no marcan ninguno: se resumen en un aviso sobre la leyenda.
    let departamentosConAlerta = new Set<string>();

    function pintarAlertasEnTabla() {
      tablaCuerpo
        ?.querySelectorAll<HTMLElement>('[data-celda-alerta]')
        .forEach((celda) => {
          const codigo = celda.dataset.celdaAlerta ?? '';
          if (departamentosConAlerta.has(codigo)) {
            const enlace = document.createElement('a');
            enlace.href = `/alertas?tipo=dengue&dept=${encodeURIComponent(codigo)}`;
            enlace.className = 'font-medium text-accent underline';
            enlace.textContent = 'Sí, ver alertas';
            celda.replaceChildren(enlace);
          } else {
            celda.textContent = 'No';
          }
        });
    }

    async function cargarAlertasVigentes() {
      const avisoNacional = document.getElementById('mapa-alertas-nacionales');
      try {
        const alertas = (await obtenerAlertasDengue()).filter((a) =>
          alertaEstaVigente(a),
        );
        const nuevas = new Set<string>();
        let nacionales = 0;
        for (const alerta of alertas) {
          if (esAlertaNacional(alerta)) nacionales += 1;
          else
            for (const codigo of alerta.departamentos ?? []) nuevas.add(codigo);
        }
        departamentosConAlerta = nuevas;
        if (avisoNacional && nacionales > 0) {
          avisoNacional.classList.remove('hidden');
          avisoNacional.innerHTML = `Hay ${nacionales} ${nacionales === 1 ? 'alerta nacional vigente' : 'alertas nacionales vigentes'} de dengue. Los departamentos con contorno punteado tienen además una alerta propia. <a href="/alertas?tipo=dengue" class="font-medium text-accent underline">Ver alertas</a>`;
        } else if (avisoNacional && nuevas.size > 0) {
          avisoNacional.classList.remove('hidden');
          avisoNacional.textContent =
            'Los departamentos con contorno punteado tienen una alerta de dengue vigente.';
        }
      } catch {
        // Sin alertas el mapa sigue igual: la marca es un añadido.
        departamentosConAlerta = new Set();
      }
      pintarAlertasEnTabla();
      resaltarDepartamento(obtenerFiltrosAnalisis().departamento);
    }

    function resaltarDepartamento(codigoActivo: string | null) {
      capaGeoJsonActiva?.eachLayer((capa) => {
        const ruta = capa as Leaflet.Path & {
          feature?: { properties?: { codigo?: string } };
          bringToFront?: () => void;
        };
        const codigo = ruta.feature?.properties?.codigo ?? '';
        const activa = codigoActivo !== null && codigo === codigoActivo;
        const conAlerta = departamentosConAlerta.has(codigo);
        ruta.setStyle({
          color: activa || conAlerta ? 'var(--color-seleccion)' : '#8a8a90',
          weight: activa ? 2 : conAlerta ? 2.5 : 1,
          // Contorno punteado: la marca de alerta no depende solo del color.
          dashArray: conAlerta && !activa ? '5 4' : undefined,
        });
        if (activa) ruta.bringToFront?.();
      });
    }

    function vincularSeleccionDepartamento(
      capa: Leaflet.Layer,
      codigo: string,
      nombre: string,
    ) {
      const seleccionar = () =>
        actualizarFiltrosAnalisis({ departamento: codigo });
      capa.on('click', seleccionar);
      capa.on('add', () => {
        const elemento = (capa as Leaflet.Path).getElement();
        if (!elemento) return;
        elemento.setAttribute('data-departamento', codigo);
        elemento.setAttribute('tabindex', '0');
        elemento.setAttribute('role', 'button');
        elemento.setAttribute('aria-label', `Seleccionar ${nombre}`);
        elemento.addEventListener('keydown', (evento: KeyboardEvent) => {
          if (evento.key !== 'Enter' && evento.key !== ' ') return;
          evento.preventDefault();
          seleccionar();
        });
      });
    }

    function botonId(id: IdCapa) {
      return `mapa-boton-${id}`;
    }

    function pintarSelector(activaId: IdCapa) {
      contenedorSelector!.innerHTML = CAPAS.map((capa) => {
        const activa = capa.id === activaId;
        const base =
          'rounded-full border px-3.5 py-1.5 font-sans text-xs font-medium transition-colors duration-150';
        const estilo = !capa.disponible
          ? 'cursor-not-allowed border-border bg-bg text-ink-muted opacity-60'
          : activa
            ? 'border-accent bg-accent text-accent-ink shadow-sm'
            : 'border-border bg-surface text-ink hover:border-accent/40 hover:bg-secondary/30';
        return `<button type="button" id="${botonId(capa.id)}" data-id="${capa.id}" ${
          capa.disponible
            ? ''
            : 'disabled aria-disabled="true" title="Capa no disponible temporalmente"'
        } role="tab" aria-selected="${activa}" tabindex="${activa ? '0' : '-1'}" class="${base} ${estilo}">${escapeHtml(capa.etiqueta)}</button>`;
      }).join('');

      for (const capa of CAPAS) {
        if (!capa.disponible) continue;
        const boton = document.getElementById(botonId(capa.id));
        boton?.addEventListener('click', () => {
          if (
            capa.id === 'presion_probable' ||
            capa.id === 'presion_confirmado'
          ) {
            const serie =
              capa.id === 'presion_probable' ? 'probable' : 'confirmado';
            if (capaActivaId === capa.id) return;
            actualizarFiltrosAnalisis({ capa: 'presion', serie });
            return;
          }
          if (capaActivaId === capa.id) return;
          actualizarFiltrosAnalisis({ capa: capa.id as CapaAnalitica });
        });
      }
    }

    function pestanasDisponibles(): HTMLButtonElement[] {
      return Array.from(
        contenedorSelector?.querySelectorAll<HTMLButtonElement>(
          '[role="tab"]:not([disabled])',
        ) ?? [],
      );
    }

    contenedorSelector?.addEventListener('keydown', (evento: KeyboardEvent) => {
      if (evento.key !== 'ArrowLeft' && evento.key !== 'ArrowRight') return;
      const pestanas = pestanasDisponibles();
      if (pestanas.length === 0) return;
      const actual = pestanas.findIndex(
        (boton) => boton === document.activeElement,
      );
      if (actual === -1) return;
      evento.preventDefault();
      const siguiente =
        evento.key === 'ArrowRight'
          ? (actual + 1) % pestanas.length
          : (actual - 1 + pestanas.length) % pestanas.length;
      pestanas.forEach((boton, indice) =>
        boton.setAttribute('tabindex', indice === siguiente ? '0' : '-1'),
      );
      pestanas[siguiente].focus();
      pestanas[siguiente].click();
    });

    function pintarTablaValores(
      capa: DefinicionCapa,
      valores: Map<string, number | undefined> | null,
    ) {
      if (!tablaCuerpo || !tablaCaption || !tablaColumnaValor) return;
      tablaColumnaValor.textContent = capa.etiqueta;
      tablaCaption.textContent = `Valores de ${capa.etiqueta} por departamento`;
      tablaCuerpo.innerHTML = '';
      const filas = (
        geojson.features as {
          properties?: { codigo?: string; shapeName?: string };
        }[]
      )
        .map((feature) => {
          const codigo = feature.properties?.codigo ?? '';
          const nombre = feature.properties?.shapeName
            ? normalizarNombreDepto(feature.properties.shapeName)
            : codigo;
          return { codigo, nombre, valor: valores?.get(codigo) };
        })
        .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
      for (const fila of filas) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.className = 'border-b border-border py-1 pr-4 text-left font-normal';
        th.textContent = fila.nombre;
        const td = document.createElement('td');
        td.className = 'border-b border-border py-1 pr-4';
        td.textContent = capa.tooltipValor(fila.valor);
        const tdAlerta = document.createElement('td');
        tdAlerta.className = 'border-b border-border py-1';
        tdAlerta.dataset.celdaAlerta = fila.codigo;
        tr.append(th, td, tdAlerta);
        tablaCuerpo.appendChild(tr);
      }
      pintarAlertasEnTabla();
    }

    async function activarCapa(id: IdCapa) {
      const capa = CAPAS.find((c) => c.id === id);
      if (!capa || !capa.disponible) return;
      capaActivaId = id;
      if (id === 'minsal_volumen') actualizarDescripcionMinsal();

      pintarSelector(id);
      contenedorAviso!.textContent = capa.aviso;
      // Solo se reemplaza la leyenda por el esqueleto al cambiar de capa. Si
      // solo cambió la semana (Play recorriendo el slider) la leyenda
      // anterior se queda puesta hasta que la nueva esté lista -- si se
      // limpiaba en cada semana, el panel lateral se achicaba al esqueleto
      // (una línea) y volvía a crecer a la leyenda real un instante después;
      // como el mapa y el panel comparten fila con items-stretch, esa
      // oscilación de alto hacía que el mapa se encogiera y estirara en
      // cada cuadro de la animación.
      if (idCapaPintada !== id) {
        contenedorLeyenda!.innerHTML =
          '<div class="flex items-center gap-2" aria-hidden="true">' +
          '<div class="skeleton h-4 w-40"></div><div class="skeleton h-4 w-24"></div><div class="skeleton h-4 w-24"></div>' +
          '</div>';
      }
      contenedorNoDisponible!.classList.add('hidden');
      contenedorNoDisponible!.replaceChildren();

      let valores = cacheValoresPorCapa.get(id);
      if (valores === undefined) {
        valores = await capa.cargarValores();
        cacheValoresPorCapa.set(id, valores);
      }

      // Para las capas de los módulos M1–M3 el tooltip muestra los cuatro valores
      // (Iv, anomalía, presión probable/confirmado) a la vez -- se esperan
      // ambos endpoints aquí (cacheados: 2 fetch en total como máximo) para
      // que el tooltip no dependa de qué capa se visitó antes.
      if (ES_CAPA_MODULO[id]) {
        await Promise.all([obtenerDatosEspaciales(), obtenerDatosPresion()]);
      }

      // Colores vigentes por departamento: si solo cambia el dato de la misma
      // capa (semana, año, serie) la capa nueva nace con el color anterior y
      // pasa al nuevo en el siguiente cuadro, para que el CSS lo funda.
      const colorPrevio = new Map<string, string>();
      if (
        capaGeoJsonActiva &&
        idCapaPintada === id &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        capaGeoJsonActiva.eachLayer((l) => {
          const ruta = l as Leaflet.Path & {
            feature?: { properties?: { codigo?: string } };
          };
          const codigo = ruta.feature?.properties?.codigo;
          if (codigo && ruta.options.fillColor) {
            colorPrevio.set(codigo, ruta.options.fillColor);
          }
        });
      }
      if (capaGeoJsonActiva) {
        mapa.removeLayer(capaGeoJsonActiva);
        capaGeoJsonActiva = null;
      }
      idCapaPintada = null;

      if (!valores) {
        contenedorNoDisponible!.classList.remove('hidden');
        contenedorLeyenda!.innerHTML = '';
        renderErrorFuente(
          contenedorNoDisponible!,
          () => void activarCapa(id),
          'No se pudo cargar esta capa. El mapa se muestra en gris hasta que los datos vuelvan a estar disponibles.',
        );
        pintarTablaValores(capa, null);
        // Se sigue dibujando el contorno departamental, todo en "sin dato",
        // para que el mapa no se sienta roto.
        capaGeoJsonActiva = L.geoJSON(geojson, {
          style: () => ({
            color: '#8a8a90',
            weight: 1,
            fillColor: SIN_DATO,
            fillOpacity: 0.5,
          }),
          onEachFeature: (feature, layer) => {
            const codigo = feature.properties?.codigo ?? '';
            const nombre = feature.properties?.shapeName
              ? normalizarNombreDepto(feature.properties.shapeName)
              : codigo;
            vincularSeleccionDepartamento(layer, codigo, nombre);
            layer.bindTooltip(
              `<strong>${nombre}</strong><br>capa no disponible todavía`,
            );
          },
        }).addTo(mapa);
        resaltarDepartamento(obtenerFiltrosAnalisis().departamento);
        return;
      }

      const numericos = [...valores.values()].filter(
        (v): v is number => v !== undefined,
      );
      const cortes = capa.calcularCortes(numericos);
      dibujarLeyenda(contenedorLeyenda!, capa, cortes);
      pintarTablaValores(capa, valores);

      const destinos = new Map<string, string>();
      const capaNueva = L.geoJSON(geojson, {
        style: (feature) => {
          const codigo = feature?.properties?.codigo ?? '';
          const valor = valores!.get(codigo);
          const fillColor = colorGenerico(
            valor,
            cortes,
            capa.rampa,
            capa.sinDatoColor,
          );
          destinos.set(codigo, fillColor);
          return {
            color: '#8a8a90',
            weight: 1,
            fillColor: colorPrevio.get(codigo) ?? fillColor,
            fillOpacity: 0.75,
          };
        },
        onEachFeature: (feature, layer) => {
          const codigo = feature.properties?.codigo ?? '';
          const nombre = feature.properties?.shapeName
            ? normalizarNombreDepto(feature.properties.shapeName)
            : codigo;
          const valor = valores!.get(codigo);

          vincularSeleccionDepartamento(layer, codigo, nombre);

          if (capa.id === 'minsal_volumen') {
            const dato = detallesMinsal.get(codigo);
            if (!dato) {
              layer.bindTooltip(`<strong>${nombre}</strong><br>sin dato`);
              return;
            }
            const valorMinsal =
              dato.valor === undefined
                ? 'sin dato'
                : dato.valor === 0
                  ? '0 observado'
                  : `${dato.valor} casos`;
            layer.bindTooltip(
              `<strong>${nombre}</strong><br>` +
                `Serie: ${escapeHtml(obtenerFiltrosAnalisis().serie)}<br>` +
                `Periodo: ${escapeHtml(dato.periodo)}<br>` +
                `Valor: ${valorMinsal}<br>` +
                `Cobertura: ${dato.semanasObservadas}/${dato.semanasEsperadas} semanas`,
            );
            return;
          }

          if (ES_CAPA_MODULO[capa.id]) {
            layer.bindTooltip(tooltipModulos(codigo, nombre, capa.id));
            return;
          }

          layer.bindTooltip(
            `<strong>${nombre}</strong><br>${capa.tituloLeyenda}: ${capa.tooltipValor(valor)}`,
          );
        },
      }).addTo(mapa);
      capaGeoJsonActiva = capaNueva;
      idCapaPintada = id;
      resaltarDepartamento(obtenerFiltrosAnalisis().departamento);
      if (colorPrevio.size > 0) {
        // Dos cuadros: el primero deja pintado el color previo.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            if (capaGeoJsonActiva !== capaNueva) return;
            capaNueva.eachLayer((l) => {
              const ruta = l as Leaflet.Path & {
                feature?: { properties?: { codigo?: string } };
              };
              const destino = destinos.get(
                ruta.feature?.properties?.codigo ?? '',
              );
              if (destino) ruta.setStyle({ fillColor: destino });
            });
          }),
        );
      }
    }

    const resolverIdCapa = (
      capaNombre?: string | null,
      serie?: SerieEpidemiologica,
    ): IdCapa => {
      if (capaNombre === 'presion') {
        return serie === 'confirmado'
          ? 'presion_confirmado'
          : 'presion_probable';
      }
      if (capaNombre && CAPAS.some((k) => k.id === capaNombre)) {
        return capaNombre as IdCapa;
      }
      return capaMinsal.id;
    };

    const idCapaInicial = resolverIdCapa(
      filtrosIniciales.capa,
      filtrosIniciales.serie,
    );
    capaActivaId = idCapaInicial;
    pintarSelector(idCapaInicial);
    void cargarAlertasVigentes();
    await activarCapa(idCapaInicial);

    let filtrosAplicados = obtenerFiltrosAnalisis();
    suscribirFiltrosAnalisis((filtros) => {
      const cambioTiempo =
        filtros.semana !== filtrosAplicados.semana ||
        filtros.anio !== filtrosAplicados.anio;
      const cambioSerie = filtros.serie !== filtrosAplicados.serie;
      const cambioModoMinsal =
        filtros.modoMinsal !== filtrosAplicados.modoMinsal;
      const cambioDepartamento =
        filtros.departamento !== filtrosAplicados.departamento;
      const idCapaObjetivo = resolverIdCapa(filtros.capa, filtros.serie);
      const cambioCapa = idCapaObjetivo !== capaActivaId;
      filtrosAplicados = filtros;

      if (cambioTiempo) {
        SEMANA_ESPACIAL = filtros.semana;
        ANIO_ESPACIAL = filtros.anio;
        cacheEspacial = null;
        cachePresion = null;
        cacheConfianza = null;
        (
          [
            'minsal_volumen',
            'iv',
            'anomalia',
            'presion_probable',
            'presion_confirmado',
            'confianza',
          ] as IdCapa[]
        ).forEach((id) => cacheValoresPorCapa.delete(id));
      }

      if (cambioSerie || cambioModoMinsal) {
        cacheValoresPorCapa.delete('minsal_volumen');
        cacheValoresPorCapa.delete('confianza');
      }

      if (
        cambioSerie &&
        (capaActivaId === 'presion_probable' ||
          capaActivaId === 'presion_confirmado')
      ) {
        capaActivaId =
          filtros.serie === 'probable'
            ? 'presion_probable'
            : 'presion_confirmado';
      } else if (cambioCapa) {
        capaActivaId = idCapaObjetivo;
      }

      void (async () => {
        if (cambioTiempo || cambioSerie || cambioModoMinsal || cambioCapa)
          await activarCapa(capaActivaId);
        if (cambioDepartamento || (cambioTiempo && filtros.departamento)) {
          resaltarDepartamento(filtros.departamento);
          if (!filtros.departamento) {
            contenedorDetalle.classList.add('hidden');
            return;
          }
          const nombre =
            nombresPorCodigo.get(filtros.departamento) ?? filtros.departamento;
          await mostrarDetalle(filtros.departamento, nombre);
        }
      })();
    }, false);
  }

  // Se difiere al primer momento ocioso del navegador: el resto de la
  // página (texto, layout) ya pintó, así que la descarga de Leaflet + el
  // geojson + los tiles de OpenStreetMap no compite por ancho de banda ni
  // CPU con el primer render. requestIdleCallback no existe en Safari, de
  // ahí el fallback a setTimeout.
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => iniciar());
  } else {
    setTimeout(iniciar, 1);
  }
</script>
