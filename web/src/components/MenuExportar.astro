---
/**
 * Menú «Exportar» de un panel o vista: el único botón de descarga. Reúne los
 * datos (CSV), la imagen (SVG y PNG), enlaces a los datos completos y el
 * código para incrustar; cada panel pide solo las opciones que tiene. Sigue el
 * patrón de botón de menú de la guía de prácticas de WAI-ARIA: el botón abre
 * una lista con flechas, Inicio y Fin; Escape cierra y devuelve el foco.
 *
 * La imagen sale del primer gráfico de la sección (`section` o `article`) que
 * contiene el menú (ver exportar-acciones.ts). El CSV lo genera cada panel:
 * si se pasa `csv`, el elemento queda deshabilitado con el `id` indicado y es
 * el panel quien lo habilita (habilitarCsv, en exportar-csv.ts) cuando tiene
 * datos.
 */
import Icono from './Icono.astro';

interface Props {
  titulo: string;
  fuente: string;
  /** "analisis" toma los filtros vigentes de /dengue; otro texto se usa tal cual. */
  filtros?: string;
  /** `id` del elemento de descarga de CSV; sin él no hay opción de CSV. */
  csv?: string;
  /** false si la vista no tiene gráfico: sin las opciones de imagen. */
  imagen?: boolean;
  /** Descargas completas servidas por la API, como enlaces del menú. */
  enlaces?: { texto: string; href: string }[];
  /** Lado del botón con el que se alinea la lista: "izquierda" para un botón
   *  que va al pie de un panel, "derecha" (por omisión) para uno de la cabecera. */
  alineacion?: 'izquierda' | 'derecha';
  /** Vista de /incrustar asociada; sin ella no hay opción de incrustar. */
  incrustar?: { ruta: string; titulo: string; alto: number };
  class?: string;
}

const {
  titulo,
  fuente,
  filtros,
  csv,
  imagen = true,
  enlaces = [],
  alineacion = 'derecha',
  incrustar,
  class: clase = '',
} = Astro.props;

const sitio = Astro.site ?? new URL('https://epi-aetheris.dev');
const src = incrustar ? new URL(incrustar.ruta, sitio).href : undefined;

const itemBase =
  'flex min-h-[40px] w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left font-sans text-sm text-ink transition-colors hover:bg-secondary/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-50';
---

<div
  class:list={['relative inline-flex items-center gap-3 print:hidden', clase]}
  data-menu-exportar
  data-exportar-titulo={titulo}
  data-exportar-fuente={fuente}
  data-exportar-filtros={filtros}
  data-incrustar-src={src}
  data-incrustar-titulo={incrustar?.titulo}
  data-incrustar-alto={incrustar?.alto}
>
  <button
    type="button"
    data-menu-exportar-boton
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={`Exportar: ${titulo}`}
    class="flex min-h-[44px] items-center gap-2 rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
  >
    <Icono nombre="download" class="h-4 w-4" />
    <span>Exportar</span>
    <Icono
      nombre="chevron-down"
      class="h-3.5 w-3.5 text-ink-muted transition-transform duration-200"
    />
  </button>

  <div
    data-menu-exportar-lista
    role="menu"
    aria-label="Opciones de exportación"
    class:list={[
      'absolute left-0 top-full z-30 mt-2 w-64 rounded-xl border border-border bg-surface p-1.5 shadow-lg',
      alineacion === 'derecha' && 'sm:left-auto sm:right-0',
    ]}
    hidden
  >
    {
      csv && (
        <button
          type="button"
          role="menuitem"
          id={csv}
          data-menu-accion="csv"
          disabled
          title="Cargando datos para descargar…"
          class={itemBase}
        >
          <Icono
            nombre="file-type-csv"
            class="h-[18px] w-[18px] text-ink-muted"
          />
          <span>Datos (CSV)</span>
        </button>
      )
    }
    {
      imagen && (
        <>
          <button
            type="button"
            role="menuitem"
            data-menu-accion="svg"
            class={itemBase}
          >
            <Icono
              nombre="file-type-svg"
              class="h-[18px] w-[18px] text-ink-muted"
            />
            <span>Imagen vectorial (SVG)</span>
          </button>
          <button
            type="button"
            role="menuitem"
            data-menu-accion="png"
            class={itemBase}
          >
            <Icono
              nombre="file-type-png"
              class="h-[18px] w-[18px] text-ink-muted"
            />
            <span>Imagen (PNG)</span>
          </button>
        </>
      )
    }
    {
      enlaces.map((enlace) => (
        <a
          role="menuitem"
          data-menu-accion="enlace"
          href={enlace.href}
          target="_blank"
          rel="noopener"
          class={itemBase}
        >
          <Icono nombre="braces" class="h-[18px] w-[18px] text-ink-muted" />
          <span>{enlace.texto}</span>
        </a>
      ))
    }
    {
      incrustar && (
        <button
          type="button"
          role="menuitem"
          data-menu-accion="incrustar"
          class={itemBase}
        >
          <Icono nombre="code" class="h-[18px] w-[18px] text-ink-muted" />
          <span>Copiar código para incrustar</span>
        </button>
      )
    }
  </div>

  <span
    data-menu-exportar-estado
    role="status"
    class="max-w-[16rem] break-words font-sans text-xs text-ink-muted"></span>
</div>

<script>
  import { copiarIncrustacion, exportarImagen } from '../lib/exportar-acciones';

  const raices = document.querySelectorAll<HTMLElement>('[data-menu-exportar]');

  for (const raiz of raices) {
    const boton = raiz.querySelector<HTMLButtonElement>(
      '[data-menu-exportar-boton]',
    );
    const lista = raiz.querySelector<HTMLElement>('[data-menu-exportar-lista]');
    const estado = raiz.querySelector<HTMLElement>(
      '[data-menu-exportar-estado]',
    );
    if (!boton || !lista || !estado) continue;

    const opciones = () =>
      Array.from(
        lista.querySelectorAll<HTMLElement>('[role="menuitem"]'),
      ).filter((opcion) => !opcion.matches(':disabled'));
    let temporizador: ReturnType<typeof setTimeout> | undefined;

    function anunciar(mensaje: string) {
      estado!.textContent = mensaje;
      clearTimeout(temporizador);
      // El código de incrustación sin portapapeles es largo: se deja visible.
      if (mensaje.startsWith('<iframe')) return;
      temporizador = setTimeout(() => {
        estado!.textContent = '';
      }, 4000);
    }

    function abrir(enfocar: 'primera' | 'ultima' | null = 'primera') {
      lista!.hidden = false;
      boton!.setAttribute('aria-expanded', 'true');
      boton!.querySelector('svg:last-of-type')?.classList.add('rotate-180');
      const disponibles = opciones();
      const destino =
        enfocar === 'ultima' ? disponibles.at(-1) : disponibles[0];
      if (enfocar) destino?.focus();
    }

    function cerrar(devolverFoco = false) {
      lista!.hidden = true;
      boton!.setAttribute('aria-expanded', 'false');
      boton!.querySelector('svg:last-of-type')?.classList.remove('rotate-180');
      if (devolverFoco) boton!.focus();
    }

    boton.addEventListener('click', () => {
      if (lista.hidden) abrir();
      else cerrar();
    });
    boton.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowDown') {
        evento.preventDefault();
        abrir('primera');
      } else if (evento.key === 'ArrowUp') {
        evento.preventDefault();
        abrir('ultima');
      }
    });

    lista.addEventListener('keydown', (evento) => {
      const disponibles = opciones();
      const indice = disponibles.indexOf(document.activeElement as HTMLElement);
      if (evento.key === 'Escape') {
        evento.preventDefault();
        cerrar(true);
      } else if (evento.key === 'ArrowDown') {
        evento.preventDefault();
        disponibles[(indice + 1) % disponibles.length]?.focus();
      } else if (evento.key === 'ArrowUp') {
        evento.preventDefault();
        disponibles[
          (indice - 1 + disponibles.length) % disponibles.length
        ]?.focus();
      } else if (evento.key === 'Home') {
        evento.preventDefault();
        disponibles[0]?.focus();
      } else if (evento.key === 'End') {
        evento.preventDefault();
        disponibles.at(-1)?.focus();
      } else if (evento.key === 'Tab') {
        cerrar();
      }
    });

    lista.addEventListener('click', async (evento) => {
      const opcion = (evento.target as HTMLElement).closest<HTMLElement>(
        '[data-menu-accion]',
      );
      if (!opcion || opcion.matches(':disabled')) return;
      const accion = opcion.dataset.menuAccion;
      cerrar(true);
      // El CSV lo resuelve el panel con su propio `click` sobre la opción y
      // el enlace lo abre el navegador.
      if (accion === 'csv' || accion === 'enlace') return;
      if (accion === 'incrustar') {
        anunciar(
          await copiarIncrustacion({
            src: raiz.dataset.incrustarSrc ?? '',
            titulo: raiz.dataset.incrustarTitulo ?? '',
            alto: Number(raiz.dataset.incrustarAlto) || 400,
          }),
        );
        return;
      }
      anunciar(
        await exportarImagen(
          raiz.closest('section, article'),
          {
            titulo: raiz.dataset.exportarTitulo ?? 'Gráfico',
            fuente: raiz.dataset.exportarFuente ?? 'EPI-Aetheris',
            filtros: raiz.dataset.exportarFiltros,
          },
          accion === 'png' ? 'png' : 'svg',
        ),
      );
    });

    document.addEventListener('click', (evento) => {
      if (!lista.hidden && !raiz.contains(evento.target as Node)) cerrar();
    });
  }
</script>
