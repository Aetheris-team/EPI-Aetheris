---
import { Font } from 'astro:assets';
import PieDePagina from '../components/PieDePagina.astro';
import AtajosTeclado from '../components/AtajosTeclado.astro';
import Icono from '../components/Icono.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  descripcion?: string;
  /** Imagen de vista previa al compartir. Absoluta en la salida -- una
   *  og:image relativa la ignoran casi todos los rastreadores. */
  imagen?: string;
  /** Saca la página del índice de los buscadores. Se usa en las rutas que no
   *  son contenido público: el formulario de operadores y la 404. */
  noindex?: boolean;
  /** La página monta un mapa Leaflet. Emite preconnect a los tres subdominios
   *  de tiles de OSM. Solo donde hay mapa: en el resto seria gasto. */
  mapa?: boolean;
}

const {
  title = 'EPI-Aetheris',
  descripcion = 'Vigilancia epidemiológica descriptiva de dengue e IRA en El Salvador, sobre datos públicos de MINSAL, OpenDengue y Open-Meteo. Licencia GPL-3.0.',
  imagen = '/og/og-default.png',
  noindex = false,
  mapa = false,
} = Astro.props;

const ruta = Astro.url.pathname;
// URL absoluta de esta página -- Astro.site viene de astro.config.mjs.
const urlCanonica = new URL(ruta, Astro.site);
// Direcciones de Render que deben llevar al dominio canónico (ADR 0024). Son
// exactas a propósito: las previews de PR (`...-pr-N.onrender.com`) no se
// tocan, porque ahí se revisa el cambio antes de fusionarlo.
const hostsRedirigidos = [
  'epi-aetheris-web.onrender.com',
  'aetheris-nitor.onrender.com',
];
// Misma razón para la imagen de vista previa: WhatsApp, Slack, Telegram y
// los rastreadores de redes descartan una og:image relativa.
const urlImagen = new URL(imagen, Astro.site);
// Nav de dos caras (ADR 0014). No es un "modo" con estado: son secciones, y
// ninguna esconde a la otra. Arriba queda lo que sirve en consulta
// (Alertas); las dos herramientas descriptivas se agrupan bajo /analisis en
// vez de ocupar una entrada cada una. `rutas` marca qué prefijos encienden
// la entrada -- /dengue, /prediccion y /respiratorio viven bajo Análisis aunque su
// URL no empiece con /analisis.
const NAV: { href: string; etiqueta: string; rutas?: string[] }[] = [
  { href: '/', etiqueta: 'Inicio' },
  // Puente vigilancia -> personal de salud (ADR 0013): decisiones humanas.
  { href: '/alertas', etiqueta: 'Alertas' },
  // Índice de las herramientas descriptivas. Dengue lleva los módulos
  // M1–M3 completos; respiratorio (neumonías, IRA y virus, ADR 0011) va sin capas
  // Iv/anomalía/presión -- esas fórmulas siguen cerradas solo a dengue.
  {
    href: '/analisis',
    etiqueta: 'Análisis',
    rutas: ['/analisis', '/dengue', '/prediccion', '/respiratorio'],
  },
  // Documentos propios en docs/biblioteca/ (ADR 0016).
  { href: '/biblioteca', etiqueta: 'Biblioteca' },
  // Sin backend: la página solo enruta a GitHub Issues del repo. Recibir
  // sugerencias con formulario propio exigiría tabla nueva + ADR y guardar
  // texto de terceros (choca con "sin datos personales").
  { href: '/sugerencias', etiqueta: 'Sugerencias' },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    {
      /* El SVG lo prefieren los navegadores modernos; el PNG de 32 es el
    respaldo para los que no lo soportan y para la barra de favoritos, y el
    apple-touch-icon es el que usa iOS al añadir el sitio a la pantalla de
    inicio (no lee el manifest para eso). */
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={urlCanonica} />
    {
      /* Los tiles son el elemento LCP de las vistas con mapa, y el navegador
        no los descubre hasta que Leaflet se ejecuta. El preconnect adelanta
        DNS, TCP y TLS a esa espera. Van los tres subdominios porque {s} de
        Leaflet rota entre a, b y c, y cada uno es un origen distinto. Sin
        crossorigin a proposito: Leaflet pide los tiles como <img> sin CORS,
        y una conexion en modo CORS no se reutilizaria. */
    }
    {
      mapa && (
        <>
          <link rel="preconnect" href="https://a.tile.openstreetmap.org" />
          <link rel="preconnect" href="https://b.tile.openstreetmap.org" />
          <link rel="preconnect" href="https://c.tile.openstreetmap.org" />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      /* PWA (ADR 0014): permite instalar el sitio y, sobre todo, que /alertas
      abra sin señal en zona rural. El service worker vive en public/sw.js. */
    }
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2a2a72" />
    {
      /* Fonts API de Astro: auto-hospedadas, con fallback de métricas
      ajustadas (size-adjust) y font-display:swap. Sin preload -- #87
      difirió las fuentes del render crítico a propósito. */
    }
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-fraunces" />
    <title>{title}</title>
    <script
      is:inline
      define:vars={{ hostsRedirigidos, origenCanonico: Astro.site?.origin }}
    >
      // Render no redirige por dominio en sitios estáticos, así que el 301 no
      // existe; esto lleva a quien llegue por la dirección de onrender.com al
      // dominio canónico, con la misma ruta, consulta y ancla. replace para no
      // dejar la dirección vieja en el historial. El canonical de cada página
      // ya apunta al dominio canónico para los buscadores.
      if (origenCanonico && hostsRedirigidos.includes(location.hostname)) {
        location.replace(
          origenCanonico + location.pathname + location.search + location.hash,
        );
      }
    </script>
    <script is:inline>
      // Tema elegido antes del primer pintado, para no parpadear en claro.
      // Misma resolución que resolverTema en lib/preferencias.ts: sin
      // elección guardada, claro.
      try {
        const tema = localStorage.getItem('epi:tema');
        if (tema === 'dark' || tema === 'light') {
          document.documentElement.setAttribute('data-theme', tema);
        } else if (tema === 'sistema') {
          document.documentElement.setAttribute('data-theme', 'system');
        }
      } catch {
        // Sin almacenamiento queda el tema claro.
      }
    </script>
    <script is:inline>
      // Animaciones antes del primer pintado. Misma resolución que
      // resolverAnimaciones en lib/animaciones.ts: lo guardado gana; sin
      // elección, prefers-reduced-motion arranca apagado.
      (function () {
        let estado = null;
        try {
          estado = localStorage.getItem('epi:animaciones');
        } catch {
          // Sin almacenamiento manda el sistema.
        }
        if (estado !== 'on' && estado !== 'off') {
          estado = window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'off'
            : 'on';
        }
        document.documentElement.dataset.animaciones = estado;
      })();
    </script>
    <script is:inline>
      // Tamaño de texto antes del primer pintado (lib/preferencias.ts).
      try {
        if (localStorage.getItem('epi:texto') === 'grande') {
          document.documentElement.dataset.texto = 'grande';
        }
      } catch {
        // Sin almacenamiento queda el tamaño normal.
      }
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:site_name" content="EPI-Aetheris" />
    <meta property="og:locale" content="es_SV" />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="EPI-Aetheris — vigilancia epidemiológica de dengue y enfermedad respiratoria en El Salvador"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-header focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido principal
    </a>
    <header
      class="sticky top-0 z-40 bg-header shadow-[0_1px_0_rgba(255,255,255,0.06)]"
    >
      {
        /* Cabecera compacta en teléfono: el logo y los controles comparten la
        primera fila y la navegación va debajo, desplazable en horizontal.
        Antes eran tres filas (180 px, un cuarto de la pantalla, y fija). Su
        altura la publica --alto-header (global.css) para que la barra pegajosa
        del análisis y los scroll-margin de las anclas no queden tapados. */
      }
      <div
        class="mx-auto flex max-w-[1600px] flex-col gap-1 px-4 pb-1.5 pt-1.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-8 sm:py-5 lg:px-12"
      >
        <div class="flex items-center justify-between sm:contents">
          <a
            href="/"
            class="group flex min-h-[44px] items-center sm:order-1"
            aria-label="EPI-Aetheris, inicio"
          >
            <img
              src="/logo/logo-dark-bg.svg"
              alt="EPI-Aetheris"
              class="h-8 w-auto shrink-0 transition-opacity duration-200 group-hover:opacity-80 sm:h-12"
              width="1066"
              height="424"
            />
          </a>
          <div class="flex shrink-0 items-center gap-1 sm:order-3">
            <button
              type="button"
              data-selector-tema
              aria-pressed="false"
              class="flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center gap-2 rounded-full px-2 font-sans text-sm font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white sm:px-3"
            >
              <span class="icono-tema icono-tema-oscuro sm:hidden">
                <Icono nombre="moon" class="h-5 w-5" />
              </span>
              <span class="icono-tema icono-tema-claro sm:hidden">
                <Icono nombre="sun" class="h-5 w-5" />
              </span>
              <span data-selector-tema-texto class="sr-only sm:not-sr-only"
                >Tema oscuro</span
              >
            </button>
            <a
              href="/configuracion"
              aria-current={ruta.startsWith('/configuracion')
                ? 'page'
                : undefined}
              aria-label="Configuración"
              title="Configuración (atajos de teclado y preferencias)"
              class:list={[
                'flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-full transition-colors',
                ruta.startsWith('/configuracion')
                  ? 'bg-white/15 text-white'
                  : 'text-white/70 hover:bg-white/10 hover:text-white',
              ]}
            >
              <Icono nombre="settings" class="h-5 w-5" />
            </a>
          </div>
        </div>

        <nav
          data-nav-principal
          class="nav-principal -mx-4 flex flex-nowrap items-center gap-1 overflow-x-auto px-4 font-sans text-sm sm:order-2 sm:mx-0 sm:justify-start sm:overflow-visible sm:px-0"
          aria-label="Navegación principal"
        >
          {
            NAV.map((item) => {
              const prefijos = item.rutas ?? [item.href];
              const activo =
                item.href === '/'
                  ? ruta === '/'
                  : prefijos.some((p) => ruta.startsWith(p));
              return (
                <a
                  href={item.href}
                  aria-current={activo ? 'page' : undefined}
                  class:list={[
                    'flex min-h-[44px] shrink-0 items-center whitespace-nowrap rounded-full px-3 font-medium transition-[background-color,color] duration-200 sm:px-3.5',
                    activo
                      ? 'bg-white/15 text-white'
                      : 'text-white/70 hover:bg-white/10 hover:text-white',
                  ]}
                >
                  {item.etiqueta}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <slot />

    <PieDePagina />
    <AtajosTeclado />

    <script>
      // Selector de tema: alterna entre claro y oscuro y recuerda la elección
      // (lib/preferencias.ts). Sin elección guardada, claro. Se
      // repinta también cuando el tema cambia desde otro control: el atajo de
      // teclado o la página /configuracion.
      import {
        EVENTO_PREFERENCIAS,
        alternarTema,
        temaEfectivo,
      } from '../lib/preferencias';

      const botonTema = document.querySelector<HTMLButtonElement>(
        '[data-selector-tema]',
      );
      const textoTema = document.querySelector<HTMLElement>(
        '[data-selector-tema-texto]',
      );

      function pintarSelectorTema(): void {
        if (!botonTema || !textoTema) return;
        const oscuro = temaEfectivo() === 'dark';
        botonTema.setAttribute('aria-pressed', String(oscuro));
        textoTema.textContent = oscuro ? 'Tema claro' : 'Tema oscuro';
      }

      botonTema?.addEventListener('click', () => {
        alternarTema();
      });
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', pintarSelectorTema);
      window.addEventListener(EVENTO_PREFERENCIAS, pintarSelectorTema);
      pintarSelectorTema();

      // En teléfono la navegación se desplaza en horizontal y la entrada
      // activa puede quedar fuera de vista (Sugerencias, por ejemplo). Se
      // centra sin tocar el scroll vertical de la página.
      const navPrincipal = document.querySelector<HTMLElement>(
        '[data-nav-principal]',
      );
      const entradaActiva = navPrincipal?.querySelector<HTMLElement>(
        '[aria-current="page"]',
      );
      if (navPrincipal && entradaActiva) {
        const sobra = navPrincipal.scrollWidth - navPrincipal.clientWidth;
        if (sobra > 0) {
          navPrincipal.scrollLeft =
            entradaActiva.offsetLeft -
            (navPrincipal.clientWidth - entradaActiva.offsetWidth) / 2;
        }
      }
    </script>

    <style>
      /* Icono del selector de tema en teléfono: luna cuando ofrece el tema
         oscuro, sol cuando ofrece volver al claro. En sm+ se ve el texto. */
      .icono-tema {
        display: inline-flex;
      }
      [data-selector-tema][aria-pressed='true'] .icono-tema-oscuro,
      [data-selector-tema][aria-pressed='false'] .icono-tema-claro {
        display: none;
      }
      @media (min-width: 40rem) {
        .icono-tema {
          display: none;
        }
      }
      /* La navegación desplazable no muestra barra: en el header oscuro la
         barra de 10 px del sitio parecería un elemento más. El borde derecho
         se desvanece mientras quede contenido por descubrir. */
      .nav-principal {
        scrollbar-width: none;
        scroll-snap-type: x proximity;
      }
      .nav-principal::-webkit-scrollbar {
        display: none;
      }
      .nav-principal > a {
        scroll-snap-align: start;
      }
      @media (max-width: 39.99rem) {
        .nav-principal {
          mask-image: linear-gradient(
            to right,
            transparent,
            #000 1rem,
            #000 calc(100% - 2.5rem),
            transparent
          );
          scroll-padding-inline: 1rem;
        }
      }
    </style>

    <script>
      import { iniciarTerminos } from '../lib/terminos-cliente';
      iniciarTerminos();
    </script>

    <script>
      // Registro del service worker (ADR 0014). Solo en producción: en dev el
      // cache del shell tapa los cambios en caliente de Astro.
      const apiBase = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', async () => {
          try {
            await navigator.serviceWorker.register('/sw.js');
            const registro = await navigator.serviceWorker.ready;
            // En la primera visita el service worker se activa después de que
            // el documento pidió sus scripts y estilos, así que esos no
            // pasaron por su `fetch` y no quedaron cacheados. Se le pasa la
            // lista de lo que esta página ya cargó para que la guarde; si no,
            // la recarga sin conexión trae el HTML y nada más.
            const recursos = performance
              .getEntriesByType('resource')
              .map((entrada) => entrada.name)
              .filter((url) => url.startsWith(window.location.origin));
            const urls = [...new Set([window.location.pathname, ...recursos])];
            const canal = new MessageChannel();
            const listo = new Promise((resolver) => {
              canal.port1.onmessage = () => resolver(undefined);
            });
            registro.active?.postMessage(
              {
                tipo: 'precache',
                urls,
                api: `${apiBase}/api/alertas`,
              },
              [canal.port2],
            );
            await listo;
            document.documentElement.dataset.swListo = '1';
          } catch {
            // Sin service worker el sitio funciona igual, solo sin offline.
          }
        });
      }
    </script>
  </body>
</html>
