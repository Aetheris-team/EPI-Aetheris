<!-- Script interactivo de Scrollytelling, Animaciones y Simulador -->
<script>
  import { animacionesActivas } from '../lib/animaciones';

  const TITULOS_ETAPAS = [
    '1. Insumos y fuentes territoriales',
    '2. Transformación logarítmica y rezagos',
    '3. Gradient Boosting y 23 cuantiles',
    '4. Ensamble dinámico (Modelo C)',
    '5. Abanico probabilístico (Fan Chart)',
    '6. Simulador interactivo del abanico',
  ];

  function inicializarFichaPredictiva() {
    const contenedor = document.querySelector<HTMLElement>(
      '[data-ficha-predictiva]',
    );
    if (!contenedor) return;

    const cards = Array.from(
      contenedor.querySelectorAll<HTMLElement>('[data-paso-card]'),
    );
    const paneles = Array.from(
      contenedor.querySelectorAll<HTMLElement>('[data-escenario-panel]'),
    );
    const botonesEtapa = Array.from(
      contenedor.querySelectorAll<HTMLButtonElement>('[data-boton-etapa]'),
    );
    const barraProgreso = contenedor.querySelector<HTMLElement>(
      '[data-barra-progreso]',
    );
    const indicadorContador = contenedor.querySelector<HTMLElement>(
      '[data-indicador-contador]',
    );
    const tituloActivo = contenedor.querySelector<HTMLElement>(
      '[data-titulo-etapa-activa]',
    );
    const btnAnt = contenedor.querySelector<HTMLButtonElement>(
      '[data-btn-anterior]',
    );
    const btnSig = contenedor.querySelector<HTMLButtonElement>(
      '[data-btn-siguiente]',
    );

    let etapaActual = 0;

    function activarEtapa(idx: number, scroll = false) {
      if (idx < 0 || idx >= TITULOS_ETAPAS.length) return;
      etapaActual = idx;

      // Actualizar paneles visibles
      paneles.forEach((panel, i) => {
        if (i === idx) {
          panel.classList.add('active');
          panel.style.display = 'block';
        } else {
          panel.classList.remove('active');
          panel.style.display = 'none';
        }
      });

      // Actualizar barra y textos
      if (barraProgreso) {
        barraProgreso.style.width = `${((idx + 1) / TITULOS_ETAPAS.length) * 100}%`;
      }
      if (indicadorContador) {
        indicadorContador.textContent = `Etapa ${idx + 1} de ${TITULOS_ETAPAS.length}`;
      }
      if (tituloActivo) {
        tituloActivo.textContent = TITULOS_ETAPAS[idx];
      }

      // Actualizar botones de etapa
      botonesEtapa.forEach((btn, i) => {
        const circulo = btn.querySelector('[data-nodo-circulo]');
        if (i === idx) {
          btn.className =
            'flex flex-col items-center gap-1 transition-colors group cursor-pointer text-accent font-bold rounded px-1.5 py-0.5';
          if (circulo) {
            circulo.className =
              'w-5 h-5 rounded-full border border-accent bg-accent text-white font-bold flex items-center justify-center text-[10px]';
          }
        } else {
          btn.className =
            'flex flex-col items-center gap-1 transition-colors group cursor-pointer text-ink-muted hover:text-ink rounded px-1.5 py-0.5';
          if (circulo) {
            circulo.className =
              'w-5 h-5 rounded-full border border-border bg-bg group-hover:border-accent/40 flex items-center justify-center text-[10px] text-ink-muted';
          }
        }
      });

      // Actualizar estado de botones ant/sig
      if (btnAnt) btnAnt.disabled = idx === 0;
      if (btnSig) btnSig.disabled = idx === TITULOS_ETAPAS.length - 1;

      // Resaltar tarjeta correspondiente en la columna izquierda
      cards.forEach((card, i) => {
        if (i === idx) {
          card.classList.add('ring-2', 'ring-accent/40');
        } else {
          card.classList.remove('ring-2', 'ring-accent/40');
        }
      });

      if (scroll && cards[idx]) {
        cards[idx].scrollIntoView({
          behavior: animacionesActivas() ? 'smooth' : 'auto',
          block: 'center',
        });
      }
    }

    // Clicks en botones del stepper
    botonesEtapa.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-boton-etapa'));
        activarEtapa(idx, true);
      });
    });

    if (btnAnt) {
      btnAnt.addEventListener('click', () => {
        activarEtapa(etapaActual - 1, true);
      });
    }

    if (btnSig) {
      btnSig.addEventListener('click', () => {
        activarEtapa(etapaActual + 1, true);
      });
    }

    // IntersectionObserver para sincronizar el scroll de las tarjetas de la izquierda
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = Number(entry.target.getAttribute('data-paso-card'));
              activarEtapa(idx, false);
            }
          });
        },
        { rootMargin: '-20% 0px -50% 0px', threshold: 0.1 },
      );

      cards.forEach((card) => observer.observe(card));
    }

    // Inicializar primera etapa
    activarEtapa(0);

    // =========================================================================
    // LÓGICA REACTIVA DEL SIMULADOR (ETAPA 6)
    // =========================================================================
    const sliderCasos =
      contenedor.querySelector<HTMLInputElement>('#sim-casos');
    const sliderTendencia =
      contenedor.querySelector<HTMLInputElement>('#sim-tendencia');
    const sliderClima =
      contenedor.querySelector<HTMLInputElement>('#sim-clima');

    const txtCasos = contenedor.querySelector<HTMLElement>(
      '[data-sim-val-casos]',
    );
    const txtTendencia = contenedor.querySelector<HTMLElement>(
      '[data-sim-val-tendencia]',
    );
    const txtClima = contenedor.querySelector<HTMLElement>(
      '[data-sim-val-clima]',
    );

    const resS1 = contenedor.querySelector<HTMLElement>('#sim-res-s1');
    const resS4 = contenedor.querySelector<HTMLElement>('#sim-res-s4');
    const resS8 = contenedor.querySelector<HTMLElement>('#sim-res-s8');

    const path95 = contenedor.querySelector<SVGPathElement>('#sim-path-95');
    const path50 = contenedor.querySelector<SVGPathElement>('#sim-path-50');
    const pathMediana =
      contenedor.querySelector<SVGPathElement>('#sim-path-mediana');
    const pathHist = contenedor.querySelector<SVGPathElement>('#sim-path-hist');
    const circleT = contenedor.querySelector<SVGCircleElement>('#sim-circle-t');

    function actualizarSimulador() {
      if (!sliderCasos || !sliderTendencia || !sliderClima) return;

      const y0 = Number(sliderCasos.value);
      const impulso = Number(sliderTendencia.value); // en %
      const climaIv = Number(sliderClima.value) / 100; // 0..1

      if (txtCasos) txtCasos.textContent = `${y0} casos`;
      if (txtTendencia) {
        const signo = impulso > 0 ? '+' : '';
        txtTendencia.textContent = `${signo}${impulso}% (${impulso > 10 ? 'expansión' : impulso < -10 ? 'descenso' : 'estable'})`;
      }
      if (txtClima) {
        txtClima.textContent =
          climaIv > 0.65
            ? `Alta idoneidad (Iv=${climaIv.toFixed(2)})`
            : climaIv < 0.3
              ? `Época seca (Iv=${climaIv.toFixed(2)})`
              : `Moderada (Iv=${climaIv.toFixed(2)})`;
      }

      // Proyección matemática basada en Modelo C:
      // z0 = ln(1 + y0)
      const z0 = Math.log(1 + y0);
      const deltaZ = (impulso / 100) * 0.45; // pendiente equivalente
      const phi = 0.8;

      const predicciones: Array<{
        h: number;
        med: number;
        b50Low: number;
        b50High: number;
        b95Low: number;
        b95High: number;
      }> = [];

      for (let h = 1; h <= 8; h++) {
        // Regla amortiguada: delta_h = phi^h * deltaZ
        const acumTendencia = Math.pow(phi, h) * deltaZ * h * 0.7;
        // Modulación climática
        const modClima = (climaIv - 0.45) * 0.3 * (h / 8);
        const zPred = z0 + acumTendencia + modClima;

        // Dispersión sigma según horizonte h
        const sigma = 0.18 + h * 0.045;
        const med = Math.max(0, Math.round(Math.exp(zPred) - 1));
        const b50Low = Math.max(
          0,
          Math.round(Math.exp(zPred - 0.674 * sigma) - 1),
        );
        const b50High = Math.max(
          0,
          Math.round(Math.exp(zPred + 0.674 * sigma) - 1),
        );
        const b95Low = Math.max(
          0,
          Math.round(Math.exp(zPred - 1.96 * sigma) - 1),
        );
        const b95High = Math.max(
          0,
          Math.round(Math.exp(zPred + 1.96 * sigma) - 1),
        );

        predicciones.push({ h, med, b50Low, b50High, b95Low, b95High });
      }

      // Actualizar tarjetas de texto de resultados
      const p1 = predicciones[0];
      const p4 = predicciones[3];
      const p8 = predicciones[7];

      if (resS1 && p1)
        resS1.textContent = `${p1.med} [${p1.b95Low}-${p1.b95High}]`;
      if (resS4 && p4)
        resS4.textContent = `${p4.med} [${p4.b95Low}-${p4.b95High}]`;
      if (resS8 && p8)
        resS8.textContent = `${p8.med} [${p8.b95Low}-${p8.b95High}]`;

      // Mapeo a coordenadas SVG (x: 140..430, y: 170 (piso 0) .. 25 (pico 450))
      const yMaxRef = Math.max(300, (p8 ? p8.b95High : 200) * 1.15);
      const mapearY = (val: number) => {
        const norm = Math.min(1, Math.max(0, val / yMaxRef));
        return 170 - norm * 145;
      };

      const yOrigin = mapearY(y0);
      const yHistPrev = mapearY(Math.max(0, y0 * (1 - (impulso / 100) * 0.6)));

      if (circleT) {
        circleT.setAttribute('cy', yOrigin.toFixed(1));
      }
      if (pathHist) {
        pathHist.setAttribute(
          'd',
          `M 40 ${mapearY(y0 * 0.85).toFixed(1)} Q 90 ${yHistPrev.toFixed(1)}, 140 ${yOrigin.toFixed(1)}`,
        );
      }

      // Puntos del fan chart:
      const yMed4 = mapearY(p4.med);
      const yMed8 = mapearY(p8.med);
      const y50Low8 = mapearY(p8.b50Low);
      const y50High8 = mapearY(p8.b50High);
      const y95Low8 = mapearY(p8.b95Low);
      const y95High8 = mapearY(p8.b95High);

      const y50Low4 = mapearY(p4.b50Low);
      const y50High4 = mapearY(p4.b50High);
      const y95Low4 = mapearY(p4.b95Low);
      const y95High4 = mapearY(p4.b95High);

      if (pathMediana) {
        pathMediana.setAttribute(
          'd',
          `M 140 ${yOrigin.toFixed(1)} Q 260 ${yMed4.toFixed(1)}, 430 ${yMed8.toFixed(1)}`,
        );
      }
      if (path50) {
        path50.setAttribute(
          'd',
          `M 140 ${yOrigin.toFixed(1)} Q 260 ${y50High4.toFixed(1)}, 430 ${y50High8.toFixed(1)} L 430 ${y50Low8.toFixed(1)} Q 260 ${y50Low4.toFixed(1)}, 140 ${yOrigin.toFixed(1)} Z`,
        );
      }
      if (path95) {
        path95.setAttribute(
          'd',
          `M 140 ${yOrigin.toFixed(1)} Q 260 ${y95High4.toFixed(1)}, 430 ${y95High8.toFixed(1)} L 430 ${y95Low8.toFixed(1)} Q 260 ${y95Low4.toFixed(1)}, 140 ${yOrigin.toFixed(1)} Z`,
        );
      }
    }

    if (sliderCasos && sliderTendencia && sliderClima) {
      sliderCasos.addEventListener('input', actualizarSimulador);
      sliderTendencia.addEventListener('input', actualizarSimulador);
      sliderClima.addEventListener('input', actualizarSimulador);
      actualizarSimulador();
    }
  }

  // Ejecutar al montar o al reingresar por ViewTransitions si aplican
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', inicializarFichaPredictiva);
  } else {
    inicializarFichaPredictiva();
  }
  document.addEventListener('astro:page-load', inicializarFichaPredictiva);
</script>

<style>
  .escenario-panel {
    display: none;
    animation: fadeIn 0.35s ease-out both;
  }
  .escenario-panel.active {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Respeto a usuarios con reducción de movimiento */
  @media (prefers-reduced-motion: reduce) {
    .escenario-panel {
      animation: none !important;
    }
    circle animate,
    circle animateTransform {
      display: none !important;
    }
  }
</style>
