# Dependencias directas de producción. requirements.txt se genera desde aquí,
# con todas las transitivas fijadas y un hash por archivo, y se instala con
# pip install --require-hashes. Para cambiar una versión, editar este archivo y
# regenerar (Python 3.14 en Linux x86_64, como la imagen y el CI):
#   cd backend
#   uv pip compile --generate-hashes --strip-extras --python-version 3.14 \
#       --python-platform x86_64-unknown-linux-gnu -o requirements.txt requirements.in
#   uv pip compile --generate-hashes --strip-extras --python-version 3.14 \
#       --python-platform x86_64-unknown-linux-gnu -o requirements-dev.txt requirements-dev.in
# pip-compile de pip-tools produce el mismo formato y también sirve.
