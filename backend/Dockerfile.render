# Imagen de produccion para Render. El contexto de build es la raiz del
# repo (render.yaml: dockerContext: .) para poder copiar db/aplicar_migraciones.py
# y db/migrations/ -- el preDeployCommand necesita esos archivos dentro de
# la imagen, y no viven bajo backend/. docker-compose sigue usando
# backend/Dockerfile con contexto ./backend; no mezclar los dos.
FROM python:3.11-slim

WORKDIR /app

# Solo las dependencias de la API (ADR 0025): ni las de la ingesta ni las de
# los tests. Todas se instalan desde wheels (--only-binary), así que la imagen
# no lleva compilador ni libpq-dev; psycopg2-binary trae su libpq. Si una
# versión nueva deja de publicar wheel, el build falla aquí en vez de
# compilarla en silencio.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements.txt

COPY backend/ .
COPY db/aplicar_migraciones.py db/aplicar_migraciones.py
COPY db/crear_rol_aplicacion.py db/crear_rol_aplicacion.py
COPY db/migrations/ db/migrations/

RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
