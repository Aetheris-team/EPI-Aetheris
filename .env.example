# Configuración de referencia para ejecutar FastAPI de forma independiente.
# El sitio estático y el exportador de datos no necesitan un archivo .env.

POSTGRES_HOST=localhost
POSTGRES_USER=aetheris_user
POSTGRES_PASSWORD=aetheris_secure_password
POSTGRES_DB=epi_aetheris

# Solo para clientes web de una API ejecutada por separado.
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Documentación interactiva de la API independiente (/docs, /redoc).
API_DOCS_ENABLED=true

# Límites de peticiones por IP (backend/api/main.py, formato de slowapi).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_HEAVY=30/minute
RATE_LIMIT_WRITE=10/minute
RATE_LIMIT_AUTH=10/minute
