# Variables de docker-compose.yml. Todas tienen el mismo valor por defecto en
# el compose, así que este archivo es opcional: Dockyard lo copia como .env si
# no existe, y `docker compose up -d --build` funciona igual sin él.

# Base de datos (servicio db). El backend se conecta a ella por la red interna
# del compose con el nombre de servicio "db"; su puerto no se publica.
POSTGRES_USER=aetheris_user
POSTGRES_PASSWORD=aetheris_secure_password
POSTGRES_DB=epi_aetheris

# El sitio abre en http://localhost:8401 (puerto del Equipo 4) y nginx reenvía
# /api al backend en el mismo origen, así que CORS no interviene. Solo hace
# falta si alguien llama a la API desde otro origen.
CORS_ALLOWED_ORIGINS=http://localhost:8401

# Documentación interactiva de la API (/docs, /redoc). No se publica por nginx;
# queda dentro de la red del compose.
API_DOCS_ENABLED=true

# Límites de peticiones por IP (backend/api/main.py, formato de slowapi).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_HEAVY=30/minute
RATE_LIMIT_WRITE=10/minute
RATE_LIMIT_AUTH=10/minute
