# Configuración de Base de Datos
POSTGRES_USER=aetheris_user
POSTGRES_PASSWORD=aetheris_secure_password
POSTGRES_DB=epi_aetheris
# Dentro del contenedor backend, docker-compose.yml inyecta POSTGRES_HOST=db.
# Desde el host (migraciones, pytest, uvicorn local) el valor "db" no
# resuelve: db/aplicar_migraciones.py lo trata como localhost. En Render,
# fromDatabase inyecta el hostname gestionado y el preDeployCommand corre
# dentro de la imagen, donde sí resuelve.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Roles de base de datos (ADR 0024, punto E). Ambas son opcionales: vacías, la
# API y el runner usan las POSTGRES_* de arriba, que en desarrollo son el rol
# propietario. En Render se definen en el panel (sync: false), con el rol de
# aplicación (epi_app) en DATABASE_URL y el propietario en
# DATABASE_URL_MIGRACIONES. Para probar el rol de aplicación en local:
# docs/seguridad/roles-de-base-de-datos.md. Nunca commitear una URL con clave.
DATABASE_URL=
DATABASE_URL_MIGRACIONES=

# Pool de conexiones a Postgres (backend/api/main.py, tarea de rendimiento).
# Todos opcionales. POSTGRES_POOL_MAX es el techo de conexiones simultaneas
# hacia la BD -- ajustar segun el limite real del plan (p.ej. basic-256mb en
# Render admite pocas). POSTGRES_POOL_ACQUIRE_TIMEOUT (segundos) es cuanto
# espera un request a que se libere un slot del pool antes de devolver 500.
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_POOL_ACQUIRE_TIMEOUT=10

# Cache de respuestas en memoria de la API (backend/api/cache_respuestas.py).
# Opcionales. Guarda las respuestas de solo lectura durante el mismo TTL de su
# Cache-Control. API_CACHE_ENABLED=false lo apaga; API_CACHE_MAX_BYTES es el
# techo de memoria (default 32 MiB).
API_CACHE_ENABLED=true
API_CACHE_MAX_BYTES=33554432

# Orígenes permitidos por CORS en el backend (backend/api/main.py), separados
# por coma sin espacios. Default si no se define: http://localhost:4321.
# Debe incluir el dominio del frontend desplegado (ej. https://xxx.vercel.app)
# o las llamadas del navegador al backend fallarán silenciosamente.
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Documentación interactiva de la API (/docs, /redoc, /openapi.json). Activa
# por defecto; en producción (render.yaml) está en false (ADR 0024).
API_DOCS_ENABLED=true

# Rate limiting de la API (backend/api/main.py, issue #61). Todos opcionales.
# RATE_LIMIT_ENABLED=false desactiva el límite por completo (lo usan los tests).
# RATE_LIMIT_DEFAULT: límite global por IP. RATE_LIMIT_HEAVY: límite más
# estricto para los endpoints que recalculan on-demand (/api/v1/spatial/current,
# /api/v1/presion/current, /api/v1/analisis/dengue*, /api/riesgo-nacional).
# RATE_LIMIT_WRITE: POST/PATCH /api/alertas (operación humana de baja
# frecuencia). Default 10/minute; no hace falta declararlo en Render salvo
# que se quiera otro valor en producción.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_HEAVY=30/minute
RATE_LIMIT_WRITE=10/minute

# URL pública del backend que consume el frontend (Astro, variable PUBLIC_*
# -- se embebe en el bundle del cliente). Default si no se define:
# http://localhost:8000.
PUBLIC_API_URL=http://localhost:8000

# Token compartido para POST/PATCH de alertas de campo (ADR 0015). Vacío a
# propósito: un valor real no va al repositorio. Sin esta variable (o con
# ella vacía) la escritura responde 503. En Render se pide en el panel
# (sync: false). Nunca commitear el secreto.
ALERTAS_TOKEN=
# Sitio que enlaza el feed Atom de alertas (/api/alertas/feed.xml). Opcional;
# default https://epi-aetheris.dev.
# SITIO_PUBLICO=http://localhost:4321

# Cuentas de usuario (ADR 0024). CUENTAS_HABILITADAS=false deja la API sin las
# rutas /api/cuenta y /api/admin.
CUENTAS_HABILITADAS=false
# Origen del sitio, que es el que puede llamar a las rutas de cuentas, y el
# identificador de las llaves de acceso (el dominio, sin esquema ni puerto).
AUTH_ORIGEN_CANONICO=http://localhost:4321
AUTH_RP_ID=localhost
# Listas "version:valor", la primera es la vigente. El valor es base64 url-safe
# de al menos 32 bytes aleatorios. Generar con:
#   python -c "import secrets,base64;print('1:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# AUTH_PEPPERS protege las contraseñas y firma los tokens CSRF; AUTH_CLAVES_CIFRADO
# cifra los secretos TOTP. Nunca commitear valores reales.
AUTH_PEPPERS=
AUTH_CLAVES_CIFRADO=
# false evita consultar Have I Been Pwned al fijar una contraseña (desarrollo sin red).
AUTH_HIBP=true
# Correo saliente. En desarrollo: docker compose --profile cuentas up -d mailpit
# y leer los mensajes en http://localhost:8025.
CORREO_REMITENTE=cuentas@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USUARIO=
SMTP_CLAVE=
# Límite por IP de ingreso, segundo factor y recuperación.
# RATE_LIMIT_AUTH=10/minute
# Verificaciones de contraseña (Argon2id, 19 MiB cada una). Se calculan de dos
# en dos; AUTH_HASH_COLA es cuántas pueden esperar turno, AUTH_HASH_ESPERA_S
# cuánto esperan como máximo y AUTH_HASH_POR_MINUTO el tope global por minuto
# sin importar la IP. Lo que no cabe recibe 503 con Retry-After.
# AUTH_HASH_COLA=2
# AUTH_HASH_ESPERA_S=2
# AUTH_HASH_POR_MINUTO=120
# Proxies de confianza entre el cliente y la API. En local no hay ninguno que
# anexe X-Forwarded-For; en Render la API queda detrás del balanceador y del
# Cloudflare de la plataforma, y ahí debe valer 2 (con 1 la IP que se toma es
# la de Cloudflare). Comprobarlo mirando la red de la sesión en /cuenta.
# TRUSTED_PROXY_DEPTH=1
